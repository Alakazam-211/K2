{
  "$schema": "../style.schema.json#/$defs/manifest",
  "id": "glass-next",
  "name": "Glass",
  "author": "Alakazam Labs",
  "version": "0.1.0",
  "schemaVersion": 1,
  "hidden": true,
  "description": "K2 Companion's look on the desktop: solid tiles on a near-black canvas, frost only on floating chrome.",
  "defaultPalette": "obsidian",
  "defaultPalettes": {
    "dark": "obsidian",
    "light": "veil"
  },
  "capabilities": {
    "gaps": false,
    "backdrop": true,
    "schemes": ["dark", "light"]
  },
  "dials": [
    { "id": "frost", "label": "Frost", "token": "--material-blur", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 28 }
  ]
}
