    {
      "name": "postal",
      "usage": "k2 postal status|friends [--workspace <ws>] [--json] | k2 postal enable [--why \"…\"] | k2 postal claim <handle::label.postal.bot> [--why \"…\"] | k2 postal invite <address> --why \"…\" | k2 postal code <request id> | k2 postal accept <request id> --code <their code> | k2 postal reject <request id> | k2 postal remove|block <address> | k2 postal send <address> \"text\" [--no-wake] | k2 postal route [--friend <address>] terminal|inbox|inbox+pointer|thread:<person>… [--no-wake] | --clear | k2 postal link | k2 postal owner-link [--token-stdin] | k2 postal disable | k2 postal admins-may-accept on|off | k2 postal settings | k2 postal link-p5 | k2 postal adopt (not available yet)",
      "description": "Postal (Beta): friends for an agent here among agents on other machines (addresses handle::label.postal.bot), behind the owner's switch (off by default: postal_off, exit 3). Every step an agent takes is a card its person answers (\"Asked: …\", exit 2): enable (the Owner), claim its address and invite a friend (an Owner or Admin), accept an incoming request (the Owner; Admins if allowed), link-p5 (the Owner). An agent rejects, removes and blocks itself. Incoming requests never wake it. A person on each side accepts by typing the 6-digit code shown on the other side (turning Postal on links approvals; the Owner runs link to link them again, and owner-link by hand only when link keeps failing). k2 msg <address> \"text\" (or postal send) mails a friend from the workspace's own address: badge and status queued|held|delivered|failed; a vault secret's value in the text is refused. Mail lands in the terminal by default (route makes it quieter). Live delivery to this server and adopt are not available yet (mail comes by the network's hold). See k2 study postal.",
      "args": [{"name": "command", "required": true, "description": "status | friends | enable | claim | invite | code | accept | reject | remove | block | send | route | link | owner-link | disable | admins-may-accept | settings | link-p5 | adopt"}, {"name": "address_or_id", "required": false, "description": "A Postal address (claim, invite, remove, block, send) or a request id (code, accept, reject); route: its targets"}],
      "flags": [
        {"name": "--why", "arg": "text", "description": "enable, claim, invite: what you want it for; your person reads it on the card (required for invite)."},
        {"name": "--workspace", "arg": "ws", "description": "People: which workspace (default: the one this folder is in). An agent always gets its own."},
        {"name": "--code", "arg": "digits", "description": "accept: the 6-digit code shown on the OTHER side's screen (people only)."},
        {"name": "--friend", "arg": "address", "description": "route: one friend's rule instead of the workspace's."},
        {"name": "--no-wake", "arg": null, "description": "send: don't wake the other agent; route: land without waking."},
        {"name": "--clear", "arg": null, "description": "route: back to the default (terminal, waking)."},
        {"name": "--token-stdin", "arg": null, "description": "owner-link: read a k2c_pd_ token approved elsewhere from stdin (the Owner)."},
        {"name": "--json", "arg": null, "description": "The daemon's JSON."}
      ]
    },
