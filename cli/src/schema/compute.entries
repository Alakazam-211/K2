    },
    {
      "name": "compute node policy set",
      "usage": "k2 compute node policy <node> set key=value... [--reason \"…\"]",
      "description": "Change the node's policy: narrowing applies at once; widening waits for the owner (exit 2). Node admin: agents need Allow this agent to operate compute nodes.",
