{
  "$defs": {
    "AgentKind": {
      "description": "What kind of agent a member is.",
      "oneOf": [
        {
          "const": "coworker",
          "description": "A team member in its own right.",
          "type": "string"
        },
        {
          "const": "assistant",
          "description": "Pinned to one person; acts within that person's access (C9).",
          "type": "string"
        }
      ]
    },
    "InstallRole": {
      "description": "Install-wide role (C12). Separate from space roles.",
      "oneOf": [
        {
          "const": "owner",
          "description": "All install admin, plus transfer.",
          "type": "string"
        },
        {
          "const": "admin",
          "description": "Spaces, policies, members, guests. No content access to private channels or DMs.",
          "type": "string"
        },
        {
          "const": "member",
          "description": "A regular member.",
          "type": "string"
        },
        {
          "const": "guest",
          "description": "A guest.",
          "type": "string"
        },
        {
          "const": "link_guest",
          "description": "A meeting link guest (Meet MC2a, C6 amendment CC1, CC3): made by redeeming a meeting\nlink, bound to one meeting channel, capped by `LINK_GUEST_MASK`, never a K2\nprincipal. Every S19 guest rule applies, and only the link-guest allowlist passes.",
          "type": "string"
        }
      ]
    },
    "MemberKind": {
      "description": "Whether a member is a person or an agent.",
      "oneOf": [
        {
          "const": "person",
          "description": "A human.",
          "type": "string"
        },
        {
          "const": "agent",
          "description": "A K2 agent.",
          "type": "string"
        }
      ]
    },
    "MgmtPrincipal": {
      "description": "One principal in `GET /mgmt/v1/principals` (directory metadata only).",
      "properties": {
        "agent_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentKind"
            },
            {
              "type": "null"
            }
          ],
          "description": "For agents."
        },
        "assistant_of": {
          "description": "For pinned assistants, the person's external id.",
          "maxLength": 128,
          "pattern": "^(k2:(principal|workspace|connect):[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|k2:owner|local:[a-z0-9_-]{2,64}|link:[1-9][0-9]{0,18}:[A-Z2-7]{16})$",
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "description": "When the member was created.",
          "format": "date-time",
          "type": "string"
        },
        "deactivated": {
          "description": "Whether the member is deactivated.",
          "type": "boolean"
        },
        "deactivated_at": {
          "description": "When the member was deactivated.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "display_name": {
          "description": "The display name.",
          "type": "string"
        },
        "email": {
          "description": "SW14: the email, as provisioned (absent when unset; additive).",
          "type": [
            "string",
            "null"
          ]
        },
        "external_id": {
          "description": "Who the member is outside Sew.",
          "maxLength": 128,
          "pattern": "^(k2:(principal|workspace|connect):[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|k2:owner|local:[a-z0-9_-]{2,64}|link:[1-9][0-9]{0,18}:[A-Z2-7]{16})$",
          "type": "string"
        },
        "install_role": {
          "$ref": "#/$defs/InstallRole",
          "description": "Install role."
        },
        "kind": {
          "$ref": "#/$defs/MemberKind",
          "description": "Person or agent."
        },
        "member_id": {
          "description": "The member id.",
          "pattern": "^[1-9][0-9]{0,18}$",
          "type": "string"
        },
        "pronouns": {
          "description": "SW14: the pronouns, as provisioned (absent when unset; additive).",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "description": "SW14: the title, as provisioned (absent when unset; additive).",
          "type": [
            "string",
            "null"
          ]
        },
        "username": {
          "description": "The handle.",
          "pattern": "^[a-z0-9_-]{2,64}$",
          "type": "string"
        }
      },
      "required": [
        "member_id",
        "external_id",
        "kind",
        "install_role",
        "username",
        "display_name",
        "deactivated",
        "created_at"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A page of an id-keyed list: `{\"items\": [...], \"has_more\": bool}`.",
  "properties": {
    "has_more": {
      "description": "Whether more items exist past this page.",
      "type": "boolean"
    },
    "items": {
      "description": "The items.",
      "items": {
        "$ref": "#/$defs/MgmtPrincipal"
      },
      "type": "array"
    }
  },
  "required": [
    "items",
    "has_more"
  ],
  "title": "Page",
  "type": "object"
}
