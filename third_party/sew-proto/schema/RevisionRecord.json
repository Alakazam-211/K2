{
  "$defs": {
    "MentionsRecord": {
      "additionalProperties": false,
      "description": "Who a message (or revision) mentions.",
      "properties": {
        "channel": {
          "description": "`@channel`.",
          "type": "boolean"
        },
        "groups": {
          "description": "User groups.",
          "items": {
            "description": "A Sew id: a decimal string of a 64-bit time-sortable id (1 to 9223372036854775807).",
            "pattern": "^[1-9][0-9]{0,18}$",
            "type": "string"
          },
          "type": "array"
        },
        "here": {
          "description": "`@here`.",
          "type": "boolean"
        },
        "members": {
          "description": "Members.",
          "items": {
            "description": "A Sew id: a decimal string of a 64-bit time-sortable id (1 to 9223372036854775807).",
            "pattern": "^[1-9][0-9]{0,18}$",
            "type": "string"
          },
          "type": "array"
        },
        "roles": {
          "description": "Roles.",
          "items": {
            "description": "A Sew id: a decimal string of a 64-bit time-sortable id (1 to 9223372036854775807).",
            "pattern": "^[1-9][0-9]{0,18}$",
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`revisions/<channel_id>/<part>.ndjson`: edit history.",
  "properties": {
    "body": {
      "description": "The body (absent when purged or unreadable).",
      "type": [
        "string",
        "null"
      ]
    },
    "channel_id": {
      "description": "Its channel.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "created_at": {
      "description": "When the version was written.",
      "format": "date-time",
      "type": "string"
    },
    "id": {
      "description": "The revision row id.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "mentions": {
      "anyOf": [
        {
          "$ref": "#/$defs/MentionsRecord"
        },
        {
          "type": "null"
        }
      ],
      "description": "Mentions of that version."
    },
    "message_id": {
      "description": "The message.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "purged": {
      "description": "The body was purged.",
      "type": "boolean"
    },
    "replaced_at": {
      "description": "When it was replaced.",
      "format": "date-time",
      "type": "string"
    },
    "unreadable": {
      "description": "The body's key is shredded.",
      "type": "boolean"
    },
    "version": {
      "description": "The version this body was.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "id",
    "message_id",
    "channel_id",
    "version",
    "created_at",
    "replaced_at"
  ],
  "title": "RevisionRecord",
  "type": "object"
}
