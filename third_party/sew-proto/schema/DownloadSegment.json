{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One segment of a compliance download (§19.4).",
  "properties": {
    "bytes": {
      "description": "Sealed size.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "duration_ms": {
      "description": "Length.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "key": {
      "description": "The segment key, base64.",
      "type": "string"
    },
    "member_id": {
      "description": "The speaker.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "segment_id": {
      "description": "The segment.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "start_ms": {
      "description": "Offset from the recording start.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "url": {
      "description": "The viewer-bound ciphertext URL.",
      "type": "string"
    }
  },
  "required": [
    "segment_id",
    "member_id",
    "start_ms",
    "duration_ms",
    "bytes",
    "url",
    "key"
  ],
  "title": "DownloadSegment",
  "type": "object"
}
