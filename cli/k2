    d = call("GET", "/cli/mail/wait", params=params, timeout=t + 30)
    if d.get("timedOut"):
        # §8.2/§11: nothing on stdout, exit 2 (stderr carries the why).
        die({"code": "timeout",
             "hint": "no matching message within %ss — loop 'k2 mail wait' to keep "
                     "listening (the blessed pattern)" % t}, 2)
