{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Answer of `POST /mgmt/v1/meet/init`.",
  "properties": {
    "app_id": {
      "description": "The App it belongs to; absent when not bound.",
      "type": [
        "string",
        "null"
      ]
    },
    "created": {
      "description": "Whether this call created it.",
      "type": "boolean"
    },
    "retention_days": {
      "description": "The Space's chat and transcript retention, in days; absent when the install's shorter\nretention applies instead.",
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "space_id": {
      "description": "The Meetings Space.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    }
  },
  "required": [
    "space_id",
    "created"
  ],
  "title": "MeetInitResponse",
  "type": "object"
}
