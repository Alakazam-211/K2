        {"name": "--owner-key", "arg": "FP", "description": "The owner key's fingerprint to check against."},
        {"name": "--json", "arg": null, "description": "JSON output."}
      ]
    },
    {
      "name": "compute preview",
      "usage": "k2 compute preview on|off|status",
      "description": "Turn the compute preview on or off for this server. Owner only, from a plain terminal, not a K2 tab.",
      "args": [{"name": "action", "required": false, "description": "on, off or status (default status)."}],
      "flags": []
    },
    {
      "name": "compute placement",
      "usage": "k2 compute placement v1|v2|status",
      "description": "How K2 ranks nodes when no node is named: v2 (default) = load first, a warm slot worth one load step, bursts spread; v1 = the 0.46.5 order. Owner only.",
      "args": [{"name": "action", "required": false, "description": "v1, v2 or status (default status)."}],
      "flags": []
    },
    {
      "name": "compute node",
      "usage": "k2 compute node add|confirm|remove|rename|retire|pause|drain|resume|pinned-only|route|health|policy|update|rollout|rollback|wall|alerts|admin|servers|packages|take-owner …",
      "description": "Enroll, manage and administer compute nodes.",
      "args": [{"name": "verb", "required": true}],
      "flags": []
    },
    {
      "name": "compute node add",
      "usage": "k2 compute node add <name> [--url URL] [--json]",
      "description": "Mint a 10-minute enroll code (CODE.FP) for a new node. Owner or admin (refused for agents and inside K2 terminals, unless Allow managing compute nodes is on for that agent).",
      "args": [{"name": "name", "required": true}],
      "flags": [
        {"name": "--url", "arg": "URL", "description": "The controller URL the node should dial."},
        {"name": "--json", "arg": null, "description": "{code, expiresAt, name, controller} for scripts."}
      ]
    },
    {
      "name": "compute node confirm",
      "usage": "k2 compute node confirm <name> <code>",
      "description": "Confirm an enrolling node with the 6 digits the node shows. Owner or admin (refused for agents and inside K2 terminals, unless Allow managing compute nodes is on for that agent).",
      "args": [{"name": "name", "required": true}, {"name": "code", "required": true}],
      "flags": []
    },
    {
      "name": "compute node remove",
      "usage": "k2 compute node remove <name>",
      "description": "Remove a node. Owner or admin; it stays the owner's even when an agent may manage compute nodes.",
      "args": [{"name": "name", "required": true}],
      "flags": []
    },
    {
      "name": "compute node rename",
      "usage": "k2 compute node rename <old> <new>",
      "description": "Rename a node. Owner or admin (refused for agents and inside K2 terminals, unless Allow managing compute nodes is on for that agent).",
      "args": [{"name": "old", "required": true}, {"name": "new", "required": true}],
      "flags": []
    },
    {
      "name": "compute node retire",
      "usage": "k2 compute node retire <name>",
      "description": "Drain a node, then remove it once its jobs end. Owner or admin (refused for agents and inside K2 terminals, unless Allow managing compute nodes is on for that agent).",
      "args": [{"name": "name", "required": true}],
      "flags": []
    },
    {
      "name": "compute node pause",
      "usage": "k2 compute node pause <name>",
      "description": "This server stops assigning jobs to the node. Owner or admin (refused for agents and inside K2 terminals, unless Allow managing compute nodes is on for that agent).",
      "args": [{"name": "name", "required": true}],
      "flags": []
    },
    {
      "name": "compute node drain",
      "usage": "k2 compute node drain <name>",
      "description": "This server stops assigning jobs to the node. Owner or admin (refused for agents and inside K2 terminals, unless Allow managing compute nodes is on for that agent).",
      "args": [{"name": "name", "required": true}],
      "flags": []
    },
    {
      "name": "compute node resume",
      "usage": "k2 compute node resume <name>",
      "description": "This server starts assigning jobs to the node again. Owner or admin (refused for agents and inside K2 terminals, unless Allow managing compute nodes is on for that agent).",
      "args": [{"name": "name", "required": true}],
      "flags": []
    },
    {
      "name": "compute node pinned-only",
      "usage": "k2 compute node pinned-only <name> on|off",
      "description": "on: only jobs that name the node run there; K2 never chooses it by itself. Owner or Admin.",
      "args": [{"name": "name", "required": true}, {"name": "on|off", "required": true}],
      "flags": []
    },
    {
      "name": "compute node route",
      "usage": "k2 compute node route add|rm <name> <url>",
      "description": "Add or remove a LAN or tailnet URL the node may dial. Owner or admin (refused for agents and inside K2 terminals, unless Allow managing compute nodes is on for that agent).",
      "args": [{"name": "add|rm", "required": true}, {"name": "name", "required": true}, {"name": "url", "required": true}],
      "flags": []
    },
    {
      "name": "compute node servers",
      "usage": "k2 compute node servers <node> [list [--refresh]] [--json]",
      "description": "Sharing a node with other K2 servers (the node's owner server): every server on it with slot, state, trust, share, today's use, end date and pending SAS.",
      "args": [{"name": "node", "required": true}],
