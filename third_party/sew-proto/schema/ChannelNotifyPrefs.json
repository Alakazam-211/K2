{
  "$defs": {
    "NotifyLevel": {
      "description": "A notification level (`*.level` codes 1–3).",
      "oneOf": [
        {
          "const": "all",
          "description": "Every message.",
          "type": "string"
        },
        {
          "const": "mentions",
          "description": "Mentions, DMs, keywords and followed threads.",
          "type": "string"
        },
        {
          "const": "none",
          "description": "Nothing (reminders still arrive).",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A member's prefs for one channel or DM.",
  "properties": {
    "channel_id": {
      "description": "The channel.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "effective_level": {
      "$ref": "#/$defs/NotifyLevel",
      "description": "The level in effect for this member here."
    },
    "level": {
      "anyOf": [
        {
          "$ref": "#/$defs/NotifyLevel"
        },
        {
          "type": "null"
        }
      ],
      "description": "The channel's own level; `null` = inherit."
    },
    "muted": {
      "description": "Muted now.",
      "type": "boolean"
    },
    "muted_until": {
      "description": "When the mute ends; absent = until unmuted (or not muted).",
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "channel_id",
    "effective_level",
    "muted"
  ],
  "title": "ChannelNotifyPrefs",
  "type": "object"
}
