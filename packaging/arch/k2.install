# k2.install — pacman install messages for the Omarchy/Arch whole bundle.
# The packaged files ARE the install (O22). Do not run `k2 daemon install`.
# Never wipe ~/.k2 — that directory is user data, not package state.

# Heartbeat S2 (W5): let the daemon set a wake alarm (timerfd
# CLOCK_BOOTTIME_ALARM) so "Wake this computer for heartbeats" can wake a
# suspended machine. pacman runs these hooks as root. A file capability
# is dropped whenever pacman replaces the binary, so post_upgrade applies
# it again. Children of the daemon (agents) do not inherit it.
_k2_wake_cap() {
    if command -v setcap >/dev/null 2>&1; then
        if setcap cap_wake_alarm+ep /usr/bin/k2-daemon; then
            echo "K2: wake alarm capability set on /usr/bin/k2-daemon (heartbeats can wake this computer)."
        else
            echo "K2: could not set cap_wake_alarm on /usr/bin/k2-daemon; heartbeats will not wake this computer."
        fi
    else
        echo "K2: setcap not found (package libcap); heartbeats will not wake this computer."
    fi
}

post_install() {
    _k2_wake_cap
    echo "K2: /usr/bin/k2 is the CLI; the GUI is /usr/bin/k2-gui (desktop launcher)."
    echo "    Enable the systemd USER unit (do not run 'k2 daemon install'):"
    echo "      systemctl --user daemon-reload"
    echo "      systemctl --user enable --now k2-daemon"
    echo "    Headless/linger boxes: loginctl enable-linger \"\$USER\""
    echo "    Upgrade via pacman/AUR. Do not use 'k2 update' or GitHub daemon swap."
}

post_upgrade() {
    _k2_wake_cap
    echo "K2: reload the user unit after upgrade:"
    echo "      systemctl --user daemon-reload"
    echo "      systemctl --user restart k2-daemon"
}

post_remove() {
    echo "K2: binaries and the user unit were removed."
    echo "    User data in ~/.k2 was left in place. Delete it yourself for a full wipe."
}
