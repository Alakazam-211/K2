{
  "$defs": {
    "NotifyLevel": {
      "description": "A notification level (`*.level` codes 1–3).",
      "oneOf": [
        {
          "const": "all",
          "description": "Every message.",
          "type": "string"
        },
        {
          "const": "mentions",
          "description": "Mentions, DMs, keywords and followed threads.",
          "type": "string"
        },
        {
          "const": "none",
          "description": "Nothing (reminders still arrive).",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Body of `POST /api/v1/spaces/{id}/notify/set`. Returns [`SpaceNotifyPrefs`].",
  "properties": {
    "level": {
      "anyOf": [
        {
          "$ref": "#/$defs/NotifyLevel"
        },
        {
          "type": "null"
        }
      ],
      "description": "The level; `null` = inherit."
    }
  },
  "title": "SetSpaceNotifyRequest",
  "type": "object"
}
