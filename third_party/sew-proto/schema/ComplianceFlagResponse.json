{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response of the compliance-flag routes.",
  "properties": {
    "changed": {
      "description": "Whether this call changed it.",
      "type": "boolean"
    },
    "compliance": {
      "description": "The flag now.",
      "type": "boolean"
    },
    "member_id": {
      "description": "The member.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    }
  },
  "required": [
    "member_id",
    "compliance",
    "changed"
  ],
  "title": "ComplianceFlagResponse",
  "type": "object"
}
