    while [ $# -gt 0 ]; do
        case "$1" in
            --get)
                [ $# -ge 2 ] || { _mail_err "usage" "--get requires the 1-based attachment number"; exit 2; }
                get="$2"; shift 2 ;;
            --out)
                [ $# -ge 2 ] || { _mail_err "usage" "--out requires a workspace-relative path"; exit 2; }
                out="$2"; shift 2 ;;
            --json) as_json=true; shift ;;
