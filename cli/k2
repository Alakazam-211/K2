print(f'{len(sessions)} live session(s):' + note)
print(f'  {\"TERMINAL_ID\":<38}  {\"KIND\":<10}  {\"HANDLE\":<22}  {\"AGENT\":<24}  {\"CMD\":<14}  CWD')
for s in sessions:
