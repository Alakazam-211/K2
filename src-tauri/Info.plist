<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 0.37.9: Microphone access string. macOS REQUIRES this key for any
	     hardened-runtime-signed app to capture audio, including Apple
	     Dictation invoked from inside a focused text input. Without it,
	     the OS silently denies all audio access — Fn-Fn does nothing,
	     no permission prompt appears, no error surfaces. The string
	     here is what shows up in the system permission dialog and in
	     System Settings → Privacy & Security → Microphone.
	     0.46.8: voice rooms (prd-k2-voice-rooms-v1 §4.4) use the same key
	     and the same `com.apple.security.device.audio-input` entitlement. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>K2 uses your microphone for voice rooms, and for macOS Dictation in terminal panes.</string>
	<!-- 0.46.9: video in voice rooms (behind videoRoomsPreview). Sew's plugin
	     opens the camera through AVFoundation; without this key macOS refuses
	     it with no prompt. Goes with `com.apple.security.device.camera` in
	     entitlements.plist. Screen sharing (ScreenCaptureKit) has no usage
	     string: macOS asks with its own Screen Recording prompt, and the
	     grant lives in System Settings → Privacy & Security → Screen &
	     System Audio Recording. -->
	<key>NSCameraUsageDescription</key>
	<string>K2 uses your camera for video in voice rooms, only while you turn it on.</string>
	<!-- Continuity Camera (an iPhone as the Mac's camera): AVFoundation lists
	     the iPhone only to an app that opts in, and macOS logs a warning for
	     an app that opens cameras without this key. -->
	<key>NSCameraUseContinuityCameraDeviceType</key>
	<true/>
</dict>
</plist>
