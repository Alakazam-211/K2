    local body RESP
    body=$(D_ID="$record_id" python3 -c 'import json,os; print(json.dumps({"id": os.environ["D_ID"]}))')
    RESP=$(cli_send cli_post_json "/cli/dns/records/remove" "$body") || RESP=""
    local AS_JSON="$as_json" D_VERB="remove"
