    python3 -c 'import os; print(os.path.abspath(os.path.expanduser(os.environ.get("K2_PROJECT_PATH") or os.environ.get("K2SO_PROJECT_PATH") or os.getcwd())))' 2>/dev/null \
        || echo "${PROJECT:-$PWD}"
}

