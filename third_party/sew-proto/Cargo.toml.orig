[package]
name = "sew-proto"
version.workspace = true
edition.workspace = true
rust-version.workspace = true
# SW1 (Rosson, 2026-10-17): Apache-2.0, with LICENSE and NOTICE in this directory.
license = "Apache-2.0"
publish.workspace = true
repository.workspace = true
description = "Sew wire contracts: ids, addresses, errors, HTTP and gateway bodies, permissions, policies, audit."
# SW8: K2 vendors this crate (scripts/vendor-sew-proto.sh): crates.io dependencies only, no
# path or git sources (tests/vendorable.rs); the package is the sources, the schema and (SW1)
# the Apache-2.0 LICENSE and NOTICE.
include = ["src/**", "schema/**", "LICENSE", "NOTICE"]

[dependencies]
serde = { workspace = true }
serde_json = { workspace = true }
schemars = { workspace = true }
chrono = { workspace = true }

[dev-dependencies]
sha2 = { workspace = true }

[lints]
workspace = true
