        {"name": "--batch", "arg": "N", "description": "With --all: at most N nodes in all."}
      ]
    },
    {
      "name": "compute node rollout",
      "usage": "k2 compute node rollout [show|pause|resume|stop] [--id ID] [--json]",
      "description": "The latest rollout and each node's state (pending, offered, healthy, rolled_back, refused, failed, timed_out, skipped). The first rolled_back pauses it; resume sends to the rest; stop ends it. Node admin: agents need Allow this agent to operate compute nodes.",
