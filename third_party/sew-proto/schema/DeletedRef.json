{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A deleted object's id (`POST …/delete` responses, `*_deleted` events).",
  "properties": {
    "id": {
      "description": "The id.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    }
  },
  "required": [
    "id"
  ],
  "title": "DeletedRef",
  "type": "object"
}
