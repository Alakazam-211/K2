{
  "$schema": "../../style.schema.json#/$defs/palette",
  "id": "charcoal",
  "name": "Charcoal",
  "schemes": [
    "dark"
  ],
  "color": {
    "bg": {
      "$value": "#0a0a0a",
      "$type": "color",
      "$description": "Base app background. Always opaque — the only background allowed on WebGL-hosting panes."
    },
    "bg-surface": {
      "$value": "#141414",
      "$type": "color"
    },
    "bg-elevated": {
      "$value": "#1e1e1e",
      "$type": "color"
    },
    "bg-inset": {
      "$value": "#1a1a1a",
      "$type": "color",
      "$description": "Recessed content wells: code blocks, table headers."
    },
    "bg-stripe": {
      "$value": "#111111",
      "$type": "color",
      "$description": "Zebra rows, blockquote fills."
    },
    "bg-canvas": {
      "$value": "#0a0a0a",
      "$type": "color",
      "$description": "The layer visible BEHIND tiles when gap.* > 0 (ST3). Square: same as bg, so seams read as hairlines."
    },
    "bg-hover": {
      "$value": "#1e1e1e",
      "$type": "color",
      "$description": "Hover fill for rows/chips. (Referenced by components since before the contract existed but never defined — dead hovers come alive with this definition.)"
    },
    "border": {
      "$value": "#2a2a2a",
      "$type": "color"
    },
    "border-strong": {
      "$value": "rgba(255, 255, 255, 0.25)",
      "$type": "color",
      "$description": "Checkbox outlines and other controls needing more contrast than border."
    },
    "text-primary": {
      "$value": "#e4e4e7",
      "$type": "color"
    },
    "text-secondary": {
      "$value": "#a1a1aa",
      "$type": "color"
    },
    "text-muted": {
      "$value": "#71717a",
      "$type": "color"
    },
    "accent": {
      "$value": "#3b82f6",
      "$type": "color"
    },
    "accent-hover": {
      "$value": "#60a5fa",
      "$type": "color"
    },
    "accent-soft": {
      "$value": "#93c5fd",
      "$type": "color",
      "$description": "Attention washes (settings-search pulse)."
    },
    "on-accent": {
      "$value": "#ffffff",
      "$type": "color",
      "$description": "Glyphs/knobs drawn on accent or bright fills (checkbox check, slider thumb)."
    },
    "status-working": {
      "$value": "#f97316",
      "$type": "color"
    },
    "status-error": {
      "$value": "#ef4444",
      "$type": "color"
    },
    "status-ok": {
      "$value": "#22c55e",
      "$type": "color"
    },
    "status-warn": {
      "$value": "oklch(76.9% 0.188 70.08)",
      "$type": "color"
    },
    "status-ok-soft": {
      "$value": "#4ade80",
      "$type": "color",
      "$description": "Lighter ok — update-available/LLM-ready dots."
    },
    "status-error-soft": {
      "$value": "#f87171",
      "$type": "color",
      "$description": "Error text (the app-wide text-red-400 idiom)."
    },
    "status-error-bright": {
      "$value": "oklch(80.8% 0.114 19.571)",
      "$type": "color",
      "$description": "Hover-brightened error text (red-300 idiom)."
    },
    "status-error-text": {
      "$value": "#ff6666",
      "$type": "color",
      "$description": "Error text in pane/tab title bars (#f66 idiom)."
    },
    "status-working-soft": {
      "$value": "oklch(75% 0.183 55.934)",
      "$type": "color"
    },
    "status-warn-text": {
      "$value": "oklch(85.2% 0.199 91.936)",
      "$type": "color",
      "$description": "Warning text (yellow-400 idiom)."
    },
    "status-warn-amber": {
      "$value": "oklch(82.8% 0.189 84.429)",
      "$type": "color",
      "$description": "Amber warning family (banners/badges): amber-400."
    },
    "status-warn-amber-soft": {
      "$value": "oklch(87.9% 0.169 91.605)",
      "$type": "color",
      "$description": "amber-300."
    },
    "status-warn-amber-bright": {
      "$value": "oklch(92.4% 0.12 95.746)",
      "$type": "color",
      "$description": "amber-200."
    },
    "status-ok-hover": {
      "$value": "#16a34a",
      "$type": "color",
      "$description": "Hover state on ok-filled buttons (green-600 idiom)."
    },
    "danger": {
      "$value": "#dc2626",
      "$type": "color",
      "$description": "Destructive button fill (red-600 idiom)."
    },
    "danger-active": {
      "$value": "#b91c1c",
      "$type": "color",
      "$description": "Destructive button hover/active (red-700 idiom)."
    },
    "wash-1": {
      "$value": "rgba(255, 255, 255, 0.05)",
      "$type": "color",
      "$description": "Faintest interactive wash (bg-white/5 idiom). Light palettes invert to black washes."
    },
    "wash-2": {
      "$value": "rgba(255, 255, 255, 0.1)",
      "$type": "color"
    },
    "wash-3": {
      "$value": "rgba(255, 255, 255, 0.2)",
      "$type": "color"
    },
    "status-warn-soft": {
      "$value": "#eab308",
      "$type": "color"
    },
    "neutral": {
      "$value": "#6b7280",
      "$type": "color",
      "$description": "Idle/disconnected gray dots and captions."
    },
    "control-track-off": {
      "$value": "#333333",
      "$type": "color",
      "$description": "Toggle track in the off position."
    },
    "diff-add-text": {
      "$value": "#a3e635",
      "$type": "color"
    },
    "diff-remove-text": {
      "$value": "#fca5a5",
      "$type": "color"
    },
    "diff-modified-border": {
      "$value": "#86efac",
      "$type": "color"
    },
    "code-inline": {
      "$value": "#d7ba7d",
      "$type": "color",
      "$description": "Inline code text in markdown."
    },
    "danger-hover": {
      "$value": "#f87171",
      "$type": "color",
      "$description": "Destructive-affordance hover (close buttons)."
    },
    "overlay-soft-bg": {
      "$value": "rgba(255, 255, 255, 0.06)",
      "$type": "color",
      "$description": "Faint white washes (minimap viewport overlay)."
    },
    "overlay-soft-border": {
      "$value": "rgba(255, 255, 255, 0.08)",
      "$type": "color"
    },
    "scrollbar-thumb": {
      "$value": "rgba(255, 255, 255, 0.1)",
      "$type": "color"
    },
    "scrollbar-thumb-hover": {
      "$value": "rgba(255, 255, 255, 0.2)",
      "$type": "color"
    },
    "scrollbar-thumb-strong": {
      "$value": "rgba(255, 255, 255, 0.25)",
      "$type": "color",
      "$description": "Editor scrollbars run brighter than app scrollbars."
    },
    "scrollbar-thumb-strong-hover": {
      "$value": "rgba(255, 255, 255, 0.4)",
      "$type": "color"
    },
    "scrim": {
      "$value": "rgba(0, 0, 0, 0.5)",
      "$type": "color",
      "$description": "Modal backdrop."
    },
    "danger-muted": {
      "$value": "#c53030",
      "$type": "color",
      "$description": "Muted destructive fill (ConfirmDialog confirm, kick buttons)."
    }
  },
  "terminal": {
