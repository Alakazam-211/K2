cmd_release() {
    local agent="${K2SO_AGENT_NAME:-}"
    local paths=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --agent) agent="$2"; shift 2 ;;
            *) paths+=("$1"); shift ;;
