{
  "$defs": {
    "ReorderCategoryItem": {
      "additionalProperties": false,
      "description": "One category's new position.",
      "properties": {
        "category_id": {
          "description": "The category.",
          "pattern": "^[1-9][0-9]{0,18}$",
          "type": "string"
        },
        "position": {
          "description": "Its new position.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "category_id",
        "position"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Body of `POST /api/v1/spaces/{id}/categories/reorder`.",
  "properties": {
    "items": {
      "description": "1–200 items with distinct category ids.",
      "items": {
        "$ref": "#/$defs/ReorderCategoryItem"
      },
      "type": "array"
    }
  },
  "required": [
    "items"
  ],
  "title": "ReorderCategoriesRequest",
  "type": "object"
}
