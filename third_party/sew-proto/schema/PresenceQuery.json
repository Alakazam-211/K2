{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Query of `GET /api/v1/presence`.",
  "properties": {
    "ids": {
      "description": "1–100 member ids.",
      "pattern": "^[1-9][0-9]{0,18}(,[1-9][0-9]{0,18}){0,99}$",
      "type": "string"
    }
  },
  "required": [
    "ids"
  ],
  "title": "PresenceQuery",
  "type": "object"
}
