{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`space_members.ndjson`.",
  "properties": {
    "added_by": {
      "description": "Who added them.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": [
        "string",
        "null"
      ]
    },
    "joined_at": {
      "description": "Joined.",
      "format": "date-time",
      "type": "string"
    },
    "member_id": {
      "description": "The member.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "role_ids": {
      "description": "Roles held (not `@everyone`), ascending.",
      "items": {
        "description": "A Sew id: a decimal string of a 64-bit time-sortable id (1 to 9223372036854775807).",
        "pattern": "^[1-9][0-9]{0,18}$",
        "type": "string"
      },
      "type": "array"
    },
    "space_id": {
      "description": "The space.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "timeout_until": {
      "description": "Timed out until.",
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "space_id",
    "member_id",
    "joined_at"
  ],
  "title": "SpaceMemberRecord",
  "type": "object"
}
