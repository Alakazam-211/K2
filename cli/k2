            printf '%s' "$_CP_BODY" | python3 -c '
import json, sys, time
for l in json.load(sys.stdin).get("lines") or []:
    at = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(l.get("at", 0)))
    hp = "%s:%s" % (l.get("host", "-"), l.get("port", "-"))
