cmd_app_access() {
    local ws="" manage="" open=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --manage) manage="${2:-}"; shift 2 ;;
            --open) open="${2:-}"; shift 2 ;;
            -h|--help) _app_grace_usage; return 0 ;;
            -*) echo "Unknown flag: $1" >&2; exit 2 ;;
            *) ws="$1"; shift ;;
        esac
    done
    { [ -z "$ws" ] || { [ -z "$manage" ] && [ -z "$open" ]; }; } && { echo "usage: k2 app access <workspace> [--manage on|off] [--open on|off]" >&2; exit 2; }
    local t v
    # The parent first when turning on; the child first when turning off.
    for t in manage open; do
        [ "$t" = manage ] && v="$manage" || v="$open"
        [ -z "$v" ] && continue
        case "$v" in on|off) ;; *) echo "usage: --$t on|off" >&2; exit 2 ;; esac
    done
    local order="manage open"
    [ "$manage" = off ] && order="open manage"
    for t in $order; do
        [ "$t" = manage ] && v="$manage" || v="$open"
        [ -z "$v" ] && continue
        _compute_call POST /cli/agent-access/set "$(_compute_json K2_CJ_workspace="$ws" K2_CJ_toggle="apps_$t" K2_CJ_value_b="$([ "$v" = on ] && echo 1 || echo 0)")"
    done
    printf '%s' "$_CP_BODY" | python3 -c '
import json, sys
v = json.load(sys.stdin)
print("%s: manage Apps %s, publish open Apps %s" % (v.get("workspace"), "on" if v.get("agentsCanManageApps") else "off", "on" if v.get("agentsCanPublishOpenApps") else "off"))'
}

