    print("API key created (id: %s)." % d.get("id",""))
    caps=d.get("capabilities") or {}
    if caps:
        on=[n for n,v in (("host-sessions",caps.get("hostSessions")),
                          ("canonical-message",caps.get("canonicalMessage")),
                          ("sandboxes",caps.get("sandboxes")),
