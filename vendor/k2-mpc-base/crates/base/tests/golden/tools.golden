argv: "tail" "-n" "+1"
text: "a\nb\nc\n"
out: "a\nb\nc\n"
exit: 0

=== tail-n-plus-zero
argv: "tail" "-n" "+0"
text: "a\nb\nc\n"
out: "a\nb\nc\n"
exit: 0

=== tail-n-zero
argv: "tail" "-n" "0"
text: "a\nb\nc\n"
out: ""
exit: 0

=== tail-n-minus
argv: "tail" "-n" "-2"
text: "a\nb\nc\n"
out: "b\nc\n"
exit: 0

=== tail-n-no-final-newline
argv: "tail" "-n" "1"
text: "a\nb"
out: "b"
exit: 0

=== tail-n-two-no-final-newline
argv: "tail" "-n" "2"
text: "a\nb"
out: "a\nb"
exit: 0

=== tail-n-blank-last
argv: "tail" "-n" "1"
text: "a\n\n"
out: "\n"
exit: 0

=== tail-n-more-than-lines
argv: "tail" "-n" "5"
text: "a\nb\n"
out: "a\nb\n"
exit: 0

=== tail-numeric
argv: "tail" "-3"
text: "1\n2\n3\n4\n5\n"
out: "3\n4\n5\n"
exit: 0

=== tail-c
argv: "tail" "-c" "3"
text: "abcdef\n"
out: "ef\n"
exit: 0

=== tail-c-plus
argv: "tail" "-c" "+3"
text: "abcdef\n"
out: "cdef\n"
exit: 0

=== tail-c-crlf-bytes
argv: "tail" "-c" "2"
file: "a\r\nb\r\n"
out: "\r\n"
exit: 0

=== tail-empty
argv: "tail"
text: ""
out: ""
exit: 0

=== tail-f-unsupported
argv: "tail" "-f"
text: "a\n"
exit: 2
err: unsupported
gnu: k2

=== tail-follow-unsupported
argv: "tail" "--follow"
text: "a\n"
exit: 2
err: unsupported
gnu: k2

# ---------------------------------------------------------------- wc
=== wc-default
argv: "wc"
text: "a b\nc\n"
out: "2 3 6 notes.md\n"
exit: 0

=== wc-default-padded
argv: "wc"
text: "x\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\nx\n"
out: " 50  50 100 notes.md\n"
exit: 0

=== wc-l
argv: "wc" "-l"
text: "a\nb\n"
out: "2 notes.md\n"
exit: 0

=== wc-l-no-final-newline
argv: "wc" "-l"
text: "a\nb"
out: "1 notes.md\n"
exit: 0

=== wc-w
argv: "wc" "-w"
text: "  hello   world \n"
out: "2 notes.md\n"
exit: 0

=== wc-w-tabs
argv: "wc" "-w"
text: "a\tb\n\nc\n"
out: "3 notes.md\n"
exit: 0

=== wc-c-utf8
argv: "wc" "-c"
text: "héllo\n"
out: "7 notes.md\n"
exit: 0

=== wc-m-utf8
argv: "wc" "-m"
text: "héllo\n"
out: "6 notes.md\n"
exit: 0

=== wc-lc
argv: "wc" "-lc"
text: "a\na\na\na\na\na\na\na\na\na\n"
out: "10 20 notes.md\n"
exit: 0

=== wc-all-four
argv: "wc" "-l" "-w" "-m" "-c"
text: "ab\n"
out: "1 1 3 3 notes.md\n"
exit: 0

=== wc-long-options
argv: "wc" "--lines" "--words"
text: "a b\nc\n"
out: "2 3 notes.md\n"
exit: 0

=== wc-empty
argv: "wc"
text: ""
out: "0 0 0 notes.md\n"
exit: 0

=== wc-c-crlf-bytes
argv: "wc" "-c"
file: "a\r\nb\r\n"
out: "6 notes.md\n"
exit: 0

=== wc-m-bom
argv: "wc" "-m"
file: "\u{feff}a\n"
out: "3 notes.md\n"
exit: 0

=== wc-L-unsupported
argv: "wc" "-L"
text: "a\n"
exit: 2
err: unsupported
gnu: k2

# ---------------------------------------------------------------- grep: basics
=== grep-basic
argv: "grep" "foo"
text: "foo\nbar\nfood\n"
out: "foo\nfood\n"
exit: 0

=== grep-no-match
argv: "grep" "zzz"
text: "foo\nbar\n"
out: ""
exit: 1

=== grep-n
argv: "grep" "-n" "foo"
text: "foo\nbar\nfood\n"
out: "1:foo\n3:food\n"
exit: 0

=== grep-c
argv: "grep" "-c" "foo"
text: "foo\nbar\nfood\n"
out: "2\n"
exit: 0

=== grep-c-none
argv: "grep" "-c" "zzz"
text: "foo\nbar\n"
out: "0\n"
exit: 1

=== grep-v
argv: "grep" "-v" "foo"
text: "foo\nbar\nfood\n"
out: "bar\n"
exit: 0

=== grep-v-all-match
argv: "grep" "-v" "o"
text: "foo\nbo\n"
out: ""
exit: 1

=== grep-i
argv: "grep" "-i" "FOO"
text: "foo\nbar\nFood\n"
out: "foo\nFood\n"
exit: 0

=== grep-w
argv: "grep" "-w" "foo"
text: "foo\nfoobar\nthe foo.\n"
out: "foo\nthe foo.\n"
exit: 0

=== grep-x
argv: "grep" "-x" "foo"
text: "foo\nfood\n foo\n"
out: "foo\n"
exit: 0

=== grep-q-match
argv: "grep" "-q" "foo"
text: "foo\n"
out: ""
exit: 0

=== grep-q-none
argv: "grep" "-q" "zzz"
text: "foo\n"
out: ""
exit: 1

=== grep-l
argv: "grep" "-l" "foo"
text: "foo\nbar\n"
out: "notes.md\n"
exit: 0

=== grep-l-none
argv: "grep" "-l" "zzz"
text: "foo\n"
out: ""
exit: 1

=== grep-L-has-match
argv: "grep" "-L" "foo"
text: "foo\n"
out: ""
exit: 0

=== grep-L-no-match
argv: "grep" "-L" "zzz"
text: "foo\n"
out: "notes.md\n"
exit: 1

=== grep-H
argv: "grep" "-H" "foo"
text: "foo\nbar\nfood\n"
out: "notes.md:foo\nnotes.md:food\n"
exit: 0

=== grep-Hn
argv: "grep" "-Hn" "foo"
text: "foo\nbar\nfood\n"
out: "notes.md:1:foo\nnotes.md:3:food\n"
exit: 0

=== grep-Hc
argv: "grep" "-H" "-c" "foo"
text: "foo\nbar\nfood\n"
out: "notes.md:2\n"
exit: 0

=== grep-h
argv: "grep" "-h" "foo"
text: "foo\nbar\n"
out: "foo\n"
exit: 0

=== grep-H-then-h
argv: "grep" "-H" "-h" "foo"
text: "foo\n"
out: "foo\n"
exit: 0

=== grep-m1
argv: "grep" "-m" "1" "foo"
text: "foo\nbar\nfood\n"
out: "foo\n"
exit: 0

=== grep-m1-c
argv: "grep" "-m1" "-c" "foo"
text: "foo\nbar\nfood\n"
out: "1\n"
exit: 0

=== grep-m0
argv: "grep" "-m" "0" "foo"
text: "foo\n"
out: ""
exit: 1

=== grep-max-count-long
argv: "grep" "--max-count=2" "-c" ""
text: "a\nb\nc\nd\ne\n"
out: "2\n"
exit: 0

=== grep-e-twice
argv: "grep" "-e" "foo" "-e" "bar"
text: "foo\nbar\nbaz\nfood\n"
out: "foo\nbar\nfood\n"
exit: 0

=== grep-pattern-newline
argv: "grep" "foo\nbar"
text: "foo\nbar\nbaz\nfood\n"
out: "foo\nbar\nfood\n"
exit: 0

=== grep-option-after-pattern
argv: "grep" "foo" "-n"
text: "x\nfoo\n"
out: "2:foo\n"
exit: 0

=== grep-double-dash
argv: "grep" "--" "-x"
text: "a-x\nb\n"
out: "a-x\n"
exit: 0

=== grep-regexp-long
argv: "grep" "--regexp=foo" "--line-number"
text: "a\nfoo\n"
out: "2:foo\n"
exit: 0

=== grep-long-prefix
argv: "grep" "--line-n" "foo"
text: "foo\n"
out: "1:foo\n"
exit: 0

=== grep-color-never
argv: "grep" "--color=never" "foo"
text: "foo\n"
out: "foo\n"
exit: 0

=== grep-no-final-newline
argv: "grep" "b"
text: "a\nb"
out: "b\n"
exit: 0

=== grep-n-empty-pattern
argv: "grep" "-n" ""
text: "a\n\nb"
out: "1:a\n2:\n3:b\n"
exit: 0

=== grep-empty-doc
argv: "grep" ""
text: ""
out: ""
exit: 1

=== grep-c-empty-pattern
argv: "grep" "-c" ""
text: "a\n\nb\n"
out: "3\n"
exit: 0

=== grep-x-empty
argv: "grep" "-x" ""
text: "a\n\nb\n"
out: "\n"
exit: 0

=== grep-c-no-final-newline
argv: "grep" "-c" "x"
text: "x"
out: "1\n"
exit: 0

# ---------------------------------------------------------------- grep: patterns
=== grep-F-dot
argv: "grep" "-F" "a.c"
text: "abc\na.c\n"
out: "a.c\n"
exit: 0

=== grep-bre-dot
argv: "grep" "a.c"
text: "abc\na.c\nac\n"
out: "abc\na.c\n"
exit: 0

=== grep-E-plus
argv: "grep" "-E" "ab+c"
text: "ac\nabc\nabbc\n"
out: "abc\nabbc\n"
exit: 0

=== grep-bre-plus-literal
argv: "grep" "ab+c"
text: "abbc\nab+c\n"
out: "ab+c\n"
exit: 0

=== grep-bre-escaped-plus
argv: "grep" "ab\\+c"
text: "abbc\nac\nab+c\n"
out: "abbc\n"
exit: 0

=== grep-bre-question
argv: "grep" "colou\\?r"
text: "color\ncolour\ncolouur\n"
out: "color\ncolour\n"
exit: 0

=== grep-E-interval
argv: "grep" "-E" "^a{2}$"
text: "a\naa\naaa\n"
out: "aa\n"
exit: 0

=== grep-bre-interval
argv: "grep" "^a\\{2\\}$"
text: "a\naa\naaa\n"
out: "aa\n"
exit: 0

=== grep-bre-interval-range
argv: "grep" "-x" "a\\{1,2\\}"
text: "a\naa\naaa\n"
out: "a\naa\n"
exit: 0

=== grep-E-interval-open
argv: "grep" "-xE" "a{2,}"
text: "a\naa\naaa\n"
out: "aa\naaa\n"
exit: 0

=== grep-E-alternation-group
argv: "grep" "-E" "^(ab|cd)$"
text: "ab\ncd\nabcd\n"
out: "ab\ncd\n"
exit: 0

=== grep-bre-alternation-group
argv: "grep" "^\\(ab\\|cd\\)$"
text: "ab\ncd\nabcd\n"
out: "ab\ncd\n"
exit: 0

=== grep-bre-parens-literal
argv: "grep" "f(x)"
text: "f(x)\nfx\n"
out: "f(x)\n"
exit: 0

=== grep-bre-pipe-literal
argv: "grep" "a|b"
text: "a|b\na\n"
out: "a|b\n"
exit: 0

=== grep-bre-braces-literal
argv: "grep" "a{1}"
text: "a{1}\na\n"
out: "a{1}\n"
exit: 0

=== grep-E-brace-not-interval
argv: "grep" "-E" "a{x"
text: "a{x\nax\n"
out: "a{x\n"
exit: 0

=== grep-bre-star-first-literal
argv: "grep" "*a"
text: "*a\nba\n"
out: "*a\n"
exit: 0

=== grep-bre-caret-literal-middle
argv: "grep" "a^b"
text: "a^b\nab\n"
out: "a^b\n"
exit: 0

=== grep-bre-dollar-literal-middle
argv: "grep" "a$b"
text: "a$b\nab\n"
out: "a$b\n"
exit: 0

=== grep-anchor-end
argv: "grep" "x$"
text: "ax\nxa\n"
out: "ax\n"
exit: 0

=== grep-anchor-start
argv: "grep" "^x"
text: "ax\nxa\n"
out: "xa\n"
exit: 0

=== grep-class-digit
argv: "grep" "[[:digit:]]\\+"
text: "abc\na1\n"
out: "a1\n"
exit: 0

=== grep-range
argv: "grep" "[a-c]x"
text: "bx\ndx\n"
out: "bx\n"
exit: 0

=== grep-negated-class
argv: "grep" "[^a]"
text: "aaa\naba\n"
out: "aba\n"
exit: 0

=== grep-bracket-close-first
argv: "grep" "[]]"
text: "a]\nb\n"
out: "a]\n"
exit: 0

=== grep-bracket-backslash-literal
argv: "grep" "[\\t]"
text: "a\\b\nt\nx\n"
out: "a\\b\nt\n"
exit: 0

=== grep-bracket-dash-last
argv: "grep" "[a-]"
text: "-\nb\na\n"
out: "-\na\n"
exit: 0

=== grep-class-space
argv: "grep" "[[:space:]]"
text: "a b\nab\nc\td\n"
out: "a b\nc\td\n"
exit: 0

=== grep-class-upper-unicode
argv: "grep" "[[:upper:]]"
text: "a\nB\nÉ\né\n"
out: "B\nÉ\n"
exit: 0

=== grep-class-alpha-unicode
argv: "grep" "-x" "[[:alpha:]]*"
text: "café\nab1\n"
out: "café\n"
exit: 0

=== grep-escaped-dot
argv: "grep" "a\\.b"
text: "a.b\naxb\n"
out: "a.b\n"
exit: 0

=== grep-F-backslash
argv: "grep" "-F" "\\d"
text: "a\\d\nd\n"
out: "a\\d\n"
exit: 0

=== grep-word-boundary
argv: "grep" "\\<foo\\>"
text: "foo bar\nfoobar\nbar-foo\n"
out: "foo bar\nbar-foo\n"
exit: 0

=== grep-backslash-w
argv: "grep" "-o" "\\w\\+"
text: "hi there\n"
out: "hi\nthere\n"
exit: 0

=== grep-unicode
argv: "grep" "é"
text: "café\ncafe\n"
out: "café\n"
exit: 0

=== grep-i-unicode
argv: "grep" "-i" "É"
text: "café\ncafe\n"
out: "café\n"
exit: 0

=== grep-x-F
argv: "grep" "-x" "-F" "a.b"
text: "a.b\na.bc\naxb\n"
out: "a.b\n"
exit: 0

=== grep-w-F-punct
argv: "grep" "-wF" "@foo"
text: "a @foo b\n@foobar\n"
out: "a @foo b\n"
exit: 0

=== grep-iw
argv: "grep" "-iw" "FOO"
text: "a Foo b\nFood\n"
out: "a Foo b\n"
exit: 0

=== grep-w-retries-shorter
argv: "grep" "-w" "ab*"
text: "abbbc ab\n"
out: "abbbc ab\n"
exit: 0

=== grep-w-no-word
argv: "grep" "-w" "ab*"
text: "abbbc\n"
out: ""
exit: 1

=== grep-cv
argv: "grep" "-cv" "foo"
text: "foo\nbar\nbaz\n"
out: "2\n"
exit: 0

=== grep-E-optional-all
argv: "grep" "-cE" "x?"
text: "a\nb\n"
out: "2\n"
exit: 0

# ---------------------------------------------------------------- grep: -o and longest match
=== grep-o
argv: "grep" "-o" "o*"
text: "foo\nbar\n"
out: "oo\n"
exit: 0

=== grep-o-numbers
argv: "grep" "-oE" "[0-9]+"
text: "a12b345\n"
out: "12\n345\n"
exit: 0

=== grep-on
argv: "grep" "-on" "o"
text: "foo\nbo\n"
out: "1:o\n1:o\n2:o\n"
exit: 0

=== grep-ow
argv: "grep" "-ow" "foo"
text: "foo foobar foo\n"
out: "foo\nfoo\n"
exit: 0

=== grep-o-unicode-dot
argv: "grep" "-o" "."
text: "é\n"
out: "é\n"
exit: 0

=== grep-o-unicode-pairs
argv: "grep" "-o" ".."
text: "日本語\n"
out: "日本\n"
exit: 0

=== grep-o-longest-bre
argv: "grep" "-o" "ab\\|abcd"
text: "xabcdy\n"
out: "abcd\n"
exit: 0

=== grep-o-longest-ere
argv: "grep" "-oE" "a|ab"
text: "ab\n"
out: "ab\n"
exit: 0

=== grep-o-star
argv: "grep" "-o" "a*"
text: "baaac\n"
out: "aaa\n"
exit: 0

=== grep-o-open-interval
argv: "grep" "-oE" "a{,2}b"
text: "aaab\n"
out: "aab\n"
exit: 0

=== grep-o-v-prints-nothing
argv: "grep" "-ov" "x"
text: "a\nx\n"
out: ""
exit: 0

=== grep-oH
argv: "grep" "-oH" "b."
text: "abcbd\n"
out: "notes.md:bc\nnotes.md:bd\n"
exit: 0

# ---------------------------------------------------------------- grep: context
=== grep-A1
argv: "grep" "-A1" "l3"
text: "l1\nl2\nl3\nl4\nl5\nl6\nl7\nl8\nl9\nl10\n"
out: "l3\nl4\n"
exit: 0

=== grep-B1
argv: "grep" "-B" "1" "l3"
text: "l1\nl2\nl3\nl4\nl5\nl6\nl7\nl8\nl9\nl10\n"
out: "l2\nl3\n"
exit: 0

=== grep-C1
argv: "grep" "-C1" "l5"
text: "l1\nl2\nl3\nl4\nl5\nl6\nl7\nl8\nl9\nl10\n"
out: "l4\nl5\nl6\n"
exit: 0

=== grep-n-C1
argv: "grep" "-n" "-C1" "l5"
text: "l1\nl2\nl3\nl4\nl5\nl6\nl7\nl8\nl9\nl10\n"
out: "4-l4\n5:l5\n6-l6\n"
exit: 0

=== grep-A1-separator
argv: "grep" "-A1" "-e" "l2" "-e" "l6"
text: "l1\nl2\nl3\nl4\nl5\nl6\nl7\nl8\nl9\nl10\n"
out: "l2\nl3\n--\nl6\nl7\n"
exit: 0

=== grep-A1-adjacent
argv: "grep" "-A1" "-e" "l2" "-e" "l4"
text: "l1\nl2\nl3\nl4\nl5\nl6\nl7\nl8\nl9\nl10\n"
out: "l2\nl3\nl4\nl5\n"
exit: 0

=== grep-B2-at-start
argv: "grep" "-B2" "l2"
text: "l1\nl2\nl3\nl4\nl5\nl6\nl7\nl8\nl9\nl10\n"
out: "l1\nl2\n"
exit: 0

=== grep-C1-ends
argv: "grep" "-C1" "-x" "-e" "l1" "-e" "l10"
text: "l1\nl2\nl3\nl4\nl5\nl6\nl7\nl8\nl9\nl10\n"
out: "l1\nl2\n--\nl9\nl10\n"
exit: 0

=== grep-numeric-context
argv: "grep" "-2" "l5"
text: "l1\nl2\nl3\nl4\nl5\nl6\nl7\nl8\nl9\nl10\n"
out: "l3\nl4\nl5\nl6\nl7\n"
exit: 0

=== grep-Hn-A1
argv: "grep" "-Hn" "-A1" "l3"
text: "l1\nl2\nl3\nl4\nl5\nl6\nl7\nl8\nl9\nl10\n"
out: "notes.md:3:l3\nnotes.md-4-l4\n"
exit: 0

=== grep-c-ignores-context
argv: "grep" "-c" "-A1" "l3"
text: "l1\nl2\nl3\nl4\nl5\nl6\nl7\nl8\nl9\nl10\n"
out: "1\n"
exit: 0

=== grep-A1-at-end
argv: "grep" "-A1" "l10"
text: "l1\nl2\nl3\nl4\nl5\nl6\nl7\nl8\nl9\nl10\n"
out: "l10\n"
exit: 0

=== grep-C1-overlap
argv: "grep" "-C1" "-e" "l3" "-e" "l5"
text: "l1\nl2\nl3\nl4\nl5\nl6\nl7\nl8\nl9\nl10\n"
out: "l2\nl3\nl4\nl5\nl6\n"
exit: 0

=== grep-v-context
argv: "grep" "-C1" "-v" "[2-9]"
text: "l1\nl2\nl3\nl4\nl5\nl6\nl7\nl8\nl9\nl10\n"
out: "l1\nl2\n--\nl9\nl10\n"
exit: 0

=== grep-A-overrides-C
argv: "grep" "-A0" "-C2" "l5"
text: "l1\nl2\nl3\nl4\nl5\nl6\nl7\nl8\nl9\nl10\n"
out: "l3\nl4\nl5\n"
exit: 0

