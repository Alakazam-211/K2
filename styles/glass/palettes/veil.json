{
  "$schema": "../../style.schema.json#/$defs/palette",
  "id": "veil",
  "name": "Veil",
  "schemes": [
    "light"
  ],
  "color": {
    "bg": {
      "$value": "#fafafa",
      "$type": "color"
    },
    "bg-surface": {
      "$value": "#ffffff",
      "$type": "color"
    },
    "bg-elevated": {
      "$value": "#f7f7f8",
      "$type": "color"
    },
    "bg-inset": {
      "$value": "#f5f5f5",
      "$type": "color"
    },
    "bg-stripe": {
      "$value": "#ffffff",
      "$type": "color"
    },
    "bg-canvas": {
      "$value": "#fafafa",
      "$type": "color"
    },
    "bg-hover": {
      "$value": "rgba(60, 60, 67, 0.08)",
      "$type": "color"
    },
    "border": {
      "$value": "#eaeaea",
      "$type": "color"
    },
    "border-strong": {
      "$value": "rgba(60, 60, 67, 0.35)",
      "$type": "color"
    },
    "control-edge": {
      "$value": "#8a8a8f",
      "$type": "color"
    },
    "divider": {
      "$value": "#ababae",
      "$type": "color",
      "$description": "Short dividers between items in a row: tab-strip tabs, top-bar groups. Between border and control-edge, about 2:1 on the tab strip and the top bar capsule."
    },
    "text-primary": {
      "$value": "#000000",
      "$type": "color"
    },
    "text-secondary": {
      "$value": "#58585d",
      "$type": "color"
    },
    "text-muted": {
      "$value": "#6e6e73",
      "$type": "color"
    },
    "accent": {
      "$value": "var(--glass-accent)",
      "$type": "color"
    },
    "accent-hover": {
      "$value": "color-mix(in srgb, var(--color-accent) 72%, black)",
      "$type": "color",
      "$description": "Deeper accent: hover text, and text on an accent wash (the info Callout). Deep enough to clear 4.5:1 on that wash over any Veil surface."
    },
    "accent-soft": {
      "$value": "color-mix(in srgb, var(--color-accent) 60%, white)",
      "$type": "color"
    },
    "on-accent": {
      "$value": "#ffffff",
      "$type": "color"
    },
    "accent-fill": {
      "$value": "color-mix(in srgb, var(--color-accent) 78%, black)",
      "$type": "color",
      "$description": "The accent as a fill under on-accent text (filled buttons, the selected segment, count badges): deep enough that the label clears 4.5:1, including at a 90% hover. Icons, rings and switches keep accent."
    },
    "accent-fill-hover": {
      "$value": "color-mix(in srgb, var(--color-accent-fill) 78%, black)",
      "$type": "color",
      "$description": "Hover on a filled accent control (the accent Button): the fill deepened to 78%, at least 1.3:1 from the resting fill so the change shows, and the white label reads better on it, not worse. A custom accent derives its own (lib/style-accent)."
    },
    "chart-1": {
      "$value": "#2a78d6",
      "$type": "color",
      "$description": "Chart series 1 (Usage: Claude). The series hues are a fixed order validated together for colour-blind separation and at least 3:1 on this palette's cards; colour follows the thing, never its rank."
    },
    "chart-2": {
      "$value": "#c8531f",
      "$type": "color",
      "$description": "Chart series 2 (Usage: Codex)."
    },
    "chart-3": {
      "$value": "#13865d",
      "$type": "color",
      "$description": "Chart series 3 (Usage: Grok)."
    },
    "chart-other": {
      "$value": "#6250d6",
      "$type": "color",
      "$description": "Chart series for anything past the named ones."
    },
    "status-working": {
      "$value": "var(--color-accent-text)",
      "$type": "color",
      "$description": "Working marks (the working grid, the Thread strip's dot, starting / installing dots): the highlight colour's legible variant, so they follow the palette's accent and a chosen one. --color-accent-text clears 4.5:1 on bg, bg-surface and bg-elevated (lib/style-accent.ts for a chosen colour), which keeps the marks over 3:1 on selected and hovered rows."
    },
    "status-error": {
      "$value": "#ff3b30",
      "$type": "color"
    },
    "status-ok": {
      "$value": "#34c759",
      "$type": "color"
    },
    "status-warn": {
      "$value": "#ff9500",
      "$type": "color"
    },
    "status-ok-soft": {
      "$value": "#207c37",
      "$type": "color",
      "$description": "Ok text and dots (the (active) mark, ok callouts): at least 4.5:1 on every ground."
    },
    "status-warn-soft": {
      "$value": "#c26b00",
      "$type": "color"
    },
    "status-error-soft": {
      "$value": "#d70015",
      "$type": "color"
    },
    "status-error-bright": {
      "$value": "#a50011",
      "$type": "color"
    },
    "status-error-text": {
      "$value": "#d70015",
      "$type": "color"
    },
    "status-working-soft": {
      "$value": "#0a6fd6",
      "$type": "color"
    },
    "status-warn-text": {
      "$value": "#b25d00",
      "$type": "color"
    },
    "status-needs-you": {
      "$value": "#ff9500",
      "$type": "color"
    },
    "status-warn-amber": {
      "$value": "#c26b00",
      "$type": "color"
    },
    "status-warn-amber-soft": {
      "$value": "#a85a00",
      "$type": "color"
    },
    "status-warn-amber-bright": {
      "$value": "#8f4c00",
      "$type": "color"
    },
    "status-ok-hover": {
      "$value": "#248a3d",
      "$type": "color"
    },
    "danger": {
      "$value": "#ff3b30",
      "$type": "color"
    },
    "danger-active": {
      "$value": "#d70015",
      "$type": "color"
    },
    "danger-muted": {
      "$value": "#c0392b",
      "$type": "color"
    },
    "danger-hover": {
      "$value": "#ff3b30",
      "$type": "color"
    },
    "neutral": {
      "$value": "#6e6e73",
      "$type": "color"
    },
    "control-track-off": {
      "$value": "rgba(120, 120, 128, 0.20)",
      "$type": "color"
    },
    "wash-1": {
      "$value": "rgba(60, 60, 67, 0.05)",
      "$type": "color"
    },
    "wash-2": {
      "$value": "rgba(60, 60, 67, 0.09)",
      "$type": "color"
    },
    "wash-3": {
      "$value": "rgba(60, 60, 67, 0.16)",
      "$type": "color"
    },
    "row-hover": {
      "$value": "rgba(60, 60, 67, 0.12)",
      "$type": "color",
      "$description": "Hover band on a list row (Settings lists): about 1.3:1 against the resting row on dark palettes, 1.2:1 or more on light ones. On it the row's muted text steps up to text-secondary (SETTING_LIST_ROW_HOVER), which reads at 4.5:1."
    },
    "scrim": {
      "$value": "rgba(30, 30, 35, 0.32)",
      "$type": "color"
    },
    "media-label-bg": {
      "$value": "rgba(0, 0, 0, 0.62)",
      "$type": "color",
      "$description": "Behind a name or time drawn on video (any picture, either scheme)."
    },
    "media-label-text": {
      "$value": "#ffffff",
      "$type": "color"
    },
    "diff-add-text": {
      "$value": "#1a7f37",
      "$type": "color"
    },
    "diff-remove-text": {
      "$value": "#c0392b",
      "$type": "color"
    },
    "diff-modified-border": {
      "$value": "#34c759",
