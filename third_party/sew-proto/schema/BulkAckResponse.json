{
  "$defs": {
    "ReadState": {
      "description": "A member's read state in one channel (C8; prd-sew-14 §5).",
      "properties": {
        "channel_id": {
          "description": "The channel.",
          "pattern": "^[1-9][0-9]{0,18}$",
          "type": "string"
        },
        "last_message_id": {
          "description": "The channel's newest timeline message (omitted in READY, where the channel entry has\nit).",
          "pattern": "^[1-9][0-9]{0,18}$",
          "type": [
            "string",
            "null"
          ]
        },
        "last_read_id": {
          "description": "The read cursor: a comparator, possibly a synthetic id (mark unread writes\n`message_id − 1`). Absent = nothing read.",
          "pattern": "^[1-9][0-9]{0,18}$",
          "type": [
            "string",
            "null"
          ]
        },
        "mention_count": {
          "description": "Unread mentions (a muted channel counts direct mentions only).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "muted": {
          "description": "The member muted the channel (S21); present only when true.",
          "type": "boolean"
        },
        "seq": {
          "default": 0,
          "description": "The member change-log head this state is current as of (S14 gap G9).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "unread": {
          "description": "Whether a message by someone else is past the cursor.",
          "type": "boolean"
        }
      },
      "required": [
        "channel_id",
        "mention_count",
        "unread"
      ],
      "type": "object"
    },
    "ThreadReadState": {
      "description": "A member's read state in one thread (prd-sew-14 §5).",
      "properties": {
        "channel_id": {
          "description": "The root's channel (always set by S14).",
          "pattern": "^[1-9][0-9]{0,18}$",
          "type": [
            "string",
            "null"
          ]
        },
        "following": {
          "default": false,
          "description": "Whether the member follows the thread.",
          "type": "boolean"
        },
        "last_read_id": {
          "description": "The thread cursor; the root id when no reply was read (always set by S14).",
          "pattern": "^[1-9][0-9]{0,18}$",
          "type": [
            "string",
            "null"
          ]
        },
        "last_reply_id": {
          "description": "The newest live reply.",
          "pattern": "^[1-9][0-9]{0,18}$",
          "type": [
            "string",
            "null"
          ]
        },
        "mention_count": {
          "default": 0,
          "description": "Unread mentions in the thread.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "root_id": {
          "description": "The thread root.",
          "pattern": "^[1-9][0-9]{0,18}$",
          "type": "string"
        },
        "seq": {
          "default": 0,
          "description": "The member change-log head this state is current as of.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "unread": {
          "default": false,
          "description": "Whether a reply is past the cursor.",
          "type": "boolean"
        },
        "unread_replies": {
          "default": 0,
          "description": "Live replies past the cursor (exact, no cap).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "root_id"
      ],
      "type": "object"
    },
    "ThreadsInbox": {
      "description": "The threads inbox summary (READY, `GET /api/v1/me/threads/summary`, S14 events).",
      "properties": {
        "mention_count": {
          "default": 0,
          "description": "Unread thread mentions over every thread in the sync set, followed or not (S14).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "seq": {
          "description": "The member change-log head these totals are current as of (S14).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "unread_count": {
          "description": "Followed threads with unread replies.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "unread_count"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response of `POST /api/v1/me/read_states/ack`, and the `read_states_bulk_updated` event.",
  "properties": {
    "read_states": {
      "description": "Every processed visible channel.",
      "items": {
        "$ref": "#/$defs/ReadState"
      },
      "type": "array"
    },
    "threads": {
      "description": "Every processed thread.",
      "items": {
        "$ref": "#/$defs/ThreadReadState"
      },
      "type": "array"
    },
    "threads_inbox": {
      "$ref": "#/$defs/ThreadsInbox",
      "description": "The threads inbox after the ack."
    },
    "threads_truncated": {
      "description": "More implied threads than `bulk_max_threads`: repeat the call.",
      "type": "boolean"
    }
  },
  "required": [
    "read_states",
    "threads",
    "threads_inbox",
    "threads_truncated"
  ],
  "title": "BulkAckResponse",
  "type": "object"
}
