            -*)
                _mail_err "usage" "unknown flag '$1' — usage: k2 mail create <localpart>[@<domain>] [--domain <d>] [--id <client-id>] [--json]"
                exit 2 ;;
            *)
                if [ -z "$local_part" ]; then local_part="$1"; else
                    _mail_err "usage" "unexpected extra argument '$1' — one <localpart>[@<domain>] only"
                    exit 2
                fi
                shift ;;
