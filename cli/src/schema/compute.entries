      "flags": []
    },
    {
      "name": "compute node servers deny",
      "usage": "k2 compute node servers <node> deny <request>",
      "description": "Deny a held servers request (the same as node admin deny). Owner only.",
      "args": [{"name": "node", "required": true}, {"name": "request", "required": true}],
      "flags": []
    },
    {
      "name": "compute node servers limits",
      "usage": "k2 compute node servers <node> limits <server> [--weight N] key=value…",
      "description": "Change a server's share on the node. Narrowing applies at once; widening (a higher weight too) waits for approval. Keys: max_running, max_queued, cpu_hours_day, max_job_secs, max_cpus, max_mem_gb, disk_gb, weight, network, top_class, gate, exclusive, for=7d|none, priority=true|false. <server> may be slot:0 (this server).",
      "args": [{"name": "node", "required": true}, {"name": "server", "required": true}, {"name": "key=value", "required": false}],
      "flags": [
        {"name": "--weight", "arg": "N", "description": "Its share weight."}
      ]
    },
    {
      "name": "compute node servers pause",
      "usage": "k2 compute node servers <node> pause <server>",
      "description": "Pause a server on the node.",
      "args": [{"name": "node", "required": true}, {"name": "server", "required": true}],
      "flags": []
    },
    {
      "name": "compute node servers resume",
      "usage": "k2 compute node servers <node> resume <server>",
      "description": "Resume a paused server on the node.",
      "args": [{"name": "node", "required": true}, {"name": "server", "required": true}],
      "flags": []
    },
    {
      "name": "compute node servers revoke",
      "usage": "k2 compute node servers <node> revoke <server> [--now] [--wipe]",
      "description": "Take a server off the node. Owner only.",
      "args": [{"name": "node", "required": true}, {"name": "server", "required": true}],
      "flags": [
        {"name": "--now", "arg": null, "description": "At once."},
        {"name": "--wipe", "arg": null, "description": "Wipe its files too."}
      ]
    },
    {
      "name": "compute node servers owner",
      "usage": "k2 compute node servers <node> owner <server> [--old keep|revoke] [--caches move|wipe] [--now] [--reason TEXT]",
      "description": "Make another of your own servers on the node its owner. Owner only; held for your approval. The node drains, the two swap slots and root re-pins to the new owner. Needs remote admin full.",
      "args": [{"name": "node", "required": true}, {"name": "server", "required": true}],
      "flags": [
        {"name": "--old", "arg": "keep|revoke", "description": "What happens to this server: it stays as one of your servers, or it leaves."},
        {"name": "--caches", "arg": "move|wipe", "description": "Caches move with their server, or are wiped."},
        {"name": "--now", "arg": null, "description": "Stop running jobs instead of draining."},
        {"name": "--reason", "arg": "TEXT", "description": "Why."}
      ]
    },
    {
      "name": "compute node take-owner",
      "usage": "k2 compute node take-owner <node>",
      "description": "Take over a node another of your servers made this server's owner. Owner, in person: it shows the node's full key, the old owner and the secret grants that start reaching it; you type the node's name, then Touch ID or vault password.",
      "args": [{"name": "node", "required": true}],
      "flags": []
    },
    {
      "name": "compute node health",
      "usage": "k2 compute node health <node> [--json]",
      "description": "Uptime, disk, RAM, FileVault, update state. Node admin: agents need Allow this agent to operate compute nodes.",
      "args": [{"name": "node", "required": true}],
      "flags": [
        {"name": "--json", "arg": null, "description": "JSON output."}
      ]
    },
