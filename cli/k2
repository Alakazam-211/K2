if preset: o["preset"] = preset
if delivery: o["delivery"] = delivery
if ceiling: o["ceiling"] = ceiling
if describe: o["description"] = describe
if rot: o["rotateEveryDays"] = int(rot)
if ttl: o["ttlSecs"] = int(ttl)
if ih or iformat:
