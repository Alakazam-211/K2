                    wake)   shift; cmd_heartbeat_wake "$@" ;;
                    *)
                        echo "Unknown 'heartbeat signal' subcommand: ${1:-}" >&2
                        echo "Verbs: fire <n>, wakeup <n> [--path-only|--edit], wake. See 'k2 help heartbeat'." >&2
                        exit 2
