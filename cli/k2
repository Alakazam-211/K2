else:
    until = datetime.datetime.fromtimestamp(s["until"], datetime.timezone.utc).strftime("%H:%M UTC")
    print("%s: TEST %s until %s. Triggers never fire for it; nothing is written to history." % (v.get("name"), s["state"], until))
'
}

