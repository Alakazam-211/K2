{
  "name": "k2-mpc-client",
  "version": "0.9.7",
  "description": "Live text editing over the kit's hunk channel: a text replica, the kit's rebase rules, and a CodeMirror 6 binding.",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core.ts"
  },
  "files": [
    "src",
    "WIRE.md"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.26.0"
  },
  "peerDependenciesMeta": {
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codemirror/state": "6.4.1",
    "@codemirror/view": "6.26.3",
    "@types/node": "22.5.4",
    "jsdom": "24.1.1",
    "typescript": "5.5.4",
    "vitest": "2.0.5"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "licences": "node scripts/check-licences.mjs"
  }
}
