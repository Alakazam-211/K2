{
  "$schema": "../../style.schema.json#/$defs/palette",
  "id": "veil",
  "name": "Veil",
  "schemes": ["light"],
  "color": {
    "bg": { "$value": "#f2f4f8", "$type": "color", "$description": "Opaque. Terminals and WebGL always sit on this — never glass." },
    "bg-surface": { "$value": "rgba(255, 255, 255, 0.55)", "$type": "color", "$description": "Frosted panel tint (backdrop-filter supplies the blur)." },
    "bg-elevated": { "$value": "rgba(255, 255, 255, 0.68)", "$type": "color" },
    "bg-inset": { "$value": "#eef1f6", "$type": "color", "$description": "Content wells stay solid for readability." },
    "bg-stripe": { "$value": "rgba(248, 250, 253, 0.50)", "$type": "color" },
    "bg-canvas": { "$value": "#e6eaf2", "$type": "color", "$description": "Base under the pale aurora (overrides.css paints it)." },
    "bg-hover": { "$value": "rgba(20, 40, 90, 0.06)", "$type": "color" },
    "border": { "$value": "rgba(20, 30, 60, 0.10)", "$type": "color" },
    "border-strong": { "$value": "rgba(20, 30, 60, 0.30)", "$type": "color" },
    "control-edge": { "$value": "#7c8294", "$type": "color" },
    "control-hover": { "$value": "var(--color-border)", "$type": "color", "$description": "Hover fill of the default Button (an elevated chip at rest). Glass keeps the border step; its tile buttons hover by the Glass rules in globals." },
    "control-hover-quiet": { "$value": "var(--color-bg-elevated)", "$type": "color", "$description": "Hover fill of the quiet Button (clear at rest, so the card or page shows). Glass hovers its tile buttons by the Glass rules in globals; this is the fallback." },
    "divider": { "$value": "#aaaebb", "$type": "color", "$description": "Short dividers between items in a row: tab-strip tabs, top-bar groups. Between border and control-edge, about 2:1 on the tab strip and the top bar capsule." },
    "text-primary": { "$value": "#1a1d26", "$type": "color" },
    "text-secondary": { "$value": "#4c5568", "$type": "color" },
    "text-muted": { "$value": "#616776", "$type": "color" },
    "accent": { "$value": "#2f6fe0", "$type": "color", "$description": "Deepened cool blue — reads through daylight frost." },
    "accent-hover": { "$value": "#2258bd", "$type": "color" },
    "accent-soft": { "$value": "#6d9ae8", "$type": "color" },
    "on-accent": { "$value": "#ffffff", "$type": "color" },
    "on-danger": { "$value": "#ffffff", "$type": "color", "$description": "The label on a danger fill (danger, danger-active, danger-muted): 4.5:1 on each." },
    "on-warn": { "$value": "#1a1400", "$type": "color", "$description": "The ink on a warning or needs-you fill (the Tickets count): 4.5:1 on status-needs-you." },
    "status-working": { "$value": "#2f6fe0", "$type": "color" },
    "status-error": { "$value": "#c22f2f", "$type": "color" },
    "status-ok": { "$value": "#1e7c46", "$type": "color" },
    "status-warn": { "$value": "#a3720a", "$type": "color" },
    "status-ok-soft": { "$value": "#27994f", "$type": "color" },
    "status-warn-soft": { "$value": "#b07f0c", "$type": "color" },
    "status-error-soft": { "$value": "#a82a2a", "$type": "color" },
    "status-error-bright": { "$value": "#8c1f1f", "$type": "color", "$description": "'Bright' inverts to darkest on light — it's the emphasis step." },
    "status-error-text": { "$value": "#a82a2a", "$type": "color" },
    "status-working-soft": { "$value": "#cf7434", "$type": "color" },
    "status-warn-text": { "$value": "#8f6508", "$type": "color" },
    "status-needs-you": { "$value": "#c2620a", "$type": "color" },
    "status-warn-amber": { "$value": "#99610a", "$type": "color" },
    "status-warn-amber-soft": { "$value": "#7f5407", "$type": "color" },
    "status-warn-amber-bright": { "$value": "#6e4805", "$type": "color" },
    "status-ok-hover": { "$value": "#16613a", "$type": "color" },
    "danger": { "$value": "#c22f2f", "$type": "color" },
    "danger-active": { "$value": "#9c2424", "$type": "color" },
    "danger-muted": { "$value": "#ab3535", "$type": "color" },
    "danger-hover": { "$value": "#c22f2f", "$type": "color" },
    "neutral": { "$value": "#76829c", "$type": "color" },
    "control-track-off": { "$value": "rgba(20, 30, 60, 0.14)", "$type": "color" },
    "wash-1": { "$value": "rgba(20, 30, 60, 0.04)", "$type": "color" },
    "wash-2": { "$value": "rgba(20, 30, 60, 0.08)", "$type": "color" },
    "wash-3": { "$value": "rgba(20, 30, 60, 0.15)", "$type": "color" },
    "row-hover": { "$value": "rgba(20, 30, 60, 0.11)", "$type": "color", "$description": "Hover band on a list row (Settings lists): about 1.3:1 against the resting row on dark palettes, 1.2:1 or more on light ones. On it the row's muted text steps up to text-secondary (SETTING_LIST_ROW_HOVER), which reads at 4.5:1." },
    "scrim": { "$value": "rgba(18, 24, 40, 0.30)", "$type": "color", "$description": "Lighter than Terminal — the frost itself does half the separation." },
    "media-label-bg": { "$value": "rgba(0, 0, 0, 0.62)", "$type": "color", "$description": "Behind a name or time drawn on video (any picture, either scheme)." },
    "media-label-text": { "$value": "#ffffff", "$type": "color" },
    "diff-add-text": { "$value": "#47691a", "$type": "color" },
    "diff-remove-text": { "$value": "#9c2c2c", "$type": "color" },
    "diff-modified-border": { "$value": "#3fa06a", "$type": "color" },
    "code-inline": { "$value": "#8a5a14", "$type": "color" },
    "overlay-soft-bg": { "$value": "rgba(20, 30, 60, 0.05)", "$type": "color" },
    "overlay-soft-border": { "$value": "rgba(20, 30, 60, 0.08)", "$type": "color" },
    "scrollbar-thumb": { "$value": "rgba(20, 30, 60, 0.14)", "$type": "color" },
    "scrollbar-thumb-hover": { "$value": "rgba(20, 30, 60, 0.26)", "$type": "color" },
    "scrollbar-thumb-strong": { "$value": "rgba(20, 30, 60, 0.30)", "$type": "color" },
    "scrollbar-thumb-strong-hover": { "$value": "rgba(20, 30, 60, 0.44)", "$type": "color" },
    "ring-edge-strong": { "$value": "rgba(255, 255, 255, 0.9)", "$type": "color", "$description": "Specular top edge on frosted surfaces (ring.surface layer 1)." },
    "ring-edge": { "$value": "rgba(255, 255, 255, 0.85)", "$type": "color", "$description": "Softer specular on fields (ring.field layer 1)." },
    "ring-hairline": { "$value": "rgba(20, 30, 60, 0.08)", "$type": "color", "$description": "Surface hairline — dark on light so the edge still reads." },
    "ring-hairline-soft": { "$value": "rgba(20, 30, 60, 0.06)", "$type": "color", "$description": "Field hairline." },
    "syntax-keyword": { "$value": "#a1349b", "$type": "color", "$description": "Code: keywords (import, const, return). Every syntax colour reads at 4.5:1 on bg, bg-surface and bg-inset (the editor, the pane tile and the code well)." },
    "syntax-string": { "$value": "#b0401b", "$type": "color", "$description": "Code: strings." },
    "syntax-number": { "$value": "#6c5a00", "$type": "color", "$description": "Code: numbers and literals." },
    "syntax-comment": { "$value": "#5d6c79", "$type": "color", "$description": "Code: comments. Quieter than code but still 4.5:1." },
    "syntax-function": { "$value": "#0f64a0", "$type": "color", "$description": "Code: function and method names." },
    "syntax-type": { "$value": "#0b7366", "$type": "color", "$description": "Code: types and classes." },
    "syntax-property": { "$value": "#3e3fa8", "$type": "color", "$description": "Code: properties and definitions." },
    "syntax-punctuation": { "$value": "#3a3a40", "$type": "color", "$description": "Code: punctuation and operators." },
    "presence-1": { "$value": "#5b45c9", "$type": "color", "$description": "Live editing: the first other person or agent (carets, name flags, holds). Presence colours reach 3:1 on bg and bg-surface." },
    "presence-2": { "$value": "#1d6aa1", "$type": "color", "$description": "Live editing: the second." },
    "presence-3": { "$value": "#ad2d67", "$type": "color", "$description": "Live editing: the third." },
    "presence-4": { "$value": "#9a520f", "$type": "color", "$description": "Live editing: the fourth." },
    "find-match": { "$value": "rgba(255, 195, 0, 0.30)", "$type": "color", "$description": "Find: every match, a wash over the editor. text-primary keeps 4.5:1 on it." },
    "find-match-current": { "$value": "rgba(255, 170, 0, 0.42)", "$type": "color", "$description": "Find: the current match, stronger than the others." },
    "selection": { "$value": "rgba(8, 106, 204, 0.20)", "$type": "color", "$description": "Selected text in editors. text-primary keeps 4.5:1 on it." }
  },
  "terminal": {
    "fg": { "$value": "#1a1d26", "$type": "color" },
    "bg": { "$value": "#f2f4f8", "$type": "color" },
    "cursor": { "$value": "#1a1d26", "$type": "color" },
    "selection": { "$value": "#c8d2e6", "$type": "color" },
    "ansi": [
      "#1a1d26", "#c22f2f", "#1e7c46", "#a3720a",
      "#2f6fe0", "#7a4b9e", "#0e7a80", "#8a93a8",
      "#4c5568", "#dc4b4b", "#27994f", "#c28d12",
      "#4f86e6", "#9463b8", "#159299", "#080a10"
    ]
  }
}
