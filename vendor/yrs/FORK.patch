+                    apply(&d, &u); // (2, 0) now at 7, marker says 5
+                }
+                PlantedPositionBug::KeepRunsOnInterior => unreachable!(),
+            }
+            let want = {
+                let mut s = text(&d, &t);
+                s.insert(6, 'Y');
+                s
+            };
+            t.insert(&mut d.transact_mut(), 6, "Y");
+            assert_eq!(text(&d, &t), want, "{bug:?}: the walk's result was used");
+            let seen = seen.lock().unwrap();
