                [ $# -ge 2 ] || { _mail_err "usage" "--domain requires a value"; exit 2; }
                domain="$2"; shift 2 ;;
            --id)
                [ $# -ge 2 ] || { _mail_err "usage" "--id requires a value (the idempotency key)"; exit 2; }
                client_id="$2"; shift 2 ;;
