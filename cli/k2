if os.environ.get("KEY"): b["key"] = os.environ["KEY"]
if os.environ.get("DRY") == "true": b["dryRun"] = True
print(json.dumps(b))') || exit 2
            printf '%s' "$body" | cli_post_json_stdin "/cli/agent-instances/hire" | _hire_print hire "$as_json" ;;
        ""|--json|--key)
