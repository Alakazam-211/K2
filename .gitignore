node_modules/
out/
dist/
# @k2/server's built JS + .d.ts: committed (the daemon embeds it; k2 app sdk add).
!/sdk/server/dist/
# Cargo workspace output — the workspace root moved in 0.33.x, so target/
# lives at the repo root now. Keep src-tauri/target/ ignored too for any
# stale per-package builds from older checkouts.
target/
# Isolated compile dirs used by worktree/land smoke tests (never ship).
/target-*/
src-tauri/target/
# Local worktrees / MCP config — not product.
/.bmr-wt/
/.mcp.json
# Bundled frpc tunnel sidecar (Apache-2.0, fatedier/frp). Staged into the
# build by scripts/fetch-frpc.sh; a ~14MB binary must not bloat the repo.
src-tauri/binaries/
# DeepFilterNet3 noise-removal weights (39 MB), staged by scripts/fetch-dfn3.sh
# from the pinned Sew release asset; bundled as app resources, never committed.
src-tauri/dfn3/*
!src-tauri/dfn3/README.md
src-tauri/.dfn3.*
*.dmg
*.zip
*.app
.DS_Store
*.db
*.db-journal
*.db-wal
.claude/
# Internal workspace dirs — agent data, internal PRDs/notes (licensing strategy,
# monetization roadmap, tunnel decisions). NEVER published to the public K2 repo.
# Kept on disk for the daemon; untracked in git. (Re-home publish-safety.)
/.k2so/
/.k2/*
# Except K2's own CI and signer config (k2 ci release reads .k2/ci.toml at
# the commit; .k2/signer.toml is the signer policy a person approves).
!/.k2/ci.toml
!/.k2/signer.toml
SKILL.md
CLAUDE.md
GEMINI.md
/AGENT.md
AGENTS.md
.goosehints
.cursor/rules/k2so.mdc
.github/copilot-instructions.md
.opencode/agent/k2so*.md
.pi/skills/k2so/
.env
.env.*
*.key
*.key.pub
.worktrees/
.k2/migration/
.k2/logs/
.k2/.last-skill-regen
.k2/.thread-md-nudge

# 0.37.12 — runtime workspace state K2SO writes at runtime; not source.
# Heartbeats / sessions / agent-templates / scratch state regenerate
# from DB + filesystem on launch.
.k2/heartbeats/
.k2/sessions/
.k2/agent/
.k2/agent-templates/
.k2/.archive/
.k2/.harvest-*-done
.k2/.unification-*-done
.k2/agents/.archive/

# 0.39.0 — work→inbox + skills consolidation migrations. The inbox/
# directory holds runtime work items the daemon manages (replacing the
# old .k2so/work/ tree); the *-v1-done sentinels mark migrations the
# daemon has applied to this workspace.
.k2/inbox/
.k2/.work-to-inbox-migration-v1-done
.k2/.skills-consolidation-v1-done

# Stub workspace dirs auto-created by some bridge experiments;
# contain AGENT.md / CLAUDE.md / etc which are themselves gitignored.
_broadcast/
_orphan/
src-tauri/_broadcast/
src-tauri/_orphan/

# Daemon scratch dirs (empty in practice, leftover from older flows).
crates/k2-daemon/canonical-ws/
crates/k2-daemon/k2so-ws/

# Personal editor config (Aider CLI). Not project-wide.
.aider.conf.yml

# Tauri-generated capability schemas — regenerated on every build from the
# hand-authored source in src-tauri/capabilities/. Not source of truth.
src-tauri/gen/schemas/

# Stray build log (was committed by accident).
build-daemon-warnings.log
dist-windows/

# Playwright run state
tests/board-file/**/test-results/
