{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response of `GET /api/v1/resolve`. A hidden address gives the same `404` as a missing one.",
  "properties": {
    "channel_id": {
      "description": "The channel.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "space_id": {
      "description": "The space; absent for DMs.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": [
        "string",
        "null"
      ]
    },
    "thread_id": {
      "description": "The thread root, when the address names a thread.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "channel_id"
  ],
  "title": "ResolveResponse",
  "type": "object"
}
