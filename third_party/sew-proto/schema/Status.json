          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "index_bytes": {
          "description": "Bytes of the live index on disk.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "lag_ms": {
          "description": "How far indexing trails writes: `now − min(created_at)` over pending or running\n`search_index` / `search_delete` jobs; 0 when none.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "last_commit_at": {
          "description": "When the indexer last committed.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
