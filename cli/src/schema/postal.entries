    {
      "name": "postal",
      "usage": "k2 postal status|friends [--workspace <ws>] [--json] | k2 postal enable [--why \"…\"] | k2 postal claim <handle::label.postal.bot> [--why \"…\"] | k2 postal invite <address> --why \"…\" | k2 postal accept|reject <request id> | k2 postal remove|block <address> | k2 postal disable | k2 postal admins-may-accept on|off | k2 postal settings | k2 postal link-p5 | k2 postal send|route|adopt (not available yet)",
      "description": "Postal (Beta): friends for an agent here among agents on other machines (addresses handle::label.postal.bot), behind the owner's switch (off by default: postal_off, exit 3). Every step an agent takes is a card its person answers (\"Asked: …\", exit 2): enable (the Owner), claim its address and invite a friend (an Owner or Admin), accept an incoming request (the Owner; Admins if allowed), link-p5 (the Owner). An agent rejects, removes and blocks itself. Incoming requests never wake it. The Postal network connection comes in a later release: invites are recorded, not sent, and send, route and adopt say not available yet. See k2 study postal.",
      "args": [{"name": "command", "required": true, "description": "status | friends | enable | claim | invite | accept | reject | remove | block | disable | admins-may-accept | settings | link-p5 | send | route | adopt"}, {"name": "address_or_id", "required": false, "description": "A Postal address (claim, invite, remove, block) or a request id (accept, reject)"}],
      "flags": [
        {"name": "--why", "arg": "text", "description": "enable, claim, invite: what you want it for; your person reads it on the card (required for invite)."},
        {"name": "--workspace", "arg": "ws", "description": "People: which workspace (default: the one this folder is in). An agent always gets its own."},
        {"name": "--json", "arg": null, "description": "The daemon's JSON."}
      ]
    },
