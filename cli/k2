# k2 changes init: make the workspace root a git repository (git init; no
# commit). Refused inside an existing repo (already_a_repo) or below/above
# a workspace root (bad_path).
_changes_init() {
    local ws=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --json) _CH_JSON=1; shift ;;
