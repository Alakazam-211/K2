    b["hire"]=h
    b["confirmToken"]=os.environ.get("K2_AK_HCONF","")
print(json.dumps(b))' \
                | cli_post_json_stdin "/cli/api-keys/create" \
                | K2_AK_WORKSPACES="$workspaces" python3 -c 'import json,os,sys
try:
    d=json.load(sys.stdin)
