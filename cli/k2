# List every session this project's filesystem knows about, by
# walking $PROJECT/.k2so/sessions/ and summarizing each directory.
# No daemon round-trip — archive dirs are the source of truth.
#
# Output columns: session id, total archive bytes, segment count,
# active-segment size, last-modified wall-clock timestamp.
# Pass --json to get a machine-parseable array.
#
# Usage:
#   k2 sessions list [--json]
cmd_sessions_list() {
    local json_mode=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json) json_mode="1"; shift ;;
            --) shift; break ;;
            *) shift ;;
        esac
    done
    local sessions_dir="$(_ws_dot_dir "$PROJECT")/sessions"
    if [ ! -d "$sessions_dir" ]; then
        if [ -n "$json_mode" ]; then
            echo "[]"
        else
            echo "No sessions yet for $PROJECT" >&2
        fi
        return 0
    fi
    python3 - "$sessions_dir" "$json_mode" <<'PY'
import json, os, sys, time
sessions_dir = sys.argv[1]
as_json = sys.argv[2] == "1"

rows = []
for name in sorted(os.listdir(sessions_dir)):
    session_dir = os.path.join(sessions_dir, name)
    if not os.path.isdir(session_dir):
        continue
    total = 0
    segments = 0
    active_bytes = 0
    latest_mtime = 0
    for f in os.listdir(session_dir):
        path = os.path.join(session_dir, f)
        try:
            st = os.stat(path)
        except OSError:
            continue
        if not (f == "archive.ndjson" or f.startswith("archive.") and (f.endswith(".ndjson") or f.endswith(".ndjson.gz"))):
            continue
        total += st.st_size
        segments += 1
        latest_mtime = max(latest_mtime, int(st.st_mtime))
        if f == "archive.ndjson":
            active_bytes = st.st_size
    rows.append({
        "session_id": name,
        "total_bytes": total,
        "segments": segments,
        "active_bytes": active_bytes,
        "last_modified_epoch": latest_mtime,
    })

def human_bytes(n):
    if n < 1024:
        return f"{n} B"
    if n < 1024 * 1024:
        return f"{n / 1024:.2f} KB"
    if n < 1024 * 1024 * 1024:
        return f"{n / (1024 * 1024):.2f} MB"
    return f"{n / (1024 * 1024 * 1024):.2f} GB"

if as_json:
    print(json.dumps(rows, indent=2))
else:
    if not rows:
        print("No sessions yet", file=sys.stderr)
        sys.exit(0)
    print(f"{'SESSION':38}  {'SEGMENTS':>8}  {'TOTAL':>12}  {'ACTIVE':>12}  LAST MODIFIED")
    for r in rows:
        ts = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(r["last_modified_epoch"])) if r["last_modified_epoch"] else "-"
        print(f"{r['session_id']:38}  {r['segments']:>8}  {human_bytes(r['total_bytes']):>12}  {human_bytes(r['active_bytes']):>12}  {ts}")
PY
}

# Compact a session's rotated segments by gzipping them in place.
# NEVER touches the active segment (archive.ndjson). Idempotent —
# re-running is a no-op once every rotated segment is already
# gzipped.
#
# Usage:
#   k2 sessions compact <session-id>
cmd_sessions_compact() {
    local session_id="${1:-}"
    [[ -z "$session_id" ]] && {
        echo "Usage: k2 sessions compact <session-id>" >&2
        echo "(use 'k2 sessions list' to find session ids)" >&2
        exit 1
    }
    local session_dir="$(_ws_dot_dir "$PROJECT")/sessions/${session_id}"
    if [ ! -d "$session_dir" ]; then
        echo "No archive directory for session $session_id at $session_dir" >&2
        exit 1
    fi
    if ! command -v gzip >/dev/null 2>&1; then
        echo "gzip not found in PATH — cannot compact" >&2
        exit 1
    fi

    local count=0
    local compacted_bytes_before=0
    local compacted_bytes_after=0
    # Loop through every rotated segment that isn't yet gzipped.
    # Filename pattern: archive.NNN.ndjson (NOT archive.ndjson,
    # NOT *.ndjson.gz).
    while IFS= read -r -d '' seg; do
        local before_size
        before_size=$(stat -f '%z' "$seg" 2>/dev/null || stat -c '%s' "$seg" 2>/dev/null || echo 0)
        compacted_bytes_before=$((compacted_bytes_before + before_size))

        # `gzip -f` overwrites if a *.gz already exists; we checked
        # above that the .gz form doesn't exist for this segment.
        if gzip -f "$seg"; then
            local after_size
            after_size=$(stat -f '%z' "$seg.gz" 2>/dev/null || stat -c '%s' "$seg.gz" 2>/dev/null || echo 0)
            compacted_bytes_after=$((compacted_bytes_after + after_size))
            count=$((count + 1))
        else
            echo "gzip failed for $seg" >&2
        fi
    done < <(find "$session_dir" -maxdepth 1 -type f \
        -name 'archive.[0-9][0-9][0-9].ndjson' -print0 | sort -z)

    if [ "$count" -eq 0 ]; then
        echo "Nothing to compact for session $session_id (no uncompressed rotated segments)." >&2
        return 0
    fi

    local saved=$((compacted_bytes_before - compacted_bytes_after))
    echo "{\"sessionId\":\"$session_id\",\"compacted\":$count,\"bytesBefore\":$compacted_bytes_before,\"bytesAfter\":$compacted_bytes_after,\"bytesSaved\":$saved}"
}

# Sessions subcommand dispatcher — handles `k2 sessions spawn`,
# 0.37.11 — List LIVE v2 sessions (daemon memory) for a workspace.
# Wraps /cli/sessions/list-for-workspace.  Distinct from
# `k2 sessions list` (which inspects on-disk archive segments) —
# this verb answers "what's the daemon currently holding open for
# this workspace?", which is what you need to verify focus-window
# adoption (sessions count shouldn't change when a focus window
# opens on top of an existing workspace).
#
# Usage:
#   k2 sessions live <path>             # human table
#   k2 sessions live <path> --json      # raw JSON from daemon
#   k2 sessions live <path> --count     # just the integer count
cmd_sessions_live() {
    local path="${1:-}"
    local mode="table"
    shift 2>/dev/null || true
    while [ $# -gt 0 ]; do
        case "$1" in
            --json)  mode="json"; shift ;;
            --count) mode="count"; shift ;;
            *) shift ;;
        esac
    done
    if [ -z "$path" ]; then
        echo "Usage: k2 sessions live <workspace-path> [--json|--count]" >&2
        echo "  Lists live daemon-side v2 sessions whose cwd is under <workspace-path>." >&2
        exit 1
    fi
    # Try the targeted endpoint first (post-0.37.11 daemons); fall back
    # to `/cli/agents/running` with client-side filtering for older
    # daemons that haven't picked up the new route yet.
    local response
    response=$(cli_request "/cli/sessions/list-for-workspace" "path=$(urlencode "$path")" 2>/dev/null)
    local fallback=0
    if echo "$response" | grep -q '"route not found"' 2>/dev/null; then
        fallback=1
        response=$(cli_request "/cli/agents/running")
    fi
    case "$mode" in
        json)
            if [ "$fallback" = "1" ]; then
                echo "$response" | python3 -c "
import json, sys
def _workspace_match(cwd: str, path: str) -> bool:
    if not cwd: return False
    p = path.rstrip('/')
    c = cwd.rstrip('/')
    return c == p or cwd.startswith(p + '/')
path = '$path'
all_sessions = json.loads(sys.stdin.read())
filtered = [
    {
        'sessionId': s.get('terminalId'),
        'agentName': s.get('agentName'),
        'command': s.get('command'),
        'args': [],
        'cwd': s.get('cwd', ''),
        'isV2': True,  # agents running only ever returns alive sessions; v2 status unknown but assumed
    }
    for s in all_sessions if _workspace_match(s.get('cwd') or '', path)
]
print(json.dumps(filtered, indent=2))
"
            else
                echo "$response"
            fi
            ;;
        count)
            if [ "$fallback" = "1" ]; then
                echo "$response" | python3 -c "
import json, sys
def _workspace_match(cwd: str, path: str) -> bool:
    if not cwd: return False
    p = path.rstrip('/')
    c = cwd.rstrip('/')
    return c == p or cwd.startswith(p + '/')
path = '$path'
sessions = json.loads(sys.stdin.read())
print(sum(1 for s in sessions if _workspace_match(s.get('cwd') or '', path)))
"
            else
                echo "$response" | python3 -c "import json,sys; print(len(json.loads(sys.stdin.read())))"
            fi
            ;;
        *)
            echo "$response" | python3 -c "
import json, sys
def _workspace_match(cwd: str, path: str) -> bool:
    if not cwd: return False
    p = path.rstrip('/')
    c = cwd.rstrip('/')
    return c == p or cwd.startswith(p + '/')
fallback = $fallback
path = '$path'
raw = json.loads(sys.stdin.read())
if fallback:
    sessions = [s for s in raw if _workspace_match(s.get('cwd') or '', path)]
    note = '  (using /cli/agents/running fallback — daemon pre-0.37.11)'
else:
    sessions = raw
    note = ''
if not sessions:
    print('No live sessions in this workspace.' + note)
    sys.exit(0)
print(f'{len(sessions)} live session(s):' + note)
print(f'  {\"TERMINAL_ID\":<38}  {\"KIND\":<10}  {\"HANDLE\":<22}  {\"AGENT\":<24}  {\"CMD\":<14}  CWD')
for s in sessions:
    sid = s.get('sessionId') or s.get('terminalId') or '?'
    kind = (s.get('kind') or '')[:10]
    handle = (s.get('handle') or '')[:22]
    name = s.get('agentName', '?')[:24]
    cmd = (s.get('command') or 'shell')[:14]
    cwd = s.get('cwd', '')
    print(f'  {sid:<38}  {kind:<10}  {handle:<22}  {name:<24}  {cmd:<14}  {cwd}')
"
            ;;
    esac
}

# `k2 sessions list`, `k2 sessions compact`, and any future
# `sessions *` verbs.
cmd_sessions() {
    local sub="${1:-}"
    shift 2>/dev/null || true
    case "$sub" in
        spawn)     cmd_sessions_spawn "$@" ;;
        list)      cmd_sessions_list "$@" ;;
        live)      cmd_sessions_live "$@" ;;
        compact)   cmd_sessions_compact "$@" ;;
        set-label) cmd_sessions_set_label "$@" ;;
        *)
            echo "Usage:" >&2
            echo "  k2 sessions list [--json]                     # on-disk archives" >&2
            echo "  k2 sessions live <workspace> [--json|--count] # live daemon sessions" >&2
            echo "  k2 sessions compact <session-id>" >&2
            echo "  k2 sessions set-label <session-id> <label> [--no-lock]" >&2
            exit 1
            ;;
    esac
}

# ── k2 sidecar v1 (prd-k2-sidecar-cli-v1) ────────────────────────────
# The daemon owns the job (SC2): POST /cli/sidecar/new|stop, GET
# /cli/sidecar/list, POST /cli/agent-access/set. `sidecar` is an `id`
# tool (SC35): inside a K2 terminal the request carries this session's
# passport (per-cell socket first, else TCP with the scoped token), never
# the owner token.

_sidecar_usage() {
    cat <<'EOF'
k2 sidecar — open extra AI sessions (sidecars) in a workspace

  k2 sidecar new <name> --harness <preset> [--brief <file>|-] [--brief-text "…"]
                 [--workspace <ws>] [--model <model>] [--json]
  k2 sidecar list [--workspace <ws>] [--json]
  k2 sidecar stop <name> [--workspace <ws>] [--force] [--json]
  k2 sidecar access on|off|status [--workspace <ws>]      owner/admin

A sidecar shares this workspace's role, skills and inbox. Its address is
<workspace>/<name>. Message it with k2 msg <address>; it replies the same way.
new on a stopped name resumes the same conversation.
Harnesses: claude, grok, codex, gemini, cursor-agent, pi, hermes (any preset that runs them).
Agents: only the main session, only with "Allow hiring and managing agents" on.
Do not put secrets in a brief.
More: k2 study sidecars
EOF
}

# _sidecar_send <GET|POST> <path> <json-body|query> — prints the body, then
# a last line with the HTTP status. Per-cell socket first (scoped Bearer),
# else TCP ($TOKEN, already the scoped token inside a cell for id tools).
_sidecar_send() {
    local method="$1" path="$2" payload="${3:-}"
    local sock out="" _K2_CFG=""
    # The payload (an API key for `k2 llm tokens add-key`) and the token
    # both ride the curl config on stdin — never curl's argv.
    sock="$(_hook_sock)"
    if [ -n "$sock" ] && [ -S "$sock" ] && ! _cli_skip_uds && [ -n "${SCOPED_TOKEN:-}" ]; then
        _K2_CFG=""
        _k2_cfg_add header "Authorization: Bearer ${SCOPED_TOKEN}"
        if [ "$method" = "GET" ]; then
            if [ -n "$payload" ]; then
                _k2_cfg_add data "$payload"
            fi
            out="$(_k2_curl "$_K2_CFG" -s -G --unix-socket "$sock" "http://localhost${path}" \
                --connect-timeout 5 --max-time 120 \
                -w $'\n%{http_code}' 2>/dev/null)" || out=""
        else
            _k2_cfg_add data-raw "$payload"
            out="$(_k2_curl "$_K2_CFG" -s -X POST --unix-socket "$sock" "http://localhost${path}" \
                --connect-timeout 5 --max-time 120 \
                -H "Content-Type: application/json" \
                -w $'\n%{http_code}' 2>/dev/null)" || out=""
        fi
        if [ -n "$out" ] && [[ "$out" != *"not served on cell socket"* ]] && [[ "$out" != *$'\n000' ]]; then
            printf '%s' "$out"
            return 0
        fi
    fi
    _K2_CFG=""
    if [ "$method" = "GET" ]; then
        _k2_cfg_add data-urlencode "token=${TOKEN}"
        if [ -n "$payload" ]; then
            _k2_cfg_add data "$payload"
        fi
        _k2_curl "$_K2_CFG" -s -G "${BASE_URL}${path}" \
            --connect-timeout 5 --max-time 120 \
            -w $'\n%{http_code}' 2>/dev/null || true
    else
        _k2_cfg_add url "${BASE_URL}${path}?token=$(urlencode "$TOKEN")"
        _k2_cfg_add data-raw "$payload"
        _k2_curl "$_K2_CFG" -s -X POST \
            --connect-timeout 5 --max-time 120 \
            -H "Content-Type: application/json" \
            -w $'\n%{http_code}' 2>/dev/null || true
    fi
}

# Exit code for an HTTP status (k2 study errors; PRD §5.6).
_sidecar_exit_for() {
    case "$1" in
        200) echo 0 ;;
        400|413) echo 2 ;;
        403) echo 3 ;;
        404) echo 4 ;;
        *) echo 1 ;;
    esac
}

# `<body>\n<status>` → _SC_BODY / _SC_STATUS.
_sidecar_split() {
    local raw="${1:-}"
    _SC_STATUS="${raw##*$'\n'}"
    _SC_BODY="${raw%$'\n'*}"
    if [ "$_SC_STATUS" = "$raw" ]; then
        _SC_BODY=""
    fi
    [ -z "$_SC_STATUS" ] && _SC_STATUS="000"
    return 0
}

# Print a refusal (`code: hint`) to stderr and exit with its code.
_sidecar_fail() {
    local status="$1" body="$2"
    local line=""
    if [ -n "$body" ]; then
        line="$(printf '%s' "$body" | python3 -c '
import json, sys
raw = sys.stdin.read()
try:
    v = json.loads(raw)
except Exception:
    print("daemon_error: " + raw[:200]); sys.exit(0)
e = v.get("error") if isinstance(v, dict) else None
if isinstance(e, dict):
    print("%s: %s" % (e.get("code", "error"), e.get("hint", "")))
elif e:
    print("error: %s" % e)
else:
    print("error: unexpected response")
' 2>/dev/null)"
    fi
    [ -z "$line" ] && line="daemon_unreachable: no answer from the K2 daemon (status ${status:-none})"
    echo "$line" >&2
    exit "$(_sidecar_exit_for "$status")"
}

# Render one verb's `<body>\n<status>` answer, then exit.
_sidecar_render() {
    local verb="$1" as_json="${2:-0}"
    _sidecar_split "${3:-}"
    if [ "$_SC_STATUS" != "200" ]; then
        _sidecar_fail "$_SC_STATUS" "$_SC_BODY"
    fi
    if [ "$as_json" = "1" ]; then
        printf '%s\n' "$_SC_BODY"
        exit 0
    fi
    case "$verb" in
        new)
            printf '%s' "$_SC_BODY" | python3 -c '
import json, sys
v = json.load(sys.stdin)
print(v["address"])
what = "resumed" if v.get("resumed") else "opened"
brief = v.get("brief") or {}
extra = (" with brief %s (%d bytes)" % (brief.get("path"), brief.get("bytes", 0))) if brief else ""
sys.stderr.write("%s %s (%s)%s. Message it: k2 msg %s \"...\"\n" % (what, v["address"], v.get("harness"), extra, v["address"]))
'
            ;;
        stop)
            printf '%s' "$_SC_BODY" | python3 -c '
import json, sys
v = json.load(sys.stdin)
print(("stopped %s" % v["address"]) if v.get("stopped") else ("%s was already asleep" % v["address"]))
'
            ;;
        list)
            printf '%s' "$_SC_BODY" | python3 -c '
import json, sys, time
v = json.load(sys.stdin)
rows = v.get("sidecars", [])
print("%s: %d live of %d (cap %d); agents may manage: %s" % (v.get("workspace"), v.get("live", 0), len(rows), v.get("cap", 0), "on" if v.get("agentsCanManage") else "off"))
if not rows:
    print("(no sidecars)"); sys.exit(0)
fmt = "%-28s %-20s %-8s %-7s %-14s %s"
print(fmt % ("ADDRESS", "NAME", "HARNESS", "STATE", "BY", "SINCE"))
for r in rows:
    since = r.get("lastSeenAt") or 0
    when = time.strftime("%Y-%m-%d %H:%M", time.localtime(since)) if since else "-"
    print(fmt % (r.get("address") or "-", (r.get("name") or "-")[:20], r.get("harness") or "-",
                 r.get("state") or "-", (r.get("createdBy") or "app")[:14], when))
'
            ;;
        access)
            printf '%s' "$_SC_BODY" | python3 -c '
import json, sys
v = json.load(sys.stdin)
print("Allow hiring and managing agents: %s for %s" % ("on" if v.get("agentsCanManage") else "off", v.get("workspace")))
'
            ;;
    esac
    exit 0
}

cmd_sidecar_new() {
    local name="" harness="" brief_file="" brief_text="" have_text=0 workspace="" model="" as_json=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --harness) harness="${2:-}"; shift 2 ;;
            --brief) brief_file="${2:-}"; shift 2 ;;
            --brief-text) brief_text="${2:-}"; have_text=1; shift 2 ;;
            --workspace) workspace="${2:-}"; shift 2 ;;
            --model) model="${2:-}"; shift 2 ;;
            --json) as_json=1; shift ;;
            --) shift; break ;;
            -*) echo "usage: unknown flag '$1' (k2 sidecar --help)" >&2; exit 2 ;;
            *)
                if [ -z "$name" ]; then
                    name="$1"
                else
                    echo "usage: one name only; quote names with spaces (k2 sidecar --help)" >&2
                    exit 2
                fi
                shift ;;
        esac
    done
    if [ -z "$name" ] || [ -z "$harness" ]; then
        echo "usage: k2 sidecar new <name> --harness <preset> [--brief <file>|-] [--brief-text \"…\"]" >&2
        exit 2
    fi
    if [ -n "$brief_file" ] && [ "$have_text" = "1" ]; then
        echo "usage: pass --brief or --brief-text, not both" >&2
        exit 2
    fi
    local brief_src=""
    if [ -n "$brief_file" ]; then
        if [ "$brief_file" = "-" ]; then
            brief_src="$(mktemp -t k2-sidecar-brief-XXXXXX)"
            cat > "$brief_src"
        elif [ -f "$brief_file" ]; then
            brief_src="$brief_file"
        else
            echo "usage: brief file not found: $brief_file" >&2
            exit 2
        fi
    fi
    [ -z "$workspace" ] && workspace="$PROJECT"
    local body rc=0
    body="$(K2_SC_NAME="$name" K2_SC_HARNESS="$harness" K2_SC_WS="$workspace" K2_SC_MODEL="$model" \
        K2_SC_BRIEF_FILE="$brief_src" K2_SC_BRIEF_TEXT="$brief_text" K2_SC_HAVE_TEXT="$have_text" python3 -c '
import json, os, sys
b = {"workspace": os.environ["K2_SC_WS"], "name": os.environ["K2_SC_NAME"],
     "harness": os.environ["K2_SC_HARNESS"]}
if os.environ.get("K2_SC_MODEL"):
    b["model"] = os.environ["K2_SC_MODEL"]
path = os.environ.get("K2_SC_BRIEF_FILE")
if path:
    raw = open(path, "rb").read()
    try:
        b["brief"] = raw.decode("utf-8")
    except UnicodeDecodeError:
        sys.stderr.write("brief_not_text: the brief is not UTF-8 text\n"); sys.exit(2)
elif os.environ.get("K2_SC_HAVE_TEXT") == "1":
    b["brief"] = os.environ.get("K2_SC_BRIEF_TEXT", "")
print(json.dumps(b))
')" || rc=$?
    [ "$brief_file" = "-" ] && rm -f "$brief_src"
    [ "$rc" -ne 0 ] && exit 2
    local raw
    raw="$(_sidecar_send POST /cli/sidecar/new "$body")" || true
    _sidecar_render new "$as_json" "$raw"
}

cmd_sidecar_list() {
    local workspace="" as_json=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --workspace) workspace="${2:-}"; shift 2 ;;
            --json) as_json=1; shift ;;
            *) echo "usage: k2 sidecar list [--workspace <ws>] [--json]" >&2; exit 2 ;;
        esac
    done
    [ -z "$workspace" ] && workspace="$PROJECT"
    local raw
    raw="$(_sidecar_send GET /cli/sidecar/list "workspace=$(urlencode "$workspace")")" || true
    _sidecar_render list "$as_json" "$raw"
}

cmd_sidecar_stop() {
    local name="" workspace="" force=0 as_json=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --workspace) workspace="${2:-}"; shift 2 ;;
            --force) force=1; shift ;;
            --json) as_json=1; shift ;;
            -*) echo "usage: unknown flag '$1' (k2 sidecar --help)" >&2; exit 2 ;;
            *)
                if [ -z "$name" ]; then
                    name="$1"
                else
                    echo "usage: k2 sidecar stop <name> [--workspace <ws>] [--force] [--json]" >&2
                    exit 2
                fi
                shift ;;
        esac
    done
    if [ -z "$name" ]; then
        echo "usage: k2 sidecar stop <name> [--workspace <ws>] [--force] [--json]" >&2
        exit 2
    fi
    [ -z "$workspace" ] && workspace="$PROJECT"
    local body
    body="$(K2_SC_NAME="$name" K2_SC_WS="$workspace" K2_SC_FORCE="$force" python3 -c '
import json, os
print(json.dumps({"workspace": os.environ["K2_SC_WS"], "name": os.environ["K2_SC_NAME"],
                  "force": os.environ["K2_SC_FORCE"] == "1"}))
')"
    local raw
    raw="$(_sidecar_send POST /cli/sidecar/stop "$body")" || true
    _sidecar_render stop "$as_json" "$raw"
}

cmd_sidecar_access() {
    local action="${1:-}" workspace=""
    shift 2>/dev/null || true
    while [ $# -gt 0 ]; do
        case "$1" in
            --workspace) workspace="${2:-}"; shift 2 ;;
            *) echo "usage: k2 sidecar access on|off|status [--workspace <ws>]" >&2; exit 2 ;;
        esac
    done
    [ -z "$workspace" ] && workspace="$PROJECT"
    local raw
    case "$action" in
        on|off)
            local body
            body="$(K2_SC_WS="$workspace" K2_SC_ON="$action" python3 -c '
import json, os
print(json.dumps({"workspace": os.environ["K2_SC_WS"], "toggle": "agents_manage",
                  "value": os.environ["K2_SC_ON"] == "on"}))
')"
            raw="$(_sidecar_send POST /cli/agent-access/set "$body")" || true
            _sidecar_render access 0 "$raw"
            ;;
        status)
            raw="$(_sidecar_send GET /cli/sidecar/list "workspace=$(urlencode "$workspace")")" || true
            _sidecar_render access 0 "$raw"
            ;;
        *)
            echo "usage: k2 sidecar access on|off|status [--workspace <ws>]" >&2
            exit 2
            ;;
    esac
}

cmd_sidecar() {
    local sub="${1:-}"
    case "$sub" in
        ""|help|--help|-h) _sidecar_usage; return 0 ;;
    esac
    shift
    if _wants_help "$@"; then
        _sidecar_usage
        return 0
    fi
    case "$sub" in
        new) cmd_sidecar_new "$@" ;;
        list|ls) cmd_sidecar_list "$@" ;;
        stop) cmd_sidecar_stop "$@" ;;
        access) cmd_sidecar_access "$@" ;;
        *)
            echo "usage: unknown sidecar verb '$sub' (new|list|stop|access — k2 sidecar --help)" >&2
            exit 2
            ;;
    esac
}

# ── k2 root-helper — K2's one root door on Linux ───────────────────────
# (prd-k2-root-helper-v1 §8.3). `status` is a read anyone (agents too) may
# do; `update` / `rollback` are owner/admin steps the daemon refuses for
# any passport — run them outside a K2 terminal. The one root install is
# `k2 root-helper install-command`, pasted by an admin in an SSH session.
_root_helper_usage() {
    cat <<'EOF'
k2 root-helper — K2's one root door on Linux (/usr/local/libexec/k2-root-helper)

  k2 root-helper status [--events] [--json]   state, version, protocol, auto-heal, legacy helpers
  k2 root-helper update [--from <dir>]        install the signed helper for this daemon's version now
                                              (--from: a dir holding k2-root-helper-linux-<arch> + .sig; air-gap)
  k2 root-helper rollback                     one step back to the previous helper
  k2 root-helper install-command              the one root command for a box without it

Agents: if hosted mail, the db sidecar or the vault says `helper_needed`,
ask your human (k2 tickets ask). Never install Stalwart or Postgres by hand.
EOF
}

# _root_helper_fail_if_error <raw "body\ncode"> — when the daemon gave no
# answer, a non-200, or an `error` body (a string like "route not found",
# or {code, hint}), print one plain line on stderr and exit 1. Otherwise
# return 0 and print nothing.
_root_helper_fail_if_error() {
    local raw="$1" code body
    code="${raw##*$'\n'}"
    body="${raw%$'\n'*}"
    if [ -z "$raw" ] || [ "$code" = "$raw" ] || [ -z "$code" ] || [ "$code" = "000" ]; then
        echo "k2 root-helper: daemon unreachable" >&2
        exit 1
    fi
    local line
    line="$(K2_RH_BODY="$body" K2_RH_CODE="$code" python3 -c '
import json, os
raw, code = os.environ["K2_RH_BODY"], os.environ["K2_RH_CODE"]
try:
    d = json.loads(raw)
except Exception:
    d = None
e = d.get("error") if isinstance(d, dict) else None
if isinstance(e, dict):
    msg = str(e.get("code") or "error")
    if e.get("hint"):
        msg += ": " + str(e["hint"])
elif e is not None:
    msg = str(e)
elif code != "200":
    msg = "HTTP " + code + (": " + raw.strip()[:200] if raw.strip() else "")
elif not isinstance(d, dict):
    msg = "unexpected answer from the daemon: " + (raw.strip()[:200] or "(empty)")
else:
    msg = ""
print(msg)
')" || line="unreadable answer from the daemon (HTTP $code)"
    if [ -n "$line" ]; then
        echo "k2 root-helper: error: $line" >&2
        exit 1
    fi
    return 0
}

_root_helper_render() {
    # _root_helper_render <as_json> <raw "body\ncode">
    # --json passes the daemon body through untouched (still exit 1 when it
    # is an error); otherwise an error is one plain stderr line + exit 1.
    local as_json="$1" raw="$2" code body
    code="${raw##*$'\n'}"
    body="${raw%$'\n'*}"
    if [ -z "$raw" ] || [ "$code" = "$raw" ] || [ "$code" = "000" ]; then
        echo "k2 root-helper: daemon unreachable" >&2
        exit 1
    fi
    if [ "$as_json" = "1" ]; then
        printf '%s\n' "$body"
        [ "$code" = "200" ] || exit 1
        return 0
    fi
    _root_helper_fail_if_error "$raw"
    K2_RH_BODY="$body" python3 -c '
import json, os
d = json.loads(os.environ["K2_RH_BODY"])
h = d.get("heal")
if h is not None:
    print("heal       :", h.get("result"), {k: v for k, v in h.items() if k != "result"} or "")
    d = d.get("status") or {}
if "state" in d:
    print("state      :", d.get("state"), "(" + str(d.get("path")) + ")")
    print("version    :", d.get("version"), " protocol", d.get("protocol"), " daemon", d.get("daemonVersion"))
    lg = d.get("legacy") or {}
    print("legacy     : mail", lg.get("mail"), "· pg", "present" if lg.get("pg") else "absent")
    print("setup      :", d.get("rootSetup"))
    ah = d.get("autoHeal") or {}
    if ah.get("lastResult"):
        print("auto-heal  :", ah["lastResult"].get("result"), ah["lastResult"].get("reason", ""))
    if d.get("plainSudoRestartUsed"):
        print("note       : a Stalwart restart used plain sudo systemctl (no helper)")
    if d.get("rootSetup") == "copy-command":
        print("one root step (an admin SSH session, never a K2 terminal):")
        print("  " + str(d.get("installCommand")))
    ev = (d.get("lastEvents") or {}).get("events") or []
    for e in ev[-20:]:
        x = e.get("event") or {}
        print("  event", e.get("at"), x.get("verb"), x.get("result"), (x.get("caller") or {}).get("pid"))
'
}

cmd_root_helper() {
    local sub="${1:-status}"
    [ $# -gt 0 ] && shift
    local as_json=0 events=0 from="" raw
    case "$sub" in
        help|--help|-h) _root_helper_usage; return 0 ;;
    esac
    while [ $# -gt 0 ]; do
        case "$1" in
            --json) as_json=1; shift ;;
            --events) events=1; shift ;;
            --from) from="${2:-}"; shift 2 ;;
            -h|--help) _root_helper_usage; return 0 ;;
            *) echo "usage: unknown argument '$1' (k2 root-helper --help)" >&2; exit 2 ;;
        esac
    done
    case "$sub" in
        status)
            local q="refresh=1"
            [ "$events" = 1 ] && q="$q&events=1"
            raw="$(_sidecar_send GET /cli/root-helper/status "$q")" || true
            _root_helper_render "$as_json" "$raw"
            ;;
        update)
            local body="{}"
            if [ -n "$from" ]; then
                case "$from" in /*) ;; *) from="$(cd "$from" 2>/dev/null && pwd)" || { echo "--from: no such directory" >&2; exit 2; } ;; esac
                body="$(K2_RH_FROM="$from" python3 -c 'import json, os; print(json.dumps({"fromDir": os.environ["K2_RH_FROM"]}))')"
            fi
            raw="$(_sidecar_send POST /cli/root-helper/update "$body")" || true
            _root_helper_render "$as_json" "$raw"
            ;;
        rollback)
            raw="$(_sidecar_send POST /cli/root-helper/rollback "{}")" || true
            _root_helper_render "$as_json" "$raw"
            ;;
        install-command)
            raw="$(_sidecar_send GET /cli/root-helper/status "")" || true
            if [ "$as_json" = "1" ]; then
                _root_helper_render 1 "$raw"
                return 0
            fi
            _root_helper_fail_if_error "$raw"
            local body="${raw%$'\n'*}" cmd
            cmd="$(K2_RH_BODY="$body" python3 -c 'import json, os; print(json.loads(os.environ["K2_RH_BODY"]).get("installCommand") or "")')"
            if [ -z "$cmd" ]; then
                echo "k2 root-helper: error: the daemon gave no install command" >&2
                exit 1
            fi
            printf '%s\n' "$cmd"
            ;;
        *)
            echo "usage: unknown root-helper verb '$sub' (status|update|rollback|install-command)" >&2
            exit 2
            ;;
    esac
}

# ── k2 compute — run commands on your compute nodes ───────────────────
# (prd-k2-compute-nodes-v1 §15.2). `compute` is an `id` tool and locked:
# inside a K2 terminal the request carries this session's passport, so an
# agent only ever sees its own workspace and needs "Allow compute nodes"
# plus a grant. Owner verbs (node add/confirm/remove, grant, local pause…)
# refuse a passport with `owner_only`: run them outside K2.
# Agent verbs ride the per-cell socket when present; owner verbs go TCP.

_compute_usage() {
    cat <<'EOF'
k2 compute — run commands on your own machines (compute nodes)

Agents:
  k2 compute nodes [--json]                  nodes granted to this workspace
  k2 compute info <node> [--json]
  k2 compute run <node>|--any [--os linux] [--arch x86_64] [--label k=v]
                 [--detach] [--dirty] [--sha REV] [--no-source]
                 [--env K=V]... [--cpus N] [--mem 16G] [--timeout 2h]
                 [--exclusive] [--retry-interrupted|--no-retry] [--raw]
                 [--needs node@22,python@3.12,rust@stable,cargo-nextest,cmake@3,sys:pkg-config]
                 (tools: node python go java bun deno zig cmake ninja protoc uv pnpm,
                  rust@<ch>, cargo-nextest, sys:<pkg>, or aqua:owner/repo@v;
                  anything else is refused: tool_unsupported, exit 2)
                 -- <command…>
  k2 compute jobs [--node N] [--mine] [--state S] [--limit N] [--json]
  k2 compute get <job> [--json]
  k2 compute attach <job> [--since SEQ] [--raw]
  k2 compute logs <job> [--tail N] [--failures] [--raw]
  k2 compute cancel <job>        k2 compute retry <job>
  k2 compute receipt <job>
Owner / admin (refused for agents and inside K2 terminals):
  k2 compute preview on|off|status             turn the preview on for this server (owner)
  k2 compute node add <name> [--url URL]       mint a 10-minute enroll code
  k2 compute node confirm <name> <code>        the 6 digits the node shows
  k2 compute node remove <name>                k2 compute node rename <old> <new>
  k2 compute node retire <name>                drain, then remove once its jobs end
  k2 compute node pause|drain|resume <name>    this server stops/starts assigning
  k2 compute node route add|rm <name> <url>    LAN or tailnet URL the node may dial
  k2 compute grant <node> --workspace WS [--max-time 2h] [--max-disk 60G]
                   [--max-parallel 1] [--max-queued 10]
  k2 compute revoke <node> --workspace WS
  k2 compute grants [--node N] [--workspace WS]
  k2 compute access on|off --workspace WS
                   the Agent tab's "Allow compute nodes" (Settings → Workspaces →
                   <agent> → Agent): on = a grant on every machine switched on,
                   default limits (and ones added later); off removes them all
  k2 compute usage [--days N]    k2 compute events [--limit N]
Node admin (agents need "Allow this agent to operate compute nodes"):
  k2 compute node health <node> [--json]       uptime, disk, RAM, FileVault, update state
  k2 compute node policy <node> show
  k2 compute node policy <node> set key=value... [--reason "…"]
                   narrowing applies at once; widening waits for the owner (exit 2)
  k2 compute node update <node> [--canary]     offer the signed k2-node build
  k2 compute node rollback <node>              back to the node's own previous build
  k2 compute node admin propose <node> <verb> [key=value…] --reason "…"
                   verbs today: unit.restart unit=k2-node, policy.set key=value,
                   control.pause|drain|resume, gc, jobs.kill job_id=…
  k2 compute node admin propose <node> --plan plan.json --reason "…"
                   held for the owner: exit 2 with the request id
  k2 compute node admin list [--node N] [--state open|pending|all] [--json]
  k2 compute node admin withdraw <id>
Node admin, owner only (refused for agents and inside K2 terminals):
  k2 compute node admin approve <id>           Touch ID / your password, then signed + sent
  k2 compute node admin deny <id> [--why "…"]
  k2 compute node alerts <node> [--after 10m|off]   offline alert after N minutes
  k2 compute node alerts --to <workspace>|none      where alerts go (an IT agent)
  k2 compute operate on|off --workspace WS
                   the Agent switch "Allow this agent to operate compute nodes"
This computer (its owner):
  k2 compute local status|pause [--now]|drain|resume
  k2 compute local policy key=value...    (cpu_cap_percent, mem_cap_gb, availability, …)
  k2 compute local enable [--controller URL --enroll CODE.FP --name NAME]
                          [--private-home | --no-private-home]
  k2 compute local disable

Attached runs stream output and exit with the job's exit code. Infra
problems exit 3 with a code (node_offline, not_granted, compute_off,
queue_full, owner_only, …). Read `k2 study compute` first.
EOF
}

# _compute_send METHOD PATH [payload] [tcp] → `<body>\n<status>` on stdout.
# GET payload = urlencoded query; POST payload = JSON body.
_compute_send() {
    local method="$1" path="$2" payload="${3:-}" force_tcp="${4:-}"
    local sock out="" _K2_CFG=""
    sock="$(_hook_sock)"
    if [ "$force_tcp" != "tcp" ] && [ -n "$sock" ] && [ -S "$sock" ] && ! _cli_skip_uds && [ -n "${SCOPED_TOKEN:-}" ]; then
        _k2_cfg_add header "Authorization: Bearer ${SCOPED_TOKEN}"
        if [ "$method" = "GET" ]; then
            [ -n "$payload" ] && _k2_cfg_add data "$payload"
            out="$(_k2_curl "$_K2_CFG" -s -G --unix-socket "$sock" "http://localhost${path}" \
                --connect-timeout 5 --max-time 60 -w $'\n%{http_code}' 2>/dev/null)" || out=""
        else
            _k2_cfg_add data-raw "$payload"
            out="$(_k2_curl "$_K2_CFG" -s -X POST --unix-socket "$sock" "http://localhost${path}" \
                --connect-timeout 5 --max-time "${K2_CP_MAX_TIME:-120}" -H "Content-Type: application/json" \
                -w $'\n%{http_code}' 2>/dev/null)" || out=""
        fi
        if [ -n "$out" ] && [[ "$out" != *"not served on cell socket"* ]] && [[ "$out" != *$'\n000' ]]; then
            printf '%s' "$out"
            return 0
        fi
    fi
    _K2_CFG=""
    if [ "$method" = "GET" ]; then
        _k2_cfg_add data-urlencode "token=${TOKEN}"
        [ -n "$payload" ] && _k2_cfg_add data "$payload"
        _k2_curl "$_K2_CFG" -s -G "${BASE_URL}${path}" \
            --connect-timeout 5 --max-time 60 -w $'\n%{http_code}' 2>/dev/null || printf '\n000'
    else
        _k2_cfg_add url "${BASE_URL}${path}?token=$(urlencode "$TOKEN")"
        _k2_cfg_add data-raw "$payload"
        _k2_curl "$_K2_CFG" -s -X POST --connect-timeout 5 --max-time "${K2_CP_MAX_TIME:-120}" \
            -H "Content-Type: application/json" -w $'\n%{http_code}' 2>/dev/null || printf '\n000'
    fi
}

_compute_split() {
    local raw="${1:-}"
    _CP_STATUS="${raw##*$'\n'}"
    _CP_BODY="${raw%$'\n'*}"
    [ "$_CP_STATUS" = "$raw" ] && _CP_BODY=""
    [ -z "$_CP_STATUS" ] && _CP_STATUS="000"
    return 0
}

# Print the refusal and exit: 2 for a bad request, 3 for everything else
# (infra and permission problems; a test failure is never exit 3).
_compute_fail() {
    local status="$1" body="$2" line=""
    if [ -n "$body" ]; then
        line="$(printf '%s' "$body" | python3 -c '
import json, sys
raw = sys.stdin.read()
try:
    v = json.loads(raw)
except Exception:
    print("daemon_error: " + raw[:200]); sys.exit(0)
e = v.get("error") if isinstance(v, dict) else None
if isinstance(e, dict):
    print(json.dumps({"error": e.get("code", "error"), "hint": e.get("hint", "")}))
else:
    print(json.dumps({"error": "error", "hint": str(e)}))
' 2>/dev/null)"
    fi
    [ -z "$line" ] && line="{\"error\":\"daemon_unreachable\",\"hint\":\"no answer from the K2 daemon (status ${status:-none})\"}"
    echo "$line" >&2
    case "$status" in
        400|413) exit 2 ;;
        *) exit 3 ;;
    esac
}

# GET/POST and fail on a refusal; the body lands in _CP_BODY.
_compute_call() {
    local raw
    raw="$(_compute_send "$@")"
    _compute_split "$raw"
    [ "$_CP_STATUS" = "200" ] || _compute_fail "$_CP_STATUS" "$_CP_BODY"
}

# JSON from KEY=VALUE env pairs: _compute_json K2_CJ_a=… (values are strings
# unless the key ends in _n (number), _b (bool) or _j (raw JSON)).
_compute_json() {
    env "$@" python3 -c '
import json, os
out = {}
for k, v in os.environ.items():
    if not k.startswith("K2_CJ_"):
        continue
    key = k[6:]
    if v == "":
        continue
    if key.endswith("_n"):
        out[key[:-2]] = float(v) if "." in v else int(v)
    elif key.endswith("_b"):
        out[key[:-2]] = v == "1"
    elif key.endswith("_j"):
        out[key[:-2]] = json.loads(v)
    else:
        out[key] = v
print(json.dumps(out))
'
}

# 2h / 90m / 300s / 300 → seconds.
_compute_secs() {
    local v="$1"
    case "$v" in
        *h) echo $(( ${v%h} * 3600 )) ;;
        *m) echo $(( ${v%m} * 60 )) ;;
        *s) echo "${v%s}" ;;
        ''|*[!0-9]*) echo "usage: bad duration '$v' (use 2h, 90m, 300s)" >&2; exit 2 ;;
        *) echo "$v" ;;
    esac
}

# 16G / 512M / bytes → bytes.
_compute_bytes() {
    local v="$1"
    case "$v" in
        *G|*g) echo $(( ${v%?} * 1073741824 )) ;;
        *M|*m) echo $(( ${v%?} * 1048576 )) ;;
        ''|*[!0-9]*) echo "usage: bad size '$v' (use 16G or 512M)" >&2; exit 2 ;;
        *) echo "$v" ;;
    esac
}

# Is this call carrying a session passport (inside a K2 terminal)?
_compute_in_session() {
    [ -n "${SCOPED_TOKEN:-}" ] && [ "${TOKEN:-}" = "${SCOPED_TOKEN:-}" ]
}

# The workspace to name: explicit --workspace, else this checkout (only
# outside a session; a passport's workspace comes from the passport).
_compute_ws() {
    local explicit="${1:-}"
    if [ -n "$explicit" ]; then
        printf '%s' "$explicit"
    elif ! _compute_in_session; then
        printf '%s' "$PROJECT"
    fi
}

_compute_render() {
    local verb="$1"
    printf '%s' "$_CP_BODY" | K2_CP_VERB="$verb" python3 -c '
import json, os, sys, time
v = json.load(sys.stdin)
verb = os.environ["K2_CP_VERB"]
def gb(n):
    return "%d GB" % round((n or 0) / (1 << 30))
def cores(m):
    return "%g" % ((m or 0) / 1000)
def ago(t):
    if not t: return "-"
    d = int(time.time()) - int(t)
    return "now" if d < 60 else ("%dm ago" % (d // 60) if d < 3600 else ("%dh ago" % (d // 3600) if d < 86400 else "%dd ago" % (d // 86400)))
def node_line(n):
    o = n.get("offer") or {}
    st = n.get("state")
    if st == "pending":
        status = "pending (code %s)" % (n.get("sas") or "?")
    elif not n.get("online"):
        status = "offline"
    else:
        status = "online/%s" % (n.get("liveRoute") or "?")
        if o.get("control") and o["control"] != "active":
            status = o["control"] + (" by " + o["controlBy"] if o.get("controlBy") else "")
        elif o.get("refusal"):
            status = "waiting: " + o["refusal"].get("code", "")
        elif o.get("available") is False:
            status = "unavailable: " + ",".join(o.get("unavailable") or [])
    if n.get("controllerPause"):
        status += " (server: %s)" % n["controllerPause"]
    os_arch = "%s-%s" % (n.get("os") or "?", n.get("arch") or "?")
    caps = o.get("caps") or {}
    free = o.get("free") or {}
    res = "%s cores  %s RAM  %s free disk" % (cores(caps.get("cpu_millis")), gb(caps.get("mem_bytes")), gb(free.get("disk_free_bytes"))) if o else "-"
    return "%-14s %-16s %-24s %-40s run %d  queue %d  seen %s" % (n["name"], os_arch, status[:24], res, n.get("running", 0), n.get("queued", 0), ago(n.get("lastSeen")))
if verb == "nodes":
    rows = v.get("nodes", [])
    if not rows:
        print("(no compute nodes%s)" % ("" if v.get("waitingCodes") is None else "; add one with: k2 compute node add <name>"))
    for n in rows:
        print(node_line(n))
    for c in v.get("waitingCodes") or []:
        print("code waiting for %s (expires %s)" % (c["name"], time.strftime("%H:%M", time.localtime(c["expiresAt"]))))
elif verb == "info":
    print(node_line(v))
    o = v.get("offer") or {}
    if o.get("tools"):
        print("tools: " + "  ".join("%s %s" % kv for kv in sorted(o["tools"].items())))
    if v.get("routes"):
        print("routes: " + " ".join(v["routes"]))
    for g in v.get("grants") or []:
        print("grant: %s  max %ss/job  %s parallel  %s queued  %s GB disk" % (g.get("workspace"), g["maxJobSecs"], g["maxParallel"], g["maxQueued"], g["maxDiskGb"]))
    for j in v.get("recentJobs") or []:
        print("job %s  %-9s exit %-4s %s" % (j["short"], j["state"], "-" if j.get("exitCode") is None else j["exitCode"], " ".join(j.get("argv") or [])[:60]))
elif verb == "jobs":
    rows = v.get("jobs", [])
    if not rows:
        print("(no jobs)")
    for j in rows:
        print("%s  %-12s %-11s exit %-4s %-10s %s" % (j["short"], (j.get("node") or "?")[:12], j["state"], "-" if j.get("exitCode") is None else j["exitCode"], (j.get("reason") or "")[:10], " ".join(j.get("argv") or [])[:60]))
elif verb == "get":
    j = v
    print("job %s on %s: %s%s" % (j["short"], j.get("node"), j["state"], (" (%s)" % j["reason"]) if j.get("reason") else ""))
    print("  argv: %s" % " ".join(j.get("argv") or []))
    print("  commit: %s  tree: %s" % (j.get("srcCommit") or "-", j.get("srcTree") or "-"))
    print("  exit: %s  signal: %s  attempt %s (generation %s)" % (j.get("exitCode"), j.get("signal"), j.get("attempt"), j.get("generation")))
    if j.get("queue"):
        q = j["queue"]
        print("  queued: position %s — %s (%s)" % (q["position"], q["reason"], q["message"]))
elif verb == "receipt":
    print(json.dumps(v.get("receipt"), indent=2))
    print("verified: %s  (%s)" % ("yes" if v.get("verified") else "NO", v.get("proves")))
elif verb == "grants":
    rows = v.get("grants", [])
    if not rows:
        print("(no grants)")
    for g in rows:
        print("%-14s %-20s max %ss/job  %s parallel  %s queued  %s GB disk  by %s" % (g.get("node"), g.get("workspace"), g["maxJobSecs"], g["maxParallel"], g["maxQueued"], g["maxDiskGb"], g["grantedBy"]))
elif verb == "usage":
    rows = v.get("usage", [])
    if not rows:
        print("(no traffic in this window)")
    for u in rows:
        print("%s  %-14s %-9s in %8.1f MB  out %8.1f MB" % (u["day"], u.get("node") or u["nodeId"][:8], u["route"], u["bytesIn"] / 1e6, u["bytesOut"] / 1e6))
    print(v.get("metered", ""))
elif verb == "events":
    for e in v.get("events", []):
        print("%s  %-16s %-18s %s %s" % (time.strftime("%m-%d %H:%M:%S", time.localtime(e["at"])), e["kind"], e["actor"][:18], (e.get("jobId") or e.get("nodeId") or "")[:8], json.dumps(e.get("detail"))[:80]))
elif verb == "enroll":
    print("Enroll code for %s (expires in 10 minutes):" % v["name"])
    print("  %s" % v["enroll"])
    print("On the node machine, as an admin:")
    print("  Linux: %s" % v["install"]["linux"])
    print("  macOS: %s" % v["install"]["macos"])
    print("The node prints a 6-digit code. Check it, then here:")
    print("  %s" % v["confirm"])
else:
    print(json.dumps(v, indent=2))
'
}

# Follow a job's logs until it ends; exit with its result.
# _compute_follow <job> <raw 0|1> [cursor|seq:N]
_compute_follow() {
    local job="$1" raw="${2:-0}" start="${3:-0}"
    local cursor=0 query state_file fails=0 lost=0
    state_file="$(mktemp -t k2-compute-XXXXXX)"
    # shellcheck disable=SC2064
    trap "rm -f '$state_file'; echo '[k2 compute] detached; the job keeps running. k2 compute attach $job | k2 compute cancel $job' >&2; exit 130" INT
    case "$start" in
        seq:*) query="since_seq=${start#seq:}" ;;
        *) cursor="$start"; query="" ;;
    esac
    while :; do
        local q="job=$(urlencode "$job")&wait=20"
        if [ -n "$query" ]; then q="$q&$query"; query=""; else q="$q&cursor=$cursor"; fi
        local resp
        resp="$(_compute_send GET /cli/compute/jobs/logs "$q")"
        _compute_split "$resp"
        if [ "$_CP_STATUS" = "000" ]; then
            fails=$((fails + 1))
            if [ "$fails" -eq 1 ]; then
                echo "[k2 compute] lost the K2 server; retrying (the job keeps running on the node)" >&2
            fi
            if [ "$fails" -gt 60 ]; then
                rm -f "$state_file"
                echo "{\"error\":\"lost_contact\",\"hint\":\"no answer from the K2 server for 10 minutes; the job may still be running: k2 compute attach $job\"}" >&2
                exit 3
            fi
            lost=1
            sleep 10
            continue
        fi
        [ "$_CP_STATUS" = "200" ] || { rm -f "$state_file"; _compute_fail "$_CP_STATUS" "$_CP_BODY"; }
        fails=0
        printf '%s' "$_CP_BODY" | K2_CP_RAW="$raw" K2_CP_STATE="$state_file" K2_CP_LOST="$lost" python3 -c '
import base64, json, os, re, sys
v = json.load(sys.stdin)
raw = os.environ.get("K2_CP_RAW") == "1"
esc = re.compile(rb"\x1b\[[0-9;?]*[ -/]*[@-~]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)|\x1b[@-Z\\-_]|[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]")
chunks = v.get("chunks", [])
if os.environ.get("K2_CP_LOST") == "1" and chunks:
    sys.stderr.write("[k2 compute] reattached at seq %d\n" % chunks[0]["seq"])
for c in chunks:
    data = base64.b64decode(c["data"])
    if not raw:
        data = esc.sub(b"", data)
    if c["stream"] == "out":
        sys.stdout.buffer.write(data); sys.stdout.buffer.flush()
    else:
        sys.stderr.buffer.write(data); sys.stderr.buffer.flush()
j = v.get("job", {})
q = v.get("queue") or {}
def s(x):
    return re.sub(r"[^A-Za-z0-9_.:-]", "", str(x if x is not None else ""))
# "|", not a tab: bash `read` merges runs of IFS whitespace, so an empty
# field (no signal, no reason) shifted every later one (mini-1 smoke printed
# the start time as the job id). s() never lets "|" through.
open(os.environ["K2_CP_STATE"], "w").write("|".join([
    s(v.get("cursor", 0)), "1" if v.get("end") else "0", s(j.get("state")), s(j.get("exitCode")),
    s(j.get("signal")), s(j.get("reason")), s(j.get("short")), s(j.get("node")),
    s(j.get("startedAt")), s(j.get("endedAt")), s(q.get("position")), s(q.get("reason")),
]) + "\n")
'
        local end st code sig reason short node started ended qpos qreason
        IFS='|' read -r cursor end st code sig reason short node started ended qpos qreason < "$state_file"
        lost=0
        if [ "$st" = "queued" ] && [ -n "$qreason" ] && [ "$qreason" != "${_CP_LAST_Q:-}" ]; then
            echo "[k2 compute] queued on $node: position $qpos — $qreason" >&2
            _CP_LAST_Q="$qreason"
        fi
        if [ "$end" = "1" ]; then
            rm -f "$state_file"
            trap - INT
            local took=""
            if [ -n "$started" ] && [ -n "$ended" ]; then
                took=" after $(( (ended - started) / 60 ))m$(( (ended - started) % 60 ))s"
            fi
            case "$st" in
                done)
                    if [ -n "$code" ]; then
                        echo "[k2 compute] exit $code$took · k2 compute logs $short --failures" >&2
                        exit "$code"
                    fi
                    echo "[k2 compute] killed by signal $sig$took" >&2
                    exit $((128 + ${sig:-0}))
                    ;;
                *)
                    echo "[k2 compute] job $short $st${reason:+ ($reason)}$took" >&2
                    echo "{\"error\":\"$st\",\"reason\":\"$reason\",\"hint\":\"k2 compute get $short; k2 compute retry $short\"}" >&2
                    exit 3
                    ;;
            esac
        fi
    done
}

cmd_compute_run() {
    local node="" any=0 os="" arch="" detach=0 dirty=0 sha="" nosrc=0 cpus="" mem="" timeout="" exclusive=0
    local retry="" raw=0 workspace=""
    local -a labels=() envs=() needs=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --) shift; break ;;
            --any) any=1; shift ;;
            --os) os="${2:-}"; shift 2 ;;
            --arch) arch="${2:-}"; shift 2 ;;
            --label) labels+=("${2:-}"); shift 2 ;;
            --detach|-d) detach=1; shift ;;
            --dirty) dirty=1; shift ;;
            --sha) sha="${2:-}"; shift 2 ;;
            --no-source) nosrc=1; shift ;;
            --env) envs+=("${2:-}"); shift 2 ;;
            --needs|--need) needs+=("${2:-}"); shift 2 ;;
            --cpus) cpus="${2:-}"; shift 2 ;;
            --mem) mem="$(_compute_bytes "${2:-}")"; shift 2 ;;
            --timeout) timeout="$(_compute_secs "${2:-}")"; shift 2 ;;
            --exclusive) exclusive=1; shift ;;
            --retry-interrupted) retry=1; shift ;;
            --no-retry) retry=0; shift ;;
            --raw) raw=1; shift ;;
            --workspace) workspace="${2:-}"; shift 2 ;;
            -*) echo "usage: unknown flag '$1' (k2 compute --help)" >&2; exit 2 ;;
            *)
                if [ -z "$node" ] && [ "$any" = "0" ]; then node="$1"; shift
                else echo "usage: put the command after --: k2 compute run <node> -- <command…>" >&2; exit 2
                fi ;;
        esac
    done
    if [ $# -eq 0 ]; then
        echo "usage: k2 compute run <node>|--any [flags] -- <command…>" >&2
        exit 2
    fi
    if [ -z "$node" ] && [ "$any" = "0" ]; then
        echo "usage: name a node or pass --any (k2 compute nodes)" >&2
        exit 2
    fi
    local cwd=""
    cwd="$(git rev-parse --show-prefix 2>/dev/null || true)"
    cwd="${cwd%/}"
    local client
    client="$(python3 -c 'import uuid; print(uuid.uuid4().hex)')"
    local argv_json labels_json env_json
    argv_json="$(python3 -c 'import json,sys; print(json.dumps(sys.argv[1:]))' "$@")"
    labels_json="$(python3 -c '
import json, sys
out = {}
for l in sys.argv[1:]:
    if "=" not in l:
        sys.stderr.write("usage: --label key=value\n"); sys.exit(2)
    k, v = l.split("=", 1); out[k] = v
print(json.dumps(out))' "${labels[@]+"${labels[@]}"}")" || exit 2
    env_json="$(python3 -c '
import json, sys
out = {}
for l in sys.argv[1:]:
    if "=" not in l:
        sys.stderr.write("usage: --env NAME=value\n"); sys.exit(2)
    k, v = l.split("=", 1); out[k] = v
print(json.dumps(out))' "${envs[@]+"${envs[@]}"}")" || exit 2
    local needs_json=""
    if [ "${#needs[@]}" -gt 0 ]; then
        needs_json="$(python3 -c '
import json, sys
out = []
for a in sys.argv[1:]:
    out += [x.strip() for x in a.split(",") if x.strip()]
print(json.dumps(out))' "${needs[@]}")"
    fi
    local ws_name
    ws_name="$(_compute_ws "$workspace")"
    local body
    body="$(_compute_json K2_CJ_node="$node" K2_CJ_any_b="$any" K2_CJ_os="$os" K2_CJ_arch="$arch" \
        K2_CJ_labels_j="$labels_json" K2_CJ_env_j="$env_json" K2_CJ_argv_j="$argv_json" K2_CJ_needs_j="$needs_json" \
        K2_CJ_detach_b="$detach" K2_CJ_dirty_b="$dirty" K2_CJ_sha="$sha" K2_CJ_noSource_b="$nosrc" \
        K2_CJ_cpus_n="$cpus" K2_CJ_memBytes_n="$mem" K2_CJ_timeoutSecs_n="$timeout" \
        K2_CJ_exclusive_b="$exclusive" K2_CJ_retryInterrupted_b="$retry" K2_CJ_cwd="$cwd" \
        K2_CJ_workspace="$ws_name" K2_CJ_clientJobId="$client")"
    [ "$any" = "0" ] && body="$(printf '%s' "$body" | python3 -c 'import json,sys; v=json.load(sys.stdin); v.pop("any", None); print(json.dumps(v))')"
    # The same clientJobId makes a retried POST idempotent.
    local raw_resp attempt=0
    while :; do
        raw_resp="$(_compute_send POST /cli/compute/run "$body")"
        _compute_split "$raw_resp"
        [ "$_CP_STATUS" != "000" ] && break
        attempt=$((attempt + 1))
        [ "$attempt" -ge 3 ] && break
        sleep 2
    done
    [ "$_CP_STATUS" = "200" ] || _compute_fail "$_CP_STATUS" "$_CP_BODY"
    local info
    info="$(printf '%s' "$_CP_BODY" | python3 -c '
import json, sys
v = json.load(sys.stdin)
j = v["job"]
c = (j.get("srcCommit") or "")[:8]
q = v.get("queue") or {}
line = "[k2 compute] job %s on %s" % (j["short"], j.get("node"))
if c: line += " · commit " + c
line += " · " + j["state"]
if q: line += " (position %s: %s)" % (q.get("position"), q.get("reason"))
for w in v.get("warnings") or []:
    sys.stderr.write("[k2 compute] note: %s\n" % w)
print(j["id"] + "\t" + line)')"
    local job_id="${info%%$'\t'*}" line="${info#*$'\t'}"
    echo "$line" >&2
    if [ "$detach" = "1" ]; then
        echo "${job_id:0:8}"
        echo "[k2 compute] detached: you get a [compute] message when it ends. k2 compute attach ${job_id:0:8}" >&2
        exit 0
    fi
    _compute_follow "$job_id" "$raw" 0
}

cmd_compute_logs() {
    local job="" tail="" failures=0 raw=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --tail) tail="${2:-}"; shift 2 ;;
            --failures) failures=1; shift ;;
            --raw) raw=1; shift ;;
            -*) echo "usage: k2 compute logs <job> [--tail N] [--failures] [--raw]" >&2; exit 2 ;;
            *) job="$1"; shift ;;
        esac
    done
    [ -n "$job" ] || { echo "usage: k2 compute logs <job> [--tail N] [--failures] [--raw]" >&2; exit 2; }
    local tmp cursor=0
    tmp="$(mktemp -t k2-compute-logs-XXXXXX)"
    : > "$tmp"
    while :; do
        _compute_call GET /cli/compute/jobs/logs "job=$(urlencode "$job")&cursor=$cursor&max=1048576"
        local next
        next="$(printf '%s' "$_CP_BODY" | K2_CP_OUT="$tmp" python3 -c '
import base64, json, os, sys
v = json.load(sys.stdin)
with open(os.environ["K2_CP_OUT"], "ab") as f:
    for c in v.get("chunks", []):
        f.write(base64.b64decode(c["data"]))
print("%s %d" % (v.get("cursor", 0), len(v.get("chunks", []))))')"
        local n="${next#* }"
        cursor="${next% *}"
        [ "$n" = "0" ] && break
    done
    K2_CP_RAW="$raw" K2_CP_TAIL="$tail" K2_CP_FAIL="$failures" python3 -c '
import os, re, sys
data = open(sys.argv[1], "rb").read()
if os.environ.get("K2_CP_RAW") != "1":
    data = re.sub(rb"\x1b\[[0-9;?]*[ -/]*[@-~]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)|\x1b[@-Z\\-_]|[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]", b"", data)
lines = data.decode("utf-8", "replace").splitlines()
if os.environ.get("K2_CP_FAIL") == "1":
    pat = re.compile(r"(FAIL|FAILED|panicked at|^error(\[E\d+\])?:|^failures:|test result: FAILED|assertion|--- STDERR)")
    lines = [l for l in lines if pat.search(l)]
t = os.environ.get("K2_CP_TAIL")
if t:
    lines = lines[-int(t):]
sys.stdout.write("\n".join(lines) + ("\n" if lines else ""))' "$tmp"
    rm -f "$tmp"
}

cmd_compute_node() {
    local sub="${1:-}"
    shift 2>/dev/null || true
    local body
    case "$sub" in
        add)
            local name="" url=""
            while [ $# -gt 0 ]; do
                case "$1" in
                    --url) url="${2:-}"; shift 2 ;;
                    *) name="$1"; shift ;;
                esac
            done
            [ -n "$name" ] || { echo "usage: k2 compute node add <name> [--url URL]" >&2; exit 2; }
            body="$(_compute_json K2_CJ_name="$name" K2_CJ_url="$url")"
            _compute_call POST /cli/compute/nodes/enroll-code "$body" tcp
            _compute_render enroll
            ;;
        confirm)
            [ $# -ge 2 ] || { echo "usage: k2 compute node confirm <name> <6-digit code>" >&2; exit 2; }
            body="$(_compute_json K2_CJ_node="$1" K2_CJ_sas="${*:2}")"
            _compute_call POST /cli/compute/nodes/confirm "$body" tcp
            printf '%s' "$_CP_BODY" | python3 -c 'import json,sys; v=json.load(sys.stdin); print("%s is active. %s" % (v["node"], v["next"]))'
            ;;
        remove|rm)
            [ $# -ge 1 ] || { echo "usage: k2 compute node remove <name>" >&2; exit 2; }
            body="$(_compute_json K2_CJ_node="$1")"
            _compute_call POST /cli/compute/nodes/remove "$body" tcp
            printf '%s' "$_CP_BODY" | python3 -c 'import json,sys; v=json.load(sys.stdin); print("removed %s (%d jobs cancelled)" % (v["node"], v["jobsCancelled"]))'
            ;;
        retire)
            [ $# -ge 1 ] || { echo "usage: k2 compute node retire <name>" >&2; exit 2; }
            body="$(_compute_json K2_CJ_node="$1")"
            _compute_call POST /cli/compute/nodes/retire "$body" tcp
            printf '%s' "$_CP_BODY" | python3 -c 'import json,sys; v=json.load(sys.stdin); print("%s: %s" % (v["node"], "removed" if v["state"] == "revoked" else "draining; removed once its %d running job(s) end" % v.get("running", 0)))'
            ;;
        rename)
            [ $# -ge 2 ] || { echo "usage: k2 compute node rename <old> <new>" >&2; exit 2; }
            body="$(_compute_json K2_CJ_node="$1" K2_CJ_name="$2")"
            _compute_call POST /cli/compute/nodes/rename "$body" tcp
            echo "renamed to $2"
            ;;
        pause|drain|resume)
            [ $# -ge 1 ] || { echo "usage: k2 compute node $sub <name>" >&2; exit 2; }
            body="$(_compute_json K2_CJ_node="$1" K2_CJ_action="$sub")"
            _compute_call POST /cli/compute/nodes/pause "$body" tcp
            printf '%s' "$_CP_BODY" | python3 -c 'import json,sys; v=json.load(sys.stdin); print("%s: server-side %s. %s" % (v["node"], v.get("controllerPause") or "active", v["note"]))'
            ;;
        route|routes)
            local op="${1:-}"
            [ $# -ge 3 ] || { echo "usage: k2 compute node route add|rm <name> <url>" >&2; exit 2; }
            case "$op" in
                add) body="$(_compute_json K2_CJ_node="$2" K2_CJ_add="$3")" ;;
                rm|remove) body="$(_compute_json K2_CJ_node="$2" K2_CJ_remove="$3")" ;;
                *) echo "usage: k2 compute node route add|rm <name> <url>" >&2; exit 2 ;;
            esac
            _compute_call POST /cli/compute/nodes/routes "$body" tcp
            printf '%s' "$_CP_BODY" | python3 -c 'import json,sys; v=json.load(sys.stdin); print("routes for %s: %s" % (v["node"], " ".join(v["routes"]) or "(none)"))'
            ;;
        admin) cmd_compute_node_admin "$@" ;;
        policy)
            local node="${1:-}" act="${2:-show}"
            [ -n "$node" ] || { echo "usage: k2 compute node policy <node> show|set key=value..." >&2; exit 2; }
            shift 2 2>/dev/null || shift $#
            case "$act" in
                show)
                    _compute_call GET /cli/compute/nodes/policy "node=$(urlencode "$node")"
                    for a in "$@"; do [ "$a" = "--json" ] && { printf '%s\n' "$_CP_BODY"; exit 0; }; done
                    printf '%s' "$_CP_BODY" | python3 -c 'import json,sys
v=json.load(sys.stdin)
print("%s (%s, remote admin %s)" % (v["node"], "online" if v["online"] else "offline", v.get("remoteAdmin") or "unknown"))
p=v.get("policy")
if not p: print("  " + v.get("hint",""))
else:
    for k in sorted(p): print("  %-18s %s" % (k, json.dumps(p[k])))'
                    ;;
                set)
                    local reason="" pairs=()
                    while [ $# -gt 0 ]; do
                        case "$1" in
                            --reason) reason="${2:-}"; shift 2 ;;
                            *=*) pairs+=("$1"); shift ;;
                            *) echo "usage: k2 compute node policy <node> set key=value... [--reason …]" >&2; exit 2 ;;
                        esac
                    done
                    [ ${#pairs[@]} -gt 0 ] || { echo "usage: k2 compute node policy <node> set key=value..." >&2; exit 2; }
                    local set_json
                    set_json="$(_compute_kv_json "${pairs[@]}")" || exit 2
                    _compute_call POST /cli/compute/nodes/policy/set "$(_compute_json K2_CJ_node="$node" K2_CJ_set_j="$set_json" K2_CJ_reason="$reason")"
                    if printf '%s' "$_CP_BODY" | grep -q '"held": *true'; then
                        _compute_admin_held_or_approve
                    fi
                    printf '%s' "$_CP_BODY" | python3 -c 'import json,sys; v=json.load(sys.stdin); print("%s: %s" % (v["node"], v.get("note","ok")))'
                    ;;
                *) echo "usage: k2 compute node policy <node> show|set key=value..." >&2; exit 2 ;;
            esac
            ;;
        health)
            [ -n "${1:-}" ] || { echo "usage: k2 compute node health <node> [--json]" >&2; exit 2; }
            _compute_call GET /cli/compute/nodes/health "node=$(urlencode "$1")"
            for a in "$@"; do [ "$a" = "--json" ] && { printf '%s\n' "$_CP_BODY"; exit 0; }; done
            _compute_render_health
            ;;
        update|rollback)
            local node="" canary=0
            while [ $# -gt 0 ]; do
                case "$1" in
                    --canary) canary=1; shift ;;
                    *) node="$1"; shift ;;
                esac
            done
            [ -n "$node" ] || { echo "usage: k2 compute node $sub <node>" >&2; exit 2; }
            _compute_call POST "/cli/compute/nodes/$sub" "$(_compute_json K2_CJ_node="$node" K2_CJ_canary_b="$canary")"
            printf '%s' "$_CP_BODY" | python3 -c 'import json,sys
v=json.load(sys.stdin); u=v.get("update") or {}
print("%s: %s%s. %s" % (v["node"], u.get("state"), (" " + u["version"]) if u.get("version") else "", v.get("note","")))'
            ;;
        alerts)
            local node="" after="" to="" have_to=0
            while [ $# -gt 0 ]; do
                case "$1" in
                    --after) after="${2:-}"; shift 2 ;;
                    --to) to="${2:-}"; have_to=1; shift 2 ;;
                    *) node="$1"; shift ;;
                esac
            done
            [ -n "$node" ] || [ "$have_to" = "1" ] || { echo "usage: k2 compute node alerts <node> [--after 10m|off] | --to <workspace>|none" >&2; exit 2; }
            local after_j=""
            if [ -n "$node" ]; then
                case "$after" in
                    "") after_j="" ;;
                    off|none) after_j='"off"' ;;
                    *) after_j="$(_compute_secs "$after")" ;;
                esac
            fi
            local to_val=""
            [ "$have_to" = "1" ] && to_val="${to:-none}"
            _compute_call POST /cli/compute/nodes/alerts "$(_compute_json K2_CJ_node="$node" K2_CJ_after_j="$after_j" K2_CJ_to="$to_val")" tcp
            printf '%s' "$_CP_BODY" | python3 -c 'import json,sys
v=json.load(sys.stdin)
if "alertsTo" in v: print("alerts go to: %s" % (v["alertsTo"] or "nobody (unset)"))
if "node" in v:
    a=v.get("alertAfterSecs")
    print("%s: %s" % (v["node"], ("offline alert after %dm" % (a // 60)) if a else "no offline alert"))'
            ;;
        *)
            echo "usage: k2 compute node add|confirm|remove|rename|pause|drain|resume|route|health|policy|update|rollback|alerts|admin …" >&2
            exit 2
            ;;
    esac
}

# key=value… → a JSON object. Values parse as JSON when they can (numbers,
# true/false, [lists]); a,b,c for names/labels becomes a list; else string.
_compute_kv_json() {
    python3 -c '
import json, sys
out = {}
for a in sys.argv[1:]:
    k, _, v = a.partition("=")
    k = k.strip()
    if not k:
        print("usage: key=value", file=sys.stderr); sys.exit(2)
    try:
        val = json.loads(v)
    except Exception:
        val = v
    if k in ("names", "labels") and isinstance(val, str):
        val = [x for x in val.split(",") if x]
    out[k] = val
print(json.dumps(out))' "$@"
}

_compute_render_health() {
    printf '%s' "$_CP_BODY" | python3 -c '
import json, sys, time
v = json.load(sys.stdin)
f = v.get("facts") or {}
def gb(b): return "%d GB" % (b // (1 << 30)) if isinstance(b, int) else "?"
seen = v.get("lastSeen")
print("%s  %s%s" % (v["node"], "online" if v["online"] else "OFFLINE", "" if v["online"] or not seen else " since " + time.strftime("%H:%M", time.localtime(seen))))
print("  k2-node %s, remote admin %s, pending approvals %s" % (v.get("nodeVersion") or "?", v.get("remoteAdmin") or "unknown", v.get("pendingApprovals", 0)))
if v.get("needsPin"):
    print("  NEEDS ONE-TIME PIN: admin commands are refused until someone runs, at that machine:")
    print("      %s" % (v.get("pinCommand") or "sudo k2-node admin pin"))
if not f:
    print("  no health report yet (needs a k2-node with health)")
else:
    if f.get("uptime_secs") is not None: print("  uptime        %dd %dh" % (f["uptime_secs"] // 86400, f["uptime_secs"] % 86400 // 3600))
    for d in f.get("disks") or []: print("  disk %-8s %s free of %s" % (d.get("path") or d.get("name"), gb(d["free_bytes"]), gb(d["total_bytes"])))
    if f.get("mem_total_bytes"): print("  memory        %s available of %s, pressure %s" % (gb(f.get("mem_available_bytes")), gb(f["mem_total_bytes"]), f.get("memory_pressure") or "?"))
    if f.get("disk_encryption"): print("  FileVault     %s%s" % (f["disk_encryption"], " (a power cut needs someone at the machine)" if f["disk_encryption"] == "on" else ""))
    ar = (f.get("sleep") or {}).get("autorestart")
    if ar is not None: print("  autorestart   %s" % ("on" if ar == 1 else "off"))
    up = f.get("updates") or {}
    if up.get("pending") is not None: print("  updates       %s pending (%s security)" % (up["pending"], up.get("security") or 0))
    if up.get("reboot_required"): print("  reboot        required")
    ex = f.get("executor") or {}
    if ex and not ex.get("reachable"): print("  executor      not answering")
    for s in f.get("stuck_jobs") or []: print("  stuck job     %s (quiet %dm)" % (s["job_id"][:8], s.get("quiet_secs", 0) // 60))
u = v.get("update")
if u: print("  update        %s %s%s" % (u.get("state"), u.get("version") or "", (" (" + u["reason"] + ")") if u.get("reason") else ""))
a = v.get("alertAfterSecs")
print("  alerts        %s, to %s" % (("offline after %dm" % (a // 60)) if a else "no offline alert", v.get("alertsTo") or "nobody (k2 compute node alerts --to <ws>)"))'
}

# A held request: the owner (outside K2) confirms right away; anyone else
# gets the request id and exit 2.
_compute_admin_held_or_approve() {
    local id
    id="$(printf '%s' "$_CP_BODY" | python3 -c 'import json,sys; print(json.load(sys.stdin)["request"]["id"])')"
    printf '%s' "$_CP_BODY" | python3 -c 'import json,sys
v=json.load(sys.stdin); r=v["request"]
print("held for the owner: %s\n  %s" % (r["id"], r["summary"]))' >&2
    if ! _compute_in_session && [ -t 0 ] && [ "${K2_NO_APPROVE:-}" != "1" ]; then
        _compute_admin_approve "$id"
        exit 0
    fi
    echo "  the owner approves it in Settings → Compute → Approvals (or: k2 compute node admin approve $id, outside K2)" >&2
    exit 2
}

# Owner confirm (Touch ID / login or vault password) bound to the request,
# then approve. Never works for an agent: the daemon refuses passports, and
# the confirm needs a person.
_compute_admin_approve() {
    local id="$1"
    if _compute_in_session; then
        echo '{"error":"owner_only","hint":"approve in Settings → Compute → Approvals, or from a terminal outside K2. An agent can never approve."}' >&2
        exit 3
    fi
    _compute_call GET /cli/compute/admin/requests "state=all&limit=500" tcp
    local found full label
    found="$(printf '%s' "$_CP_BODY" | python3 -c '
import json, sys
want = sys.argv[1]
rows = [r for r in json.load(sys.stdin)["requests"] if r["id"] == want or r["id"].startswith(want)]
if len(rows) != 1:
    sys.exit(1)
r = rows[0]
print(r["id"]); print(r["state"]); print(r["summary"][:64])
print("---"); print(r["summary"])
if r.get("reason"): print("reason: " + r["reason"])
for s in (r.get("body") or {}).get("steps") or [r.get("body") or {}]:
    if s.get("verb") == "script":
        print("--- script (%s) ---" % (s.get("args") or {}).get("interpreter", "/bin/sh"))
        print((s.get("args") or {}).get("text", ""))
'  "$id")" || { echo "{\"error\":\"request_not_found\",\"hint\":\"no single request matches '$id' (k2 compute node admin list)\"}" >&2; exit 3; }
    local state
    full="$(printf '%s\n' "$found" | sed -n 1p)"
    state="$(printf '%s\n' "$found" | sed -n 2p)"
    label="$(printf '%s\n' "$found" | sed -n 3p)"
    if [ "$state" != "pending" ]; then
        echo "{\"error\":\"not_pending\",\"hint\":\"$full is $state\"}" >&2
        exit 3
    fi
    printf '%s\n' "$found" | sed -n '5,$p' >&2
    local tok
    tok="$(_vault_confirm_token node-admin "$full" "$label")" || exit 3
    _compute_call POST /cli/compute/admin/approve "$(_compute_json K2_CJ_request="$full" K2_CJ_confirmToken="$tok")" tcp
    tok=""
    printf '%s' "$_CP_BODY" | python3 -c 'import json,sys
v=json.load(sys.stdin); r=v["request"]
print("approved %s: %s\n  %s" % (r["id"], r["summary"], v.get("note","")))'
}

cmd_compute_node_admin() {
    local sub="${1:-}"
    case "$sub" in
        propose|list|ls|approve|deny|withdraw) shift ;;
        ""|help|--help|-h) _compute_usage; return 0 ;;
        *) sub="propose" ;;  # PRD shape: k2 compute node admin <node> <verb> …
    esac
    case "$sub" in
        propose)
            local node="" verb="" reason="" file="" interp="" timeout="" plan="" pairs=()
            while [ $# -gt 0 ]; do
                case "$1" in
                    --reason) reason="${2:-}"; shift 2 ;;
                    --file) file="${2:-}"; shift 2 ;;
                    --interpreter) interp="${2:-}"; shift 2 ;;
                    --timeout) timeout="$(_compute_secs "${2:-}")"; shift 2 ;;
                    --plan) plan="${2:-}"; shift 2 ;;
                    *=*) pairs+=("$1"); shift ;;
                    *)
                        if [ -z "$node" ]; then node="$1"
                        elif [ -z "$verb" ]; then verb="$1"
                        else echo "usage: k2 compute node admin propose <node> <verb> [key=value…]" >&2; exit 2
                        fi
                        shift ;;
                esac
            done
            [ -n "$node" ] && { [ -n "$verb" ] || [ -n "$plan" ]; } || { echo "usage: k2 compute node admin propose <node> <verb> [key=value…] --reason \"…\" (or --plan plan.json)" >&2; exit 2; }
            local body
            if [ -n "$plan" ]; then
                [ -f "$plan" ] || { echo "usage: --plan needs a JSON file: {\"steps\": [{\"verb\": …, \"args\": {…}}]}" >&2; exit 2; }
                body="$(python3 -c '
import json, sys
p = json.load(open(sys.argv[1]))
steps = p["steps"] if isinstance(p, dict) else p
print(json.dumps({"node": sys.argv[2], "kind": "plan", "steps": steps, "reason": sys.argv[3] or None}))' "$plan" "$node" "$reason")" || exit 2
            else
                local args_json
                args_json="$(_compute_kv_json ${pairs[@]+"${pairs[@]}"})" || exit 2
                if [ "$verb" = "script" ]; then
                    [ -n "$file" ] && [ -f "$file" ] || { echo "usage: k2 compute node admin propose <node> script --file fix.sh --reason …" >&2; exit 2; }
                    args_json="$(python3 -c '
import json, sys
a = json.loads(sys.argv[1]); a["text"] = open(sys.argv[2]).read()
if sys.argv[3]: a["interpreter"] = sys.argv[3]
if sys.argv[4]: a["timeout_secs"] = int(sys.argv[4])
print(json.dumps(a))' "$args_json" "$file" "$interp" "$timeout")" || exit 2
                fi
                local kind=command
                case "$verb" in svc.*) kind=service ;; esac
                body="$(_compute_json K2_CJ_node="$node" K2_CJ_kind="$kind" K2_CJ_verb="$verb" K2_CJ_args_j="$args_json" K2_CJ_reason="$reason")"
            fi
            _compute_call POST /cli/compute/admin/propose "$body"
            _compute_admin_held_or_approve
            ;;
        list|ls)
            local q="" as_json=0
            while [ $# -gt 0 ]; do
                case "$1" in
                    --node) q="$q&node=$(urlencode "${2:-}")"; shift 2 ;;
                    --state) q="$q&state=$(urlencode "${2:-}")"; shift 2 ;;
                    --limit) q="$q&limit=$(urlencode "${2:-}")"; shift 2 ;;
                    --json) as_json=1; shift ;;
                    *) echo "usage: k2 compute node admin list [--node N] [--state open|pending|all]" >&2; exit 2 ;;
                esac
            done
            _compute_call GET /cli/compute/admin/requests "${q#&}"
            [ "$as_json" = "1" ] && { printf '%s\n' "$_CP_BODY"; exit 0; }
            printf '%s' "$_CP_BODY" | python3 -c 'import json,sys,time
v=json.load(sys.stdin)
rows=v["requests"]
if not rows: print("no admin requests")
for r in rows:
    print("%-36s %-9s %-10s %s" % (r["id"], r["state"], r.get("node") or "?", r["summary"]))
    if r.get("reason"): print("%36s reason: %s" % ("", r["reason"]))
    if r.get("denyReason"): print("%36s denied: %s" % ("", r["denyReason"]))'
            ;;
        approve)
            [ -n "${1:-}" ] || { echo "usage: k2 compute node admin approve <id>" >&2; exit 2; }
            _compute_admin_approve "$1"
            ;;
        deny)
            local id="" why=""
            while [ $# -gt 0 ]; do
                case "$1" in
                    --why) why="${2:-}"; shift 2 ;;
                    *) id="$1"; shift ;;
                esac
            done
            [ -n "$id" ] || { echo "usage: k2 compute node admin deny <id> [--why …]" >&2; exit 2; }
            _compute_call POST /cli/compute/admin/deny "$(_compute_json K2_CJ_request="$id" K2_CJ_why="$why")" tcp
            printf '%s' "$_CP_BODY" | python3 -c 'import json,sys; r=json.load(sys.stdin)["request"]; print("denied %s: %s" % (r["id"], r["summary"]))'
            ;;
        withdraw)
            [ -n "${1:-}" ] || { echo "usage: k2 compute node admin withdraw <id>" >&2; exit 2; }
            _compute_call POST /cli/compute/admin/withdraw "$(_compute_json K2_CJ_request="$1")"
            printf '%s' "$_CP_BODY" | python3 -c 'import json,sys; r=json.load(sys.stdin)["request"]; print("withdrew %s" % r["id"])'
            ;;
    esac
}

cmd_compute_grant() {
    local node="" workspace="" maxt="" maxd="" maxp="" maxq=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --workspace) workspace="${2:-}"; shift 2 ;;
            --max-time) maxt="$(_compute_secs "${2:-}")"; shift 2 ;;
            --max-disk) maxd="${2:-}"; maxd="${maxd%[Gg]}"; shift 2 ;;
            --max-parallel) maxp="${2:-}"; shift 2 ;;
            --max-queued) maxq="${2:-}"; shift 2 ;;
            -*) echo "usage: unknown flag '$1'" >&2; exit 2 ;;
            *) node="$1"; shift ;;
        esac
    done
    [ -n "$node" ] && [ -n "$workspace" ] || { echo "usage: k2 compute grant <node> --workspace WS [--max-time 2h] [--max-disk 60G] [--max-parallel 1] [--max-queued 10]" >&2; exit 2; }
    local body
    body="$(_compute_json K2_CJ_node="$node" K2_CJ_workspace="$workspace" K2_CJ_maxJobSecs_n="$maxt" \
        K2_CJ_maxDiskGb_n="$maxd" K2_CJ_maxParallel_n="$maxp" K2_CJ_maxQueued_n="$maxq")"
    _compute_call POST /cli/compute/grants/set "$body" tcp
    printf '%s' "$_CP_BODY" | python3 -c 'import json,sys; v=json.load(sys.stdin); g=v["grant"]; print("granted %s to %s (max %ss/job, %s parallel, %s queued, %s GB disk). %s" % (v["node"], v["workspace"], g["maxJobSecs"], g["maxParallel"], g["maxQueued"], g["maxDiskGb"], v["note"]))'
}

