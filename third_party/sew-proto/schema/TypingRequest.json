{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Op 10 TYPING.",
  "properties": {
    "channel_id": {
      "description": "The channel.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "thread_id": {
      "description": "The thread, when typing a reply.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "channel_id"
  ],
  "title": "TypingRequest",
  "type": "object"
}
