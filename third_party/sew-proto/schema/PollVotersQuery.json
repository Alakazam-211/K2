{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Query of `GET /api/v1/messages/{id}/poll/voters`.",
  "properties": {
    "after": {
      "description": "Voters after this member id (ascending).",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": [
        "string",
        "null"
      ]
    },
    "limit": {
      "description": "Page size, 1–100 (default 50).",
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "option_id": {
      "description": "The option.",
      "format": "uint8",
      "maximum": 255,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "option_id"
  ],
  "title": "PollVotersQuery",
  "type": "object"
}
