        ""|guide|help|--help|-h) _skip_conn_gate=1 ;;
        widget|widgets)
            case "${3:-}" in grant|allow|revoke|""|help) _skip_conn_gate=1 ;; esac
            for _a in "${@:2}"; do
                case "$_a" in -h|--help) _skip_conn_gate=1 ;; esac
            done
            ;;
        *)
            for _a in "${@:2}"; do
                case "$_a" in -h|--help) _skip_conn_gate=1 ;; esac
            done
