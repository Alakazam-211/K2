# 30s / 5m / 2h / 1d / bare seconds → seconds.
_sources_b2_secs() {
    local v="$1"
    case "$v" in
        *d) echo $(( ${v%d} * 86400 )) ;;
        *h) echo $(( ${v%h} * 3600 )) ;;
        *m) echo $(( ${v%m} * 60 )) ;;
        *s) echo "${v%s}" ;;
        ''|*[!0-9]*) echo "usage: bad duration '$v' (use 30s, 5m, 2h, 1d)" >&2; exit 2 ;;
        *) echo "$v" ;;
    esac
}

# A query string from k=v pairs (values url-encoded; empty values dropped).
