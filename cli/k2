cmd_terminal_spawn() {
    local agent="" command="" title="" wait="" cwd="" sandbox=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --title) title="$2"; shift 2 ;;
            --command) command="$2"; shift 2 ;;
            --agent) agent="$2"; shift 2 ;;
            --cwd) cwd="$2"; shift 2 ;;
