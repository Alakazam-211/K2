  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response of `GET /mgmt/v1/status`.",
  "properties": {
    "alarms": {
      "default": [],
      "description": "Every active alarm, sorted (S9, additive). K2 shows them verbatim.",
      "items": {
        "$ref": "#/$defs/StatusAlarm"
      },
      "type": "array"
    },
    "backup": {
      "anyOf": [
        {
          "$ref": "#/$defs/StatusBackup"
        },
        {
          "type": "null"
        }
      ],
      "description": "Backups (contracts rev 21; S6 fills it)."
    },
    "client_listen": {
      "description": "The client listener as `http://<bound address>` (contracts rev 21, additive).",
      "type": [
        "string",
        "null"
      ]
    },
    "db": {
      "$ref": "#/$defs/StatusDb",
      "description": "Database status."
    },
    "digest": {
      "anyOf": [
        {
          "$ref": "#/$defs/StatusDigest"
        },
        {
          "type": "null"
        }
      ],
      "description": "The email digest (S21 §12.6, additive)."
    },
    "drill": {
      "anyOf": [
        {
          "$ref": "#/$defs/StatusDrill"
        },
        {
          "type": "null"
        }
      ],
      "description": "Restore drills (contracts rev 21; S6 fills it)."
    },
    "exports": {
      "anyOf": [
        {
          "$ref": "#/$defs/StatusExports"
        },
        {
          "type": "null"
        }
      ],
      "description": "Exports running, queued and on disk (S23 §16, additive)."
    },
    "files": {
      "anyOf": [
        {
          "$ref": "#/$defs/StatusFiles"
        },
        {
          "type": "null"
        }
      ],
      "description": "Files (S15 G21, additive)."
    },
    "identity": {
      "anyOf": [
        {
          "$ref": "#/$defs/StatusIdentity"
        },
        {
          "type": "null"
        }
      ],
      "description": "The identity provider's state (contracts rev 21, additive)."
    },
    "install_id": {
      "description": "The install id (gap G20).",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "jobs": {
      "$ref": "#/$defs/StatusJobs",
      "description": "Job queue status."
    },
    "keys": {
      "$ref": "#/$defs/StatusKeys",
      "description": "Key status."
    },
    "mail": {
      "anyOf": [
        {
          "$ref": "#/$defs/StatusMail"
        },
        {
          "type": "null"
        }
      ],
      "description": "Outgoing mail (S21 §12.6, additive)."
    },
    "provider": {
      "$ref": "#/$defs/ProviderKind",
      "description": "The identity provider."
    },
    "recording": {
      "anyOf": [
        {
          "$ref": "#/$defs/StatusRecording"
        },
        {
          "type": "null"
        }
      ],
      "description": "Recording and transcription (S35 v2 §22.3, additive). Absent while recording is off."
    },
    "retention": {
      "anyOf": [
        {
          "$ref": "#/$defs/StatusRetention"
        },
        {
          "type": "null"
        }
      ],
      "description": "Retention runs, pending policies, holds and shred candidates (S22 §18, additive)."
    },
    "schema_version": {
      "description": "The applied schema version.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "search": {
      "$ref": "#/$defs/StatusSearch",
      "description": "Search status."
    },
    "sessions": {
      "description": "Live login sessions.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "sockets": {
      "description": "Open gateway sockets.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "started_at": {
      "description": "When this process started (S9, additive).",
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "uptime_ms": {
      "default": 0,
      "description": "Time since this process started (S9, additive).",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "version": {
      "description": "The Sew version.",
      "type": "string"
    },
    "voice": {
      "anyOf": [
        {
          "$ref": "#/$defs/VoiceStatus"
