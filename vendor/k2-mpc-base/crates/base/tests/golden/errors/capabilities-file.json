{
  "kit": "k2-mpc-base",
  "version": "0.11.0",
  "error_ids": {
    "kit": "MPC-E",
    "engine": "MPCE-E",
    "explain": "explain <ID> [--json]",
    "json_shape": ["id", "exit", "message", "next", "next_step", "rule", "details"]
  },
  "exit_codes": [
    {
      "code": 0,
      "name": "ok",
      "meaning": "success (diff, grep: no difference, a match)"
    },
    {
      "code": 1,
      "name": "no",
      "meaning": "the tool's own no: grep found nothing, diff found differences, a conflict, a patch that didn't apply; nothing applied unless the message says otherwise"
    },
    {
      "code": 2,
      "name": "usage_or_held",
      "meaning": "bad usage or an unsupported flag (fix the command), or held for now (MPC-E130: don't retry in a loop)"
    },
    {
      "code": 3,
      "name": "refused",
      "meaning": "the caller lacks a right; don't retry"
    },
    {
      "code": 4,
      "name": "not_found",
      "meaning": "no such doc, version, change or claim; or live editing is off"
    },
    {
      "code": 5,
      "name": "leased",
      "meaning": "someone else holds it for now (a lease or a claim); retry after the time left"
    },
    {
      "code": 6,
      "name": "store_unavailable",
      "meaning": "the store failed; nothing acknowledged"
    },
    {
      "code": 7,
      "name": "link_lost",
      "meaning": "the link dropped mid-verb (the host's)"
    },
    {
      "code": 8,
      "name": "too_old",
      "meaning": "too old (revert, an expired base); never retry the same request"
    }
  ],
