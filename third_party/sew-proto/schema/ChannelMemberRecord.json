{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`channel_members.ndjson`.",
  "properties": {
    "added_by": {
      "description": "Who added them.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": [
        "string",
        "null"
      ]
    },
    "channel_id": {
      "description": "The channel.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "joined_at": {
      "description": "Joined.",
      "format": "date-time",
      "type": "string"
    },
    "member_id": {
      "description": "The member.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    }
  },
  "required": [
    "channel_id",
    "member_id",
    "joined_at"
  ],
  "title": "ChannelMemberRecord",
  "type": "object"
}
