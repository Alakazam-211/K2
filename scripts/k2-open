#!/bin/sh
# k2-open — K2 browser-open shim (staged by the K2 daemon; do not edit).
# K2_OPEN_SHIM_VERSION: 5
#
# 0.40.34 (Rosson): when a process inside a K2 terminal session runs
# `xdg-open <url>` / honors $BROWSER, the URL must surface in the
# CONNECTED K2 app as an event (the app opens it in a browser tab)
# instead of launching a browser on the daemon's machine — which on a
# headless server does nothing at all.
#
# Contract (xdg-open/open CLI shape): exactly one URL argument in the
# typical case; `open -u <url>` is tolerated; other options are skipped
# loosely. If the args are unparseable or the target isn't http(s), we
# fall through to the REAL system opener when one exists (/usr/bin/open
# on macOS, the next xdg-open on PATH skipping ourselves), else exit 0
# silently.
#
# Auth order (mirrors notify.sh / the k2 CLI):
#   1. Scoped session (K2_HOOK_SOCK + K2_HOOK_TOKEN): POST the verb over
#      the per-cell unix socket with a Bearer header (the scoped token is
#      allowlisted for /cli/browser/open-url in the daemon's
#      require_hook capability gate).
#   2. Owner fallback: ~/.k2/heartbeat.{port,token} → loopback TCP with
#      the owner token as a Bearer header. In a session (K2_HOOK_SOCK or
#      K2_HOOK_TOKEN set), K2 doesn't act as the owner: this arm sends the
#      session's passport in the owner token's place, and with no
#      passport it sends nothing (one line, exit 1).
# Neither arm goes through a proxy (`--noproxy '*'`), and no credential
# rides the query string.
#
# Sent once (0.46.15): an arm hands on to the next one (the owner arm,
# then the system opener) only when K2 took none of the request: the
# connect failed (curl 7) or K2 answered with an error status (curl 22;
# its "not served on cell socket" 404 is one). Any other failure (a
# timeout, an empty or broken reply) may have reached K2, which may have
# opened the URL, so it is not sent again: one line on stderr, exit 1.
#
# The token is NEVER echoed or logged by this script, and never put on
# curl's argv (any OS user can read argv with `ps`): the header / URL that
# carries it goes to curl as a config on stdin (`curl -K -`), written by
# the printf builtin. Tokens hold no `"` or `\`, so no escaping.

# ── parse: find the URL argument ─────────────────────────────────────
url=""
want_u=0
for a in "$@"; do
    if [ "$want_u" = 1 ]; then
        url="$a"
        want_u=0
        continue
    fi
    case "$a" in
        -u) want_u=1 ;;          # `open -u <url>` (loose)
        -*) ;;                   # skip other options loosely
        *) [ -z "$url" ] && url="$a" ;;
    esac
done

is_http=0
case "$url" in
    http://*|https://*|HTTP://*|HTTPS://*) is_http=1 ;;
esac

# _sent_once RC: after an arm's curl. 0 ends the script; 7 or 22 (K2 took
# none of it) returns to try the next arm; any other code ends it with 1.
_sent_once() {
    case "$1" in
        0) exit 0 ;;
        7|22) return 0 ;;
    esac
    echo "k2-open: K2's server didn't answer /cli/browser/open-url; the URL may have been opened. Check before opening it again." >&2
    exit 1
}

if [ "$is_http" = 1 ] && command -v curl >/dev/null 2>&1; then
    # 1. Scoped-session channel: per-cell UDS + scoped hook token.
    _sock="${K2_HOOK_SOCK:-${K2SO_HOOK_SOCK:-}}"
    _hook_tok="${K2_HOOK_TOKEN:-${K2SO_HOOK_TOKEN:-}}"
    if [ -n "$_sock" ] && [ -n "$_hook_tok" ] && [ -S "$_sock" ]; then
        _rc=0
        printf 'header = "Authorization: Bearer %s"\n' "$_hook_tok" \
            | curl -fsS --noproxy '*' -K - --max-time 5 --unix-socket "$_sock" \
                --data-urlencode "url=$url" \
                "http://k2/cli/browser/open-url" >/dev/null 2>&1 || _rc=$?
        _sent_once "$_rc"
    fi
    # 2. Owner fallback: daemon loopback with the disk owner credentials.
    _k2_home="${HOME}/.k2"
    if [ -r "${_k2_home}/heartbeat.port" ] && [ -r "${_k2_home}/heartbeat.token" ]; then
        _port=$(cat "${_k2_home}/heartbeat.port" 2>/dev/null)
        _tok=$(cat "${_k2_home}/heartbeat.token" 2>/dev/null)
        if [ -n "$_port" ] && [ -n "$_tok" ]; then
            if [ -n "$_sock" ] || [ -n "$_hook_tok" ]; then
                if [ -z "$_hook_tok" ]; then
                    echo "Error: in a session, K2 doesn't act as the owner; this session has no passport, so nothing was sent." >&2
                    exit 1
                fi
                _tok="$_hook_tok"
            fi
            _rc=0
            printf 'url = "http://127.0.0.1:%s/cli/browser/open-url"\nheader = "Authorization: Bearer %s"\n' "$_port" "$_tok" \
                | curl -fsS --noproxy '*' -K - --max-time 5 \
                    --data-urlencode "url=$url" >/dev/null 2>&1 || _rc=$?
            _sent_once "$_rc"
        fi
    fi
fi

# ── fall through to the REAL system opener (never ourselves) ─────────
if [ -x /usr/bin/open ]; then
    exec /usr/bin/open "$@"
fi
# Next xdg-open on PATH, skipping anything in our own directory
# (~/.k2/bin stages a copy of this script under the name `xdg-open`
# on Linux, so a naive lookup would recurse).
self_dir=$(dirname "$0")
_saved_ifs="$IFS"
IFS=:
for d in $PATH; do
    IFS="$_saved_ifs"
    [ -n "$d" ] || continue
    [ "$d" = "$self_dir" ] && continue
    cand="$d/xdg-open"
    if [ -x "$cand" ] && [ "$cand" != "$0" ]; then
        exec "$cand" "$@"
    fi
done
IFS="$_saved_ifs"
# Headless box with no real opener: swallow silently (a broken no-op
# is worse than a quiet one — the K2 channel above is the real path).
exit 0
