{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Body of `POST /api/v1/compliance/holds/{id}/update`: additive only.",
  "properties": {
    "add_channels": {
      "description": "Channels to add.",
      "items": {
        "description": "A Sew id: a decimal string of a 64-bit time-sortable id (1 to 9223372036854775807).",
        "pattern": "^[1-9][0-9]{0,18}$",
        "type": "string"
      },
      "type": "array"
    },
    "add_members": {
      "description": "Members to add.",
      "items": {
        "description": "A Sew id: a decimal string of a 64-bit time-sortable id (1 to 9223372036854775807).",
        "pattern": "^[1-9][0-9]{0,18}$",
        "type": "string"
      },
      "type": "array"
    },
    "add_spaces": {
      "description": "Spaces to add.",
      "items": {
        "description": "A Sew id: a decimal string of a 64-bit time-sortable id (1 to 9223372036854775807).",
        "pattern": "^[1-9][0-9]{0,18}$",
        "type": "string"
      },
      "type": "array"
    },
    "from": {
      "description": "An earlier start, or `null` to open it.",
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "description": "A new name.",
      "type": [
        "string",
        "null"
      ]
    },
    "to": {
      "description": "A later end, or `null` to open it.",
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "title": "UpdateHoldRequest",
  "type": "object"
}
