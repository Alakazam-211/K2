{
  "$defs": {
    "OverwriteTarget": {
      "description": "What an overwrite targets.",
      "oneOf": [
        {
          "const": "role",
          "description": "A role (`@everyone`'s role id is the space id).",
          "type": "string"
        },
        {
          "const": "member",
          "description": "A single member.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Body of `POST /api/v1/channels/{id}/overwrites/delete` and the category route.",
  "properties": {
    "target_id": {
      "description": "The role or member.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "target_kind": {
      "$ref": "#/$defs/OverwriteTarget",
      "description": "Role or member."
    }
  },
  "required": [
    "target_kind",
    "target_id"
  ],
  "title": "OverwriteRef",
  "type": "object"
}
