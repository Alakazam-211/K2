{
  "name": "k2-mpc-client",
  "version": "0.10.0",
  "description": "Live text editing over the kit's hunk channel: a text replica, the kit's rebase rules, a CodeMirror 6 binding, and a mountable live editor.",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core.ts",
    "./editor": "./src/editor/index.ts"
  },
  "files": [
    "src",
    "WIRE.md",
    "EDITOR.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-markdown": "^6.2.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.27.0"
  },
  "peerDependenciesMeta": {
    "@codemirror/commands": {
      "optional": true
    },
    "@codemirror/lang-markdown": {
      "optional": true
    },
    "@codemirror/language": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codemirror/commands": "6.6.0",
    "@codemirror/lang-markdown": "6.2.5",
    "@codemirror/language": "6.10.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@playwright/test": "1.47.2",
    "@types/node": "22.5.4",
    "esbuild": "0.21.5",
    "jsdom": "24.1.1",
    "typescript": "5.5.4",
    "vitest": "2.0.5"
  },
  "scripts": {
    "test": "vitest run",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "licences": "node scripts/check-licences.mjs"
  }
}
