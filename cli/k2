_rs_apply_target() {
    local host="${1:-}" token="${2:-}"
    if [ -n "$host" ]; then
        _apply_remote_host "$host" "$token" || return 1
        return 0
    fi
    if [ -n "$token" ]; then
        TOKEN="$token"
    fi
    return 0
}

