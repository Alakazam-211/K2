{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Why a member left voice (S33 v2 §10.4). Sent only to the member themself. Codes are\nstable for metrics and logs.",
  "oneOf": [
    {
      "const": "left",
      "description": "The member left.",
      "type": "string"
    },
    {
      "const": "disconnected",
      "description": "The media connection ended for good.",
      "type": "string"
    },
    {
      "const": "replaced",
      "description": "Another device took over (swap).",
      "type": "string"
    },
    {
      "const": "moved",
      "description": "Moved (or switched) to another channel.",
      "type": "string"
    },
    {
      "const": "removed_by_moderator",
      "description": "A moderator disconnected the member.",
      "type": "string"
    },
    {
      "const": "perms_lost",
      "description": "CONNECT or VIEW was lost.",
      "type": "string"
    },
    {
      "const": "channel_archived",
      "description": "The channel was archived.",
      "type": "string"
    },
    {
      "const": "removed_from_space",
      "description": "The member left or was removed from the space.",
      "type": "string"
    },
    {
      "const": "timed_out",
      "description": "The member was timed out.",
      "type": "string"
    },
    {
      "const": "account_removed",
      "description": "The account was deprovisioned.",
      "type": "string"
    },
    {
      "const": "session_revoked",
      "description": "The login session was revoked.",
      "type": "string"
    },
    {
      "const": "device_revoked",
      "description": "The device was revoked (S50 §10.4).",
      "type": "string"
    },
    {
      "const": "orphaned",
      "description": "The media outlived every socket.",
      "type": "string"
    },
    {
      "const": "alone_timeout",
      "description": "Alone in the channel too long.",
      "type": "string"
    },
    {
      "const": "connect_timeout",
      "description": "Media never connected.",
      "type": "string"
    },
    {
      "const": "media_restarted",
      "description": "The engine restarted or was down and the media did not come back.",
      "type": "string"
    },
    {
      "const": "voice_disabled",
      "description": "Voice was turned off.",
      "type": "string"
    },
    {
      "const": "e2ee_sender_index_stuck",
      "description": "The sender stayed on a stale key slot (S50 §12.10; rev 78 D4, rev 85 D3).",
      "type": "string"
    },
    {
      "const": "call_ended",
      "description": "The DM call ended (S34 v2 §14.5).",
      "type": "string"
    },
    {
      "const": "media_unused",
      "description": "Self-only (no leave): a camera or screen lease was released unused (S34 v2 §10.2).",
      "type": "string"
    },
    {
      "const": "media_revoked",
      "description": "Self-only (no leave): a camera or screen lease was revoked (S34 v2 §10.4).",
      "type": "string"
    },
    {
      "const": "unresponsive",
      "description": "The device stopped answering key requests (S50 unresponsive removal, F16 #29).",
      "type": "string"
    },
    {
      "const": "e2ee_unsupported_client",
      "description": "The engine refused the device's client (an SDK that cannot switch the sender key index,\nrev 73) after Sew admitted it; the join is dropped at once (F16, #24).",
      "type": "string"
    },
    {
      "const": "recording_declined",
      "description": "Declined the recording notice while declining means not joining (S35 v2 §9.11).",
      "type": "string"
    },
    {
      "const": "recording_withdrawn",
      "description": "Withdrew recording consent while declining means not joining (S35 v2 §9.11).",
      "type": "string"
    },
    {
      "const": "recording_consent_timeout",
      "description": "Left the recording notice unanswered too long while declining means not joining\n(S35 v2 §9.11).",
      "type": "string"
    }
  ],
  "title": "VoiceLeaveReason"
}
