{
  "$schema": "../style.schema.json#/$defs/tokens",
  "radius": {
    "box": { "$value": "12px", "$type": "dimension" },
    "field": { "$value": "8px", "$type": "dimension" },
    "selector": { "$value": "6px", "$type": "dimension" }
  },
  "gap": {
    "pane": { "$value": "8px", "$type": "dimension", "$description": "Rings render OUTSIDE the element — gaps must clear the 4px outer ring." },
    "tile": { "$value": "8px", "$type": "dimension" },
    "section": { "$value": "10px", "$type": "dimension" }
  },
  "inset": {
    "window": { "$value": "10px", "$type": "dimension" }
  },
  "divider": {
    "width": { "$value": "16px", "$type": "dimension", "$description": "2 × gap.tile — fills the seam so drag still works." },
    "color": { "$value": "transparent", "$type": "color" }
  },
  "ring": {
    "surface": { "$value": "0 -1px 0 0 rgba(255, 255, 255, 0.06), 0 0 0 1px rgba(255, 255, 255, 0.08), 0 2px 4px rgba(0, 0, 0, 0.32), 0 0 0 3px var(--color-bg-canvas), 0 0 0 4px rgba(255, 255, 255, 0.08)", "$type": "shadow", "$description": "The signature: inner hairline → drop → gap painted in canvas → outer hairline (zite's dark inversion)." },
    "field": { "$value": "inset 0 1px 0 rgba(255, 255, 255, 0.10), inset 0 -2px 0 rgba(0, 0, 0, 0.22), 0 0 0 1px rgba(0, 0, 0, 0.45)", "$type": "shadow", "$description": "Tactile keycap: top glow, bottom shade, dark outline." },
    "focus": { "$value": "0 0 0 1px var(--color-bg-canvas), 0 0 0 3px var(--color-accent)", "$type": "shadow", "$description": "Offset focus ring — the accent sits outside a canvas-colored gap." }
  },
  "shadow": {
    "1": { "$value": "0 1px 1px -0.5px rgba(0, 0, 0, 0.25)", "$type": "shadow" },
    "2": { "$value": "0 3px 3px -1.5px rgba(0, 0, 0, 0.22), 0 1px 1px -0.5px rgba(0, 0, 0, 0.25)", "$type": "shadow" },
    "3": { "$value": "0 6px 6px -3px rgba(0, 0, 0, 0.22), 0 3px 3px -1.5px rgba(0, 0, 0, 0.22), 0 1px 1px -0.5px rgba(0, 0, 0, 0.25)", "$type": "shadow", "$description": "zite's geometric halving ramp, dark-adapted." },
    "4": { "$value": "0 12px 12px -6px rgba(0, 0, 0, 0.22), 0 6px 6px -3px rgba(0, 0, 0, 0.22), 0 3px 3px -1.5px rgba(0, 0, 0, 0.22), 0 1px 1px -0.5px rgba(0, 0, 0, 0.25)", "$type": "shadow" },
    "5": { "$value": "0 24px 24px -12px rgba(0, 0, 0, 0.28), 0 12px 12px -6px rgba(0, 0, 0, 0.22), 0 6px 6px -3px rgba(0, 0, 0, 0.22), 0 3px 3px -1.5px rgba(0, 0, 0, 0.25)", "$type": "shadow" }
  },
  "material": {
    "blur": { "$value": "0px", "$type": "dimension" },
    "saturate": { "$value": "100%", "$type": "dimension" },
    "tint": { "$value": "transparent", "$type": "color" },
    "tint-opacity": { "$value": 0, "$type": "number" }
  },
  "density": {
    "scale": { "$value": 1, "$type": "number" }
  },
  "motion": {
    "duration-fast": { "$value": "120ms", "$type": "duration" },
    "duration-medium": { "$value": "150ms", "$type": "duration" },
    "duration-slow": { "$value": "280ms", "$type": "duration" },
    "ease-standard": { "$value": "ease-out", "$type": "cubicBezier" }
  },
  "font": {
    "ui": { "$value": "'MesloLGM Nerd Font', Menlo, Monaco, 'Cascadia Code', 'Fira Code', 'SF Mono', Consolas, monospace, 'Apple Color Emoji', 'Segoe UI Emoji'", "$type": "fontFamily" },
    "display": { "$value": "'MesloLGM Nerd Font', Menlo, Monaco, 'Cascadia Code', 'Fira Code', 'SF Mono', Consolas, monospace, 'Apple Color Emoji', 'Segoe UI Emoji'", "$type": "fontFamily" }
  }
}
