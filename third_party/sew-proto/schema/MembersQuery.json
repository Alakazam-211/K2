{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Query of `GET /api/v1/members`: exactly one of `ids`, `username`.",
  "properties": {
    "ids": {
      "description": "1–100 member ids.",
      "pattern": "^[1-9][0-9]{0,18}(,[1-9][0-9]{0,18}){0,99}$",
      "type": [
        "string",
        "null"
      ]
    },
    "username": {
      "description": "One handle.",
      "pattern": "^[a-z0-9_-]{2,64}$",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "title": "MembersQuery",
  "type": "object"
}
