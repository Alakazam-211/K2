                         [--keep-daily N] [--keep-weekly N]           (7 / 4)
                         [--offsite-keep-daily N] [--offsite-keep-weekly N]
                         [--offsite-keep-monthly N]                (7 / 4 / 6)
                         [--window HH:MM-HH:MM]          (03:30-04:30 box time)
                         [--max-local-gb G]
