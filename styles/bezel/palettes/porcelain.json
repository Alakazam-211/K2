{
  "$schema": "../../style.schema.json#/$defs/palette",
  "id": "porcelain",
  "name": "Porcelain",
  "schemes": ["light"],
  "color": {
    "bg": { "$value": "#f7f6f2", "$type": "color", "$description": "Opaque terminal ground — warm porcelain white." },
    "bg-surface": { "$value": "#ffffff", "$type": "color", "$description": "White cards — the original zite look." },
    "bg-elevated": { "$value": "#f1efe9", "$type": "color" },
    "bg-inset": { "$value": "#f3f1eb", "$type": "color" },
    "bg-stripe": { "$value": "#f7f5f0", "$type": "color" },
    "bg-canvas": { "$value": "#edeae3", "$type": "color", "$description": "Darker than cards so the white gap ring pops." },
    "bg-hover": { "$value": "#f1efe9", "$type": "color" },
    "border": { "$value": "rgba(28, 26, 20, 0.08)", "$type": "color", "$description": "Quiet — rings do the definition work in this style." },
    "border-strong": { "$value": "rgba(28, 26, 20, 0.26)", "$type": "color" },
    "control-edge": { "$value": "#837f76", "$type": "color" },
    "control-hover": { "$value": "var(--color-border)", "$type": "color", "$description": "Hover fill of the default Button (an elevated chip at rest). Glass keeps the border step; its tile buttons hover by the Glass rules in globals." },
    "control-hover-quiet": { "$value": "var(--color-bg-elevated)", "$type": "color", "$description": "Hover fill of the quiet Button (clear at rest, so the card or page shows). Glass hovers its tile buttons by the Glass rules in globals; this is the fallback." },
    "divider": { "$value": "#b2b0aa", "$type": "color", "$description": "Short dividers between items in a row: tab-strip tabs, top-bar groups. Between border and control-edge, about 2:1 on the tab strip and the top bar capsule." },
    "text-primary": { "$value": "#1c1b18", "$type": "color", "$description": "Warm ink." },
    "text-secondary": { "$value": "#57544c", "$type": "color" },
    "text-muted": { "$value": "#8d897e", "$type": "color" },
    "accent": { "$value": "#e6b400", "$type": "color", "$description": "Gold fills — the zite tribute, daylight cut." },
    "accent-hover": { "$value": "#c79c00", "$type": "color" },
    "accent-soft": { "$value": "#8a6d00", "$type": "color", "$description": "Accent-toned TEXT on light must be dark." },
    "on-accent": { "$value": "#1a1400", "$type": "color", "$description": "Ink on gold — white fails contrast on gold." },
    "on-danger": { "$value": "#ffffff", "$type": "color", "$description": "The label on a danger fill (danger, danger-active, danger-muted): 4.5:1 on each." },
    "on-warn": { "$value": "#000000", "$type": "color", "$description": "The ink on a warning or needs-you fill (the Tickets count): 4.5:1 on status-needs-you." },
    "status-working": { "$value": "#2f6fe0", "$type": "color" },
    "status-error": { "$value": "#b3261e", "$type": "color" },
    "status-ok": { "$value": "#276b3d", "$type": "color" },
    "status-warn": { "$value": "#9a6a08", "$type": "color" },
    "status-ok-soft": { "$value": "#2f8a4e", "$type": "color" },
    "status-warn-soft": { "$value": "#a87908", "$type": "color" },
    "status-error-soft": { "$value": "#a12b24", "$type": "color" },
    "status-error-bright": { "$value": "#8c211b", "$type": "color", "$description": "'Bright' inverts to darkest on light — it's the emphasis step." },
    "status-error-text": { "$value": "#a12b24", "$type": "color" },
    "status-working-soft": { "$value": "#c76a2e", "$type": "color" },
    "status-warn-text": { "$value": "#8a6206", "$type": "color" },
    "status-needs-you": { "$value": "#c2620a", "$type": "color" },
    "status-warn-amber": { "$value": "#935f04", "$type": "color" },
    "status-warn-amber-soft": { "$value": "#7d5203", "$type": "color" },
    "status-warn-amber-bright": { "$value": "#6b4603", "$type": "color" },
    "status-ok-hover": { "$value": "#1f5731", "$type": "color" },
    "danger": { "$value": "#b3261e", "$type": "color" },
    "danger-active": { "$value": "#8e1d17", "$type": "color" },
    "danger-muted": { "$value": "#a03029", "$type": "color" },
    "danger-hover": { "$value": "#b3261e", "$type": "color" },
    "neutral": { "$value": "#857c6b", "$type": "color" },
    "control-track-off": { "$value": "#ddd8cc", "$type": "color" },
    "wash-1": { "$value": "rgba(30, 26, 16, 0.04)", "$type": "color" },
    "wash-2": { "$value": "rgba(30, 26, 16, 0.08)", "$type": "color" },
    "wash-3": { "$value": "rgba(30, 26, 16, 0.16)", "$type": "color" },
    "row-hover": { "$value": "rgba(30, 26, 16, 0.11)", "$type": "color", "$description": "Hover band on a list row (Settings lists): about 1.3:1 against the resting row on dark palettes, 1.2:1 or more on light ones. On it the row's muted text steps up to text-secondary (SETTING_LIST_ROW_HOVER), which reads at 4.5:1." },
    "scrim": { "$value": "rgba(30, 25, 12, 0.40)", "$type": "color" },
    "media-label-bg": { "$value": "rgba(0, 0, 0, 0.62)", "$type": "color", "$description": "Behind a name or time drawn on video (any picture, either scheme)." },
    "media-label-text": { "$value": "#ffffff", "$type": "color" },
    "diff-add-text": { "$value": "#4a6b12", "$type": "color" },
    "diff-remove-text": { "$value": "#9c2c24", "$type": "color" },
    "diff-modified-border": { "$value": "#3f9e63", "$type": "color" },
    "code-inline": { "$value": "#8a4f0e", "$type": "color" },
    "overlay-soft-bg": { "$value": "rgba(30, 26, 16, 0.05)", "$type": "color" },
    "overlay-soft-border": { "$value": "rgba(30, 26, 16, 0.09)", "$type": "color" },
    "scrollbar-thumb": { "$value": "rgba(30, 26, 16, 0.15)", "$type": "color" },
    "scrollbar-thumb-hover": { "$value": "rgba(30, 26, 16, 0.28)", "$type": "color" },
    "scrollbar-thumb-strong": { "$value": "rgba(30, 26, 16, 0.30)", "$type": "color" },
    "scrollbar-thumb-strong-hover": { "$value": "rgba(30, 26, 16, 0.45)", "$type": "color" },
    "ring-edge": { "$value": "rgba(255, 255, 255, 0)", "$type": "color", "$description": "No top-light in the light original (ring.surface layer 1)." },
    "ring-edge-strong": { "$value": "rgba(255, 255, 255, 0.65)", "$type": "color", "$description": "Keycap top glow (ring.field layer 1)." },
    "ring-hairline": { "$value": "rgba(17, 17, 17, 0.06)", "$type": "color", "$description": "Inner hairline around cards." },
    "ring-hairline-outer": { "$value": "rgba(17, 17, 17, 0.05)", "$type": "color", "$description": "Outer hairline beyond the gap." },
    "ring-shadow": { "$value": "rgba(0, 0, 0, 0.06)", "$type": "color", "$description": "Drop shadow between hairline and gap." },
    "ring-gap": { "$value": "rgba(255, 255, 255, 0.85)", "$type": "color", "$description": "THE bright gap — zite's #fffc." },
    "ring-key-shade": { "$value": "rgba(0, 0, 0, 0.10)", "$type": "color", "$description": "Keycap bottom shade." },
    "ring-key-line": { "$value": "rgba(17, 17, 17, 0.20)", "$type": "color", "$description": "Keycap outline." },
    "syntax-keyword": { "$value": "#84298a", "$type": "color", "$description": "Code: keywords (import, const, return). Every syntax colour reads at 4.5:1 on bg, bg-surface and bg-inset (the editor, the pane tile and the code well)." },
    "syntax-string": { "$value": "#3f6b12", "$type": "color", "$description": "Code: strings." },
    "syntax-number": { "$value": "#9a4a06", "$type": "color", "$description": "Code: numbers and literals." },
    "syntax-comment": { "$value": "#625b51", "$type": "color", "$description": "Code: comments. Quieter than code but still 4.5:1." },
    "syntax-function": { "$value": "#1d5a92", "$type": "color", "$description": "Code: function and method names." },
    "syntax-type": { "$value": "#6e5200", "$type": "color", "$description": "Code: types and classes." },
    "syntax-property": { "$value": "#6234a0", "$type": "color", "$description": "Code: properties and definitions." },
    "syntax-punctuation": { "$value": "#4a4437", "$type": "color", "$description": "Code: punctuation and operators." },
    "presence-1": { "$value": "#5b45c9", "$type": "color", "$description": "Live editing: the first other person or agent (carets, name flags, holds). Presence colours reach 3:1 on bg and bg-surface." },
    "presence-2": { "$value": "#1d6aa1", "$type": "color", "$description": "Live editing: the second." },
    "presence-3": { "$value": "#ad2d67", "$type": "color", "$description": "Live editing: the third." },
    "presence-4": { "$value": "#9a520f", "$type": "color", "$description": "Live editing: the fourth." },
    "find-match": { "$value": "rgba(214, 160, 0, 0.28)", "$type": "color", "$description": "Find: every match, a wash over the editor. text-primary keeps 4.5:1 on it." },
    "find-match-current": { "$value": "rgba(214, 150, 0, 0.40)", "$type": "color", "$description": "Find: the current match, stronger than the others." },
    "selection": { "$value": "rgba(37, 90, 146, 0.20)", "$type": "color", "$description": "Selected text in editors. text-primary keeps 4.5:1 on it." }
  },
  "terminal": {
    "fg": { "$value": "#1c1b18", "$type": "color" },
    "bg": { "$value": "#f7f6f2", "$type": "color" },
    "cursor": { "$value": "#b8860b", "$type": "color" },
    "selection": { "$value": "#e4dfd2", "$type": "color" },
    "ansi": [
      "#1c1b18", "#b3261e", "#276b3d", "#9a6a08",
      "#2d5a9e", "#7b4a86", "#0f7070", "#8d897e",
      "#57544c", "#d03828", "#2f8a4e", "#b8830a",
      "#3873ab", "#94609f", "#12888a", "#0a0906"
    ]
  }
}
