  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A message the member saved for later.",
  "properties": {
    "channel_id": {
      "description": "Its channel.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "created_at": {
      "description": "Saved.",
      "format": "date-time",
      "type": "string"
    },
    "id": {
      "description": "The saved item id.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "message": {
      "anyOf": [
        {
          "$ref": "#/$defs/Message"
        },
        {
          "type": "null"
        }
      ],
      "description": "The message as the member sees it now (lists; never in events)."
    },
    "message_id": {
      "description": "The message.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "note": {
      "description": "The member's private note.",
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "$ref": "#/$defs/SavedState",
      "description": "The state."
    },
    "state_changed_at": {
      "description": "Last state change.",
      "format": "date-time",
      "type": "string"
    },
    "updated_at": {
      "description": "Last change.",
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "id",
    "message_id",
    "channel_id",
    "state",
    "created_at",
    "updated_at",
    "state_changed_at"
  ],
  "title": "SavedItem",
  "type": "object"
}
