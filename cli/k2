        | python3 -c 'import json,sys
try:
    print(json.load(sys.stdin).get("path",""))
except Exception:
    pass' 2>/dev/null)
    if [ -z "$resolved_path" ]; then
        resolved_path="$target"
    fi
    cli_request "/cli/workspace/resume-chat-args" "project=$(urlencode "$resolved_path")"
