{
 "agentAccess": "values",
 "everySecs": 60,
 "extract": {
  "aggregates": {
   "certs": {
    "op": "count"
   },
   "min_days": {
    "field": "days",
    "op": "min"
   }
  },
  "fields": {
   "error": "/certs/error",
   "ts": "/certs/ts"
  },
  "items": {
   "itemFields": {
    "days": "/days"
   },
   "itemKey": "/name",
   "pointer": "/certs/items"
  },
  "trend": [
   "min_days"
  ]
 },
 "failAfter": 3,
 "fetch": {
  "url": "https://ops.example.test/api/ops/fleet?part=certs"
 },
 "headers": [],
 "keep": "values",
 "label": "Ops: certificates",
 "link": null,
 "name": "k2-ops-certs",
 "onTargetError": "crit",
 "rules": [
  {
   "crit": {
    "lt": 7
   },
   "field": "days",
   "ok": {
    "gte": 14
   },
   "warn": {
    "lt": 14
   }
  },
  {
   "crit": {
    "ageGt": 900
   },
   "field": "ts",
   "ok": {
    "ageLt": 300
   },
   "warn": {
    "ageGt": 300
   }
  },
  {
   "field": "ts",
   "warn": {
    "exists": false
   }
  }
 ],
 "secret": "OPS_READ_TOKEN",
 "timeoutSecs": 10,
 "viewers": "admin"
}
