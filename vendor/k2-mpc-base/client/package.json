{
  "name": "k2-mpc-client",
  "version": "0.13.1",
  "license": "MIT OR Apache-2.0",
  "description": "Live text editing over the kit's hunk channel, as a library: a text replica, the kit's rebase rules, the wire and transport contract, Re-apply, and presence and marks as data. No DOM; the host draws its own editor (HOST.md).",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core.ts",
    "./test": "./test/index.ts",
    "./test/jsdom-shims": "./test/jsdom-shims.ts"
  },
  "files": [
    "src",
    "test/index.ts",
    "test/fake-live.ts",
    "test/fake-server.ts",
    "test/random-edits.ts",
    "test/runrec.ts",
    "test/jsdom-shims.ts",
    "HOST.md",
    "WIRE.md",
    "EDITOR.md",
    "PRESENCE.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": [
    "./test/jsdom-shims.ts"
  ],
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@types/node": "22.5.4",
    "esbuild": "0.28.2",
    "typescript": "5.5.4",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "licences": "node scripts/check-licences.mjs"
  }
}
