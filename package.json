    "styles:lint": "node scripts/check-style-lint.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "parity:capture": "playwright test --config tests/parity/playwright.config.ts",
    "parity:diff": "node tests/parity/diff.mjs",
