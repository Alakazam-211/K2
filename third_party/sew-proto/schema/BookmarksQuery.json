{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Query of `GET /api/v1/channels/{id}/bookmarks`.",
  "properties": {
    "ids": {
      "description": "Only these bookmarks (catch-up refetch; missing = deleted).",
      "pattern": "^[1-9][0-9]{0,18}(,[1-9][0-9]{0,18}){0,99}$",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "title": "BookmarksQuery",
  "type": "object"
}
