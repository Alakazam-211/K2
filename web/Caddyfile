# Local same-origin reverse proxy for the hosted web client (Stage B+C).
#
# Serves:
#   /              → tiny short-cached loader (web/loader)
#   /app/<ver>/*   → versioned Vite SPA (out/web/app/<ver>)
#   /boot-status, /cli/*, /events → local K2 daemon
#
# Env (set by scripts/web-serve.sh):
#   K2_DAEMON_PORT   — daemon listen port (from ~/.k2/heartbeat.port)
#   K2_WEB_VERSION   — package.json version; SPA fallback inside /app/*
#   K2_WEB_PORT      — listen port for this edge (default 8080)
#
# Usage:
#   bun run vite:build:web
#   bun run web:serve
#   open http://127.0.0.1:8080/
#
# Install Caddy: brew install caddy

{
	# Quiet local admin API; this is a laptop throwaway edge.
	admin off
}

:{$K2_WEB_PORT:8080} {
	encode gzip

	# ── Data plane → local daemon ─────────────────────────────────────
	# /boot-status is public (loader + ConnectionGate).
	handle /boot-status* {
		reverse_proxy 127.0.0.1:{$K2_DAEMON_PORT}
	}

	# REST + WebSocket routes under /cli/* (grid WS, session events, auth).
	handle /cli/* {
		reverse_proxy 127.0.0.1:{$K2_DAEMON_PORT}
	}

	# Legacy /events bus (WS); keep for parity with desktop event bridge.
	handle /events* {
		reverse_proxy 127.0.0.1:{$K2_DAEMON_PORT}
	}

	# ── Versioned SPA (vite base = /app/<version>/) ────────────────────
	# Bundles are immutable content-hashed assets; long-cache is safe.
	handle /app/* {
		root * ./out/web
		# SPA fallback inside the versioned tree (deep-link refresh).
		# Falls back to the locally built version when a path is missing.
		try_files {path} {path}/ /app/{$K2_WEB_VERSION}/index.html
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# ── Edge loader (mutable; never immutable) ────────────────────────
	# Serves web/loader at / and unknown non-API paths so refresh on a
	# deep link still hits the loader (which then picks /app/<ver>/).
	handle {
		root * ./web/loader
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}
}
