    python3 -c '
import sys, urllib.parse
pairs = [a.split("=", 1) for a in sys.argv[1:]]
print(urllib.parse.urlencode([(k, v) for k, v in pairs if v != ""]))
' "$@"
}

# A draft source (export shape) from propose-style flags, or a file. Used by
