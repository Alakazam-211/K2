        "stop_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/StopReason"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why."
        },
        "stopped_at": {
          "description": "When it stopped.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "transcript": {
          "$ref": "#/$defs/SummaryTranscript",
          "description": "The transcript."
        }
      },
      "required": [
