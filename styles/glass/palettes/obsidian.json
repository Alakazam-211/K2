{
  "$schema": "../../style.schema.json#/$defs/palette",
  "id": "obsidian",
  "name": "Obsidian",
  "schemes": ["dark"],
  "color": {
    "bg": { "$value": "#0a0c12", "$type": "color", "$description": "Opaque. Terminals and WebGL always sit on this — never glass." },
    "bg-surface": { "$value": "rgba(16, 20, 32, 0.58)", "$type": "color", "$description": "Frosted panel tint (backdrop-filter supplies the blur)." },
    "bg-elevated": { "$value": "rgba(30, 36, 56, 0.62)", "$type": "color" },
    "bg-inset": { "$value": "#0e1118", "$type": "color", "$description": "Content wells stay solid for readability." },
    "bg-stripe": { "$value": "rgba(12, 15, 24, 0.50)", "$type": "color" },
    "bg-canvas": { "$value": "#05060a", "$type": "color", "$description": "Base under the ambient gradient (overrides.css paints the aurora)." },
    "bg-hover": { "$value": "rgba(255, 255, 255, 0.07)", "$type": "color" },
    "border": { "$value": "rgba(255, 255, 255, 0.09)", "$type": "color" },
    "border-strong": { "$value": "rgba(255, 255, 255, 0.28)", "$type": "color" },
    "text-primary": { "$value": "#eef1f8", "$type": "color" },
    "text-secondary": { "$value": "#a8b0c2", "$type": "color" },
    "text-muted": { "$value": "#6d7590", "$type": "color" },
    "accent": { "$value": "#5aa2ff", "$type": "color", "$description": "Luminous cool blue — reads through frost." },
    "accent-hover": { "$value": "#82b8ff", "$type": "color" },
    "accent-soft": { "$value": "#b3d4ff", "$type": "color" },
    "on-accent": { "$value": "#ffffff", "$type": "color" },
    "status-working": { "$value": "#ff9d42", "$type": "color" },
    "status-error": { "$value": "#ff5d5d", "$type": "color" },
    "status-ok": { "$value": "#3ddc84", "$type": "color" },
    "status-warn": { "$value": "#ffc043", "$type": "color" },
    "status-ok-soft": { "$value": "#6ee7a0", "$type": "color" },
    "status-warn-soft": { "$value": "#ffd166", "$type": "color" },
    "status-error-soft": { "$value": "#ff8080", "$type": "color" },
    "status-error-bright": { "$value": "#ffb3b3", "$type": "color" },
    "status-error-text": { "$value": "#ff7a7a", "$type": "color" },
    "status-working-soft": { "$value": "#ffb877", "$type": "color" },
    "status-warn-text": { "$value": "#ffd166", "$type": "color" },
    "status-warn-amber": { "$value": "#ffc043", "$type": "color" },
    "status-warn-amber-soft": { "$value": "#ffd685", "$type": "color" },
    "status-warn-amber-bright": { "$value": "#ffe7b3", "$type": "color" },
    "status-ok-hover": { "$value": "#2fbf70", "$type": "color" },
    "danger": { "$value": "#e0454f", "$type": "color" },
    "danger-active": { "$value": "#c23540", "$type": "color" },
    "danger-muted": { "$value": "#b53a44", "$type": "color" },
    "danger-hover": { "$value": "#ff8080", "$type": "color" },
    "neutral": { "$value": "#7c849c", "$type": "color" },
    "control-track-off": { "$value": "rgba(255, 255, 255, 0.14)", "$type": "color" },
    "wash-1": { "$value": "rgba(255, 255, 255, 0.05)", "$type": "color" },
    "wash-2": { "$value": "rgba(255, 255, 255, 0.10)", "$type": "color" },
    "wash-3": { "$value": "rgba(255, 255, 255, 0.20)", "$type": "color" },
    "scrim": { "$value": "rgba(3, 5, 10, 0.40)", "$type": "color", "$description": "Lighter than Square — the frost itself does half the separation." },
    "diff-add-text": { "$value": "#a5e075", "$type": "color" },
    "diff-remove-text": { "$value": "#ffb3b3", "$type": "color" },
    "diff-modified-border": { "$value": "#6ee7a0", "$type": "color" },
    "code-inline": { "$value": "#e8c586", "$type": "color" },
    "overlay-soft-bg": { "$value": "rgba(255, 255, 255, 0.06)", "$type": "color" },
    "overlay-soft-border": { "$value": "rgba(255, 255, 255, 0.08)", "$type": "color" },
    "scrollbar-thumb": { "$value": "rgba(255, 255, 255, 0.12)", "$type": "color" },
    "scrollbar-thumb-hover": { "$value": "rgba(255, 255, 255, 0.22)", "$type": "color" },
    "scrollbar-thumb-strong": { "$value": "rgba(255, 255, 255, 0.28)", "$type": "color" },
    "scrollbar-thumb-strong-hover": { "$value": "rgba(255, 255, 255, 0.42)", "$type": "color" }
  },
  "terminal": {
    "fg": { "$value": "#e6e9f2", "$type": "color" },
    "bg": { "$value": "#0a0c12", "$type": "color" },
    "cursor": { "$value": "#e6e9f2", "$type": "color" },
    "selection": { "$value": "#2a3350", "$type": "color" },
    "ansi": [
      "#10131c", "#ff5d5d", "#3ddc84", "#ffc043",
      "#5aa2ff", "#b58aff", "#4dd0e1", "#c3c9d9",
      "#5b6378", "#ff8080", "#6ee7a0", "#ffd166",
      "#82b8ff", "#cbaaff", "#7ee3ef", "#f2f5fc"
    ]
  }
}
