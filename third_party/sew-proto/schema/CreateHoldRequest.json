{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Body of `POST /api/v1/compliance/holds`.",
  "properties": {
    "channels": {
      "default": [],
      "description": "Channel targets.",
      "items": {
        "description": "A Sew id: a decimal string of a 64-bit time-sortable id (1 to 9223372036854775807).",
        "pattern": "^[1-9][0-9]{0,18}$",
        "type": "string"
      },
      "type": "array"
    },
    "from": {
      "description": "Start of the range (inclusive).",
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "members": {
      "default": [],
      "description": "Member targets.",
      "items": {
        "description": "A Sew id: a decimal string of a 64-bit time-sortable id (1 to 9223372036854775807).",
        "pattern": "^[1-9][0-9]{0,18}$",
        "type": "string"
      },
      "type": "array"
    },
    "name": {
      "description": "1–100 characters, unique among all holds (case-insensitive).",
      "type": "string"
    },
    "spaces": {
      "default": [],
      "description": "Space targets.",
      "items": {
        "description": "A Sew id: a decimal string of a 64-bit time-sortable id (1 to 9223372036854775807).",
        "pattern": "^[1-9][0-9]{0,18}$",
        "type": "string"
      },
      "type": "array"
    },
    "to": {
      "description": "End of the range (exclusive).",
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "name"
  ],
  "title": "CreateHoldRequest",
  "type": "object"
}
