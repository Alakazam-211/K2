{
  "$schema": "../../style.schema.json#/$defs/palette",
  "id": "obsidian",
  "name": "Obsidian",
  "schemes": [
    "dark"
  ],
  "color": {
    "bg": {
      "$value": "#0a0a0a",
      "$type": "color"
    },
    "bg-surface": {
      "$value": "#1c1c1e",
      "$type": "color"
    },
    "bg-elevated": {
      "$value": "#2c2c2e",
      "$type": "color"
    },
    "bg-inset": {
      "$value": "#101012",
      "$type": "color"
    },
    "bg-stripe": {
      "$value": "#1c1c1e",
      "$type": "color"
    },
    "bg-canvas": {
      "$value": "#0a0a0a",
      "$type": "color"
    },
    "bg-hover": {
      "$value": "rgba(255, 255, 255, 0.08)",
      "$type": "color"
    },
    "border": {
      "$value": "#333333",
      "$type": "color"
    },
    "border-strong": {
      "$value": "rgba(255, 255, 255, 0.28)",
      "$type": "color"
    },
    "control-edge": {
      "$value": "#787880",
      "$type": "color"
    },
    "divider": {
      "$value": "#525255",
      "$type": "color",
      "$description": "Short dividers between items in a row: tab-strip tabs, top-bar groups. Between border and control-edge, about 2:1 on the tab strip and the top bar capsule."
    },
    "text-primary": {
      "$value": "#ffffff",
      "$type": "color"
    },
    "text-secondary": {
      "$value": "#c7c7cc",
      "$type": "color"
    },
    "text-muted": {
      "$value": "#a1a1a6",
      "$description": "Hints, placeholders and quiet labels. 4.9:1 on a field inside a tile (#333336), where #98989d was 4.39.",
      "$type": "color"
    },
    "accent": {
      "$value": "var(--glass-accent)",
      "$type": "color"
    },
    "accent-hover": {
      "$value": "color-mix(in srgb, var(--color-accent) 82%, white)",
      "$type": "color"
    },
    "accent-soft": {
      "$value": "color-mix(in srgb, var(--color-accent) 58%, white)",
      "$type": "color"
    },
    "on-accent": {
      "$value": "#ffffff",
      "$type": "color"
    },
    "accent-fill": {
      "$value": "color-mix(in srgb, var(--color-accent) 82%, black)",
      "$type": "color",
      "$description": "The accent as a fill under on-accent text (filled buttons, the selected segment, count badges): deep enough that the label clears 4.5:1, including at a 90% hover. Icons, rings and switches keep accent."
    },
    "chart-1": {
      "$value": "#3987e5",
      "$type": "color",
      "$description": "Chart series 1 (Usage: Claude). The series hues are a fixed order validated together for colour-blind separation and at least 3:1 on this palette's cards; colour follows the thing, never its rank."
    },
    "chart-2": {
      "$value": "#d95926",
      "$type": "color",
      "$description": "Chart series 2 (Usage: Codex)."
    },
    "chart-3": {
      "$value": "#199e70",
      "$type": "color",
      "$description": "Chart series 3 (Usage: Grok)."
    },
    "chart-other": {
      "$value": "#9085e9",
      "$type": "color",
      "$description": "Chart series for anything past the named ones."
    },
    "status-working": {
      "$value": "var(--color-accent-text)",
      "$type": "color",
      "$description": "Working marks (the working grid, the Thread strip's dot, starting / installing dots): the highlight colour's legible variant, so they follow the palette's accent and a chosen one. --color-accent-text clears 4.5:1 on bg, bg-surface and bg-elevated (lib/style-accent.ts for a chosen colour), which keeps the marks over 3:1 on selected and hovered rows."
    },
    "status-error": {
      "$value": "#ff453a",
      "$type": "color"
    },
    "status-ok": {
      "$value": "#30d158",
      "$type": "color"
    },
    "status-warn": {
      "$value": "#ff9f0a",
      "$type": "color"
    },
