{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Body of `POST /api/v1/spaces/{id}/members/remove`.",
  "properties": {
    "member_id": {
      "description": "The member to remove.",
      "pattern": "^[1-9][0-9]{0,18}$",
