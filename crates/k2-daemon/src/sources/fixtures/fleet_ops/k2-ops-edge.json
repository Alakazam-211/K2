{
 "agentAccess": "values",
 "everySecs": 60,
 "extract": {
  "aggregates": {
   "relays": {
    "op": "count"
   },
   "tunnels_total": {
    "field": "tunnels",
    "op": "sum"
   }
  },
  "fields": {
   "cp_sha_k2e01": "/deploys/cp/k2e-01",
   "cp_sha_k2e02": "/deploys/cp/k2e-02",
   "deploys_ts": "/deploys/ts",
   "dns_ts": "/dns/ts",
   "failback": "/dns/failback",
   "failover_armed": "/dns/failover_armed",
   "relays_ts": "/relays/ts",
   "web_sha": "/deploys/web/sha",
   "wildcard_a": "/dns/wildcard_a"
  },
  "items": {
   "itemFields": {
    "caddy": "/caddy",
    "cp": "/cp",
    "cp_sha": "/cp_sha",
    "frps": "/frps",
    "haproxy": "/haproxy",
    "pdns": "/pdns",
    "pushed_at": "/ts",
    "role": "/role",
    "tunnels": "/tunnels"
   },
   "itemKey": "/name",
   "pointer": "/relays/items"
  },
  "trend": [
   "tunnels_total"
  ]
 },
 "failAfter": 3,
 "fetch": {
  "url": "https://ops.example.test/api/ops/fleet?part=relays,dns,deploys"
 },
 "headers": [],
 "keep": "values",
 "label": "Ops: relays, DNS, deploys",
 "link": null,
 "name": "k2-ops-edge",
 "onTargetError": "crit",
 "rules": [
  {
   "crit": {
    "ne": "active"
   },
   "field": "cp",
   "ok": {
    "eq": "active"
   }
  },
  {
   "crit": {
    "ne": "active"
   },
   "field": "frps",
   "ok": {
    "eq": "active"
   }
  },
  {
   "crit": {
    "ne": "active"
   },
   "field": "caddy",
   "ok": {
    "eq": "active"
   }
  },
  {
   "crit": {
    "ne": "active"
   },
   "field": "haproxy",
   "ok": {
    "eq": "active"
   }
  },
  {
   "crit": {
    "ne": "active"
   },
   "field": "pdns",
   "ok": {
    "eq": "active"
   }
  },
  {
   "crit": {
    "eq": "other"
   },
   "field": "wildcard_a",
   "ok": {
    "eq": "primary"
   },
   "warn": {
    "eq": "standby"
   }
  },
  {
   "field": "failover_armed",
   "ok": {
    "eq": true
   },
   "warn": {
    "eq": false
   }
  },
  {
   "crit": {
    "ageGt": 900
   },
   "field": "relays_ts",
   "ok": {
    "ageLt": 300
   },
   "warn": {
    "ageGt": 300
   }
  },
  {
   "crit": {
    "ageGt": 900
   },
   "field": "dns_ts",
   "ok": {
    "ageLt": 300
   },
   "warn": {
    "ageGt": 300
   }
  },
  {
   "crit": {
    "ageGt": 900
   },
   "field": "deploys_ts",
   "ok": {
    "ageLt": 300
   },
   "warn": {
    "ageGt": 300
   }
  },
  {
   "crit": {
    "ageGt": 900
   },
   "critAfter": 2,
   "field": "pushed_at",
   "ok": {
    "ageLt": 300
   },
   "warn": {
    "ageGt": 300
   }
  }
 ],
 "secret": "OPS_READ_TOKEN",
 "timeoutSecs": 10,
 "viewers": "admin"
}
