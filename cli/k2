# Stage local file under <ws>/.k2/tmp/msg-inbox/ on the daemon. Echoes remote path.
# Exit 3 on passport/fs-auth gate (teaching already printed); 1 on other errors.
_msg_inbox_stage_file() {
    local target="$1"
    local local_path="$2"
    local ws_path filename remote_dir remote_path
    local rc=0
    ws_path=$(_msg_inbox_resolve_ws_path "$target")
    if [ -z "$ws_path" ]; then
        # Fall back: if target looks absolute, use it; else fail loudly.
        case "$target" in
            /*) ws_path="$target" ;;
            *)
                echo "Error: cannot resolve workspace '$target' on daemon for file staging" >&2
                return 1
                ;;
        esac
    fi
    filename=$(basename "$local_path")
    # Prefer .k2/ layout (0.40+); write_upload creates the tree.
    remote_dir="${ws_path}/.k2/tmp/msg-inbox"
    remote_path=$(_msg_inbox_upload_file "$local_path" "$remote_dir" "$filename") || rc=$?
    if [ "$rc" -ne 0 ]; then
        return "$rc"
    fi
    printf '%s' "$remote_path"
    return 0
}

# Best-effort permanent delete of a staged path on the daemon.
_msg_inbox_delete_staged() {
    local staged_path="$1"
    [ -z "$staged_path" ] && return 0
    if ! command -v python3 >/dev/null 2>&1; then
        return 0
    fi
    local body
    body=$(python3 -c 'import json,sys; print(json.dumps({"paths":[sys.argv[1]],"permanent":True}))' "$staged_path") || return 0
    _msg_inbox_cli_post_json "/cli/fs/delete" "$body" 30 >/dev/null 2>&1 || true
}

# Shared JSON error mapper for inbox compose / deliver responses.
# Exit 3 for not_connected/gated/forbidden; exit 1 for other structured
# errors; exit 0 on success. For wake-after-package: package ok + wake
# fail still exits 0 (wake field present for callers).
_msg_inbox_map_response() {
    local response="$1"
    local wake_mode="${2:-false}"
    echo "$response"
    if ! command -v python3 >/dev/null 2>&1; then
        return 0
    fi
    echo "$response" | WAKE_MODE="$wake_mode" python3 -c '
import json, sys, os
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
err = d.get("error")
if isinstance(err, dict):
    code = err.get("code") or ""
    hint = err.get("hint") or code
    sys.stderr.write(json.dumps({"error": {"code": code, "hint": hint}},
                                ensure_ascii=False, separators=(",", ":")) + "\n")
    if code in ("not_connected", "gated", "forbidden"):
        sys.exit(3)
    sys.exit(1)
if isinstance(err, str) and err:
    sys.stderr.write(json.dumps({"error": {"code": "error", "hint": err}},
                                ensure_ascii=False, separators=(",", ":")) + "\n")
    sys.exit(1)
if d.get("ok") is False and "id" not in d and "filename" not in d:
    sys.exit(1)
# Package primary: if wake failed after package landed, note it but exit 0.
if os.environ.get("WAKE_MODE") == "true":
    wake = d.get("wake")
    if isinstance(wake, dict) and wake.get("success") is False:
        reason = wake.get("reason") or "wake_failed"
        hint = wake.get("hint") or ""
        sys.stderr.write(
            f"note: package landed; wake notify failed ({reason})"
            + (f": {hint}" if hint else "")
            + "\n"
        )
sys.exit(0)
' || return $?
}

# Resolve a client path to absolute. Echoes path or empty.
_msg_inbox_abspath() {
    local path="$1"
    local abs_path=""
    if command -v python3 >/dev/null 2>&1; then
        abs_path=$(python3 -c 'import os,sys; print(os.path.abspath(os.path.expanduser(sys.argv[1])))' "$path" 2>/dev/null) || abs_path=""
    fi
    if [[ -z "$abs_path" ]]; then
        case "$path" in
            /*) abs_path="$path" ;;
            ~/*) abs_path="${HOME}/${path#~/}" ;;
            *) abs_path="$(pwd)/$path" ;;
        esac
    fi
    printf '%s' "$abs_path"
}

# Build a flat .tar.gz of absolute files (basenames only; collisions get -N
# suffix). Echoes the temp archive path. Caller must rm it.
_msg_inbox_pack_tar_gz() {
    local out=""
    if ! command -v python3 >/dev/null 2>&1; then
        echo "Error: python3 required to pack multi-file inbox bundle" >&2
        return 1
    fi
    out=$(mktemp "${TMPDIR:-/tmp}/k2-msg-inbox-bundle.XXXXXX.tar.gz") || {
        echo "Error: cannot create temp archive for multi-file inbox" >&2
        return 1
    }
    if ! python3 -c '
import os, sys, tarfile
out = sys.argv[1]
paths = sys.argv[2:]
used = set()
with tarfile.open(out, "w:gz") as tf:
    for p in paths:
        base = os.path.basename(p) or "attachment"
        name = base
        n = 2
        while name in used:
            stem, dot, ext = base.rpartition(".")
            if dot and stem:
                name = f"{stem}-{n}.{ext}"
            else:
                name = f"{base}-{n}"
            n += 1
        used.add(name)
        tf.add(p, arcname=name)
' "$out" "$@"; then
        rm -f "$out"
        echo "Error: failed to pack multi-file inbox bundle" >&2
        return 1
    fi
    printf '%s' "$out"
    return 0
}

cmd_msg_inbox_form() {
    # `msg <ws> --inbox-silent|wake [path …] [--title ...] [--body ...] [--from ...]`
    #
    # P2 multi-file: multiple positionals that are files become ONE tray
    # package (cover + sidecars under <id>.files/). Local loopback posts
    # paths[] to /cli/inbox/deliver; remote multi packs a flat tar.gz,
    # stages via upload-binary/chunk, then /cli/inbox/deliver-bundle.
    #
    # Remote tray routing (agent::host / name@host): unlike live text msg
    # (federation), file packages must land on the daemon that owns the
    # target tray. When Connect credentials exist for <host>, save/restore
    # BASE_URL+TOKEN, repoint at that host, and deliver with the bare
    # workspace/agent name. No Connect token → hard fail (federation
    # cannot upload files). Local peer names stay on the active daemon.
    #
    # #36: recipient is workspace=<token> (same as live msg) — stamp_principal
    # never overwrites workspace=/target=.
    local target="$1"
    shift
    local mode="$1"   # silent | wake
    shift

    # ── Remote Connect host repoint (tray only; save/restore globals) ──
    local _tray_saved_base_url="${BASE_URL}"
    local _tray_saved_token="${TOKEN}"
    local _tray_remote_applied=0
    _tray_restore_env() {
        if [ "${_tray_remote_applied}" = "1" ]; then
            BASE_URL="${_tray_saved_base_url}"
            TOKEN="${_tray_saved_token}"
            _tray_remote_applied=0
        fi
    }
    # Restore on normal function return (exit ends the process anyway).
    trap '_tray_restore_env' RETURN

    _split_remote_target "$target"
    if [ "${_IS_WIRE_FORM:-0}" = "1" ]; then
        echo "k2 msg: '${target}' looks like federation wire form (<fp>::<workspace>::<agent>)." >&2
        echo "  Tray file send needs a Connect host user form:  k2 msg <agent>::<host> --inbox-wake <path>" >&2
        echo "  Wire form is for:              k2 fed send <fp>::<ws>::<agent> \"text\"" >&2
        return 2
    fi
    if [ -n "${_REMOTE_HOST}" ]; then
        local _tray_tok=""
        _tray_tok="$(_remote_token_for_host "$_REMOTE_HOST" "")"
        if [ -z "$_tray_tok" ]; then
            cat >&2 <<EOF
Error: tray file send needs a K2 Connect host for ${_REMOTE_HOST} (add/sign-in under Servers, or switch ServerSwitcher).
Live text msg over federation does not upload files.
EOF
            return 2
        fi
        if ! _apply_remote_host "$_REMOTE_HOST" ""; then
            cat >&2 <<EOF
Error: tray file send needs a K2 Connect host for ${_REMOTE_HOST} (add/sign-in under Servers, or switch ServerSwitcher).
Live text msg over federation does not upload files.
EOF
            return 2
        fi
        _tray_remote_applied=1
        target="$_BARE_TARGET"
    fi

    local title="" body="" priority="" from="" path=""
    local positional=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --title)    title="$2"; shift 2 ;;
            --body)     body="$2"; shift 2 ;;
            --priority) priority="$2"; shift 2 ;;
            --from)     from="$2"; shift 2 ;;
            --path)     path="$2"; shift 2 ;;
            -*)
                echo "Error: unknown flag '$1' (try 'k2 msg --help')" >&2
                exit 2 ;;
            *)
                positional+=("$1"); shift ;;
        esac
    done

    # Collect ALL positional paths that are readable files (P2 multi-file).
    # Explicit --path is treated as a single-file override when set.
    local file_paths=()
    if [[ -n "$path" ]]; then
        file_paths+=("$path")
    else
        local cand
        for cand in "${positional[@]+"${positional[@]}"}"; do
            if [[ -f "$cand" ]]; then
                file_paths+=("$cand")
            fi
        done
    fi
    # If no file found but one positional looks path-like, keep it for
    # a clearer error (daemon will reject missing file).
    if [[ ${#file_paths[@]} -eq 0 && ${#positional[@]} -gt 0 ]]; then
        local p0="${positional[0]}"
        case "$p0" in
            ./*|/*|~/*|*.md|*.txt|*.pdf|*.png|*.jpg|*.zip|*.json|*.csv)
                file_paths+=("$p0") ;;
        esac
    fi

    local wake_flag="false"
    [[ "$mode" == "wake" ]] && wake_flag="true"

    # ── File package path (primary; single or multi) ─────────────────
    if [[ ${#file_paths[@]} -gt 0 ]]; then
        local abs_paths=()
        local fp abs_path
        for fp in "${file_paths[@]}"; do
            abs_path=$(_msg_inbox_abspath "$fp")
            if [[ ! -f "$abs_path" ]]; then
                echo "Error: file not found: $fp" >&2
                echo "Usage: k2 msg <workspace> --inbox-${mode} <path> [path…] [--title \"...\"] [--from <name>]" >&2
                exit 2
            fi
            abs_paths+=("$abs_path")
        done

        local need_upload="false"
        if ! _msg_daemon_is_local; then
            need_upload="true"
        fi

        _msg_inbox_post_deliver_single() {
            local pth="$1"
            local params="workspace=$(urlencode "$target")&path=$(urlencode "$pth")&wake=$(urlencode "$wake_flag")&mode=$(urlencode "$mode")&source=msg-inbox"
            [[ -n "$title" ]] && params="${params}&title=$(urlencode "$title")"
            [[ -n "$from" ]] && params="${params}&from=$(urlencode "$from")"
            cli_send cli_post_form "/cli/inbox/deliver" "$params"
        }

        _msg_inbox_post_deliver_multi() {
            # paths= is a JSON array of absolute paths the daemon can open.
            local paths_json
            paths_json=$(python3 -c 'import json,sys; print(json.dumps(sys.argv[1:]))' "${abs_paths[@]}") || {
                echo "Error: failed to encode paths JSON for multi-file deliver" >&2
                return 1
            }
            local params="workspace=$(urlencode "$target")&paths=$(urlencode "$paths_json")&wake=$(urlencode "$wake_flag")&mode=$(urlencode "$mode")&source=msg-inbox"
            [[ -n "$title" ]] && params="${params}&title=$(urlencode "$title")"
            [[ -n "$from" ]] && params="${params}&from=$(urlencode "$from")"
            cli_send cli_post_form "/cli/inbox/deliver" "$params"
        }

        _msg_inbox_post_deliver_bundle() {
            local pth="$1"
            local params="workspace=$(urlencode "$target")&path=$(urlencode "$pth")&wake=$(urlencode "$wake_flag")&mode=$(urlencode "$mode")&source=msg-inbox"
            [[ -n "$title" ]] && params="${params}&title=$(urlencode "$title")"
            [[ -n "$from" ]] && params="${params}&from=$(urlencode "$from")"
            cli_send cli_post_form "/cli/inbox/deliver-bundle" "$params"
        }

        local response staged_path=""

        # ── Multi-file ──────────────────────────────────────────────
        if [[ ${#abs_paths[@]} -gt 1 ]]; then
            if [[ "$need_upload" != "true" ]]; then
                response=$(_msg_inbox_post_deliver_multi) || true
                if _msg_inbox_is_not_readable_error "$response"; then
                    need_upload="true"
                else
                    _msg_inbox_map_response "$response" "$wake_flag"
                    return $?
                fi
            fi
            # Remote (or local FS skew): pack flat tar.gz → stage → deliver-bundle.
            local bundle_local stage_rc=0
            bundle_local=$(_msg_inbox_pack_tar_gz "${abs_paths[@]}") || exit 1
            staged_path=$(_msg_inbox_stage_file "$target" "$bundle_local") || stage_rc=$?
            if [ "$stage_rc" -ne 0 ]; then
                rm -f "$bundle_local"
                # Passport/fs-auth teaching already printed (exit 3).
                [ "$stage_rc" -eq 3 ] && exit 3
                echo "Error: failed to stage multi-file bundle on daemon for inbox deliver" >&2
                exit 1
            fi
            rm -f "$bundle_local"
            response=$(_msg_inbox_post_deliver_bundle "$staged_path")
            _msg_inbox_delete_staged "$staged_path"
            _msg_inbox_map_response "$response" "$wake_flag"
            return $?
        fi

        # ── Single-file (P0/P1 path unchanged) ───────────────────────
        local deliver_path="${abs_paths[0]}"
        if [[ "$need_upload" != "true" ]]; then
            response=$(_msg_inbox_post_deliver_single "$deliver_path")
            if _msg_inbox_is_not_readable_error "$response"; then
                need_upload="true"
            else
                _msg_inbox_map_response "$response" "$wake_flag"
                return $?
            fi
        fi

        if [[ "$need_upload" == "true" ]]; then
            local stage_rc=0
            staged_path=$(_msg_inbox_stage_file "$target" "${abs_paths[0]}") || stage_rc=$?
            if [ "$stage_rc" -ne 0 ]; then
                [ "$stage_rc" -eq 3 ] && exit 3
                echo "Error: failed to stage local file on daemon for inbox deliver" >&2
                exit 1
            fi
            deliver_path="$staged_path"
            response=$(_msg_inbox_post_deliver_single "$deliver_path")
            # Best-effort cleanup of staging copy (package already owns bytes).
            _msg_inbox_delete_staged "$staged_path"
            _msg_inbox_map_response "$response" "$wake_flag"
            return $?
        fi
    fi

    # ── Legacy string compose (--title/--body, no path) ──────────────
    if [[ -z "$title" ]]; then
        echo "Usage: k2 msg <workspace> --inbox-${mode} <path> [path…] [--title \"...\"] [--from <name>]" >&2
        echo "   or: k2 msg <workspace> --inbox-${mode} --title \"...\" [--body \"...\"]" >&2
        exit 2
    fi

    local params="workspace=$(urlencode "$target")&title=$(urlencode "$title")&source=msg-inbox"
    [[ -n "$body" ]] && params="${params}&body=$(urlencode "$body")"
    [[ -n "$priority" ]] && params="${params}&priority=$(urlencode "$priority")"
    [[ -n "$from" ]] && params="${params}&from=$(urlencode "$from")"
    local response
    response=$(cli_send cli_post_form "/cli/inbox/compose" "$params")

    # Compose-only for silent. For wake: after compose success, deliver_live
    # with the inbox pointer (package ok is primary).
    if [[ "$wake_flag" != "true" ]]; then
        _msg_inbox_map_response "$response" "false"
        return $?
    fi

    # Parse compose result; on error, map and exit. On success, wake.
    local compose_id="" compose_title="$title"
    if command -v python3 >/dev/null 2>&1; then
        local mapped
        mapped=$(echo "$response" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    print("PARSE_FAIL"); sys.exit(0)
err = d.get("error")
if isinstance(err, dict):
    code = err.get("code") or ""
    hint = err.get("hint") or code
    print("ERR\t" + code + "\t" + hint)
    sys.exit(0)
if isinstance(err, str) and err:
    print("ERR\terror\t" + err)
    sys.exit(0)
if d.get("ok") is False and "id" not in d:
    print("ERR\terror\tcompose failed")
    sys.exit(0)
print("OK\t" + (d.get("id") or "") + "\t" + (d.get("title") or ""))
') || true
        case "$mapped" in
            ERR$'\t'*)
                local ecode hint
                ecode=$(printf '%s' "$mapped" | cut -f2)
                hint=$(printf '%s' "$mapped" | cut -f3-)
                echo "$response"
                printf '%s\n' "$(python3 -c 'import json,sys; print(json.dumps({"error":{"code":sys.argv[1],"hint":sys.argv[2]}},separators=(",",":")))' "$ecode" "$hint")" >&2
                if [[ "$ecode" == "not_connected" || "$ecode" == "gated" || "$ecode" == "forbidden" ]]; then
                    return 3
                fi
                return 1
                ;;
            OK$'\t'*)
                compose_id=$(printf '%s' "$mapped" | cut -f2)
                compose_title=$(printf '%s' "$mapped" | cut -f3-)
                [[ -z "$compose_title" ]] && compose_title="$title"
                ;;
            *)
                echo "$response"
                return 0
                ;;
        esac
    else
        echo "$response"
        return 0
    fi

    # Wake knock with pointer payload.
    local from_tag="${from:-external}"
    local pointer="[inbox:${compose_id}] ${compose_title}"$'\n'"Open: k2 inbox read ${compose_id}"
    local wake_params="workspace=$(urlencode "$target")&text=$(urlencode "$pointer")&from=$(urlencode "$from_tag")&wake=true"
    local wake_resp
    wake_resp=$(cli_send cli_post_form "/cli/workspace/msg" "$wake_params")
    # Merge package + wake into one JSON line for the agent.
    if command -v python3 >/dev/null 2>&1; then
        python3 -c '
import json, sys
pkg = json.loads(sys.argv[1])
try:
    wake = json.loads(sys.argv[2])
except Exception:
    wake = {"success": False, "reason": "wake_parse_error", "hint": sys.argv[2][:200]}
pkg["wake"] = {
    "success": bool(wake.get("success")),
    "reason": wake.get("reason"),
    "hint": wake.get("hint"),
    "targetSessionId": wake.get("target_session_id") or wake.get("targetSessionId"),
    "woke": wake.get("woke"),
    "wakeMs": wake.get("wake_ms") or wake.get("wakeMs"),
    "attempts": wake.get("attempts"),
}
print(json.dumps(pkg, ensure_ascii=False, separators=(",", ":")))
if not wake.get("success"):
    reason = wake.get("reason") or "wake_failed"
    hint = wake.get("hint") or ""
    sys.stderr.write(
        f"note: package landed; wake notify failed ({reason})"
        + (f": {hint}" if hint else "")
        + "\n"
    )
' "$response" "$wake_resp" || {
            echo "$response"
            echo "note: package landed; wake notify failed (merge error)" >&2
        }
    else
        echo "$response"
    fi
    return 0
}

cmd_msg_signal_form() {
    # Forward to legacy cmd_signal which builds the AgentSignal wire payload.
    # `msg <ws> --signal <kind> [--payload <json>] [--from <name>]`
    local target="$1"
    shift
    local kind="msg" payload="{}" from="${K2SO_AGENT_NAME:-cli}" delivery="live"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --signal)  kind="$2"; shift 2 ;;
            --payload) payload="$2"; shift 2 ;;
            --from)    from="$2"; shift 2 ;;
            --inbox|--inbox-silent|--inbox-wake) delivery="inbox"; shift ;;
            *) shift ;;
        esac
    done
    # Delegate to cmd_signal — preserves wire-format consistency with
    # the now-deprecated `signal` top-level verb.
    local args=("$target" "$kind" "$payload" "--from" "$from")
    [[ "$delivery" == "inbox" ]] && args+=("--inbox")
    cmd_signal "${args[@]}"
}

# Wrapper that splits `k2 msg <ws> ...` into live / tray / --signal forms.
cmd_msg_v2() {
    # Detect tray flags or --signal anywhere in the args.
    local has_inbox_bare="false"
    local has_inbox_silent="false"
    local has_inbox_wake="false"
    local has_signal="false"
    for arg in "$@"; do
        case "$arg" in
            --inbox) has_inbox_bare="true" ;;
            --inbox-silent) has_inbox_silent="true" ;;
            --inbox-wake) has_inbox_wake="true" ;;
            --signal) has_signal="true" ;;
        esac
    done
    if [[ "$has_signal" == "true" ]]; then
        local target="$1"; shift
        cmd_msg_signal_form "$target" "$@"
        return $?
    fi
    # Bare --inbox without silent/wake → hard teaching error (exit 2).
    if [[ "$has_inbox_bare" == "true" && "$has_inbox_silent" != "true" && "$has_inbox_wake" != "true" ]]; then
        cmd_msg_inbox_bare_error
    fi
    if [[ "$has_inbox_silent" == "true" && "$has_inbox_wake" == "true" ]]; then
        echo "Error: pass exactly one of --inbox-silent or --inbox-wake" >&2
        exit 2
    fi
    if [[ "$has_inbox_silent" == "true" || "$has_inbox_wake" == "true" ]]; then
        local target="$1"; shift
        local mode="silent"
        [[ "$has_inbox_wake" == "true" ]] && mode="wake"
        local rest=()
        for arg in "$@"; do
            case "$arg" in
                --inbox|--inbox-silent|--inbox-wake) continue ;;
                *) rest+=("$arg") ;;
            esac
        done
        cmd_msg_inbox_form "$target" "$mode" "${rest[@]+"${rest[@]}"}"
        return $?
    fi
    # Bare --inbox alone already exited; any leftover bare with mode was stripped.
    cmd_msg "$@"
}

# ── Phase 2.1: checkin --status / --done flag handlers ───────────────

cmd_checkin_v2() {
    # Detect --status or --done flags; dispatch to legacy cmd_status /
    # cmd_done. Without those flags, defer to legacy cmd_checkin.
    local has_status="false" has_done="false"
    for arg in "$@"; do
        case "$arg" in
            --status) has_status="true" ;;
            --done) has_done="true" ;;
        esac
    done
    if [[ "$has_done" == "true" ]]; then
        local blocked=""
        local agent_arg="${K2SO_AGENT_NAME:-}"
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --done) shift ;;
                --blocked) blocked="$2"; shift 2 ;;
                --agent) agent_arg="$2"; shift 2 ;;
                *) shift ;;
            esac
        done
        local args=("--agent" "$agent_arg")
        [[ -n "$blocked" ]] && args+=("--blocked" "$blocked")
        cmd_done "${args[@]}"
    elif [[ "$has_status" == "true" ]]; then
        local message=""
        local agent_arg="${K2SO_AGENT_NAME:-}"
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --status) message="$2"; shift 2 ;;
                --agent) agent_arg="$2"; shift 2 ;;
                *) shift ;;
            esac
        done
        cmd_status "--agent" "$agent_arg" "$message"
    else
        cmd_checkin "$@"
    fi
}

# ── Phase 2.1: commit --merge flag handler ───────────────────────────

cmd_commit_v2() {
    local has_merge="false"
    for arg in "$@"; do
        [[ "$arg" == "--merge" ]] && has_merge="true"
    done
    if [[ "$has_merge" == "true" ]]; then
        # Strip --merge and call commit-merge.
        local rest=()
        for arg in "$@"; do
            [[ "$arg" == "--merge" ]] && continue
            rest+=("$arg")
        done
        cmd_commit_merge "${rest[@]}"
    else
        cmd_commit "$@"
    fi
}

# ── Phase 2.1: update --cli / --app flag handler ─────────────────────

cmd_update_v2() {
    local target="app"  # default per mock: `update` = `update --app`
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --app)  target="app";  shift ;;
            --cli)  target="cli";  shift ;;
            --list) cmd_app_update --list; return ;;
            *) shift ;;
        esac
    done
    if [[ "$target" == "cli" ]]; then
        cmd_update "$@"
    else
        cmd_app_update "$@"
    fi
}

# ── Federation (cross-server agent comms) ────────────────────────────
# DARK by default: the daemon 404s every /cli/federation/* route unless it
# was started with K2_FEDERATION=1. SSOT: prd-cross-server-agent-comms.md.
#
#   k2 fed pubkey [--pem|--fingerprint|--json]   export THIS box's SPKI pubkey
#   k2 fed send <peer>::<workspace>::<agent> "message"
#   k2 fed outbox                                queued + dead-lettered per peer
#   k2 fed pair-request --pubkey <spki.pem> [--label L] [--subdomain S]
#   k2 fed confirm <fingerprint> <sas-code>
#
# send + confirm are OWNER-gated (they need ~/.k2/daemon.token). pubkey is
# pure-CLI (reads the on-box tunnel key) so it works even when federation is
# dark — you need your key to bootstrap the very first pairing.
cmd_fed() {
    local owner_token=""
    local _tok_file="$K2_HOME/daemon.token"
    [ -f "$_tok_file" ] && owner_token=$(cat "$_tok_file" 2>/dev/null | tr -d '[:space:]')

    local sub="${1:-}"; shift || true
    case "$sub" in
        send)
            local to="${1:-}"; local text="${2:-}"
            if [ -z "$to" ] || [ -z "$text" ]; then
                echo "usage: k2 fed send <peer>::<workspace>::<agent> \"message\"" >&2
                exit 2
            fi
            if [ -z "$owner_token" ]; then
                echo "k2 fed send: no owner token (need $_tok_file)" >&2
                exit 1
            fi
            # GAP #3: carry the SOURCE workspace ($PROJECT, resolved at the
            # top of this script from K2_PROJECT_PATH/CWD — same source
            # cmd_connections uses). The daemon GATES the cross-daemon send
            # on `is_remote_connection(from_workspace, <agent>::<host>)`:
            # an agent may only message a peer its workspace is connected
            # to. (Owner-remote `k2 talk` is a different, ungated path.)
            local body
            body=$(python3 -c 'import json,sys; print(json.dumps({"to":sys.argv[1],"text":sys.argv[2],"from_workspace":sys.argv[3]}))' "$to" "$text" "$PROJECT")
            curl -s -X POST "${BASE_URL}/cli/federation/send?token=${owner_token}" \
                --connect-timeout 5 --max-time 60 \
                -H "Content-Type: application/json" \
                --data-raw "$body" 2>/dev/null
            echo
            ;;
        pair-request)
            local pubkey_file="" label="" subdomain=""
            while [ $# -gt 0 ]; do
                case "$1" in
                    --pubkey) pubkey_file="${2:-}"; shift 2 ;;
                    --pubkey=*) pubkey_file="${1#--pubkey=}"; shift ;;
                    --label) label="${2:-}"; shift 2 ;;
                    --label=*) label="${1#--label=}"; shift ;;
                    --subdomain) subdomain="${2:-}"; shift 2 ;;
                    --subdomain=*) subdomain="${1#--subdomain=}"; shift ;;
                    *) echo "k2 fed pair-request: unknown arg: $1" >&2; exit 2 ;;
                esac
            done
            if [ -z "$pubkey_file" ] || [ ! -f "$pubkey_file" ]; then
                echo "usage: k2 fed pair-request --pubkey <spki.pem> [--label L] [--subdomain S]" >&2
                exit 2
            fi
            local body
            body=$(python3 -c 'import json,sys; print(json.dumps({"label":sys.argv[1],"subdomain":sys.argv[2],"public_key_pem":open(sys.argv[3]).read()}))' "$label" "$subdomain" "$pubkey_file")
            # UNAUTH route (creates only a Pending peer).
            curl -s -X POST "${BASE_URL}/cli/federation/pair/request" \
                --connect-timeout 5 --max-time 30 \
                -H "Content-Type: application/json" \
                --data-raw "$body" 2>/dev/null
            echo
            ;;
        confirm)
            local fp="${1:-}"; local sas="${2:-}"
            if [ -z "$fp" ] || [ -z "$sas" ]; then
                echo "usage: k2 fed confirm <fingerprint> <sas-code>" >&2
                exit 2
            fi
            if [ -z "$owner_token" ]; then
                echo "k2 fed confirm: no owner token (need $_tok_file)" >&2
                exit 1
            fi
            local body
            body=$(python3 -c 'import json,sys; print(json.dumps({"fingerprint":sys.argv[1],"sas":sys.argv[2]}))' "$fp" "$sas")
            curl -s -X POST "${BASE_URL}/cli/federation/pair/confirm?token=${owner_token}" \
                --connect-timeout 5 --max-time 30 \
                -H "Content-Type: application/json" \
                --data-raw "$body" 2>/dev/null
            echo
            ;;
        pubkey)
            # Export THIS box's federation identity — the SPKI public key PEM a
            # peer pins via `k2 fed pair-request --pubkey`. Pure-CLI: derive it
            # from the on-box ECDSA P-256 tunnel key with openssl, so it works
            # even when K2_FEDERATION is off (you need the key to START pairing).
            # fingerprint = sha256(SPKI DER) hex — matches the daemon's
            # federation::peers::fingerprint_of_spki_der.
            local key_file="$K2_HOME/tunnel-key.pem"
            local want="${1:-}"
            if [ ! -f "$key_file" ]; then
                echo "k2 fed pubkey: no federation key at $key_file (start the daemon once to generate it)" >&2
                exit 1
            fi
            if ! command -v openssl >/dev/null 2>&1; then
                echo "k2 fed pubkey: openssl not found on PATH" >&2
                exit 1
            fi
            local pem fp
            pem=$(openssl pkey -in "$key_file" -pubout 2>/dev/null) || {
                echo "k2 fed pubkey: failed to derive SPKI public key from $key_file" >&2; exit 1; }
            fp=$(openssl pkey -in "$key_file" -pubout -outform DER 2>/dev/null | shasum -a 256 | awk '{print $1}')
            case "$want" in
                --fingerprint|--fp) printf '%s\n' "$fp" ;;
                --json) python3 -c 'import json,sys; print(json.dumps({"public_key_pem":sys.argv[1],"fingerprint":sys.argv[2]}))' "$pem" "$fp" ;;
                ""|--pem) printf '%s\n' "$pem"; printf '# fingerprint: %s\n' "$fp" >&2 ;;
                *) echo "usage: k2 fed pubkey [--pem|--fingerprint|--json]" >&2; exit 2 ;;
            esac
            ;;
        enable|disable)
            # Flip the persisted federation master switch on THIS daemon — the
            # headless equivalent of Settings → K2 Connect → Enable federation.
            # Owner-gated via /cli/settings/update; federation::set_enabled() is
            # synced so the /cli/federation/* gate goes live/dark immediately
            # (no restart). Built for Linux headless setup.
            local fval="true"; [ "$sub" = "disable" ] && fval="false"
            cli_post_json "/cli/settings/update" "{\"federationEnabled\": $fval}" \
                | python3 -c "import json,sys
try:
    d = json.load(sys.stdin)
    print('federation: ' + ('ENABLED' if d.get('federationEnabled') else 'disabled') + ' (this server)')
except Exception:
    sys.stderr.write('k2 fed: unexpected response from /cli/settings/update\n'); sys.exit(1)"
            ;;
        status)
            cli_request "/cli/settings/get" \
                | python3 -c "import json,sys
try:
    d = json.load(sys.stdin)
    print('federation: ' + ('ENABLED' if d.get('federationEnabled') else 'disabled') + ' (this server)')
except Exception:
    sys.stderr.write('k2 fed status: unexpected response from /cli/settings/get\n'); sys.exit(1)"
            ;;
        peers)
            # GH #48 — list pinned federation peers so asymmetric trust is
            # visible (and k2 msg can name hosts that match). Dual-auth:
            # owner token or agent passport via cli_send.
            cli_send cli_request "/cli/federation/peers" | python3 -c "
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.stderr.write('k2 fed peers: could not parse response\n'); sys.exit(1)
if isinstance(d, dict) and d.get('error'):
    err = d['error']
    if isinstance(err, dict):
        sys.stderr.write('k2 fed peers: %s\n' % (err.get('hint') or err.get('code') or err))
    else:
        sys.stderr.write('k2 fed peers: %s\n' % err)
    sys.exit(1)
peers = d.get('peers', []) if isinstance(d, dict) else []
if not peers:
    print('No federation peers pinned on this server.')
    print('Pair with: k2 fed pair-request / k2 fed confirm (or Settings → Connections auto-pair).')
    sys.exit(0)
print('Peers (%d):' % len(peers))
for p in peers:
    sub = (p.get('subdomain') or '').strip()
    host = (sub + '.k2.dev') if sub and not sub.endswith('.k2.dev') else (sub or '—')
    label = p.get('label') or ''
    trust = p.get('trust') or '?'
    fp = (p.get('fingerprint') or '')[:16]
    extra = ('  label=%s' % label) if label else ''
    print('  %s  trust=%s  fp=%s…%s' % (host, trust, fp, extra))
"
            ;;
        outbox)
            # The truthful surface for the outbox drain: per peer, how many
            # cross-server messages are still QUEUED (waiting for the peer to
            # become reachable — the drain retries with backoff) and what got
            # DEAD-LETTERED (terminal failures kept for inspection).
            if [ -z "$owner_token" ]; then
                echo "k2 fed outbox: no owner token (need $_tok_file)" >&2
                exit 1
            fi
            curl -s "${BASE_URL}/cli/federation/outbox?token=${owner_token}" \
                --connect-timeout 5 --max-time 30 2>/dev/null \
                | python3 -c "import json,sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.stderr.write('k2 fed outbox: unexpected response (is federation on?)\n'); sys.exit(1)
if 'error' in d:
    sys.stderr.write('k2 fed outbox: ' + str(d['error']) + '\n'); sys.exit(1)
peers = d.get('peers', [])
if not peers:
    print('outbox: empty (no queued or dead-lettered cross-server messages)')
    sys.exit(0)
for p in peers:
    who = p.get('label') or p.get('subdomain') or p.get('fingerprint','')[:12]
    line = f\"{who}: {p.get('queued',0)} queued\"
    age = p.get('oldest_age_secs')
    if age is not None:
        line += f' (oldest {age}s)'
    line += f\", {p.get('dead',0)} dead-lettered\"
    print(line)
    for dl in p.get('dead_letters', [])[:5]:
        print(f\"  dead {dl.get('msg_uuid','')[:8]}… — {dl.get('reason','')}\")
print(f\"total queued: {d.get('total_queued',0)}\")"
            ;;
        *)
            echo "usage: k2 fed <enable|disable|status|peers|pubkey|send|outbox|pair-request|confirm> ..." >&2
            echo "  enable/disable/status: flip the persisted federation switch (headless-friendly)" >&2
            echo "  peers: list pinned servers (use their host with k2 msg agent::host)" >&2
            echo "  send/outbox/pair-request/confirm need federation ON; pubkey works anytime" >&2
            echo "  outbox: queued + dead-lettered cross-server messages per peer" >&2
            exit 2
            ;;
    esac
}

# ── Feedback (F1) — ask a human for input, durably ───────────────────
#
# `k2 tickets` (alias: `k2 tickets`) files agent→human asks as durable
# items on this server's Tickets page (prd-agent-feedback-notifications, mockup:
# .k2/notes/feedback-cli-mockup.md — the help text below is that
# mockup VERBATIM; it passed the 36/36 comprehension gate).
#
# Contract highlights (pinned):
# - Success output human-readable; --json flips it to JSON.
# - ERRORS are ALWAYS JSON on stderr ({"error":{"code","hint"}})
#   regardless of --json.
# - Exit codes: 0 ok · 1 error · 2 bad usage · 4 not found (ambiguous
#   id prefix = 4 too, candidates in the hint).
# - `ask --wait` prints the BARE answer to stdout (exit 0);
#   resolved/dismissed WITHOUT an answer → empty stdout +
#   {"error":{"code":"closed_unanswered"}} on stderr + exit 1;
#   --timeout → {"error":{"code":"timeout"}} + exit 1, item STAYS
#   waiting.

# Note: `k2 tickets` remains a compatibility alias for `k2 tickets`.
# Product "Feedback" (K2 itself) is a future separate channel — use
# tickets for human contact on this server.

_feedback_err() {
    local code="$1" hint="$2"
    CODE="$code" HINT="$hint" python3 -c 'import json,os
print(json.dumps({"error": {"code": os.environ["CODE"], "hint": os.environ["HINT"]}}))' >&2 \
        || echo "Error ($code): $hint" >&2
}

# Session auto-detection (feedback F1): the asking session's id + kind
# from the environment, first match wins:
#   1. K2_SESSION_ID — the daemon stages this into SANDBOX cells
#      (v1_sandboxes/policy.rs: guest runs `claude --session-id $K2_SESSION_ID`).
#   2. CLAUDE_SESSION_ID — reserved hook-context spelling (PRD §4.2).
#   3. CLAUDE_CODE_SESSION_ID — what Claude Code actually exports into
#      Bash-tool subshells; in a K2 canonical (pinned-chat) session it
#      equals the forced `claude --session-id <id>`.
# Nothing found → both stay empty (a session-less ask must still work).
_feedback_detect_session() {
    FB_SESSION_ID=""
    FB_SESSION_KIND=""
    if [ -n "${K2_SESSION_ID:-}" ]; then
        FB_SESSION_ID="$K2_SESSION_ID"; FB_SESSION_KIND="sandbox"
    elif [ -n "${CLAUDE_SESSION_ID:-}" ]; then
        FB_SESSION_ID="$CLAUDE_SESSION_ID"; FB_SESSION_KIND="canonical"
    elif [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then
        FB_SESSION_ID="$CLAUDE_CODE_SESSION_ID"; FB_SESSION_KIND="canonical"
    fi
}

cmd_feedback_ask() {
    if _wants_help "$@"; then cmd_help_feedback_ask; exit 0; fi
    local title="" body="" body_file="" kind="" options="" priority=""
    local wait=false timeout="" as_json=false
    while [ $# -gt 0 ]; do
        case "$1" in
            --body)
                [ $# -ge 2 ] || { _feedback_err "usage" "--body requires a value"; exit 2; }
                body="$2"; shift 2 ;;
            --body-file)
                [ $# -ge 2 ] || { _feedback_err "usage" "--body-file requires a file path"; exit 2; }
                body_file="$2"; shift 2 ;;
            --kind)
                [ $# -ge 2 ] || { _feedback_err "usage" "--kind requires a value (question | approval | fyi)"; exit 2; }
                kind="$2"; shift 2 ;;
            --options)
                [ $# -ge 2 ] || { _feedback_err "usage" "--options requires a comma-separated list (e.g. \"Ship it,Hold\")"; exit 2; }
                options="$2"; shift 2 ;;
            --priority)
                [ $# -ge 2 ] || { _feedback_err "usage" "--priority requires a value (1-5)"; exit 2; }
                priority="$2"; shift 2 ;;
            --wait) wait=true; shift ;;
            --timeout)
                [ $# -ge 2 ] || { _feedback_err "usage" "--timeout requires a value in seconds"; exit 2; }
                timeout="$2"; shift 2 ;;
            --json) as_json=true; shift ;;
            -*)
                _feedback_err "usage" "unknown flag '$1' — usage: k2 tickets ask <title> [--body|--body-file f] [--kind k] [--options a,b,c] [--priority 1-5] [--wait [--timeout s]] [--json]"
                exit 2 ;;
            *)
                if [ -z "$title" ]; then title="$1"; else
                    _feedback_err "usage" "unexpected extra argument '$1' — quote the title if it contains spaces"
                    exit 2
                fi
                shift ;;
        esac
    done
    if [ -z "$title" ]; then
        _feedback_err "usage" "ask requires a <title>"
        exit 2
    fi
    case "${kind:-question}" in
        question|approval|fyi) ;;
        *)
            _feedback_err "usage" "invalid --kind '$kind' — valid: question, approval, fyi"
            exit 2 ;;
    esac
    if [ -n "$priority" ]; then
        case "$priority" in
            1|2|3|4|5) ;;
            *)
                _feedback_err "usage" "--priority must be 1-5"
                exit 2 ;;
        esac
    fi
    if [ -n "$body" ] && [ -n "$body_file" ]; then
        _feedback_err "usage" "--body and --body-file are mutually exclusive"
        exit 2
    fi
    if [ -n "$body_file" ]; then
        if [ ! -f "$body_file" ]; then
            _feedback_err "usage" "--body-file: no such file '$body_file'"
            exit 2
        fi
        body="$(cat "$body_file")" || {
            _feedback_err "usage" "--body-file: cannot read '$body_file'"
            exit 2
        }
    fi
    if [ -n "$timeout" ]; then
        if ! $wait; then
            _feedback_err "usage" "--timeout only makes sense with --wait"
            exit 2
        fi
        case "$timeout" in
            ''|*[!0-9]*|0)
                _feedback_err "usage" "--timeout must be a positive number of seconds"
                exit 2 ;;
        esac
    fi
    _feedback_detect_session
    FB_TITLE="$title" FB_BODY="$body" FB_KIND="$kind" FB_OPTIONS="$options" \
    FB_PRIORITY="$priority" FB_WAIT="$wait" FB_TIMEOUT="$timeout" FB_JSON="$as_json" \
    FB_PROJECT="$PROJECT" FB_AGENT="${K2_AGENT_NAME:-${K2SO_AGENT_NAME:-}}" \
    FB_SESSION_ID="$FB_SESSION_ID" FB_SESSION_KIND="$FB_SESSION_KIND" \
    ABASE="$BASE_URL" ATOKEN="$TOKEN" python3 - <<'PYEOF'
import json, os, re, sys, time
import urllib.error, urllib.parse, urllib.request

base = os.environ["ABASE"]
token = os.environ["ATOKEN"]
as_json = os.environ.get("FB_JSON") == "true"
wait = os.environ.get("FB_WAIT") == "true"
timeout = os.environ.get("FB_TIMEOUT", "")

def die(err, exit_code=None):
    # Errors are ALWAYS JSON on stderr, regardless of --json.
    if isinstance(err, str):
        err = {"code": "error", "hint": err}
    sys.stderr.write(json.dumps({"error": err}) + "\n")
    if exit_code is None:
        code = err.get("code")
        exit_code = 4 if code in ("not_found", "ambiguous_id") else 2 if code == "usage" else 1
    sys.exit(exit_code)

def request(method, route, params=None, body=None):
    qs = urllib.parse.urlencode(dict(params or {}, token=token))
    url = base + route + "?" + qs
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method,
        headers={"Content-Type": "application/json"} if data else {})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.loads(r.read().decode("utf-8", "replace"))
    except urllib.error.HTTPError as e:
        try:
            return json.loads(e.read().decode("utf-8", "replace"))
        except Exception:
            return {"error": {"code": "error", "hint": "HTTP %s on %s" % (e.code, route)}}
    except Exception:
        return None

payload = {
    "project": os.environ["FB_PROJECT"],
    "title": os.environ["FB_TITLE"],
}
if os.environ.get("FB_BODY"):
    payload["body"] = os.environ["FB_BODY"]
if os.environ.get("FB_KIND"):
    payload["kind"] = os.environ["FB_KIND"]
if os.environ.get("FB_PRIORITY"):
    payload["priority"] = int(os.environ["FB_PRIORITY"])
if os.environ.get("FB_OPTIONS"):
    # Split on unescaped commas only; "\," inside an option is a literal comma.
    raw = re.split(r"(?<!\\),", os.environ["FB_OPTIONS"])
    opts = [o for o in (p.strip().replace("\\,", ",") for p in raw) if o]
    if opts:
        payload["options"] = opts
if os.environ.get("FB_AGENT"):
    payload["agentName"] = os.environ["FB_AGENT"]
# Session auto-detection result (may be absent — must not fail the ask).
if os.environ.get("FB_SESSION_ID"):
    payload["sessionId"] = os.environ["FB_SESSION_ID"]
    if os.environ.get("FB_SESSION_KIND"):
        payload["sessionKind"] = os.environ["FB_SESSION_KIND"]

d = request("POST", "/cli/feedback/create", body=payload)
if d is None:
    die({"code": "daemon_unreachable", "hint": "no response from the K2 daemon (is it running?)"})
if d.get("error"):
    die(d["error"])
if not d.get("ok"):
    die({"code": "error", "hint": "unexpected daemon response: %r" % json.dumps(d)[:200]})

fid = d["id"]

if not wait:
    if as_json:
        print(json.dumps(d))
    else:
        short = fid[:8]
        print('Filed feedback %s — "%s" (%s, priority %s, %s)'
              % (short, d.get("title", ""), d.get("kind", "?"),
                 d.get("priority", "?"), d.get("status", "?")))
        print("A human will be notified. Check back with: k2 tickets show %s" % short)
    sys.exit(0)

# ── --wait: poll `show` (~2s) until answered / closed / timeout ──────
# Pinned contract: BARE answer to stdout + exit 0 on answered (also on
# resolved/dismissed WITH an answer); closed WITHOUT an answer →
# {"error":{"code":"closed_unanswered"}} on stderr + exit 1; timeout →
# {"error":{"code":"timeout"}} on stderr + exit 1 and the item STAYS
# waiting (we just stop polling). Transient poll failures are retried —
# a daemon blip must not fake a closed_unanswered.
deadline = time.time() + int(timeout) if timeout else None
while True:
    d = request("GET", "/cli/feedback/show", params={"id": fid})
    if isinstance(d, dict) and d.get("ok"):
        status = d.get("status")
        answer = d.get("answer")
        if status == "answered" and answer:
            print(answer)
            sys.exit(0)
        if status in ("resolved", "dismissed"):
            if answer:
                print(answer)
                sys.exit(0)
            sys.stderr.write('{"error":{"code":"closed_unanswered"}}\n')
            sys.exit(1)
    if deadline is not None and time.time() >= deadline:
        sys.stderr.write('{"error":{"code":"timeout"}}\n')
        sys.exit(1)
    nap = 2.0
    if deadline is not None:
        nap = max(0.1, min(nap, deadline - time.time()))
    time.sleep(nap)
PYEOF
}

