{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`POST /api/v1/channels/{id}/call/ring` body (§15.4).",
  "properties": {
    "call_id": {
      "description": "The active call.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "member_ids": {
      "description": "Whom to ring (default: every ringable member not in the call and not ringing).",
      "items": {
        "description": "A Sew id: a decimal string of a 64-bit time-sortable id (1 to 9223372036854775807).",
        "pattern": "^[1-9][0-9]{0,18}$",
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    }
  },
  "required": [
    "call_id"
  ],
  "title": "CallRingRequest",
  "type": "object"
}
