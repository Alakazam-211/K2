{
  "$schema": "../style.schema.json#/$defs/tokens",
  "radius": {
    "box": {
      "$value": "16px",
      "$type": "dimension",
      "$description": "Tiles, cards, dialogs, menus."
    },
    "field": {
      "$value": "22px",
      "$type": "dimension",
      "$description": "Text fields and buttons. At desktop control heights this draws a full pill, as on the phone."
    },
    "field-multiline": {
      "$value": "12px",
      "$type": "dimension",
      "$description": "Multi-line text boxes (textareas). A pill is wrong for a box: a soft corner a step under the tile's, like the phone's note and outcome boxes."
    },
    "selector": {
      "$value": "16px",
      "$type": "dimension",
      "$description": "Round controls and chips. On a small control this draws a circle."
    },
    "pill": {
      "$value": "999px",
      "$type": "dimension",
      "$description": "Fully round controls."
    },
    "badge": {
      "$value": "9999px",
      "$type": "dimension",
      "$description": "Status dots and notification badges."
    },
    "status": {
      "$value": "9999px",
      "$type": "dimension",
      "$description": "Agent status marks (needs you, monitoring, no update, live, the working grid's cells). Glass draws them as circles."
    }
  },
  "chamfer": {
    "surface": {
      "$value": "0px",
      "$type": "dimension"
    },
    "control": {
      "$value": "0px",
      "$type": "dimension"
    },
    "chip": {
      "$value": "0px",
      "$type": "dimension"
    },
    "send": {
      "$value": "0px",
      "$type": "dimension"
    }
  },
  "control": {
    "check": {
      "$value": "16px",
      "$type": "dimension"
    },
    "switch-width": {
      "$value": "38px",
      "$type": "dimension"
    },
    "switch-height": {
      "$value": "22px",
      "$type": "dimension"
    },
    "switch-knob": {
      "$value": "18px",
      "$type": "dimension"
    },
    "slider-track": {
      "$value": "4px",
      "$type": "dimension"
    },
    "slider-thumb": {
      "$value": "16px",
      "$type": "dimension"
    },
    "switch-sm-width": {
      "$value": "30px",
      "$type": "dimension"
    },
    "switch-sm-height": {
      "$value": "18px",
      "$type": "dimension"
    },
    "switch-sm-knob": {
      "$value": "14px",
      "$type": "dimension"
    }
  },
  "gap": {
    "pane": {
      "$value": "8px",
      "$type": "dimension"
    },
    "tile": {
      "$value": "4px",
      "$type": "dimension"
    },
    "section": {
      "$value": "0px",
      "$type": "dimension"
    }
  },
  "inset": {
    "window": {
      "$value": "8px",
      "$type": "dimension",
      "$description": "The whole workspace floats on the near-black canvas."
    }
  },
  "divider": {
    "width": {
      "$value": "8px",
      "$type": "dimension",
      "$description": "2 × gap.tile, so the drag strip fills the seam."
    },
    "color": {
      "$value": "transparent",
      "$type": "color",
      "$description": "Seams are open canvas; the hover accent stays as the drag cue."
    }
  },
  "ring": {
    "surface": {
      "$value": "0 0 #0000",
      "$type": "shadow",
      "$description": "Tiles carry their own edge and sheen, so the plain ring is off."
    },
    "field": {
      "$value": "inset 0 1px 0 0 var(--color-ring-edge)",
      "$type": "shadow",
      "$description": "The light catch along a control's top edge."
    },
    "focus": {
      "$value": "0 0 0 2px color-mix(in srgb, var(--color-accent) 40%, transparent)",
      "$type": "shadow"
    }
  },
  "shadow": {
    "1": {
      "$value": "0 1px 2px var(--color-shadow-soft)",
      "$type": "shadow"
    },
    "2": {
      "$value": "0 4px 12px var(--color-shadow-soft)",
      "$type": "shadow"
    },
    "3": {
      "$value": "0 8px 24px var(--color-shadow)",
      "$type": "shadow"
    },
    "4": {
      "$value": "0 16px 40px var(--color-shadow)",
      "$type": "shadow"
    },
    "5": {
      "$value": "0 24px 64px var(--color-shadow), 0 4px 16px var(--color-shadow-soft)",
      "$type": "shadow"
    }
  },
  "material": {
    "blur": {
      "$value": "28px",
      "$type": "dimension",
      "$description": "Frost. Companion's .zen-glass."
    },
    "saturate": {
      "$value": "180%",
      "$type": "dimension"
    },
    "tint": {
      "$value": "var(--color-frost-fill)",
      "$type": "color",
      "$description": "Palette slot: white over dark, milky over light."
    },
    "tint-opacity": {
      "$value": 0.1,
      "$type": "number"
    },
    "edge": {
      "$value": "var(--color-frost-edge)",
      "$type": "color"
    },
    "sheen": {
      "$value": "inset 0 1px 0 var(--color-frost-sheen)",
      "$type": "shadow"
    }
  },
  "tile": {
    "fill": {
      "$value": "var(--color-bg-surface)",
      "$type": "color"
    },
    "raised": {
      "$value": "var(--color-bg-elevated)",
      "$type": "color"
    },
    "edge": {
      "$value": "color-mix(in srgb, var(--color-border) 55%, color-mix(in srgb, var(--color-text-primary) 14%, transparent))",
      "$type": "color",
      "$description": "Companion's .k2-tile rim: the glass is the edge."
    },
    "sheen": {
      "$value": "inset 0 1px 0 var(--color-ring-edge-strong)",
      "$type": "shadow",
      "$description": "White at 22% on dark, Companion's value."
    },
    "shadow": {
      "$value": "0 10px 30px color-mix(in srgb, black 8%, transparent)",
      "$type": "shadow"
    }
  },
  "density": {
    "scale": {
      "$value": 1,
      "$type": "number"
    }
  },
  "motion": {
    "duration-fast": {
      "$value": "140ms",
      "$type": "duration"
    },
    "duration-medium": {
      "$value": "180ms",
      "$type": "duration"
    },
    "duration-slow": {
      "$value": "320ms",
      "$type": "duration"
    },
    "ease-standard": {
      "$value": "cubic-bezier(0.22, 1, 0.36, 1)",
      "$type": "cubicBezier",
      "$description": "Companion's soft-out."
    },
    "ease-out-soft": {
      "$value": "cubic-bezier(0.22, 1, 0.36, 1)",
      "$type": "cubicBezier"
    },
    "press-scale": {
      "$value": 1.045,
      "$type": "number",
      "$description": "Read by the press spring (later half of S4)."
    }
  },
  "font": {
    "ui": {
      "$value": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI Variable Text', 'Segoe UI', Roboto, 'Noto Sans', 'Helvetica Neue', Arial, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji'",
      "$type": "fontFamily",
      "$description": "The system UI face. Nothing bundled."
    },
    "display": {
      "$value": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI Variable Text', 'Segoe UI', Roboto, 'Noto Sans', 'Helvetica Neue', Arial, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji'",
      "$type": "fontFamily"
    },
    "code": {
      "$value": "'MesloLGM Nerd Font', Menlo, Monaco, 'Cascadia Code', 'Fira Code', 'SF Mono', Consolas, monospace, 'Apple Color Emoji', 'Segoe UI Emoji'",
      "$type": "fontFamily",
      "$description": "Terminals stay Meslo."
    }
  },
  "type": {
    "micro": {
      "$value": "9px",
      "$type": "dimension"
    },
    "xs": {
      "$value": "10px",
      "$type": "dimension"
    },
    "sm": {
      "$value": "11px",
      "$type": "dimension"
    },
    "md": {
      "$value": "12px",
      "$type": "dimension"
    },
    "lg": {
      "$value": "13px",
      "$type": "dimension"
    },
    "xl": {
      "$value": "15px",
      "$type": "dimension"
    }
  }
}