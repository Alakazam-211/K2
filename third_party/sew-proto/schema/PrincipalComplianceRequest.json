{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Body of `POST /mgmt/v1/principals/compliance` (S23 §6.3): grant or revoke the compliance\nflag. Returns `ComplianceFlagResponse`.",
  "properties": {
    "compliance": {
      "description": "Grant (`true`) or revoke (`false`).",
      "type": "boolean"
    },
    "external_id": {
      "description": "The member.",
      "maxLength": 128,
      "pattern": "^(k2:(principal|workspace|connect):[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|k2:owner|local:[a-z0-9_-]{2,64}|link:[1-9][0-9]{0,18}:[A-Z2-7]{16})$",
      "type": "string"
    }
  },
  "required": [
    "external_id",
    "compliance"
  ],
  "title": "PrincipalComplianceRequest",
  "type": "object"
}
