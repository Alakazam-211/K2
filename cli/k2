                esac
            done
            if [ -n "$key" ]; then
                cli_request "/cli/agent-instances" "key=$(urlencode "$key")" | _hire_print instances "$as_json"
            else
                cli_request "/cli/agent-instances" | _hire_print instances "$as_json"
            fi ;;
