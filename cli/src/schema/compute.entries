        {"name": "--refresh", "arg": null, "description": "With list: ask the node for its server list now, instead of the copy K2 keeps (fetched again by itself once it is old)."},
        {"name": "--json", "arg": null, "description": "JSON output."}
      ]
    },
    {
      "name": "compute node servers add",
      "usage": "k2 compute node servers <node> add --url URL --code CODE.FP|- [--trust own|team] [--for 7d|none] [--weight N] [--max-running N] [--max-queued N] [--cpu-hours N] [--max-time 2h] [--cpus N] [--mem 8G] [--disk 40G] [--network on|no-lan|none] [--gate] [--exclusive]",
      "description": "Add another K2 server to a node you own. Held for your approval (Touch ID or vault password); the new server's owner then confirms the SAS. Needs the node's remote-admin level full.",
      "args": [{"name": "node", "required": true}],
      "flags": [
        {"name": "--url", "arg": "URL", "description": "The new server's URL."},
        {"name": "--code", "arg": "CODE.FP|-", "description": "What k2 compute node add <node> printed on the new server; - reads it from stdin, never in argv."},
        {"name": "--trust", "arg": "own|team", "description": "How far the new server is trusted."},
        {"name": "--for", "arg": "7d|none", "description": "How long the share lasts."},
        {"name": "--weight", "arg": "N", "description": "Its share weight (every server starts at 1)."},
        {"name": "--max-running", "arg": "N", "description": "At most N running jobs."},
        {"name": "--max-queued", "arg": "N", "description": "At most N queued jobs."},
        {"name": "--cpu-hours", "arg": "N", "description": "CPU hours a day."},
        {"name": "--max-time", "arg": "2h", "description": "The longest job."},
        {"name": "--cpus", "arg": "N", "description": "The most cores per job."},
        {"name": "--mem", "arg": "8G", "description": "The most memory per job."},
        {"name": "--disk", "arg": "40G", "description": "Its disk."},
        {"name": "--network", "arg": "on|no-lan|none", "description": "The jobs' network (no-lan on a Mac: the internet over HTTPS through a per-job proxy, never the local network)."},
        {"name": "--gate", "arg": null, "description": "It may send CI gate jobs."},
        {"name": "--exclusive", "arg": null, "description": "It may send --exclusive jobs."}
      ]
    },
    {
      "name": "compute node servers approve",
      "usage": "k2 compute node servers <node> approve <request>",
      "description": "Approve a held servers request (the same as node admin approve). Owner only.",
