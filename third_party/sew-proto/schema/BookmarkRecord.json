{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`bookmarks.ndjson`.",
  "properties": {
    "channel_id": {
      "description": "Its channel.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "created_at": {
      "description": "Created.",
      "format": "date-time",
      "type": "string"
    },
    "created_by": {
      "description": "Creator.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "data": {
      "description": "The decrypted bookmark object (`{title, url, emoji?}`); absent when unreadable."
    },
    "id": {
      "description": "The bookmark id.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "position": {
      "description": "Order.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "updated_at": {
      "description": "Last change.",
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "id",
    "channel_id",
    "position",
    "created_by",
    "created_at",
    "updated_at"
  ],
  "title": "BookmarkRecord",
  "type": "object"
}
