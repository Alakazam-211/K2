      "args": [{"name": "f", "required": true, "description": "The doc's path; it is the last argument."}],
      "flags": [
        {"name": "--participant", "arg": "P", "description": "Who to erase."},
        {"name": "--pseudonym", "arg": "NAME", "description": "The name that stands in."}
      ]
    },
    {
      "name": "doc share",
      "usage": "k2 doc share <file-or-folder> --with <ws> [--write] [--history] [--comment] -w <ws>",
      "description": "People only: share a file or folder with another workspace.",
      "args": [{"name": "file-or-folder", "required": true}],
