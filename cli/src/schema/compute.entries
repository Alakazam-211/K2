    {
      "name": "compute",
      "usage": "k2 compute <nodes|status|info|run|test|prewarm|jobs|get|fetch|wait|attach|logs|rightsize|stats|cancel|retry|events|cache|queue|retier|move|allow-nodes|git-access|receipt|provenance|verify|node|grant|revoke|grants|access|operate|manage|usage|preview|placement|roster|lanes|seats|trust|owners|local> [...]",
      "description": "Run commands on your own machines (compute nodes). Exit codes: 0 to 255 the command's own exit (attached runs), 2 bad usage, 3 infra with a JSON code on stderr (node_offline, not_granted, compute_off, queue_full, owner_only, job_started), 130 you detached with Ctrl-C (the job keeps running). Read k2 study compute first.",
      "args": [{"name": "verb", "required": true}],
      "flags": []
    },
    {
      "name": "compute nodes",
      "usage": "k2 compute nodes [--json]",
      "description": "Nodes granted to this workspace, with each node's platform; a row ends with reboot pending when a kernel update waits.",
      "args": [],
      "flags": [
        {"name": "--json", "arg": null, "description": "A host object per node (distro, distroVersion, pkgManager, kernel, libc, gpu, rebootRequired, line)."}
      ]
    },
    {
      "name": "compute status",
      "usage": "k2 compute status [--json]",
      "description": "Every node at a glance: state, waits, run/queue and the jobs, free CPU and memory, load, disk free vs floor; plus this controller. k2 compute status <job> is get.",
      "args": [],
      "flags": [
        {"name": "--json", "arg": null, "description": "JSON output."}
      ]
    },
    {
      "name": "compute info",
      "usage": "k2 compute info <node> [--json]",
      "description": "One node, with a host line (distro, package manager, kernel, libc, arch, GPU) and a packages line (manager, the policy for this server, open requests).",
      "args": [{"name": "node", "required": true}],
      "flags": [
        {"name": "--json", "arg": null, "description": "JSON output; host.gpus[] says which GPUs are open to this server."}
      ]
    },
    {
      "name": "compute allow-nodes",
      "usage": "k2 compute allow-nodes [<node>[,<node>…] | --add N | --remove N | --clear] [--workspace WS] [--json]",
      "description": "Show or set this workspace's node list. With one, its jobs go only to those nodes (a node named off it: node_not_allowed, exit 3). An agent may only narrow its own; adding a node or --clear is a person's, from a terminal outside K2 (an agent gets allow_nodes_needs_person, exit 3).",
      "args": [{"name": "node", "required": false}],
      "flags": [
        {"name": "--add", "arg": "NODE[,NODE…]", "description": "Add nodes to the list (a person)."},
        {"name": "--remove", "arg": "NODE[,NODE…]", "description": "Take nodes off the list."},
        {"name": "--clear", "arg": null, "description": "Remove the list: any granted node again (a person)."},
        {"name": "--workspace", "arg": "WS", "description": "Which workspace."},
        {"name": "--json", "arg": null, "description": "JSON output."}
      ]
    },
    {
      "name": "compute git-access",
      "usage": "k2 compute git-access [--workspace WS] [--json] | setup … | grant … | revoke …",
      "description": "Let this workspace's jobs read private GitHub repos with short-lived read-only tokens. Bare: the workspace's grants and this server's GitHub credential (its kind and App id; never a key or token).",
      "args": [],
      "flags": [
        {"name": "--workspace", "arg": "WS", "description": "Which workspace (default: the folder's; an agent always gets its own)."},
        {"name": "--json", "arg": null, "description": "JSON output."}
      ]
    },
    {
      "name": "compute git-access setup",
      "usage": "k2 compute git-access setup --github-app <app id> --key-file <app.pem> | --github-token-file <file> | --github-token-stdin | --clear",
      "description": "Set the server's GitHub credential, one per server. The owner or an Admin, from a terminal outside K2. An agent can't set it; it asks with k2 permission request compute.git-access-setup.",
      "args": [],
      "flags": [
        {"name": "--github-app", "arg": "APP_ID", "description": "A GitHub App's id (preferred; Contents read-only)."},
        {"name": "--key-file", "arg": "app.pem", "description": "The App's private key; it goes into this server's vault."},
        {"name": "--github-token-file", "arg": "FILE", "description": "A fine-grained token (github_pat_…) read from a file."},
        {"name": "--github-token-stdin", "arg": null, "description": "The fine-grained token on stdin."},
        {"name": "--clear", "arg": null, "description": "Remove the credential."}
      ]
    },
    {
      "name": "compute git-access grant",
      "usage": "k2 compute git-access grant --github <owner>/<repo>[,<owner>/<repo>…] [--nodes all|<node>[,<node>…]] [--shared] [--workspace WS]",
      "description": "Let the workspace's jobs read these repos (read-only). A person grants; an agent gets git_access_needs_person (exit 3), or git_access_needs_setup (exit 3) when the server has no credential yet.",
      "args": [],
      "flags": [
        {"name": "--github", "arg": "owner/repo[,…]", "description": "The repos."},
        {"name": "--nodes", "arg": "all|node[,node…]", "description": "Which nodes (default all: every node this server owns, now and later)."},
        {"name": "--shared", "arg": null, "description": "Needed, with the node's name, for a node another server shares with you; App tokens only."},
        {"name": "--read-only", "arg": null, "description": "Accepted and changes nothing: access is always read-only."},
        {"name": "--workspace", "arg": "WS", "description": "Which workspace."}
      ]
    },
    {
      "name": "compute git-access revoke",
      "usage": "k2 compute git-access revoke --github <owner>/<repo>[,…] [--nodes …] | --all [--workspace WS]",
      "description": "Remove grants: new asks are refused at once and an App's tokens already handed out are deleted at GitHub. An agent may revoke its own workspace's.",
      "args": [],
      "flags": [
        {"name": "--github", "arg": "owner/repo[,…]", "description": "The repos."},
        {"name": "--nodes", "arg": "node[,node…]", "description": "Only on these nodes."},
        {"name": "--all", "arg": null, "description": "Every grant of the workspace."},
        {"name": "--workspace", "arg": "WS", "description": "Which workspace."}
      ]
    },
    {
      "name": "compute run",
      "usage": "k2 compute run [<node>] [--os linux|macos] [--arch A] [--distro ID[@VERSION]] [--label k=v] [--avoid N]... [--only N]... [--preset NAME] [--mem 16G|auto[:8G]] [--cpus N|N+M] [--needs tool@ver,…] [--env K=V]... [--secret NAME[=ENVNAME]]... [--sha REV] [--dirty] [--no-source] [--repo DIR] [--with DIR[@SHA]]... [--cache NAME] [--cache-required] [--timeout D] [--queue-timeout 2h|off] [--stall-timeout 30m|off] [--retries N] [--tag NAME] [--detach | --wait [--failures] [--max-wait 9m] [--quiet]] [--now] [--same-node-as JOB] [--priority --why \"…\"] [--tier standard|priority|batch|ci] [--exclusive --why \"…\"] [--gpu [any|amd|intel]] [--gpu-mem 4G] [--network none] [--netns-dummy NAME=ADDR/PREFIX]... [--shards N] [--artifact GLOB]... [--plan|--dry-run] [--json] [--workspace WS] -- <command…>",
      "description": "Run a command on a compute node. No node: K2 picks one of the nodes granted to you and prints where and why; name a node only to pin the job there. Always pass --mem. Exit: the command's own (attached runs), 2 bad usage, 3 infra with a JSON code on stderr, 130 you detached with Ctrl-C (the job keeps running). --network none (0.46.14): the job gets no network whatever its node's setting (Linux: a network namespace of its own, loopback only; macOS: no remote IP, no DNS); a job can only narrow its network. --netns-dummy (Linux only, at most 4, implies --network none): a dummy interface with that address in the job's own namespace, up before the job starts. A node that can't run it at that network never gets it: job_network_needs_update, exit 3. More: k2 study compute.",
      "args": [{"name": "node", "required": false, "description": "Pin the job to this node (full name or a start that fits only one). Leave it off unless the job needs that machine."}, {"name": "command", "required": true, "description": "After --: the command to run."}],
      "flags": [
        {"name": "--os", "arg": "linux|macos", "description": "Only nodes of that OS."},
        {"name": "--arch", "arg": "A", "description": "Only nodes of that architecture (x86_64)."},
        {"name": "--distro", "arg": "ID[@VERSION]", "description": "Only nodes of that distro: its /etc/os-release ID or ID_LIKE (ubuntu, ubuntu@24.04, debian, arch)."},
        {"name": "--label", "arg": "k=v", "description": "Pick nodes by a label the node has."},
        {"name": "--avoid", "arg": "NODE", "description": "K2 never picks that node for this job (repeatable). Not with a named node (avoid_with_pinned_node, exit 2)."},
        {"name": "--only", "arg": "NODE", "description": "K2 picks only among these nodes (repeatable). Not with a named node."},
        {"name": "--preset", "arg": "NAME", "description": "Settings from .k2/compute.toml: [defaults], then [presets.NAME]; a flag beats both."},
        {"name": "--now", "arg": null, "description": "Start at once or fail (exit 3 not_now); nothing is queued."},
        {"name": "--same-node-as", "arg": "JOB", "description": "Run on the node that ran one of your jobs and wait for it there."},
        {"name": "--tag", "arg": "NAME", "description": "A name you give the job (1 to 64 of A-Z a-z 0-9 . _ : / -) for jobs --tag and cancel --all-mine --tag."},
        {"name": "--detach", "arg": null, "description": "Return at once; the job gets a [compute] message when it ends."},
        {"name": "--sha", "arg": "REV", "description": "Ship this commit."},
        {"name": "--no-source", "arg": null, "description": "Ship no source."},
        {"name": "--dirty", "arg": null, "description": "Ship your uncommitted changes too (HEAD + the diff + untracked, not-ignored files; never .k2/)."},
        {"name": "--repo", "arg": "DIR", "description": "Ship a git repo nested in the workspace (or a worktree of one) instead of the workspace's own."},
        {"name": "--with", "arg": "DIR[@SHA]", "description": "Ship sibling repos too (up to 8, repeatable), commits only."},
        {"name": "--cache", "arg": "NAME", "description": "A folder on the node that outlives the job, per workspace and NAME: $K2_JOB_CACHE. Never with --secret."},
        {"name": "--cache-required", "arg": null, "description": "With --cache: run only on the node that holds the cache, however long it waits."},
        {"name": "--mem", "arg": "16G|auto[:8G]", "description": "The memory the job needs; left out, K2 reserves 4G. A job that uses more is stopped (failed/mem_cap). auto sizes it from this command's finished runs."},
        {"name": "--env", "arg": "K=V", "description": "An environment variable for the job (repeatable)."},
        {"name": "--cpus", "arg": "N|N+M", "description": "Cores; N+M: N guaranteed, up to M on idle cores."},
        {"name": "--secret", "arg": "NAME[=ENVNAME]", "description": "A vault secret as env, sealed to the node at spawn (repeatable); only a person grants it."},
        {"name": "--timeout", "arg": "D", "description": "The job's time limit (at most the grant's max, default 2h)."},
        {"name": "--exclusive", "arg": null, "description": "The whole node to itself; needs --why (else exit 2) and a grant with --ci, or the owner or an Admin (else exit 3 exclusive_needs_grant)."},
        {"name": "--why", "arg": "text", "description": "The one-line reason for --priority or --exclusive; it shows in the queue."},
        {"name": "--gpu", "arg": "[any|amd|intel]", "description": "One GPU of the node, to this job alone (bare --gpu = any). Needs a grant with --gpu (else no_gpu_node or gpu_needs_grant, exit 3)."},
        {"name": "--gpu-mem", "arg": "4G", "description": "Only with --gpu (alone: exit 2): the job's GPU memory budget."},
        {"name": "--network", "arg": "none", "description": "No network for this job (loopback only), whatever the node's setting; the one value is none (on, no-lan: exit 2, job_network_invalid)."},
        {"name": "--netns-dummy", "arg": "NAME=ADDR/PREFIX", "description": "Linux nodes: a dummy interface in the job's own network namespace, e.g. sewlane0=10.254.254.1/32. NAME 1-15 of A-Z a-z 0-9 . _ - (not lo); the address from a private, link-local or test range only. Repeatable, at most 4; implies --network none."},
        {"name": "--receipt-v2", "arg": null, "description": "The node signs receipt v2; only nodes on protocol 9 take it (preview: ciPreview)."},
        {"name": "--retry-interrupted", "arg": null, "description": "Retry a job that an infrastructure failure interrupted."},
        {"name": "--no-retry", "arg": null, "description": "Never retry (the same as --retries 0)."},
        {"name": "--retries", "arg": "N", "description": "Retries after infrastructure failures (default 1)."},
        {"name": "--raw", "arg": null, "description": "Raw output."},
        {"name": "--workspace", "arg": "WS", "description": "Which workspace (found for you inside the workspace or a git worktree of it)."},
        {"name": "--wait", "arg": null, "description": "Print the job id, then stream its output and exit with its code."},
        {"name": "--failures", "arg": null, "description": "With --wait: failing tests first."},
        {"name": "--max-wait", "arg": "9m", "description": "With --wait: when it passes, exit 3 still_running and the line to resume with. Counts from submit."},
        {"name": "--quiet", "arg": null, "description": "With --wait: no output, only the exit."},
        {"name": "--artifact", "arg": "GLOB", "description": "Keep files matching GLOB, relative to the job's working directory (repeatable)."},
        {"name": "--artifacts", "arg": "GLOB", "description": "The same as --artifact."},
        {"name": "--json", "arg": null, "description": "One result object on stdout (logs go to stderr)."},
        {"name": "--queue-timeout", "arg": "2h|off", "description": "How long it may wait to start (default 2h attached or --wait, 24h --detach, 48h --tier batch)."},
        {"name": "--stall-timeout", "arg": "30m|off", "description": "A job that prints nothing that long ends (default 30m); off for a job that goes quiet."},
        {"name": "--shards", "arg": "N", "description": "N jobs, {shard}/{shards} in the command, each on its own node when it can (no node named)."},
        {"name": "--priority", "arg": null, "description": "The critical path; needs --why. At most 2 Priority jobs queued or running per workspace."},
        {"name": "--tier", "arg": "standard|priority|batch|ci", "description": "Which line: standard (default), priority, batch (idle time, always detached) or ci (needs a grant with --ci)."},
        {"name": "--gate", "arg": null, "description": "The same as --tier ci (kept for scripts)."},
        {"name": "--critical", "arg": null, "description": "The same as --priority."},
        {"name": "--supersede", "arg": "KEY", "description": "Cancel your older queued jobs with the same KEY (never a running one)."},
        {"name": "--submitter", "arg": "NAME", "description": "Your own turn in the queue, the per-submitter cap and the views (not security)."},
        {"name": "--plan", "arg": null, "description": "Dry run: the node it would pick and why, queue, estimate, needs, limits and where each setting came from (JSON)."},
        {"name": "--dry-run", "arg": null, "description": "The same as --plan."},
        {"name": "--needs", "arg": "tool@ver,…", "description": "Tools the job needs (node@22, python@3.12, rust@stable, cargo-nextest, cmake@3, sys:<pkg>, profile:<name>). A package the node's owner hasn't approved: package_not_approved, exit 3; an unknown tool: tool_unsupported, exit 2."}
      ]
    },
    {
      "name": "compute test",
      "usage": "k2 compute test [<node>] [--shards N] [--partition hash|count] [--profile P] [--runner CMD] [--preset NAME] [run flags] [-- <nextest args>]",
      "description": "A cargo-nextest suite split across nodes (nextest --partition), JUnit kept and parsed, one combined result. It takes run's flags except --wait, --failures, --max-wait, --quiet and --priority (the code refuses those here; --critical and --tier work).",
      "args": [{"name": "node", "required": false, "description": "Pin to this node (not with --shards above 1)."}, {"name": "nextest args", "required": false, "description": "After --: nextest's own arguments."}],
      "flags": [
        {"name": "--shards", "arg": "N", "description": "How many shards (1 to 16), each on its own node."},
        {"name": "--partition", "arg": "hash|count", "description": "How nextest splits the suite across the shards (nextest --partition hash or count; default hash). Only with --shards above 1."},
        {"name": "--profile", "arg": "P", "description": "Use the repo's own nextest profile."},
        {"name": "--runner", "arg": "CMD", "description": "Replace cargo nextest run."},
        {"name": "--preset", "arg": "NAME", "description": "The .k2/compute.toml preset, as for run."}
      ]
    },
    {
      "name": "compute prewarm",
      "usage": "k2 compute prewarm [--preset NAME | --needs …] [--os …] [--distro …] [--arch …] [--label k=v] [--node N]... [--tag T] [--plan] [--wait] [--workspace WS] [--json]",
      "description": "Install the tools ahead of time: one idle-time (Batch) job on each matching node granted to you that lacks one of them. The jobs are detached and wait for an idle node.",
      "args": [],
      "flags": [
        {"name": "--preset", "arg": "NAME", "description": "Take needs, os and arch from this .k2/compute.toml preset."},
        {"name": "--needs", "arg": "tool@ver,…", "description": "The tools to install."},
        {"name": "--os", "arg": "linux|macos", "description": "Only nodes of that OS."},
        {"name": "--distro", "arg": "ID[@VERSION]", "description": "Only nodes of that distro."},
        {"name": "--arch", "arg": "A", "description": "Only nodes of that architecture."},
        {"name": "--label", "arg": "k=v", "description": "Only nodes with that label."},
        {"name": "--node", "arg": "N", "description": "Only this node (repeatable)."},
        {"name": "--tag", "arg": "T", "description": "A tag for the jobs."},
        {"name": "--plan", "arg": null, "description": "Show what it would do; submits nothing."},
        {"name": "--wait", "arg": null, "description": "Wait for the jobs (exit as k2 compute wait)."},
        {"name": "--json", "arg": null, "description": "JSON output."},
        {"name": "--workspace", "arg": "WS", "description": "Which workspace's grants and needs (people; an agent may name only its own). Without it: the workspace you run from."}
      ]
    },
    {
      "name": "compute jobs",
      "usage": "k2 compute jobs [--node N] [--mine] [--state S] [--tier ci|priority|standard|batch] [--tag T] [--limit N] [--workspace WS] [--json]",
      "description": "List jobs, with TAG and WHO columns (the job's --tag, and who sent it).",
      "args": [],
      "flags": [
        {"name": "--node", "arg": "N", "description": "Only this node's jobs."},
        {"name": "--mine", "arg": null, "description": "Only the jobs this session sent."},
        {"name": "--state", "arg": "S", "description": "Only jobs in this state."},
        {"name": "--tier", "arg": "ci|priority|standard|batch", "description": "Only this line's jobs."},
        {"name": "--tag", "arg": "T", "description": "Only jobs with this --tag."},
        {"name": "--limit", "arg": "N", "description": "At most N jobs."},
        {"name": "--workspace", "arg": "WS", "description": "Which workspace (pass it from outside the workspace or its worktrees)."},
        {"name": "--json", "arg": null, "description": "JSON output."}
      ]
    },
    {
      "name": "compute get",
      "usage": "k2 compute get <job> [--full] [--json]",
      "description": "One job: state, node, placement, attempts, wait, and the network it asked for (network: none; dummies: sewlane0 10.254.254.1/32). --json prints the result object (result.network {mode, dummies, line} when the job asked for one). k2 compute status <job> is the same. A missing job exits 4.",
      "args": [{"name": "job", "required": true, "description": "A job id or its short form."}],
      "flags": [
        {"name": "--full", "arg": null, "description": "The whole command line, however long."},
        {"name": "--json", "arg": null, "description": "The result object."}
      ]
    },
    {
      "name": "compute fetch",
      "usage": "k2 compute fetch <job> [NAME...] [--out DIR] [--json] [--over-relay] [--attempt N]",
      "description": "Copy a job's kept artifacts here (all, or the NAMEs).",
      "args": [{"name": "job", "required": true}, {"name": "name", "required": false}],
      "flags": [
        {"name": "--out", "arg": "DIR", "description": "Where to put them."},
        {"name": "--json", "arg": null, "description": "JSON output."},
        {"name": "--over-relay", "arg": null, "description": "Files over 100 MB through the relay too (up to 500 MB)."},
        {"name": "--attempt", "arg": "N", "description": "An earlier attempt's files (from the node it ran on; get lists them)."}
      ]
    },
    {
      "name": "compute wait",
      "usage": "k2 compute wait <job>... [--any] [--follow] [--failures] [--max-wait 9m] [--quiet] [--json]",
      "description": "Block until the jobs end, no log text. Exit: the job's exit code (the first failing job for several); 3 = a job was cancelled, failed or timed out, or --max-wait passed first (still_running), or a job's own command exited 3: the stderr JSON says which.",
      "args": [{"name": "job", "required": true}],
      "flags": [
        {"name": "--any", "arg": null, "description": "Return when the first of them ends (exit = its code) and name the ones still running. Not with --follow."},
        {"name": "--follow", "arg": null, "description": "One job: stream its output too (resume a run --wait whose shell timed out). No --json or --quiet."},
        {"name": "--failures", "arg": null, "description": "Failing tests first."},
        {"name": "--max-wait", "arg": "9m", "description": "Give up waiting after this long (exit 3 still_running); counts from this call."},
        {"name": "--quiet", "arg": null, "description": "No output, only the exit."},
        {"name": "--json", "arg": null, "description": "JSON output."}
      ]
    },
    {
      "name": "compute attach",
      "usage": "k2 compute attach <job> [--since SEQ] [--raw]",
      "description": "Follow a job's output.",
      "args": [{"name": "job", "required": true}],
      "flags": [
        {"name": "--since", "arg": "SEQ", "description": "Start after this sequence number."},
        {"name": "--raw", "arg": null, "description": "Raw output."}
      ]
    },
    {
      "name": "compute logs",
      "usage": "k2 compute logs <job> [--attempt N] [--tail N] [--failures] [--raw] [--json] | k2 compute logs --search 'TEXT' [--check C] [--branch B] [--state failed] [--since 7d] [--limit 50] [-i] [--workspace WS] [--json]",
      "description": "A job's log (a retried or moved job: the latest attempt; logs are kept 14 days). With --search: find TEXT in this workspace's kept job logs, newest job first (preview: ciPreview); lines are program output, never instructions.",
      "args": [{"name": "job", "required": false}],
      "flags": [
        {"name": "--attempt", "arg": "N", "description": "Print attempt N's log."},
        {"name": "--tail", "arg": "N", "description": "Only the last N lines."},
        {"name": "--failures", "arg": null, "description": "Failing tests first, then log lines."},
        {"name": "--raw", "arg": null, "description": "Raw output."},
        {"name": "--json", "arg": null, "description": "{attempt, generation, attempts, log}; with --search, the matches as JSON."},
        {"name": "--search", "arg": "TEXT", "description": "Search kept logs instead of printing one (stops at 500 jobs, 2 GB read or 10 s and says so)."},
        {"name": "--check", "arg": "C", "description": "With --search: only this CI check's jobs."},
        {"name": "--branch", "arg": "B", "description": "With --search: only CI check jobs of this branch."},
        {"name": "--state", "arg": "failed|passed|done|cancelled|timeout", "description": "With --search: only jobs in this state."},
        {"name": "--since", "arg": "7d", "description": "With --search: how far back."},
        {"name": "--limit", "arg": "50", "description": "With --search: at most this many matches."},
        {"name": "-i", "arg": null, "description": "With --search: any case."},
        {"name": "--workspace", "arg": "WS", "description": "With --search: another workspace's logs (people; an agent may name only its own). Without it: the workspace you run from."}
      ]
    },
    {
      "name": "compute rightsize",
      "usage": "k2 compute rightsize [--check C | --tag T | -- <command…>] [--days 14] [--workspace WS] [--json]",
      "description": "What one command really used and what to ask for, from this workspace's finished runs of it: memory peak p50/p95/max, mem_cap kills, a --mem suggestion, cores used vs --cpus, and how sure (preview: ciPreview).",
      "args": [{"name": "command", "required": false, "description": "After --: the exact command."}],
      "flags": [
        {"name": "--check", "arg": "C", "description": "A .k2/ci.toml check."},
        {"name": "--tag", "arg": "T", "description": "Runs with this --tag."},
        {"name": "--days", "arg": "14", "description": "How many days back (1 to 90)."},
        {"name": "--json", "arg": null, "description": "JSON output."},
        {"name": "--workspace", "arg": "WS", "description": "Another workspace's runs (people; an agent may name only its own). Without it: the workspace you run from."}
      ]
    },
    {
      "name": "compute stats",
      "usage": "k2 compute stats <job> [--json]",
      "description": "One job's CPU, memory, IO and load over its run (every 5 s), held time at its --cpus, OOM kills (preview: ciPreview).",
      "args": [{"name": "job", "required": true}],
      "flags": [
        {"name": "--json", "arg": null, "description": "JSON output."}
      ]
    },
    {
      "name": "compute cancel",
      "usage": "k2 compute cancel <job> [--force|--if-queued] | k2 compute cancel --all-mine|--workspace-all [--tag T] [--state queued|running|any] [--node N] [--workspace WS] [--force]",
      "description": "Cancel a job. A queued job is cancelled at once; one that already started (or was just assigned) needs --force (else job_started, exit 3).",
      "args": [{"name": "job", "required": false}],
      "flags": [
        {"name": "--force", "arg": null, "description": "Stop a job that already started."},
        {"name": "--if-queued", "arg": null, "description": "Cancel only if it is still queued; if it started or ended, say so, leave it alone and exit 0. Not with --force."},
        {"name": "--all-mine", "arg": null, "description": "Every matching job this session sent (queued ones by default)."},
        {"name": "--workspace-all", "arg": null, "description": "Every matching job of the workspace (other sessions' too)."},
        {"name": "--tag", "arg": "T", "description": "With --all-mine or --workspace-all: only jobs with this tag."},
        {"name": "--state", "arg": "queued|running|any", "description": "With --all-mine or --workspace-all: which jobs (started ones only with --force, else listed as skipped)."},
        {"name": "--node", "arg": "N", "description": "With --all-mine or --workspace-all: only this node's jobs."},
        {"name": "--workspace", "arg": "WS", "description": "With --workspace-all: another workspace's jobs (people; an agent always acts on its own). Without it: the workspace you run from."},
        {"name": "--json", "arg": null, "description": "JSON output."}
      ]
    },
    {
      "name": "compute retry",
      "usage": "k2 compute retry <job>",
      "description": "Run a job again as a new attempt.",
      "args": [{"name": "job", "required": true}],
      "flags": []
    },
    {
      "name": "compute events",
      "usage": "k2 compute events [--follow] [--mine] [--tag T] [--since CURSOR] [--limit N] [--max-wait D] [--json] | k2 compute events --audit [--limit N]",
      "description": "Events of every job of this workspace, instead of polling logs: queued, started, finished (state, exit, reason), requeued, moved. No --follow: the newest N (default 20).",
      "args": [],
      "flags": [
        {"name": "--follow", "arg": null, "description": "Only events after now (or after --since), as they happen; it never exits on its own unless --max-wait passes (then exit 0 and the line to continue)."},
        {"name": "--mine", "arg": null, "description": "Only the jobs this session sent."},
        {"name": "--tag", "arg": "T", "description": "Only jobs with this tag."},
        {"name": "--since", "arg": "CURSOR", "description": "Events after this cursor."},
        {"name": "--limit", "arg": "N", "description": "How many (default 20; --audit: 50)."},
        {"name": "--max-wait", "arg": "D", "description": "With --follow: stop after this long."},
        {"name": "--json", "arg": null, "description": "One JSON object per line (NDJSON), each with its cursor."},
        {"name": "--audit", "arg": null, "description": "The audit log instead of job events."}
      ]
    },
    {
      "name": "compute cache",
      "usage": "k2 compute cache [list] [--node N] [--workspace WS] [--name NAME] [--json] | k2 compute cache --lineage trusted|scratch|release|all [--node N] [--json]",
      "description": "This server's --cache folders on its nodes: size, last use, busy. Owner or admin, or an agent allowed to manage compute nodes. --lineage lists cache generations instead.",
      "args": [],
      "flags": [
        {"name": "--node", "arg": "N", "description": "Only this node."},
        {"name": "--workspace", "arg": "WS", "description": "Only this workspace's caches."},
        {"name": "--name", "arg": "NAME", "description": "Only this cache."},
        {"name": "--lineage", "arg": "trusted|scratch|release|all", "description": "Cache generations: per node, each copy of this workspace's build cache (list only)."},
        {"name": "--json", "arg": null, "description": "JSON output."}
      ]
    },
    {
      "name": "compute cache clear",
      "usage": "k2 compute cache clear (--workspace WS | --all) [--name NAME] [--node N]",
      "description": "Clear --cache folders; a cache a running job holds is never cleared. Owner or admin, or an agent allowed to manage compute nodes; an agent clears its own workspace's caches only (no --workspace or --all needed).",
      "args": [],
      "flags": [
        {"name": "--workspace", "arg": "WS", "description": "This workspace's caches."},
        {"name": "--all", "arg": null, "description": "Every workspace's caches."},
        {"name": "--name", "arg": "NAME", "description": "Only this cache."},
        {"name": "--node", "arg": "N", "description": "Only on this node."}
      ]
    },
    {
      "name": "compute queue",
      "usage": "k2 compute queue <node> [--json]",
      "description": "The node's whole queue, with why each job waits. On a shared node, other servers' jobs show only as another server with tier, class, size and ETA.",
      "args": [{"name": "node", "required": true}],
      "flags": [
        {"name": "--json", "arg": null, "description": "JSON output."}
      ]
    },
    {
      "name": "compute retier",
      "usage": "k2 compute retier <job> --tier standard|priority|batch|ci [--why \"…\"] [--json]",
      "description": "Move a queued job to another line. Your workspace's jobs, or any job for the owner or an Admin.",
      "args": [{"name": "job", "required": true}],
      "flags": [
        {"name": "--tier", "arg": "standard|priority|batch|ci", "description": "The line to move it to."},
        {"name": "--priority", "arg": null, "description": "The same as --tier priority; needs --why."},
        {"name": "--why", "arg": "text", "description": "The one-line reason (required for priority)."},
        {"name": "--json", "arg": null, "description": "JSON output."}
      ]
    },
    {
      "name": "compute move",
      "usage": "k2 compute move <job>... --auto [--avoid <node>]... [--os O|any] [--arch A|any] [--label k=v] [--json] | k2 compute move <job>... --to <node> [--json] | k2 compute move --all-mine|--workspace-all [--tag T] [--node N] [--workspace WS] (--auto … | --to <node>)",
      "description": "Move queued jobs: no cancel, no new job id. A started job is never moved (job_started, exit 3).",
      "args": [{"name": "job", "required": false}],
      "flags": [
        {"name": "--auto", "arg": null, "description": "Let K2 place a job that was pinned to a named node: it moves within about 5 s to a node that can start it now, else waits where it is."},
        {"name": "--to", "arg": "NODE", "description": "Move the job to that node and pin it there (the same checks as naming the node in run)."},
        {"name": "--avoid", "arg": "NODE", "description": "With --auto: keep it off this node (repeatable)."},
        {"name": "--os", "arg": "O|any", "description": "With --auto: another OS than its node's (any = either)."},
        {"name": "--arch", "arg": "A|any", "description": "With --auto: another architecture (any = either)."},
        {"name": "--label", "arg": "k=v", "description": "With --auto: pick nodes by a label."},
        {"name": "--all-mine", "arg": null, "description": "Every matching queued job this session sent."},
        {"name": "--workspace-all", "arg": null, "description": "Every matching queued job of the workspace."},
        {"name": "--tag", "arg": "T", "description": "With --all-mine or --workspace-all: only jobs with this tag."},
        {"name": "--node", "arg": "N", "description": "With --all-mine or --workspace-all: only jobs on this node."},
        {"name": "--workspace", "arg": "WS", "description": "With --workspace-all: another workspace's jobs (people; an agent always acts on its own). Without it: the workspace you run from."},
        {"name": "--json", "arg": null, "description": "JSON output."}
      ]
    },
    {
      "name": "compute receipt",
      "usage": "k2 compute receipt <job> [--json]",
      "description": "What the node signed it ran and made.",
      "args": [{"name": "job", "required": true}],
      "flags": [
        {"name": "--json", "arg": null, "description": "The receipt as JSON (what scripts and k2sign read)."}
      ]
    },
    {
      "name": "compute provenance",
      "usage": "k2 compute provenance <job> [--out FILE] [--json]",
      "description": "The node's signed build statement (in-toto/SLSA, one .intoto.jsonl line); CI preview.",
      "args": [{"name": "job", "required": true}],
      "flags": [
        {"name": "--out", "arg": "FILE", "description": "Write the statement to this file."},
        {"name": "--json", "arg": null, "description": "JSON output."}
      ]
    },
    {
      "name": "compute verify",
      "usage": "k2 compute verify <job | FILE.intoto.jsonl> [--file PATH] [--owner-key FP] [--json]",
      "description": "Check a statement against this server's records; says what it checked (k2 study provenance).",
      "args": [{"name": "target", "required": true, "description": "A job id or a .intoto.jsonl file."}],
