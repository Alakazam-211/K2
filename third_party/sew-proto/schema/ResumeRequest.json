{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Op 4 RESUME: resume a gateway session. Send exactly one of `ticket` or `token`.",
  "properties": {
    "seq": {
      "description": "The last `s` the client received.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "session_id": {
      "description": "The session to resume.",
      "type": "string"
    },
    "ticket": {
      "description": "A single-use gateway ticket, `sewtk_…` (exclusive with `token`).",
      "type": [
        "string",
        "null"
      ]
    },
    "token": {
      "description": "A session token, `sews_…` (exclusive with `ticket`).",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "session_id",
    "seq"
  ],
  "title": "ResumeRequest",
  "type": "object"
}
