{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Body of `POST /mgmt/v1/spaces/members/remove` (SW13).",
  "properties": {
    "app_id": {
      "description": "The Space's App; absent for an unbound Space.",
      "type": [
        "string",
        "null"
      ]
    },
    "external_id": {
      "description": "The principal.",
      "maxLength": 128,
      "pattern": "^(k2:(principal|workspace|connect):[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|k2:owner|local:[a-z0-9_-]{2,64}|link:[1-9][0-9]{0,18}:[A-Z2-7]{16})$",
      "type": "string"
    },
    "space_id": {
      "description": "The Space.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    }
  },
  "required": [
    "space_id",
    "external_id"
  ],
  "title": "MgmtSpaceMemberRemoveRequest",
  "type": "object"
}
