# k2sign policy (prd-signing-user-v1 §4.1). Installed by scripts/k2sign/install.sh
# as /usr/local/etc/k2sign/policy (root:wheel 0644) and hashed into
# pins.sha256: any edit needs root and `k2sign-admin repin`, and a re-run of
# install.sh puts this reviewed copy back.
#
# approval=off is the SOFT rollback (prd §9): no Touch ID session is needed,
# every other check still runs. release.sh skips Step 0.46 when status says off.
approval = on
# A Touch ID approval opens a session this long (covers K2_RELEASE_RESUME and
# by-hand sign-daemon.sh re-runs); after it, release.sh asks to RE-APPROVE.
session_hours = 12
# An issued challenge must be approved within this many minutes, once.
challenge_minutes = 15
# The biggest file the signer accepts on stdin (K2.app.tar.gz is ~300 MB).
max_stdin_mb = 1024
# What each key may sign ({version} is the release version). The Windows
# setup signs under two names (A7): setup.exe for U1, the URL name for U2.
assets.u1 = K2.app.tar.gz k2-daemon-macos-aarch64 k2-daemon-linux-x86_64 k2-daemon-linux-aarch64 setup.exe
assets.u2 = K2.app.tar.gz k2-daemon-macos-aarch64 k2-daemon-linux-x86_64 k2-daemon-linux-aarch64 K2_{version}_x64-setup.exe
# Signable only when the approval said "windows": true (A7, Q5).
windows_assets = setup.exe K2_{version}_x64-setup.exe
# The repository S3's GitHub checks read (attestations, tags, main), and
# the API the signer reads it through (its own read-only token).
repo = Alakazam-211/K2
github_api = https://api.github.com
# The workflow whose build attestation a Linux daemon must carry, at refs/tags/v<x>.
daemon_workflow = .github/workflows/daemon-binaries.yml
# What the release commit (Step 8.9) may change on top of the approved base
# commit: release.sh's RELEASE_COMMIT_FILES (a test keeps the two equal).
release_commit_files = package.json src-tauri/tauri.conf.json cli/k2 Cargo.lock src-tauri/Cargo.toml crates/k2-core/Cargo.toml crates/k2-daemon/Cargo.toml crates/k2-menubar/Cargo.toml WHATS_NEW.md
# The Developer ID team every Mac file must be signed by (K2.app, its daemon
# helper, k2-ptyd inside the standalone macOS daemon).
apple_team = 36B8R93HXV
# K2 Compute builds (S3b; release.sh K2_LINUX_BUILDS=compute). The signer
# signs these assets from our own nodes only on node-signed receipts it
# checks itself: a build and a verify job on two nodes pinned in
# compute-pins (k2sign-admin pin-compute-node), sent by the pinned
# controller, at the tag's tree. x86_64: L1 and V1 (the lines without a
# suffix). aarch64: L2 and V2, cross-compiled on x86_64 nodes with zig (the
# _aarch64 lines); an aarch64 daemon signs from compute only when the
# registered evidence has L2 and V2, else it takes the GitHub path.
compute_assets = k2-daemon-linux-x86_64 k2-daemon-linux-aarch64
# The release build command both jobs must have run (compute-release.sh L1/V1).
compute_argv = bash scripts/ci/build-linux-bins.sh x86_64
compute_argv_aarch64 = bash scripts/ci/build-linux-bins.sh aarch64
# Exactly what the plan of a release build job needs ({rust_pin}: the
# channel rust-toolchain.toml pins at the tag, read from GitHub; the job's
# rustc must be that version too). compute-release.sh's bins_needs; a test
# keeps the two equal. Its sys: names are the only packages a plan may list.
compute_needs = rust@{rust_pin} cmake@3 sys:pkg-config sys:zlib1g-dev
# aarch64: no rust@ need (an explicit one would drop rust-toolchain.toml's
# aarch64 target, which a job can't add itself); the node installs the
# file's channel and targets, and the receipt's rustc must still be the pin.
# zig and cargo-zigbuild are not needs: build-linux-bins.sh fetches them
# itself and refuses any bytes but scripts/ci/cross-pins.sh's hashes.
compute_needs_aarch64 = cmake@3 sys:pkg-config sys:zlib1g-dev
# The artifact globs the plan collects (compute-release.sh --artifact).
compute_artifacts = dist/*
# The OAuth values come only from the vault, as these names (secret mode).
# The plan's env is exactly BUILD_COMMIT and BUILD_TREE. A job without these
# secrets (env or placeholder mode) is refused: it isn't a secret job, so
# it may share the node's warm target, CARGO_HOME and sccache.
compute_secret_env = BUILD_GMAIL_CLIENT_ID BUILD_GMAIL_CLIENT_SECRET
compute_secret_env_optional = BUILD_MICROSOFT_CLIENT_ID
# TODO (tracked, not built): the OAuth client IDs are public values, but the
# vault serves them by name, so whoever can edit the vault entry can swap
# the client baked into the daemon. Pin their sha256 here and have the
# build record what it baked, so the signer can compare.
# V1 must reproduce these byte for byte (plan G12; compute-release.sh
# k2cr_dual_names, and a test keeps the two equal): the root-key assets
# and every compute_assets entry (the signer refuses a policy whose
# compute asset isn't here: one node alone must never get a file signed).
compute_dual_names = k2-root-helper-linux-x86_64 k2-node-linux-x86_64 k2-app-engine-linux-x86_64 k2-daemon-linux-x86_64
compute_dual_names_aarch64 = k2-root-helper-linux-aarch64 k2-node-linux-aarch64 k2-app-engine-linux-aarch64 k2-daemon-linux-aarch64
# A receipt older than this is refused, even with the approval off.
compute_receipt_max_hours = 24
