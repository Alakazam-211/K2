_hostmail_read_text() {
    local raw="$1"
    if [ "$raw" = "-" ]; then
        cat
    elif [ "${raw#@}" != "$raw" ]; then
        local path="${raw#@}"
        if [ -z "$path" ]; then
            _mail_err "usage" "--text @path needs a path"
            return 1
        fi
        if [ ! -f "$path" ]; then
            _mail_err "usage" "no such file: $path"
            return 1
        fi
        cat "$path"
    else
        printf '%s' "$raw"
    fi
}

