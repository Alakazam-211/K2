# S9 (PRD §17.5): save a reply DRAFT into an external assistant
# inbox's real Drafts folder. Agent verb — drafting is always on so the
# human can review + send from their own client; agents can also send
# directly once a workspace is raised to the 'send' level (SMTP).
cmd_mail_draft() {
    if _wants_help "$@"; then cmd_help_mail_draft; exit 0; fi
    local id="" body="" body_file="" as_json=false
    while [ $# -gt 0 ]; do
        case "$1" in
            --body)
                [ $# -ge 2 ] || { _mail_err "usage" "--body requires the draft text"; exit 2; }
                body="$2"; shift 2 ;;
            --body-file)
                [ $# -ge 2 ] || { _mail_err "usage" "--body-file requires a file path"; exit 2; }
                body_file="$2"; shift 2 ;;
            --json) as_json=true; shift ;;
            -*)
                _mail_err "usage" "unknown flag '$1' — usage: k2 mail draft <message-id> (--body <text> | --body-file <f>) [--json]"
                exit 2 ;;
            *)
                if [ -z "$id" ]; then id="$1"; else
                    _mail_err "usage" "unexpected extra argument '$1' — one <message-id> only"
                    exit 2
                fi
                shift ;;
        esac
    done
    if [ -z "$id" ]; then
        _mail_err "usage" "draft requires a <message-id> (from 'k2 mail messages')"
        exit 2
    fi
    if [ -n "$body" ] && [ -n "$body_file" ]; then
        _mail_err "usage" "--body and --body-file are mutually exclusive"
        exit 2
    fi
    if [ -n "$body_file" ]; then
        if [ ! -f "$body_file" ]; then
            _mail_err "usage" "--body-file: no such file '$body_file'"
            exit 2
        fi
        body="$(cat "$body_file")" || {
            _mail_err "usage" "--body-file: cannot read '$body_file'"
            exit 2
        }
    fi
    if [ -z "$body" ]; then
        _mail_err "usage" "draft requires --body <text> or --body-file <f>"
        exit 2
    fi
    local M_VERB="draft" M_JSON="$as_json" M_ID="$id" M_BODY="$body"
    _mail_py
}

