                shift ;;
        esac
    done
    if [ -z "$selector" ]; then
        _preset_err "usage" "remove requires a <preset> (id, label, or command token)"
        exit 2
    fi
    local PR_VERB="remove" PR_JSON="$as_json" PR_SELECTOR="$selector"
    _preset_py
}

