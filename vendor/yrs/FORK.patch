+    #[test]
+    fn the_shadow_fires_on_a_planted_bug() {
+        for bug in [
+            PlantedPositionBug::RemoveOffByOne,
+            PlantedPositionBug::KeepMarkersOnIntegrate,
+        ] {
+            let d = doc(1, false, OffsetKind::Utf16);
+            d.plant_position_bug(Some(bug));
