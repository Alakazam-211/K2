cmd_connect_logout() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --help|-h) _connect_usage; return 0 ;;
            *) echo "Usage: k2 connect logout" >&2; return 2 ;;
        esac
    done
    # Best-effort server-side logout when we still have an access token.
    local loaded access
    loaded="$(_connect_account_load)"
    access="$(printf '%s\n' "$loaded" | sed -n '1p')"
    if [ -n "$access" ]; then
        ACCESS="$access" SUPA_URL="$_K2_SUPABASE_URL" SUPA_KEY="$_K2_SUPABASE_ANON_KEY" python3 -c '
import os, urllib.request
url = os.environ["SUPA_URL"].rstrip("/") + "/auth/v1/logout"
req = urllib.request.Request(url, data=b"", method="POST", headers={
    "apikey": os.environ["SUPA_KEY"],
    "Authorization": "Bearer " + os.environ["ACCESS"],
})
try:
    urllib.request.urlopen(req, timeout=10)
except Exception:
    pass
' 2>/dev/null || true
    fi
    _connect_account_clear
    echo "Logged out of k2.dev account (cleared ~/.k2/connect-account.json)."
    echo "Tunnel pairing is unchanged. To unpair this device: k2 tunnel release --confirm"
}

cmd_connect() {
    local sub="${1:-}"
    shift 2>/dev/null || true
    case "$sub" in
        login)
            cmd_connect_login "$@"
            ;;
        status)
            cmd_connect_status "$@"
            ;;
        logout)
            cmd_connect_logout "$@"
            ;;
        ""|help|--help|-h)
            _connect_usage
            # Bare `k2 connect` without a subcommand is usage, exit 2.
            [ -n "$sub" ] && [ "$sub" != "" ] && return 0
            # help/-h exit 0; bare empty exits 2 so scripts detect missing subcommand.
            if [ -z "$sub" ]; then return 2; fi
            return 0
            ;;
        # Former `k2 connect` → publish surface (0.40.41). Point people over.
        subdomain|publish)
            echo "Nested subdomains moved to: k2 publish ${sub}${*:+ $*}" >&2
            echo "  e.g. k2 publish subdomain list" >&2
            echo "  e.g. k2 publish status" >&2
            echo "Account pairing is now: k2 connect login | status | logout" >&2
            return 2
            ;;
        *)
            # Heuristic: anything that looks like an old publish verb.
            case "$sub" in
                create|list|point|rm|claim|unclaim)
                    echo "Unknown 'k2 connect' subcommand: $sub" >&2
                    echo "Did you mean: k2 publish subdomain $sub … ?" >&2
                    echo "Account pairing: k2 connect login | status | logout" >&2
                    return 2
                    ;;
            esac
            echo "Unknown 'k2 connect' subcommand: $sub" >&2
            _connect_usage
            return 2
            ;;
    esac
}

# ── Workspace Knowledge Base (brain map) — k2 wiki ────────────────────
# Thin wrappers over daemon /cli/wiki/* (indexer + optional localhost serve).
# Publish reuses k2 publish subdomain create/point/rm (K4 in PRD).
# See .k2/prds/prd-workspace-kb-brain-map-and-publish.md.

_wiki_usage() {
    cat <<'EOF' >&2
k2 wiki — per-workspace knowledge base (brain map)

Vault lives at <workspace>/.k2/wiki/ (Markdown + [[wikilinks]]).

USAGE
  k2 wiki status [--json] [project]
  k2 wiki index [--json] [project]
  k2 wiki note <id> [--json] [project]
  k2 wiki seed [project]
  k2 wiki serve on|off [--port N] [project]
  k2 wiki chat on|off [project]
  k2 wiki publish [--label LABEL] [project]
  k2 wiki unpublish [project]

COMMANDS
  status     Serve + publish + public-chat state (port, url, publicChat*)
  index      Graph index (nodes + links)
  note       One note body by id (e.g. Home.md)
  seed       Create Home.md + _Index.md if missing
  serve      Start/stop read-only localhost site (127.0.0.1 only)
  chat       Allow public chat on the served/published wiki (default OFF)
  publish    Serve on + nest a subdomain (or print create instructions)
  unpublish  Serve off + hint to remove the nested subdomain

FLAGS
  --json                 Machine-readable stdout (status/index/note)
  --port N               Preferred port for serve on (daemon may reassign)
  --label LABEL          Nested subdomain label for publish (default: workspace basename slug)
  --workspace|--project  Alias for trailing [project] (path, name, or uuid)

EXIT CODES
  0 ok
  1 error (daemon / not found / control plane)
  2 bad usage
EOF
}

_wiki_err() {
    local code="$1" hint="$2"
    if [ "${AS_JSON:-false}" = "true" ] || [ "${as_json:-false}" = "true" ]; then
        python3 -c 'import json,sys; print(json.dumps({"error":{"code":sys.argv[1],"hint":sys.argv[2]}}), file=sys.stderr)' \
            "$code" "$hint" 2>/dev/null || echo "{\"error\":{\"code\":\"$code\",\"hint\":\"$hint\"}}" >&2
    else
        echo "Error: $hint" >&2
    fi
}

# Resolve optional workspace selector into global PROJECT (path preferred).
# Accepts absolute/relative dir, workspace name, or uuid (via daemon resolve).
_wiki_apply_project() {
    local sel="${1:-}"
    [ -z "$sel" ] && return 0
    if [ -d "$sel" ]; then
        PROJECT="$(cd "$sel" && pwd)"
        return 0
    fi
    local resolved=""
    if [ -n "${PORT:-}" ] && [ -n "${TOKEN:-}" ]; then
        resolved=$(cli_request "/cli/workspace/resolve" "q=$(urlencode "$sel")" 2>/dev/null \
            | python3 -c '
import json,sys
try:
    d=json.loads(sys.stdin.read() or "{}")
except Exception:
    d={}
if isinstance(d, dict):
    print(d.get("path") or d.get("projectPath") or d.get("project_path") or "")
else:
    print("")
' 2>/dev/null || true)
    fi
    if [ -n "$resolved" ]; then
        PROJECT="$resolved"
        return 0
    fi
    # Pass through; daemon /cli/wiki/* also resolves project= tokens.
    PROJECT="$sel"
}

# Default nested label for wiki publish: workspace folder basename, slugified.
_wiki_default_label() {
    local base
    base="$(basename "$PROJECT" 2>/dev/null || echo brain)"
    printf '%s' "$base" | python3 -c '
import re,sys
s=sys.stdin.read().strip().lower()
s=re.sub(r"[^a-z0-9]+","-",s).strip("-")
print((s or "brain")[:48])
' 2>/dev/null || echo "brain"
}

# Parse shared wiki flags. Sets: as_json, project_sel, port, label.
# Remaining positionals go into wiki_pos array.
# Usage: _wiki_parse_args [--need-pos] "$@" then inspect wiki_pos.
_wiki_parse_args() {
    as_json=false
    project_sel=""
    port=""
    label=""
    wiki_pos=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --json) as_json=true; shift ;;
            --port)
                port="${2:-}"
                if [ -z "$port" ]; then
                    _wiki_err "usage" "--port requires a value"
                    exit 2
                fi
                shift 2
                ;;
            --port=*) port="${1#--port=}"; shift ;;
            --label)
                label="${2:-}"
                if [ -z "$label" ]; then
                    _wiki_err "usage" "--label requires a value"
                    exit 2
                fi
                shift 2
                ;;
            --label=*) label="${1#--label=}"; shift ;;
            --workspace|--project)
                project_sel="${2:-}"
                if [ -z "$project_sel" ]; then
                    _wiki_err "usage" "$1 requires a workspace path/name"
                    exit 2
                fi
                shift 2
                ;;
            --workspace=*|--project=*)
                project_sel="${1#*=}"; shift
                ;;
            --help|-h)
                return 99
                ;;
            --)
                shift
                while [ $# -gt 0 ]; do wiki_pos+=("$1"); shift; done
                break
                ;;
            -*)
                _wiki_err "usage" "unknown flag '$1'"
                exit 2
                ;;
            *)
                wiki_pos+=("$1"); shift
                ;;
        esac
    done
    # Trailing bare project when no --workspace given: last positional that
    # is not consumed as a required arg is applied by the caller.
    return 0
}

cmd_wiki() {
    local sub="${1:-}"
