#!/bin/bash
# k2-signer — the release signer for clients (prd-ci-on-compute-for-clients-v1
# C4). Installed by scripts/k2sign/install-k2-signer.sh as
# /usr/local/libexec/k2-signer/k2-signer (root:wheel 0755). The ONLY command
# the release user may run as _k2sign without a password, beside k2sign:
#   sudo -n -u _k2sign /usr/local/libexec/k2-signer/k2-signer <verb> ...
# Documents and file bytes come in on stdin; signatures and JSON go out on
# stdout. This wrapper throws the caller's environment away (env -i), sets a
# fixed PATH, HOME and umask, and runs the root-owned Rust binary next to it.
#
# Test mode (K2_SIGNER_TEST_ROOT) is passed through so the binary can REFUSE
# it when this runs as _k2sign or root; sudo's env_reset drops it anyway.
set -u
root="${K2_SIGNER_TEST_ROOT:-}"
keep=()
if [ -n "$root" ]; then
    # Refused here, before anything under the test root runs (security
    # review M5): root and the signing user never take a test root.
    me="$(/usr/bin/id -un)"
    if [ "$(/usr/bin/id -u)" = 0 ] || [ "$me" = _k2sign ] || [ "$me" = "${K2_SIGNER_TEST_SIGNER_USER:-}" ]; then
        printf '\033[1;31mk2-signer: refused: test mode (K2_SIGNER_TEST_ROOT) is refused as root or the signing user\033[0m\n' >&2
        exit 3
    fi
    keep+=("K2_SIGNER_TEST_ROOT=$root")
    for v in K2_SIGNER_TEST_NOW K2_SIGNER_TEST_SIGNER_USER K2_SIGNER_TEST_GITHUB_API; do
        if [ -n "${!v:-}" ]; then keep+=("$v=${!v}"); fi
    done
fi
umask 077
cd / || exit 4
exec /usr/bin/env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin HOME="$root/var/k2sign" LANG=C \
    ${keep[@]+"${keep[@]}"} \
    "$root/usr/local/libexec/k2-signer/k2-signer-bin" signer "$@"
