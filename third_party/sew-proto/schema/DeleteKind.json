{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Why a message was deleted.",
  "oneOf": [
    {
      "const": "own",
      "description": "Its author deleted it.",
      "type": "string"
    },
    {
      "const": "moderator",
