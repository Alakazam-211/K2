{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`status.recording` (§22.3).",
  "properties": {
    "active": {
      "description": "Active recordings.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "audio_bytes": {
      "description": "Stored audio bytes.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "backend": {
      "description": "Its backend.",
      "type": [
        "string",
        "null"
      ]
    },
    "backlog_audio_s": {
      "description": "Queued speech awaiting transcription.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "enabled": {
      "description": "`[recording] enabled`.",
      "type": "boolean"
    },
    "held_audio_bytes": {
      "description": "Held audio bytes.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "model": {
      "description": "The model the transcriber reports.",
      "type": [
        "string",
        "null"
      ]
    },
    "oldest_pending_s": {
      "description": "Age of the oldest stored, untranscribed segment.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "recorder_ok": {
      "description": "The recorder answers health.",
      "type": "boolean"
    },
    "rejoins_1h": {
      "description": "Rejoins in the last hour.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "rtf_1h": {
      "description": "Realtime factor over the last hour.",
      "format": "double",
      "type": [
        "number",
        "null"
      ]
    },
    "tracks": {
      "description": "Allowlisted tracks install-wide.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "transcriber_ok": {
      "description": "The transcriber answers health.",
      "type": "boolean"
    },
    "workers": {
      "description": "Its workers.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "enabled",
    "recorder_ok",
    "transcriber_ok",
    "workers",
    "active",
    "tracks",
    "rejoins_1h",
    "backlog_audio_s",
    "oldest_pending_s",
    "audio_bytes",
    "held_audio_bytes"
  ],
  "title": "StatusRecording",
  "type": "object"
}
