{
  "$defs": {
    "MuteInput": {
      "additionalProperties": false,
      "description": "A channel mute in a request.",
      "properties": {
        "muted": {
          "description": "Muted.",
          "type": "boolean"
        },
        "until": {
          "description": "Muted until then (after now, at most 366 days ahead); absent = until unmuted.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "muted"
      ],
      "type": "object"
    },
    "NotifyLevel": {
      "description": "A notification level (`*.level` codes 1–3).",
      "oneOf": [
        {
          "const": "all",
          "description": "Every message.",
          "type": "string"
        },
        {
          "const": "mentions",
          "description": "Mentions, DMs, keywords and followed threads.",
          "type": "string"
        },
        {
          "const": "none",
          "description": "Nothing (reminders still arrive).",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Body of `POST /api/v1/channels/{id}/notify/set`. Returns [`ChannelNotifyPrefs`].",
  "properties": {
    "level": {
      "anyOf": [
        {
          "$ref": "#/$defs/NotifyLevel"
        },
        {
          "type": "null"
        }
      ],
      "description": "The level; `null` = inherit."
    },
    "mute": {
      "anyOf": [
        {
          "$ref": "#/$defs/MuteInput"
        },
        {
          "type": "null"
        }
      ],
      "description": "The mute."
    }
  },
  "title": "SetChannelNotifyRequest",
  "type": "object"
}
