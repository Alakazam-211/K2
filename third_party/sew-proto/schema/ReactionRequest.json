{
  "$defs": {
    "EmojiInput": {
      "description": "An emoji in a request: Unicode or a custom emoji.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A Unicode emoji.",
          "properties": {
            "kind": {
              "const": "unicode",
              "type": "string"
            },
            "value": {
              "description": "The emoji text.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A custom emoji.",
          "properties": {
            "id": {
              "description": "The emoji id.",
              "pattern": "^[1-9][0-9]{0,18}$",
              "type": "string"
            },
            "kind": {
              "const": "custom",
              "type": "string"
            },
            "name": {
              "description": "The emoji name.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id",
            "name"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Body of the add-reaction route.",
  "properties": {
    "emoji": {
      "$ref": "#/$defs/EmojiInput",
      "description": "The emoji."
    }
  },
  "required": [
    "emoji"
  ],
  "title": "ReactionRequest",
  "type": "object"
}
