elif verb == "flag":
    body = {"project": ws_path, "id": env("M_ID")}
    if env("M_READ") != "":
        body["read"] = (env("M_READ") == "true")
    if env("M_FLAGGED") != "":
        body["flagged"] = (env("M_FLAGGED") == "true")
    d = call("POST", "/cli/mail/flag", body=body)
    if as_json:
