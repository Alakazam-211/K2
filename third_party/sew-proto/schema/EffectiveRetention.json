{
  "$defs": {
    "RetentionScope": {
      "description": "Which level a retention policy sets (`kind` tag).",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The whole install (DMs use it too). A struct variant so unknown fields are refused.",
          "properties": {
            "kind": {
              "const": "install",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One space and every channel in it.",
          "properties": {
            "id": {
              "description": "The space.",
              "pattern": "^[1-9][0-9]{0,18}$",
              "type": "string"
            },
            "kind": {
              "const": "space",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One channel, DM or group DM.",
          "properties": {
            "id": {
              "description": "The channel.",
              "pattern": "^[1-9][0-9]{0,18}$",
              "type": "string"
            },
            "kind": {
              "const": "channel",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`GET /api/v1/compliance/retention/effective?channel_id=`: what applies to one channel now.",
  "properties": {
    "channel_id": {
      "description": "The channel.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "clamped": {
      "description": "A child value is above what its parents allow (the parent's shorter value wins).",
      "type": "boolean"
    },
    "deleted_purge_days": {
      "description": "The install's deleted-content window (`null` = off).",
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "files_days": {
      "description": "Effective days for files (`null` = forever).",
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "files_from": {
      "$ref": "#/$defs/RetentionScope",
      "description": "The level that sets `files_days` (the install when forever)."
    },
    "messages_days": {
      "description": "Effective days for messages (`null` = forever).",
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "messages_from": {
      "$ref": "#/$defs/RetentionScope",
      "description": "The level that sets `messages_days` (the install when forever)."
    }
  },
  "required": [
    "channel_id",
    "messages_from",
    "files_from",
    "clamped"
  ],
  "title": "EffectiveRetention",
  "type": "object"
}
