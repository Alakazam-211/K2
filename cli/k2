# k2 zen proposals [--all] | show <id> | approve <id> | reject <id>
cmd_zen_proposals() {
    local as_json=false all=false
    local -a pos=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --json) as_json=true; shift ;;
            --all) all=true; shift ;;
            -h|--help) cmd_help_zen; exit 0 ;;
            -*) echo "Error: unexpected '$1' (see k2 zen --help)" >&2; exit 2 ;;
            *) pos+=("$1"); shift ;;
        esac
    done
    local verb="${pos[0]:-list}" raw body
    case "$verb" in
        list)
            if [ "$all" = true ]; then raw=$(cli_request "/cli/zen/proposals" "all=1"); else raw=$(cli_request "/cli/zen/proposals"); fi
            _zen_agent_print list "$as_json" "$raw" ;;
        show)
            [ -n "${pos[1]:-}" ] || { echo "Error: k2 zen proposals show <id>" >&2; exit 2; }
            raw=$(cli_request "/cli/zen/proposals/show" "id=$(urlencode "${pos[1]}")")
            _zen_agent_print show "$as_json" "$raw" ;;
        approve|reject)
            [ -n "${pos[1]:-}" ] || { echo "Error: k2 zen proposals $verb <id>" >&2; exit 2; }
            body=$(ZI="${pos[1]}" python3 -c 'import json, os; print(json.dumps({"id": os.environ["ZI"]}))')
            # Inside K2: the passport (an agent with the switch approves; any
            # agent may withdraw its own with reject). Outside: the person.
            raw=$(_zen_session_post "/cli/zen/proposals/$verb" "$body")
            _zen_agent_print decide "$as_json" "$raw" ;;
        *) echo "Error: unknown 'k2 zen proposals' command '$verb' (show, approve, reject)" >&2; exit 2 ;;
    esac
}

cmd_zen() {
    local sub="${1:-}"
    shift || true
    local raw=""
    case "$sub" in
        validate|history)
            _zen_args "$@"
            _zen_validate_only_flags "$sub"
            [ -z "$ZEN_TO" ] || { echo "Error: --to is for k2 zen reset" >&2; exit 2; }
            if [ "$ZEN_NO_SIGN" = true ] && { [ "$sub" != "validate" ] || [ -z "$ZEN_WIDGET_SEL" ]; }; then
                echo "Error: --no-sign is for k2 zen validate --widget" >&2
                exit 2
            fi
            if [ "$ZEN_SIGN" = true ] && [ -z "$ZEN_WIDGET_SEL" ]; then
                echo "Error: --sign is for k2 zen validate --widget <name>" >&2
                exit 2
            fi
            if [ "$ZEN_SIGN" = true ] && [ "$ZEN_NO_SIGN" = true ]; then
                echo "Error: pass --sign or --no-sign, not both" >&2
                exit 2
            fi
            if [ -n "$ZEN_TYPES" ] && { [ "$sub" != "validate" ] || [ -z "$ZEN_WIDGET_SEL" ]; }; then
                echo "Error: --types is for k2 zen validate --widget <name>" >&2
                exit 2
            fi
            if [ -n "$ZEN_AS" ] && [ -z "$ZEN_DIR_SEL" ]; then
                echo "Error: --as names a staged folder: k2 zen validate --dir <folder> --as <name>" >&2
                exit 2
            fi
            if [ -n "$ZEN_FROM" ] && [ -z "$ZEN_GARDEN_SEL" ]; then
                echo "Error: --from checks a staged Garden page: k2 zen validate --garden <name|id> --from <file>|-" >&2
                exit 2
            fi
            export ZEN_STRICT
            # A staged widget folder (0.46.1 S3): checked by the daemon,
            # nothing written, Zen needn't be set up. Never pending.
            if [ -n "$ZEN_DIR_SEL" ]; then
                local extra
                extra=$(ZA="$ZEN_AS" python3 -c 'import json, os; b = {}
if os.environ.get("ZA"): b["widget"] = os.environ["ZA"]
print(json.dumps(b))')
                raw=$(_zen_dir_call "/cli/zen/widget/folder/check" "$ZEN_DIR_SEL" "$extra" fallback) || exit $?
                _zen_print validate "$ZEN_AS_JSON" "$raw"
                return
            fi
            # A staged Garden page: checked against that Garden, never written.
            if [ -n "$ZEN_FROM" ]; then
                local body
                body="$(_zen_read_text "$ZEN_FROM" | ZG="$ZEN_GARDEN_SEL" python3 -c '
import json, os, sys
print(json.dumps({"garden": os.environ["ZG"], "text": sys.stdin.read()}))')"
                raw=$(_zen_session_post "/cli/zen/garden/check" "$body")
                _zen_print validate "$ZEN_AS_JSON" "$raw"
                return
            fi
            local -a q=()
            [ -n "$ZEN_GARDEN_SEL" ] && q+=("garden=$(urlencode "$ZEN_GARDEN_SEL")")
            [ -n "$ZEN_FILE_SEL" ] && q+=("file=$(urlencode "$ZEN_FILE_SEL")")
            [ -n "$ZEN_THEME_SEL" ] && q+=("theme=$(urlencode "$ZEN_THEME_SEL")")
            [ -n "$ZEN_WIDGET_SEL" ] && q+=("widget=$(urlencode "$ZEN_WIDGET_SEL")")
            [ -n "$ZEN_TYPES" ] && q+=("types=$ZEN_TYPES")
            raw=$(cli_request "/cli/zen/$sub" ${q[@]+"${q[@]}"})
            # Garden data (contract-garden-data-v1 §8): `validate --widget
            # --sign` then signs a clean version as the caller (a second call;
            # validate stays a read). 0.46.1: a check never signs by default;
            # --no-sign is kept as a no-op. k2 zen widget sign does it alone.
            local signed=""
            if [ "$sub" = "validate" ] && [ -n "$ZEN_WIDGET_SEL" ] && [ "$ZEN_SIGN" = true ] \
                && [ "$(ZEN_RAW="$raw" python3 -c 'import json, os
try:
    d = json.loads(os.environ.get("ZEN_RAW") or "")
except Exception:
    d = {}
print("yes" if isinstance(d, dict) and d.get("ok") is True and d.get("error") is None and not d.get("locked") else "no")')" = "yes" ]; then
                signed=$(_zen_session_post "/cli/zen/widget/sign" \
                    "$(ZW="$ZEN_WIDGET_SEL" python3 -c 'import json, os; print(json.dumps({"widget": os.environ["ZW"]}))')")
                if [ "$ZEN_AS_JSON" = true ]; then
                    raw=$(ZEN_RAW="$raw" ZEN_SIGNED="$signed" python3 -c 'import json, os
d = json.loads(os.environ["ZEN_RAW"])
try:
    d["signed"] = json.loads(os.environ.get("ZEN_SIGNED") or "null")
except Exception:
    d["signed"] = None
print(json.dumps(d))')
                fi
            fi
            _zen_print "$sub" "$ZEN_AS_JSON" "$raw"
            if [ -n "$signed" ] && [ "$ZEN_AS_JSON" != true ]; then
                _zen_sign_print sign false "$signed" || echo "(validate was clean; signing failed, so its data calls keep the version's old maker)" >&2
            fi
            ;;
        inspect)
            cmd_zen_inspect "$@"
            ;;
        reload)
            _zen_args "$@"; _zen_validate_only_flags "$sub"
            if [ -n "$ZEN_GARDEN_SEL$ZEN_FILE_SEL$ZEN_TO$ZEN_THEME_SEL$ZEN_WIDGET_SEL" ]; then
                echo "Error: k2 zen reload takes only --json" >&2
                exit 2
            fi
            raw=$(cli_post_json "/cli/zen/reload" '{}')
            _zen_print reload "$ZEN_AS_JSON" "$raw"
            ;;
        reset)
            _zen_args "$@"; _zen_validate_only_flags "$sub"
            local body
            body=$(ZG="$ZEN_GARDEN_SEL" ZF="$ZEN_FILE_SEL" ZT="$ZEN_TO" ZM="$ZEN_THEME_SEL" ZW="$ZEN_WIDGET_SEL" python3 -c '
import json, os
b = {}
for k, e in (("garden", "ZG"), ("file", "ZF"), ("to", "ZT"), ("theme", "ZM"), ("widget", "ZW")):
    if os.environ.get(e):
        b[k] = os.environ[e]
print(json.dumps(b))
')
            raw=$(_zen_session_post "/cli/zen/reset" "$body")
            _zen_print reset "$ZEN_AS_JSON" "$raw"
            ;;
        doctor|path)
            _zen_args "$@"; _zen_validate_only_flags "$sub"
            if [ -n "$ZEN_GARDEN_SEL$ZEN_FILE_SEL$ZEN_TO$ZEN_THEME_SEL$ZEN_WIDGET_SEL" ]; then
                echo "Error: k2 zen $sub takes only --json" >&2
                exit 2
            fi
            if [ "$sub" = "doctor" ]; then
                raw=$(cli_request "/cli/zen/doctor")
            else
                raw=$(cli_request "/cli/zen/status")
            fi
            _zen_print "$sub" "$ZEN_AS_JSON" "$raw"
            ;;
        garden|gardens)
            cmd_zen_garden "$@"
            ;;
        theme|themes)
            cmd_zen_theme "$@"
            ;;
        widget|widgets)
            cmd_zen_widget "$@"
            ;;
        sync)
            cmd_zen_sync "$@"
            ;;
        news)
            cmd_zen_news "$@"
            ;;
        proposals|proposal)
            cmd_zen_proposals "$@"
            ;;
        pages)
            echo "Error: there is no 'k2 zen pages' any more: Zen pages are Gardens now. Use k2 zen garden list." >&2
            exit 2
            ;;
        ""|help|--help|-h)
            cmd_help_zen
            exit 0
            ;;
        guide)
            cmd_zen_guide "$@"
            ;;
        # Garden data admin (contract-garden-data-v1 §8): the person only.
        data)
            cmd_zen_data "$@"
            ;;
        grant|grants|allow)
            echo "Error: there is no 'k2 zen $sub'. Widgets in your own Gardens need no permissions:" >&2
            echo "they can talk to your agents right away." >&2
            exit 2
            ;;
        *)
            echo "Unknown 'k2 zen' subcommand: $sub" >&2
            cmd_help_zen >&2
            exit 2
            ;;
    esac
}

# ── Agent hire: teams, instances, hire root, sender check (0.45.6) ────
# prd-agent-hire-templates-v1 "build A": the v1 API hires from an inline
# recipe (`POST /v1/agents/hire`, an API key with the hire scope). These
# verbs are the people's side on this box:
#   k2 agent team [--workspace <ws>] [--json]      who serves me / my team / who I serve
#   k2 agent team served [--workspace <ws>]        the workspaces this team serves (+ scope)
#   k2 agent team link <team> <workspace> [--kind serves|helper_of] [--scope JSON] [--mesh]
#   k2 agent team unlink <link-id>
#   k2 agent instances [--key <api-key-id>] [--json]
#   k2 agent instances show <instance>
#   k2 agent instances hire <recipe.json|-> [--key <idempotency-key>] [--dry-run] [--json]
#   k2 agent instances retire <instance> [--force]
#   k2 agent hire-root [set <dir>]
#   k2 msg who <m_…>                               who really sent a delivery
# Inside a K2 terminal `team` and `instances` carry the session passport:
# an agent reads its own links; it never hires teams, links or retires.

# Print a hire-route JSON answer. $1 = view, $2 = "true" for raw JSON.
# Exit codes: owner_only/forbidden/exceeds_key/vault_* → 3, not_found → 4,
# usage → 2, anything else → 1.
_hire_print() {
    HIRE_VIEW="$1" HIRE_JSON="${2:-false}" python3 -c '
import json, os, sys
raw = sys.stdin.read()
try:
    d = json.loads(raw)
except Exception:
    print("Error: daemon answered: %s" % raw[:300], file=sys.stderr); sys.exit(1)
err = d.get("error") if isinstance(d, dict) else None
if err:
    code = err.get("code", "") if isinstance(err, dict) else ""
    hint = err.get("hint", "") if isinstance(err, dict) else str(err)
    print("Error: %s%s" % ((code + ": ") if code else "", hint), file=sys.stderr)
    if code in ("owner_only", "forbidden", "exceeds_key", "role_required") or "token" in hint.lower():
        sys.exit(3)
    sys.exit({"not_found": 4, "usage": 2}.get(code, 1))
if os.environ.get("HIRE_JSON") == "true":
    print(json.dumps(d, indent=2)); sys.exit(0)
view = os.environ.get("HIRE_VIEW", "")
def link_line(l, side):
    other = l.get("teamLeadHandle") if side == "out" else l.get("consumerHandle")
    team = l.get("teamName") or l.get("teamLeadHandle") or "?"
    scope = json.dumps(l["scope"]) if l.get("scope") is not None else "-"
    if side == "out":
        return "  %s  %s %s (lead %s)  scope %s" % (l["id"], "served by" if l["kind"] == "serves" else "helped by", team, other or "?", scope)
    return "  %s  %s %s  scope %s" % (l["id"], "serves" if l["kind"] == "serves" else "helps", other or "?", scope)
if view in ("team", "served"):
    ws = d.get("workspace") or {}
    print("Workspace: %s" % (ws.get("handle") or ws.get("id")))
    t = d.get("team")
    if view == "team":
        if t:
            print("Team: %s (%s)" % (t.get("name") or "(single hire)", t.get("instance")))
            for m in t.get("members") or []:
                print("  %s%s  %s" % (m["handle"], " (lead)" if m.get("lead") else "", m.get("role", "")))
        out = d.get("servedBy") or []
        print("Served by:" if out else "Served by: nobody")
        for l in out: print(link_line(l, "out"))
    inn = d.get("serves") or []
    print("Serves:" if inn else "Serves: nobody")
    for l in inn: print(link_line(l, "in"))
elif view == "instances":
    rows = d.get("instances") or []
    if not rows:
        print("No hires yet."); sys.exit(0)
    for i in rows:
        members = ",".join(m["handle"] for m in i.get("members") or [])
        who = i.get("apiKeyId") and ("key " + i["apiKeyId"][:8]) or i.get("actor")
        print("%s  [%s]  %s  %s  by %s%s" % (i["id"], i["status"], i.get("teamName") or "-", members or "-", who,
              ("  for %s (app-asserted)" % i["onBehalfOf"]) if i.get("onBehalfOf") else ""))
elif view == "instance":
    i = d.get("instance") or {}
    print("%s  [%s]  %s" % (i.get("id"), i.get("status"), i.get("teamName") or "(single hire)"))
    if i.get("reason"): print("  reason: %s" % i["reason"])
    for m in i.get("members") or []:
        print("  %s%s  %s  [%s]  %s" % (m["handle"], " (lead)" if m.get("lead") else "", m.get("role"), m.get("status"), m.get("path")))
    for l in d.get("links") or []:
        print("  link %s  %s → %s" % (l["id"], l.get("teamLeadHandle"), l.get("consumerHandle")))
    for e in d.get("events") or []:
        print("  event %s %s %s%s" % (e["at"], e["action"], e["result"], (" — " + e["reason"]) if e.get("reason") else ""))
elif view == "hire":
    if d.get("dryRun"):
        p = d.get("plan") or {}
        print("Plan (nothing written):")
        for m in p.get("members") or []:
            print("  %s%s  %s" % (m["handle"], " (lead)" if m.get("lead") else "", m["path"]))
        print(p.get("note", "")); sys.exit(0)
    print("%s %s" % ("Hired" if d.get("changed") else "Already hired (same key):", d.get("instance")))
    for m in d.get("members") or []:
        print("  %s%s  %s" % (m["handle"], " (lead)" if m.get("lead") else "", m["path"]))
    for l in d.get("links") or []:
        print("  linked %s" % l["id"])
elif view == "retire":
    print("%s %s" % (d.get("instance"), d.get("status")))
    for m in d.get("members") or []:
        print("  %s %s%s" % (m["handle"], m["status"], (" — " + m["reason"]) if m.get("reason") else ""))
    if d.get("hint"): print(d["hint"])
    if d.get("status") == "retire_blocked": sys.exit(3)
elif view == "link":
    l = d.get("link") or {}
    print("%s %s" % ("Linked" if d.get("changed") else "Already linked:", l.get("id")))
elif view == "unlink":
    print("Unlinked %s" % d.get("link") if d.get("changed") else "Link %s was already removed" % d.get("link"))
elif view == "root":
    print("%s%s" % (d.get("root"), "  (default)" if d.get("default") else ""))
elif view == "who":
    s = d.get("sender") or {}
    print("Delivery %s" % d.get("id"))
    print("  via:     %s%s" % (d.get("via"), "  (the sender agent'"'"'s own session)" if d.get("via") == "passport" else ""))
    print("  sender:  %s" % (s.get("handle") or s.get("label") or "-"))
    print("  actor:   %s" % d.get("actor"))
    if d.get("onBehalfOf"): print("  for:     %s (app-asserted, not verified)" % d["onBehalfOf"]["value"])
    print("  linked:  %s" % ("yes " + ", ".join("%s %s" % (l["id"], json.dumps(l.get("scope"))) for l in d.get("links") or []) if d.get("linked") else "no"))
else:
    print(json.dumps(d, indent=2))
'
}

cmd_agent_team() {
    local sub="${1:-}"
    case "$sub" in
        --help|-h|help)
            sed -n '/^# ── Agent hire: teams, instances/,/^# Inside a K2 terminal/p' "$0" | sed 's/^# \{0,1\}//'
            return 0 ;;
        link)
            shift
            local team="" ws="" kind="" scope="" topo="" as_json=false
            while [ $# -gt 0 ]; do
                case "$1" in
                    --kind) kind="${2:-}"; shift 2 ;;
                    --scope) scope="${2:-}"; shift 2 ;;
                    --mesh) topo="mesh"; shift ;;
                    --json) as_json=true; shift ;;
                    -*) echo "Unknown flag: $1" >&2; exit 2 ;;
                    *) if [ -z "$team" ]; then team="$1"; elif [ -z "$ws" ]; then ws="$1"; else echo "Unexpected: $1" >&2; exit 2; fi; shift ;;
                esac
            done
            [ -n "$team" ] && [ -n "$ws" ] || { echo "Usage: k2 agent team link <team instance|workspace> <workspace it serves> [--kind serves|helper_of] [--scope JSON] [--mesh]" >&2; exit 2; }
            local body
            body=$(T="$team" W="$ws" KIND="$kind" SCOPE="$scope" TOPO="$topo" python3 -c '
import json, os, sys
b = {"team": os.environ["T"], "workspace": os.environ["W"]}
if os.environ.get("KIND"): b["kind"] = os.environ["KIND"]
if os.environ.get("TOPO"): b["topology"] = os.environ["TOPO"]
s = os.environ.get("SCOPE", "")
if s:
    try: b["scope"] = json.loads(s)
    except ValueError: print("--scope must be JSON", file=sys.stderr); sys.exit(2)
print(json.dumps(b))') || exit 2
            cli_post_json "/cli/agent-teams/link" "$body" | _hire_print link "$as_json" ;;
        unlink)
            shift
            local id="${1:-}"
            [ -n "$id" ] || { echo "Usage: k2 agent team unlink <link-id>" >&2; exit 2; }
            cli_post_json "/cli/agent-teams/unlink" "$(L="$id" python3 -c 'import json,os; print(json.dumps({"link": os.environ["L"]}))')" \
                | _hire_print unlink false ;;
        served|""|--json|--workspace)
            local view="team" ws="" as_json=false
            [ "$sub" = "served" ] && { view="served"; shift; }
            while [ $# -gt 0 ]; do
                case "$1" in
                    --workspace) ws="${2:-}"; shift 2 ;;
                    --json) as_json=true; shift ;;
                    *) echo "Unknown argument: $1 (see k2 agent team --help)" >&2; exit 2 ;;
                esac
            done
            [ -n "$ws" ] || ws="$PROJECT"
            cli_request "/cli/agent-teams/links" "workspace=$(urlencode "$ws")" | _hire_print "$view" "$as_json" ;;
        *)
            echo "Unknown: k2 agent team $sub (see k2 agent team --help)" >&2; exit 2 ;;
    esac
}

cmd_agent_instances() {
