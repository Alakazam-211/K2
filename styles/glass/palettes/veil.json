{
  "$schema": "../../style.schema.json#/$defs/palette",
  "id": "veil",
  "name": "Veil",
  "schemes": ["light"],
  "color": {
    "bg": { "$value": "#f2f4f8", "$type": "color", "$description": "Opaque. Terminals and WebGL always sit on this — never glass." },
    "bg-surface": { "$value": "rgba(255, 255, 255, 0.55)", "$type": "color", "$description": "Frosted panel tint (backdrop-filter supplies the blur)." },
    "bg-elevated": { "$value": "rgba(255, 255, 255, 0.68)", "$type": "color" },
    "bg-inset": { "$value": "#eef1f6", "$type": "color", "$description": "Content wells stay solid for readability." },
    "bg-stripe": { "$value": "rgba(248, 250, 253, 0.50)", "$type": "color" },
    "bg-canvas": { "$value": "#e6eaf2", "$type": "color", "$description": "Base under the pale aurora (overrides.css paints it)." },
    "bg-hover": { "$value": "rgba(20, 40, 90, 0.06)", "$type": "color" },
    "border": { "$value": "rgba(20, 30, 60, 0.10)", "$type": "color" },
    "border-strong": { "$value": "rgba(20, 30, 60, 0.30)", "$type": "color" },
    "text-primary": { "$value": "#1a1d26", "$type": "color" },
    "text-secondary": { "$value": "#4c5568", "$type": "color" },
    "text-muted": { "$value": "#8a93a8", "$type": "color" },
    "accent": { "$value": "#2f6fe0", "$type": "color", "$description": "Deepened cool blue — reads through daylight frost." },
    "accent-hover": { "$value": "#2258bd", "$type": "color" },
    "accent-soft": { "$value": "#6d9ae8", "$type": "color" },
    "on-accent": { "$value": "#ffffff", "$type": "color" },
    "status-working": { "$value": "#c05a12", "$type": "color" },
    "status-error": { "$value": "#c22f2f", "$type": "color" },
    "status-ok": { "$value": "#1e7c46", "$type": "color" },
    "status-warn": { "$value": "#a3720a", "$type": "color" },
    "status-ok-soft": { "$value": "#27994f", "$type": "color" },
    "status-warn-soft": { "$value": "#b07f0c", "$type": "color" },
    "status-error-soft": { "$value": "#a82a2a", "$type": "color" },
    "status-error-bright": { "$value": "#8c1f1f", "$type": "color", "$description": "'Bright' inverts to darkest on light — it's the emphasis step." },
    "status-error-text": { "$value": "#a82a2a", "$type": "color" },
    "status-working-soft": { "$value": "#cf7434", "$type": "color" },
    "status-warn-text": { "$value": "#8f6508", "$type": "color" },
    "status-warn-amber": { "$value": "#99610a", "$type": "color" },
    "status-warn-amber-soft": { "$value": "#7f5407", "$type": "color" },
    "status-warn-amber-bright": { "$value": "#6e4805", "$type": "color" },
    "status-ok-hover": { "$value": "#16613a", "$type": "color" },
    "danger": { "$value": "#c22f2f", "$type": "color" },
    "danger-active": { "$value": "#9c2424", "$type": "color" },
    "danger-muted": { "$value": "#ab3535", "$type": "color" },
    "danger-hover": { "$value": "#c22f2f", "$type": "color" },
    "neutral": { "$value": "#76829c", "$type": "color" },
    "control-track-off": { "$value": "rgba(20, 30, 60, 0.14)", "$type": "color" },
    "wash-1": { "$value": "rgba(20, 30, 60, 0.04)", "$type": "color" },
    "wash-2": { "$value": "rgba(20, 30, 60, 0.08)", "$type": "color" },
    "wash-3": { "$value": "rgba(20, 30, 60, 0.15)", "$type": "color" },
    "scrim": { "$value": "rgba(18, 24, 40, 0.30)", "$type": "color", "$description": "Lighter than Square — the frost itself does half the separation." },
    "diff-add-text": { "$value": "#47691a", "$type": "color" },
    "diff-remove-text": { "$value": "#9c2c2c", "$type": "color" },
    "diff-modified-border": { "$value": "#3fa06a", "$type": "color" },
    "code-inline": { "$value": "#8a5a14", "$type": "color" },
    "overlay-soft-bg": { "$value": "rgba(20, 30, 60, 0.05)", "$type": "color" },
    "overlay-soft-border": { "$value": "rgba(20, 30, 60, 0.08)", "$type": "color" },
    "scrollbar-thumb": { "$value": "rgba(20, 30, 60, 0.14)", "$type": "color" },
    "scrollbar-thumb-hover": { "$value": "rgba(20, 30, 60, 0.26)", "$type": "color" },
    "scrollbar-thumb-strong": { "$value": "rgba(20, 30, 60, 0.30)", "$type": "color" },
    "scrollbar-thumb-strong-hover": { "$value": "rgba(20, 30, 60, 0.44)", "$type": "color" },
    "ring-edge-strong": { "$value": "rgba(255, 255, 255, 0.9)", "$type": "color", "$description": "Specular top edge on frosted surfaces (ring.surface layer 1)." },
    "ring-edge": { "$value": "rgba(255, 255, 255, 0.85)", "$type": "color", "$description": "Softer specular on fields (ring.field layer 1)." },
    "ring-hairline": { "$value": "rgba(20, 30, 60, 0.08)", "$type": "color", "$description": "Surface hairline — dark on light so the edge still reads." },
    "ring-hairline-soft": { "$value": "rgba(20, 30, 60, 0.06)", "$type": "color", "$description": "Field hairline." }
  },
  "terminal": {
    "fg": { "$value": "#1a1d26", "$type": "color" },
    "bg": { "$value": "#f2f4f8", "$type": "color" },
    "cursor": { "$value": "#1a1d26", "$type": "color" },
    "selection": { "$value": "#c8d2e6", "$type": "color" },
    "ansi": [
      "#1a1d26", "#c22f2f", "#1e7c46", "#a3720a",
      "#2f6fe0", "#7a4b9e", "#0e7a80", "#8a93a8",
      "#4c5568", "#dc4b4b", "#27994f", "#c28d12",
      "#4f86e6", "#9463b8", "#159299", "#080a10"
    ]
  }
}
