        {"name": "--comment", "arg": null, "description": "A read-only share may comment."},
        {"name": "-w", "arg": "ws", "description": "The workspace that owns it."}
      ]
    },
    {
      "name": "doc unshare",
      "usage": "k2 doc unshare <file-or-folder> --with <ws> -w <ws>",
      "description": "People only: end a share.",
      "args": [{"name": "file-or-folder", "required": true}],
      "flags": [
        {"name": "--with", "arg": "ws", "description": "The workspace that had it."},
        {"name": "-w", "arg": "ws", "description": "The workspace that owns it."}
      ]
    },
    {
      "name": "doc shares",
      "usage": "k2 doc shares [-w <ws>] [--with <ws>]",
      "description": "People only: list shares.",
      "args": [],
      "flags": [
        {"name": "-w", "arg": "ws", "description": "Which workspace."},
