            --no-sandbox) sandbox="false"; shift ;;
            *) shift ;;
        esac
    done
    if [ -z "$command" ]; then
        echo "Usage: k2 terminal spawn --command \"...\" [--title \"...\"] [--agent <name>] [--wait] [--sandbox|--no-sandbox]" >&2
        exit 1
