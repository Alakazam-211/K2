cmd_compute() {
    local sub="${1:-}"
    case "$sub" in
        ""|help|--help|-h) _compute_usage; return 0 ;;
    esac
    shift
    if _wants_help "$@"; then
        _compute_usage
        return 0
    fi
    local as_json=0 a
    for a in "$@"; do [ "$a" = "--json" ] && as_json=1; done
    case "$sub" in
        nodes|ls)
            _compute_call GET /cli/compute/nodes ""
            [ "$as_json" = "1" ] && { printf '%s\n' "$_CP_BODY"; exit 0; }
            _compute_render nodes
            ;;
        info)
            [ -n "${1:-}" ] || { echo "usage: k2 compute info <node>" >&2; exit 2; }
            _compute_call GET /cli/compute/nodes/info "node=$(urlencode "$1")"
            [ "$as_json" = "1" ] && { printf '%s\n' "$_CP_BODY"; exit 0; }
            _compute_render info
            ;;
        run) cmd_compute_run "$@" ;;
        jobs)
            local q="" n=""
            while [ $# -gt 0 ]; do
                case "$1" in
                    --node) q="$q&node=$(urlencode "${2:-}")"; shift 2 ;;
                    --state) q="$q&state=$(urlencode "${2:-}")"; shift 2 ;;
                    --limit) q="$q&limit=$(urlencode "${2:-}")"; shift 2 ;;
                    --workspace) q="$q&workspace=$(urlencode "${2:-}")"; shift 2 ;;
                    --mine) q="$q&mine=1"; shift ;;
                    --json) shift ;;
                    *) echo "usage: k2 compute jobs [--node N] [--mine] [--state S] [--limit N]" >&2; exit 2 ;;
                esac
            done
            n="${q#&}"
            _compute_call GET /cli/compute/jobs "$n"
            [ "$as_json" = "1" ] && { printf '%s\n' "$_CP_BODY"; exit 0; }
            _compute_render jobs
            ;;
        get|status)
            [ -n "${1:-}" ] || { echo "usage: k2 compute get <job>" >&2; exit 2; }
            _compute_call GET /cli/compute/jobs/get "job=$(urlencode "$1")"
            [ "$as_json" = "1" ] && { printf '%s\n' "$_CP_BODY"; exit 0; }
            _compute_render get
            ;;
        attach)
            local job="" since="" raw=0
            while [ $# -gt 0 ]; do
                case "$1" in
                    --since) since="${2:-}"; shift 2 ;;
                    --raw) raw=1; shift ;;
                    *) job="$1"; shift ;;
                esac
            done
            [ -n "$job" ] || { echo "usage: k2 compute attach <job> [--since SEQ]" >&2; exit 2; }
            _compute_call GET /cli/compute/jobs/get "job=$(urlencode "$job")"
            job="$(printf '%s' "$_CP_BODY" | python3 -c 'import json,sys; print(json.load(sys.stdin)["id"])')"
            _compute_follow "$job" "$raw" "seq:${since:-0}"
            ;;
        logs) cmd_compute_logs "$@" ;;
        cancel|retry)
            [ -n "${1:-}" ] || { echo "usage: k2 compute $sub <job>" >&2; exit 2; }
            _compute_call POST "/cli/compute/jobs/$sub" "$(_compute_json K2_CJ_job="$1")"
            printf '%s' "$_CP_BODY" | python3 -c '
import json, sys
v = json.load(sys.stdin)
if "cancel" in v: print("cancel %s (job was %s)" % (v["cancel"], v["state"]))
elif "job" in v: print("retrying as attempt %s: k2 compute attach %s" % (v["job"]["attempt"], v["job"]["short"]))
else: print(v.get("state", "ok"))'
            ;;
        receipt)
            [ -n "${1:-}" ] || { echo "usage: k2 compute receipt <job>" >&2; exit 2; }
            _compute_call GET /cli/compute/jobs/receipt "job=$(urlencode "$1")"
            [ "$as_json" = "1" ] && { printf '%s\n' "$_CP_BODY"; exit 0; }
            _compute_render receipt
            ;;
        node) cmd_compute_node "$@" ;;
        grant) cmd_compute_grant "$@" ;;
        revoke)
            local node="" workspace=""
            while [ $# -gt 0 ]; do
                case "$1" in
                    --workspace) workspace="${2:-}"; shift 2 ;;
                    *) node="$1"; shift ;;
                esac
            done
            [ -n "$node" ] && [ -n "$workspace" ] || { echo "usage: k2 compute revoke <node> --workspace WS" >&2; exit 2; }
            _compute_call POST /cli/compute/grants/revoke "$(_compute_json K2_CJ_node="$node" K2_CJ_workspace="$workspace")" tcp
            printf '%s' "$_CP_BODY" | python3 -c 'import json,sys; v=json.load(sys.stdin); print(("revoked %s for %s. " % (v["node"], v["workspace"]) if v["removed"] else "no grant to revoke. ") + v["note"])'
            ;;
        grants)
            local q=""
            while [ $# -gt 0 ]; do
                case "$1" in
                    --node) q="$q&node=$(urlencode "${2:-}")"; shift 2 ;;
                    --workspace) q="$q&workspace=$(urlencode "${2:-}")"; shift 2 ;;
                    *) shift ;;
                esac
            done
            _compute_call GET /cli/compute/grants "${q#&}"
            [ "$as_json" = "1" ] && { printf '%s\n' "$_CP_BODY"; exit 0; }
            _compute_render grants
            ;;
        preview)
            # The owner's switch for the whole preview (CN30, `computePreview`).
            # Not a compute route, so it works while compute is off. Owner
            # only: run it from a plain terminal, not a K2 tab (a tab sends
            # its session passport and the daemon refuses).
            local action="${1:-status}"
            case "$action" in
                on|off)
                    _compute_call POST /cli/settings/update "{\"computePreview\":$([ "$action" = on ] && echo true || echo false)}" tcp
                    ;;
                status) _compute_call GET /cli/settings/get "" tcp ;;
                *) echo "usage: k2 compute preview on|off|status" >&2; exit 2 ;;
            esac
            printf '%s' "$_CP_BODY" | python3 -c 'import json,sys; v=json.load(sys.stdin); print("Compute nodes (preview): %s on this server" % ("on" if v.get("computePreview") else "off"))'
            ;;
        access)
            local action="${1:-status}" workspace="" all=""
            shift 2>/dev/null || true
            while [ $# -gt 0 ]; do
                case "$1" in
                    --workspace) workspace="${2:-}"; shift 2 ;;
                    --all-machines) all=1; shift ;;
                    *) echo "usage: k2 compute access on|off --workspace WS" >&2; exit 2 ;;
                esac
            done
            [ -z "$workspace" ] && workspace="$(_compute_ws "")"
            case "$action" in
                on|off)
                    # The Agent tab's "Allow compute nodes" (the single
                    # control, Rosson 2026-10-11): on also grants every
                    # machine switched on (and ones added later); off removes
                    # the workspace's grants. --all-machines is accepted for
                    # old scripts; it's what plain on/off does now.
                    : "$all"
                    _compute_call POST /cli/agent-access/set "$(_compute_json K2_CJ_workspace="$workspace" K2_CJ_toggle=compute K2_CJ_value_b="$([ "$action" = on ] && echo 1 || echo 0)")" tcp
                    printf '%s' "$_CP_BODY" | python3 -c 'import json,sys
v=json.load(sys.stdin)
on=v["agentsCanUseCompute"]
m=v.get("granted", []) + v.get("kept", [])
tail=((": " + ", ".join(m)) if m else ": no machines switched on yet (ones added later are granted)") if on else (" (%d grants removed)" % v.get("grantsRemoved", 0) if "grantsRemoved" in v else "")
print("Allow compute nodes: %s for %s%s" % ("on" if on else "off", v["workspace"], tail))'
                    ;;
                *) echo "usage: k2 compute access on|off --workspace WS" >&2; exit 2 ;;
            esac
            ;;
        operate)
            # Node admin (Q14): "Allow this agent to operate compute nodes".
            local action="${1:-}" workspace=""
            shift 2>/dev/null || true
            while [ $# -gt 0 ]; do
                case "$1" in
                    --workspace) workspace="${2:-}"; shift 2 ;;
                    *) echo "usage: k2 compute operate on|off --workspace WS" >&2; exit 2 ;;
                esac
            done
            [ -z "$workspace" ] && workspace="$(_compute_ws "")"
            case "$action" in
                on|off) ;;
                *) echo "usage: k2 compute operate on|off --workspace WS" >&2; exit 2 ;;
            esac
            _compute_call POST /cli/agent-access/set "$(_compute_json K2_CJ_workspace="$workspace" K2_CJ_toggle=compute_operate K2_CJ_value_b="$([ "$action" = on ] && echo 1 || echo 0)")" tcp
            printf '%s' "$_CP_BODY" | python3 -c 'import json,sys
v=json.load(sys.stdin)
print("Allow this agent to operate compute nodes: %s for %s%s" % ("on" if v["agentsCanOperateCompute"] else "off", v["workspace"], " (narrow, pause, update, restart; root actions still wait for you)" if v["agentsCanOperateCompute"] else ""))'
            ;;
        usage)
            local days=7
            [ "${1:-}" = "--days" ] && days="${2:-7}"
            _compute_call GET /cli/compute/usage "days=$(urlencode "$days")" tcp
            _compute_render usage
            ;;
        events)
            local limit=50
            [ "${1:-}" = "--limit" ] && limit="${2:-50}"
            _compute_call GET /cli/compute/events "limit=$(urlencode "$limit")" tcp
            [ "$as_json" = "1" ] && { printf '%s\n' "$_CP_BODY"; exit 0; }
            _compute_render events
            ;;
        local) cmd_compute_local "$@" ;;
        *)
            echo "usage: unknown compute verb '$sub' (k2 compute --help)" >&2
            exit 2
            ;;
    esac
}

# ── k2 llm tokens — LLM subscriptions and API tokens ─────────────────
# (`k2 llm accounts` is a working alias.) One token per tool is the
# SERVER DEFAULT, kept where the tool always keeps it; the other
# subscriptions and API tokens wait in ~/.k2/llm-accounts. GET
# /cli/llm/accounts/list|status|usage|login/status|pins; POST
# add|add-key|login|login/input|login/cancel|switch|next|rename|remove|
# refresh|pin|unpin (JSON bodies; route names are internal and unchanged).
# `llm` is an `id` tool: inside a K2 terminal the request carries this
# session's passport, and the daemon keeps passports read-only
# (list/status/usage/pins). Change tokens on Settings → Language Models → Subs / Tokens, or
# from a terminal outside K2.

_llm_accounts_usage() {
    cat <<'EOF'
k2 llm tokens — LLM tokens: subscriptions and API tokens
(Claude, Codex, Grok subscriptions; API tokens also Gemini)

  k2 llm tokens list [--tool <tool>] [--json]
  k2 llm tokens status <tool> <label|id> [--json]
  k2 llm tokens usage [--json]
  k2 llm tokens add <tool> <label> [--device]        add a subscription (the tool's own sign-in)
  k2 llm tokens login <tool> <label> [--device]      sign a subscription in again
  k2 llm tokens switch <tool> <label>                use this token as the server default
  k2 llm tokens next <tool>                          use the next signed-in subscription
  k2 llm tokens rename <tool> <label> <new-label>
  k2 llm tokens remove <tool> <label>                not the server default (kept in Trash)
  k2 llm tokens refresh [<tool> <label>] [--usage]   re-read state (and usage)
  k2 llm tokens add-key <tool> <label>               add an API token (read from stdin)
  k2 llm tokens pin --workspace <ws> <tool> <label>  use this token for a workspace
  k2 llm tokens pin --session <key> <tool> <label>   use this token for one chat
  k2 llm tokens unpin --workspace <ws>|--session <key> <tool>
                                                     back to Server default
  k2 llm tokens pins [--json]                        workspaces and chats with their own token

`k2 llm accounts …` is the same command (alias).

Each tool has ONE server default token per server. Changing the server
default affects every chat that uses Server default on this server;
running sessions pick up the new token.
add/login print the sign-in page and any device code; when the tool asks
for a code, paste it at the prompt (it is read from stdin, never an argument).
--device signs in from another device (device code where the tool has one).
Which token a chat uses: its own token > its workspace's token > Server
default. A chat's own token (--session <key>: the pinned chat's key is its
workspace id, a tab's is tab-<id>; or conversation:<id>) applies every time
that chat starts or is revived. Otherwise a resumed chat keeps the token it
started on. A subscription set for a workspace or chat is never also the
server default, and `next` skips it.
API tokens (add-key) are billed per token, go only to sessions that use
them, and are never shown again. The key is read from stdin, never an argument.
Agents and K2 terminals are read-only (list, status, usage, pins). Change
tokens on Settings → Language Models → Subs / Tokens, or run k2 from a terminal outside K2.
More: k2 study llm-tokens
EOF
}

# Paths (kept in variables: none of these is ever sent as a GET unless it
# is a read route).
_LLMA_BASE="/cli/llm/accounts"

# _llma_json k1 v1 k2 v2 … → a JSON object. Values "__true__"/"__false__"
# become booleans; empty values are dropped.
_llma_json() {
    python3 -c '
import json, sys
a = sys.argv[1:]
out = {}
for k, v in zip(a[::2], a[1::2]):
    if v == "__true__":
        out[k] = True
    elif v == "__false__":
        out[k] = False
    elif v != "":
        out[k] = v
print(json.dumps(out))
' "$@"
}

# Tools that take API keys (and so can be pinned): the sign-in tools
# plus Gemini.
_llma_key_tool_ok() {
    case "${1:-}" in
        claude|codex|grok|gemini) return 0 ;;
        cursor|cursor-agent|pi|hermes)
            echo "usage: ${1} has no LLM tokens yet (claude, codex, grok, gemini)" >&2
            exit 2
            ;;
        "")
            echo "usage: missing <tool> (claude, codex, grok or gemini) — k2 llm tokens --help" >&2
            exit 2
            ;;
        *)
            echo "usage: unknown tool '$1' (claude, codex, grok or gemini) — k2 llm tokens --help" >&2
            exit 2
            ;;
    esac
}

_llma_tool_ok() {
    case "${1:-}" in
        claude|codex|grok) return 0 ;;
        gemini|cursor|cursor-agent|pi|hermes)
            echo "usage: ${1} has no subscriptions yet (claude, codex, grok)" >&2
            exit 2
            ;;
        "")
            echo "usage: missing <tool> (claude, codex or grok) — k2 llm tokens --help" >&2
            exit 2
            ;;
        *)
            echo "usage: unknown tool '$1' (claude, codex or grok) — k2 llm tokens --help" >&2
            exit 2
            ;;
    esac
}

# GET a read route; sets _SC_BODY/_SC_STATUS, exits on a refusal.
_llma_get() {
    local path="$1" query="${2:-}"
    _sidecar_split "$(_sidecar_send GET "${_LLMA_BASE}/${path}" "$query")"
    [ "$_SC_STATUS" = "200" ] || _sidecar_fail "$_SC_STATUS" "$_SC_BODY"
}

# POST a JSON body; sets _SC_BODY/_SC_STATUS, exits on a refusal.
_llma_post() {
    local path="$1" body="$2"
    _sidecar_split "$(_sidecar_send POST "${_LLMA_BASE}/${path}" "$body")"
    [ "$_SC_STATUS" = "200" ] || _sidecar_fail "$_SC_STATUS" "$_SC_BODY"
}

# Resolve <tool> <label|id> to an account id through the list route.
_llma_resolve() {
    local tool="$1" key="$2" id
    _llma_get list
    id="$(printf '%s' "$_SC_BODY" | python3 -c '
import json, sys
tool, key = sys.argv[1], sys.argv[2]
v = json.load(sys.stdin)
for t in v.get("tools", []):
    if t.get("tool") != tool:
        continue
    for a in t.get("accounts", []):
        if a.get("id") == key or (a.get("label") or "").lower() == key.lower():
            print(a["id"]); sys.exit(0)
' "$tool" "$key" 2>/dev/null)"
    if [ -z "$id" ]; then
        echo "not_found: no ${tool} token named '${key}' (k2 llm tokens list --tool ${tool})" >&2
        exit 4
    fi
    printf '%s' "$id"
}

_llma_render_list() {
    local tool_filter="${1:-}"
    printf '%s' "$_SC_BODY" | python3 -c '
import json, sys
want = sys.argv[1]
v = json.load(sys.stdin)

import time

def ago(ts):
    # "checked 12 min ago"; ts is unix seconds.
    if not ts:
        return "never checked"
    d = max(0, int(time.time()) - int(ts))
    if d < 60:
        return "checked just now"
    if d < 3600:
        return "checked %d min ago" % (d // 60)
    if d < 86400:
        return "checked %d h ago" % (d // 3600)
    return "checked %d d ago" % (d // 86400)

def usage_summary(u, checked):
    if not u:
        return "-"
    wins = u.get("windows") or []
    if wins:
        s = " · ".join("%s %d%%" % (w.get("label", "?"), round(float(w.get("used", 0)) * 100)) for w in wins)
    else:
        s = u.get("status") or "-"
    s += " (%s)" % ago(checked)
    if u.get("error"):
        s += " [last check failed: %s]" % u["error"]
    return s

for t in v.get("tools", []):
    name = t.get("tool")
    if want and name != want and not (want == "cursor-agent" and name == "cursor"):
        continue
    disp = t.get("display") or name
    if not t.get("supported"):
        print("%s: no tokens yet" % disp)
        continue
    accts = t.get("accounts") or []
    if not accts:
        if t.get("subscription") is False:
            print("%s: no API tokens (add one: k2 llm tokens add-key %s <label>)" % (disp, name))
        else:
            print("%s: no tokens (add a subscription: k2 llm tokens add %s <label>)" % (disp, name))
        continue
    since = ""
    if t.get("switchedAt"):
        since = " (server default since %s%s)" % (
            time.strftime("%Y-%m-%d %H:%M", time.localtime(int(t["switchedAt"]))),
            (" by %s" % t["switchedBy"]) if t.get("switchedBy") else "")
    print("%s:%s" % (disp, since))
    for a in accts:
        mark = "*" if a.get("active") else " "
        if a.get("kind") == "api_key":
            line = "  %s %-20s %-12s %s" % (mark, (a.get("label") or "-")[:20], a.get("state") or "-",
                                            "API token · billed per token")
        else:
            line = "  %s %-20s %-12s %-8s %s" % (mark, (a.get("label") or "-")[:20], a.get("state") or "-",
                                                 (a.get("plan") or "-")[:8],
                                                 usage_summary(a.get("usage"), a.get("usageCheckedAt")))
        print(line.rstrip())
        pins = a.get("pinnedTo") or []
        if pins:
            print("      used by: %s%s" % (", ".join("%s %s" % ("chat" if p.get("scopeKind") == "session" else p.get("scopeKind"), p.get("label") or p.get("scopeId")) for p in pins),
                                         " (in use)" if a.get("inUse") else ""))
        if a.get("detail"):
            print("      %s" % a["detail"])
if v.get("airgap"):
    print("Air-gap is on: no sign-in, refresh or usage calls.")
for r in v.get("keychainRepairs") or []:
    print("WARN keychain: macOS asks for your password on every Claude read of \"%s\" (%s): its partition list is %s, without apple-tool:." % (
        r.get("service"), r.get("holds"), ",".join(r.get("partitions") or []) or "empty"))
    print("     Fix once in Terminal (asks for your login password): %s" % r.get("command"))
print("* = the server default token.")
print(v.get("switchNote") or "Changing the server default token affects every chat that uses Server default on this server.")
' "$tool_filter"
}

# Follow a login started by add/login until it ends. Prints the sign-in
# page and device code once each; reads a pasted code from stdin when the
# tool asks for one (never echoed, never an argument).
_llma_follow_login() {
    local start_body="$1"
    local login_id
    login_id="$(printf '%s' "$start_body" | python3 -c '
import json, sys
v = json.load(sys.stdin)
print((v.get("login") or {}).get("loginId") or "")
' 2>/dev/null)"
    if [ -z "$login_id" ]; then
        echo "daemon_error: the daemon did not start a sign-in" >&2
        exit 1
    fi
    _LLMA_LOGIN_ID="$login_id"
    trap '_llma_post login/cancel "$(_llma_json loginId "$_LLMA_LOGIN_ID")" >/dev/null 2>&1; echo "cancelled" >&2; exit 130' INT TERM
    local poll="${K2_LLMA_POLL_SECS:-2}"
    local shown_url="" shown_code="" shown_banner="" prompted=0
    local deadline=$(( $(date +%s) + 1200 ))
    while :; do
        _llma_get login/status "loginId=$(urlencode "$login_id")"
        local fields
        fields="$(printf '%s' "$_SC_BODY" | python3 -c '
import json, sys
l = json.load(sys.stdin).get("login") or {}
def one(x):
    return ("" if x is None else str(x)).replace("\n", " ").replace("\t", " ")
print("\x1f".join([one(l.get("state")), one(l.get("url")), one(l.get("code")), one(l.get("banner")),
                 one(l.get("error")), "1" if l.get("done") else "0", "1" if l.get("offerMakeActive") else "0",
                 one(l.get("tool")), one(l.get("label"))]))
')"
        local state url code banner err done offer tool label
        IFS=$'\x1f' read -r state url code banner err done offer tool label <<< "$fields"
        if [ -n "$banner" ] && [ "$banner" != "$shown_banner" ]; then
            echo "$banner" >&2
            shown_banner="$banner"
        fi
        if [ -n "$url" ] && [ "$url" != "$shown_url" ]; then
            echo "Open this page to sign in: $url"
            shown_url="$url"
        fi
        if [ -n "$code" ] && [ "$code" != "$shown_code" ]; then
            echo "Enter this code on that page: $code"
            shown_code="$code"
        fi
        case "$state" in
            signed_in)
                trap - INT TERM
                echo "Signed in: ${tool} subscription '${label}'."
                if [ "$offer" = "1" ]; then
                    echo "It is not the server default. To use it now: k2 llm tokens switch ${tool} '${label}'"
                    echo "Changing the server default token affects every chat that uses Server default on this server."
                fi
                exit 0
                ;;
            failed|timed_out|cancelled)
                trap - INT TERM
                echo "sign-in ${state}${err:+: $err}" >&2
                exit 1
                ;;
            waiting_for_code)
                if [ "$prompted" = "0" ]; then
                    prompted=1
                    local pasted=""
                    printf 'Paste the code: ' >&2
                    if [ -t 0 ]; then
                        IFS= read -rs pasted || pasted=""
                        echo >&2
                    else
                        IFS= read -r pasted || pasted=""
                    fi
                    if [ -z "$pasted" ]; then
                        _llma_post login/cancel "$(_llma_json loginId "$login_id")" >/dev/null 2>&1 || true
                        trap - INT TERM
                        echo "no code entered; sign-in cancelled" >&2
                        exit 1
                    fi
                    _llma_post login/input "$(_llma_json loginId "$login_id" text "$pasted")"
                    pasted=""
                    continue
                fi
                ;;
        esac
        if [ "$done" = "1" ]; then
            trap - INT TERM
            echo "sign-in ended (${state:-unknown})${err:+: $err}" >&2
            exit 1
        fi
        if [ "$(date +%s)" -ge "$deadline" ]; then
            _llma_post login/cancel "$(_llma_json loginId "$login_id")" >/dev/null 2>&1 || true
            trap - INT TERM
            echo "sign-in timed out" >&2
            exit 1
        fi
        sleep "$poll"
    done
}

cmd_llm_accounts() {
    local sub="${1:-}"
    case "$sub" in
        ""|help|--help|-h) _llm_accounts_usage; return 0 ;;
    esac
    shift
    if _wants_help "$@"; then
        _llm_accounts_usage
        return 0
    fi
    local as_json=0 device=0 usage=0 tool_filter="" pin_ws="" pin_sess=""
    local pos=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --json) as_json=1; shift ;;
            --device) device=1; shift ;;
            --usage) usage=1; shift ;;
            --workspace)
                [ -n "${2:-}" ] || { echo "usage: --workspace needs a value" >&2; exit 2; }
                pin_ws="$2"; shift 2 ;;
            --session)
                [ -n "${2:-}" ] || { echo "usage: --session needs a value" >&2; exit 2; }
                pin_sess="$2"; shift 2 ;;
            --tool)
                [ -n "${2:-}" ] || { echo "usage: --tool needs a value" >&2; exit 2; }
                tool_filter="$2"; shift 2 ;;
            --*) echo "usage: unknown flag '$1' (k2 llm tokens --help)" >&2; exit 2 ;;
            *) pos+=("$1"); shift ;;
        esac
    done
    local mode="this_computer"
    [ "$device" = "1" ] && mode="other_device"
    case "$sub" in
        list|ls)
            [ "${#pos[@]}" -eq 0 ] || { echo "usage: k2 llm tokens list [--tool <tool>] [--json]" >&2; exit 2; }
            [ -z "$tool_filter" ] || _llma_tool_ok "$tool_filter"
            _llma_get list
            if [ "$as_json" = "1" ]; then printf '%s\n' "$_SC_BODY"; exit 0; fi
            _llma_render_list "$tool_filter"
            ;;
        status)
            [ "${#pos[@]}" -eq 2 ] || { echo "usage: k2 llm tokens status <tool> <label|id> [--json]" >&2; exit 2; }
            _llma_tool_ok "${pos[0]}"
            _llma_get status "id=$(urlencode "${pos[1]}")&tool=$(urlencode "${pos[0]}")"
            if [ "$as_json" = "1" ]; then printf '%s\n' "$_SC_BODY"; exit 0; fi
            printf '%s' "$_SC_BODY" | python3 -c '
import json, sys
a = json.load(sys.stdin).get("account") or {}
print("%s %s%s" % (a.get("tool"), a.get("label"), " (server default)" if a.get("active") else ""))
for k in ("state", "detail", "plan", "email", "org"):
    if a.get(k):
        print("  %-8s %s" % (k, a[k]))
u = a.get("usage") or {}
for w in u.get("windows") or []:
    print("  %-8s %d%% used, resets %s" % (w.get("label"), round(float(w.get("used", 0)) * 100), w.get("resetsAt") or "-"))
'
            ;;
        usage)
            [ "${#pos[@]}" -eq 0 ] || { echo "usage: k2 llm tokens usage [--json]" >&2; exit 2; }
            _llma_get usage
            if [ "$as_json" = "1" ]; then printf '%s\n' "$_SC_BODY"; exit 0; fi
            printf '%s' "$_SC_BODY" | python3 -c '
import json, sys
rows = json.load(sys.stdin).get("rows") or []
if not rows:
    print("(no tokens)")
for r in rows:
    u = r.get("usage") or {}
    wins = u.get("windows") or []
    summ = " · ".join("%s %d%%" % (w.get("label", "?"), round(float(w.get("used", 0)) * 100)) for w in wins) or (u.get("status") or "-")
    print("%s %-7s %-20s %s" % ("*" if r.get("active") else " ", r.get("tool"), (r.get("label") or "-")[:20], summ))
'
            ;;
        add)
            [ "${#pos[@]}" -eq 2 ] || { echo "usage: k2 llm tokens add <tool> <label> [--device]" >&2; exit 2; }
            _llma_tool_ok "${pos[0]}"
            _llma_post add "$(_llma_json tool "${pos[0]}" label "${pos[1]}" mode "$mode")"
            if [ "$as_json" = "1" ]; then printf '%s\n' "$_SC_BODY"; exit 0; fi
            _llma_follow_login "$_SC_BODY"
            ;;
        login)
            [ "${#pos[@]}" -eq 2 ] || { echo "usage: k2 llm tokens login <tool> <label> [--device]" >&2; exit 2; }
            _llma_tool_ok "${pos[0]}"
            local lid
            lid="$(_llma_resolve "${pos[0]}" "${pos[1]}")" || exit $?
            _llma_post login "$(_llma_json id "$lid" mode "$mode")"
            if [ "$as_json" = "1" ]; then printf '%s\n' "$_SC_BODY"; exit 0; fi
            _llma_follow_login "$_SC_BODY"
            ;;
        switch|use)
            [ "${#pos[@]}" -eq 2 ] || { echo "usage: k2 llm tokens switch <tool> <label>" >&2; exit 2; }
            _llma_tool_ok "${pos[0]}"
            local sid
            sid="$(_llma_resolve "${pos[0]}" "${pos[1]}")" || exit $?
            _llma_post switch "$(_llma_json id "$sid")"
            if [ "$as_json" = "1" ]; then printf '%s\n' "$_SC_BODY"; exit 0; fi
            _llma_render_switch
            ;;
        next)
            [ "${#pos[@]}" -eq 1 ] || { echo "usage: k2 llm tokens next <tool>" >&2; exit 2; }
            _llma_tool_ok "${pos[0]}"
            _llma_post next "$(_llma_json tool "${pos[0]}")"
            if [ "$as_json" = "1" ]; then printf '%s\n' "$_SC_BODY"; exit 0; fi
            _llma_render_switch
            ;;
        rename)
            [ "${#pos[@]}" -eq 3 ] || { echo "usage: k2 llm tokens rename <tool> <label> <new-label>" >&2; exit 2; }
            _llma_tool_ok "${pos[0]}"
            local rid
            rid="$(_llma_resolve "${pos[0]}" "${pos[1]}")" || exit $?
            _llma_post rename "$(_llma_json id "$rid" label "${pos[2]}")"
            if [ "$as_json" = "1" ]; then printf '%s\n' "$_SC_BODY"; exit 0; fi
            echo "renamed ${pos[0]} '${pos[1]}' to '${pos[2]}'"
            ;;
        remove|rm)
            [ "${#pos[@]}" -eq 2 ] || { echo "usage: k2 llm tokens remove <tool> <label>" >&2; exit 2; }
            _llma_tool_ok "${pos[0]}"
            local xid
            xid="$(_llma_resolve "${pos[0]}" "${pos[1]}")" || exit $?
            _llma_post remove "$(_llma_json id "$xid")"
            if [ "$as_json" = "1" ]; then printf '%s\n' "$_SC_BODY"; exit 0; fi
            echo "removed ${pos[0]} token '${pos[1]}' (its folder is kept in ~/.k2/llm-accounts/.removed)"
            ;;
        refresh)
            local fid="" u=""
            [ "$usage" = "1" ] && u="__true__"
            case "${#pos[@]}" in
                0) ;;
                2)
                    _llma_tool_ok "${pos[0]}"
                    fid="$(_llma_resolve "${pos[0]}" "${pos[1]}")" || exit $?
                    ;;
                *) echo "usage: k2 llm tokens refresh [<tool> <label>] [--usage]" >&2; exit 2 ;;
            esac
            _llma_post refresh "$(_llma_json id "$fid" usage "$u")"
            if [ "$as_json" = "1" ]; then printf '%s\n' "$_SC_BODY"; exit 0; fi
            printf '%s' "$_SC_BODY" | python3 -c '
import json, sys
rows = json.load(sys.stdin).get("accounts") or []
for a in rows:
    print("%s %-7s %-20s %s" % ("*" if a.get("active") else " ", a.get("tool"), (a.get("label") or "-")[:20], a.get("state") or "-"))
'
            ;;
        pins)
            [ "${#pos[@]}" -eq 0 ] || { echo "usage: k2 llm tokens pins [--json]" >&2; exit 2; }
            _llma_get pins
            if [ "$as_json" = "1" ]; then printf '%s\n' "$_SC_BODY"; exit 0; fi
            local pins_body="$_SC_BODY"
            _llma_get list
            printf '%s\n%s' "$pins_body" "$_SC_BODY" | python3 -c '
import json, sys
pins_raw, list_raw = sys.stdin.read().split("\n", 1)
pins = json.loads(pins_raw).get("pins") or []
labels = {}
for t in json.loads(list_raw).get("tools", []):
    for a in t.get("accounts") or []:
        labels[a.get("id")] = a.get("label")
if not pins:
    print("(no workspace or chat has its own token — every chat uses Server default)")
for p in pins:
    print("%-7s %-9s %-28s -> %s" % (p.get("tool"), "chat" if p.get("scopeKind") == "session" else p.get("scopeKind"), (p.get("label") or p.get("scopeId") or "-")[:28],
                                    labels.get(p.get("accountId")) or p.get("accountId")))
'
            ;;
        pin|unpin)
            if [ -n "$pin_ws" ] && [ -n "$pin_sess" ]; then
                echo "usage: pass --workspace or --session, not both" >&2; exit 2
            fi
            local scope="" scope_id=""
            local scope_word=""
            if [ -n "$pin_ws" ]; then scope="workspace"; scope_id="$pin_ws"
            elif [ -n "$pin_sess" ]; then scope="session"; scope_id="$pin_sess"
            else
                echo "usage: k2 llm tokens $sub --workspace <ws>|--session <key> <tool>$([ "$sub" = pin ] && echo ' <label>')" >&2
                exit 2
            fi
            scope_word="$scope"
            [ "$scope" = "session" ] && scope_word="chat"
            if [ "$sub" = "pin" ]; then
                [ "${#pos[@]}" -eq 2 ] || { echo "usage: k2 llm tokens pin --workspace <ws>|--session <key> <tool> <label>" >&2; exit 2; }
                _llma_key_tool_ok "${pos[0]}"
                local pid
                pid="$(_llma_resolve "${pos[0]}" "${pos[1]}")" || exit $?
                _llma_post pin "$(_llma_json scope "$scope" scopeId "$scope_id" tool "${pos[0]}" id "$pid")"
                if [ "$as_json" = "1" ]; then printf '%s\n' "$_SC_BODY"; exit 0; fi
                printf '%s' "$_SC_BODY" | python3 -c '
import json, sys
v = json.load(sys.stdin)
p = v.get("pin") or {}
print("%s %s now uses %s token %s" % ("chat" if p.get("scopeKind") == "session" else p.get("scopeKind"), p.get("label") or p.get("scopeId"), p.get("tool"), sys.argv[1]))
if v.get("note"):
    print(v["note"])
' "${pos[1]}"
            else
                [ "${#pos[@]}" -eq 1 ] || { echo "usage: k2 llm tokens unpin --workspace <ws>|--session <key> <tool>" >&2; exit 2; }
                _llma_key_tool_ok "${pos[0]}"
                _llma_post unpin "$(_llma_json scope "$scope" scopeId "$scope_id" tool "${pos[0]}")"
                if [ "$as_json" = "1" ]; then printf '%s\n' "$_SC_BODY"; exit 0; fi
                if printf '%s' "$_SC_BODY" | python3 -c 'import json,sys; sys.exit(0 if json.load(sys.stdin).get("unpinned") else 1)'; then
                    echo "${scope_word} ${scope_id} ${pos[0]}: back to Server default"
                else
                    echo "${scope_word} ${scope_id} has no ${pos[0]} token of its own (it uses Server default)"
                fi
            fi
            ;;
        add-key)
            if [ "${#pos[@]}" -gt 2 ]; then
                echo "usage: the API token is read from stdin, never an argument — k2 llm tokens add-key <tool> <label>" >&2
                exit 2
            fi
            [ "${#pos[@]}" -eq 2 ] || { echo "usage: k2 llm tokens add-key <tool> <label>   (the API token is read from stdin)" >&2; exit 2; }
            _llma_key_tool_ok "${pos[0]}"
            local api_key=""
            if [ -t 0 ]; then
                printf 'Paste the API token: ' >&2
                IFS= read -rs api_key || api_key=""
                echo >&2
            else
                IFS= read -r api_key || true
            fi
            if [ -z "$api_key" ]; then
                echo "usage: no API token on stdin" >&2
                exit 2
            fi
            # The key reaches python on stdin and curl in its config on
            # stdin (_sidecar_send): never on any process's argv, never printed.
            local key_body
            key_body="$(printf '%s' "$api_key" | python3 -c '
import json, sys
print(json.dumps({"tool": sys.argv[1], "label": sys.argv[2], "key": sys.stdin.read().strip()}))
' "${pos[0]}" "${pos[1]}")"
            api_key=""
            _llma_post add-key "$key_body"
            key_body=""
            if [ "$as_json" = "1" ]; then printf '%s\n' "$_SC_BODY"; exit 0; fi
            echo "added ${pos[0]} API token '${pos[1]}' (billed per token; the key is not shown again)"
            echo "Use it: k2 llm tokens pin --workspace <ws> ${pos[0]} '${pos[1]}', or make it the server default (k2 llm tokens switch)."
            ;;
        *)
            echo "usage: unknown llm tokens verb '$sub' (list|status|usage|add|add-key|login|switch|next|rename|remove|refresh|pin|unpin|pins — k2 llm tokens --help)" >&2
            exit 2
            ;;
    esac
}

_llma_render_switch() {
    printf '%s' "$_SC_BODY" | python3 -c '
import json, sys
v = json.load(sys.stdin)
s = v.get("switch") or {}
a = v.get("account") or {}
tool = s.get("tool") or a.get("tool")
if s.get("alreadyActive"):
    print("%s: %s is already the server default" % (tool, a.get("label") or s.get("to")))
else:
    was = (" (was %s)" % s["fromLabel"]) if s.get("fromLabel") else ""
    print("%s: server default is now %s%s" % (tool, a.get("label") or s.get("toLabel") or s.get("to"), was))
    for w in v.get("warnings") or []:
        print("WARN: %s" % w)
    if tool == "claude" and not s.get("profileSwapped"):
        print("Note: ~/.claude.json was not updated, so Claude /status may still name the previous account.")
    print("Changing the server default token affects every chat that uses Server default on this server.")
'
}

# ── k2 sources (Garden v3 data sources; contract-sources-v1 §7) ─────
# HTTP JSON checks the daemon polls; Garden cards and agents read them.
# Regions: C0 owns the noun line, help, --schema, the shared helpers and
# the dispatcher below; B1 edits only BEGIN/END_SOURCES_B1, B2 only
# BEGIN/END_SOURCES_B2. Transport is the compute sender: the session
# passport over the cell socket inside K2, the owner token outside.
# Exit codes: 0 ok; 1 failure; 2 usage; 3 needs a person (person_only,
# owner_only, confirm needed, lan_owner_only, field_person_only); 4 not
# found (source_not_found, trigger_not_found, removed).

# BEGIN_SOURCES_C0
_sources_usage() {
    cat <<'EOF'
k2 sources — data sources: HTTP JSON checks this server runs for Garden cards and agents

  k2 sources list [--all] [--json]          every source with its state
  k2 sources show <name> [--json]           definition + current state
  k2 sources read <name> [--json]           current state (the card view)
  k2 sources history <name> health|<series> [--item K] [--from <dur|epoch>] [--to …]
  k2 sources status [--json]                the poller: in flight, behind, parked sites
  k2 sources export <name>                  definition as JSON (feeds propose --from)
  k2 sources propose --from <file.json> | --name N --label L --url URL [flags…]
  k2 sources add …                          like propose; people only (Settings or outside K2)
  k2 sources edit <name> [flags…]           change a source (agents: only their own)
  k2 sources remove <name> --yes            the name is held for 7 days
  k2 sources pause|resume <name>            people, or agents with the switch below
  k2 sources mute <name> --for 30m [--reason "…"]   agents: up to 2 h, reason required
  k2 sources unmute <name>
  k2 sources refresh <name> [--wait]        check now (at most once per 15 s)
  k2 sources try [propose flags] | --name <saved> [--targets N]   fetch once (every target)
  k2 sources simulate <name> ok|warn|crit|stale|unknown|slow|off [--for 1h]
  k2 sources pending [--names a,b]          proposals waiting (agents: their own)
  k2 sources approve <name>… [--secret NAME]        one secret for every name: ONE confirm
  k2 sources secret <name>… NAME|--none     bind (or unbind) one secret: all or none, ONE confirm
  k2 sources pin|unpin <name>               pinned: agents without the switch can't change it
  k2 sources trigger list|show|log|propose|add|edit|approve|pause|resume|remove|test …
  k2 sources access on|off [--workspace <ws>]   owner/admin: the agent switch below

AGENTS AND "MANAGE GARDENS AND DATA SOURCES"
  A per-agent switch (Settings → Workspaces → <ws> → Agent, or
  `k2 sources access on --workspace <ws>` outside K2). Off (the default): an
  agent proposes; pending, approve, secret, pause/resume, pin/unpin and
  trigger approve/add/pause/resume exit 3 (person_only). On: the agent does
  all of those itself with no confirm (approve its own proposals and others'
  on this server). It binds only a secret it may already use: its own
  workspace's secret, or a server secret when it also has "Allow managing
  server-wide secrets" (else secret_not_usable, exit 3). The bind still goes
  only to the source's one site, inside the secret's own sites. It never sets
  viewers / agent-access / keep or a trigger's cooldown or cap. Every act is
  logged with the agent and its session (Settings → Logs → Access Audit).
  Only the owner or an admin flips the switch; an agent never can.

RULES AND THRESHOLDS (k2 sources propose --help has every flag)
  --rule 'field:crit:op:v,warn:op:v,ok:op:v' with eq ne in lt lte gt gte exists, ageGt/ageLt
  (a timestamp's age), versionBehind/versionAtLeast (semver), and @field to compare two
  fields (box version vs target_version). failAfter (--fail-after, default 3) is how many
  checks in a row a reading waits before it goes hard. warnAfter:N / critAfter:N on any
  rule opts the source in to per-rule thresholds: failAfter then counts FETCH failures
  only, and each rule waits its own warnAfter (default 1: at once) / critAfter (warn after
  1, crit after N). Without them a source behaves as before 0.46.1.
  --expect-status 200,401 makes a status-only check.
  More lists: --list / --list-field; an array's length: --count.

Exit codes: 0 ok, 1 failure, 2 usage, 3 needs a person, 4 not found.
--json prints the daemon's answer as is (also on errors).
Each verb has its own page: k2 sources <verb> --help. More: k2 study data-sources
EOF
}

# Per-verb help (0.46.1): `k2 sources <verb> --help`. Returns 1 for a verb
# with no page of its own (the caller then prints the noun help).
_sources_verb_help() {
    case "$1" in
        propose|add|edit|try) _sources_flags_help "$1" ;;
        history) cat <<'EOF'
k2 sources history <name> health|<series> [--item <key>] [--from 6h|epoch] [--to 1h|epoch] [--json]

  health          the source's state changes, oldest first (went_warn, recovered, …);
                  with --item <key>, that item's (a box, a cert). Kept: the newest 200.
  <series>        a trend, count or aggregate of the source (extract.trend, counts,
                  aggregates): points (t, v). Raw points 48 h, hourly 35 days.
                  An item field has no series; aggregate it (--agg) instead.

  Values are hidden from agents on an agentAccess "shape" source (0s), and a
  keep "states" source has no series (409 no_history); health still reads.
EOF
        ;;
        export) cat <<'EOF'
k2 sources export <name>

  The definition as JSON: the shape `propose --from` takes, so
    k2 sources export fleet > fleet.json && $EDITOR fleet.json && k2 sources propose --from fleet.json
  round-trips. Secret NAMES only, never values. For agents, query values that
  look secret (token/key/sig keys, or 24+ character token-shaped values) show
  as •••; plain ones (?part=boxes) stay as they are.
EOF
        ;;
        pending) cat <<'EOF'
k2 sources pending [--names a,b] [--json]

  Proposals (sources and triggers) waiting for approval.
  A person, or an agent with "Manage Gardens and data sources": every proposal.
  Any other agent: only its own (the answer says "scope": "own"); a person
  approves them.
EOF
        ;;
        read|show|list) cat <<'EOF'
k2 sources list [--all] [--json]    every source with its state
k2 sources show <name> [--json]     definition + current state
k2 sources read <name> [--json]     the card view (what sources.read gives a widget)

  The card view: health ok|warn|crit|unknown, phase pending|live|stale|paused,
  display, reason (a fixed code), fields, items[] (each with health, reason,
  soft, list for a named list), counts, soft, serverNow, updatedAt.
  soft {count, of, level}: a reading waiting to go hard, e.g. "soft crit 2/3"
  (a rule's critAfter) or "soft crit 1/3" for a fetch failure (failAfter).
EOF
        ;;
        *) return 1 ;;
    esac
}

_sources_flags_help() {
    case "$1" in
        propose) echo "k2 sources propose --from <file.json> | --name N --label L <fetch> [flags…]  (agents: it waits for approval)" ;;
        add) echo "k2 sources add --from <file.json> | --name N --label L <fetch> [flags…]  (people only; active at once without a secret)" ;;
        edit) echo "k2 sources edit <name> [flags…]  (agents: only their own; a changed definition needs approving again)" ;;
        try) echo "k2 sources try --from <file.json> | --url URL [flags…] | --name <saved> [--targets N] [--tree-depth N] [--json]
  Fetch once and show the shape (pointer · type · sample) and the card it would make. Saves nothing.
  A fan-out source fetches every target (or the first N with --targets N)." ;;
    esac
    cat <<'EOF'

FETCH (one of)
  --url URL                       one HTTPS JSON address
  --target key=URL                one fan-out target (repeat, up to 50); each answer is one item
  --url-secret NAME --origin https://host   the whole URL lives in the vault
  --secret NAME                   a vault secret sent as the auth header (bound by a person,
                                  or an agent with the switch)
  --header 'Name: value'          a plain header (no secrets: those are refused)
  --expect-status 200,401         status-only check: these statuses are healthy answers,
                                  whatever the body (HTML, 401). JSON is still read if it parses.

SCHEDULE
  --every 60s|5m|1h               how often (30 s to 1 day; default 60 s)
  --timeout 10s                   1-30 s (fan-out default 5 s)
  --max-bytes 1M                  1 KiB to 5 MiB
  --fail-after N                  checks in a row before a reading goes hard (1-10,
                                  default 3). Once any rule sets warnAfter/critAfter,
                                  failAfter counts fetch failures only.
  --on-target-error crit|unknown  what a failed fan-out target reads as

WHAT TO KEEP
  --field name=/pointer           a value from the answer
  --count name=/pointer           the length of an array or object (e.g. past_due)
  --items /pointer                the item list (array, or object keyed by name)
  --item-key /pointer             each item's key (default: index or property name)
  --item-field name=/pointer      a value from each item
  --list name=/pointer            another item list next to --items (single URL only)
  --list-key name=/pointer        that list's item key
  --list-field list.field=/pointer   a value from each of that list's items
                                  (item field names are unique across all lists; list
                                  items have the key <list>/<key> and "list": "<list>")
  --agg name=count[:list] | count-where:field:op:value | sum:f | min:f | max:f | distinct:f
  --trend name                    chart a field/count/aggregate (up to 8; history also
                                  keeps every count and aggregate)

RULES  --rule 'field:level:op:value[,level:op:value…][,warnAfter:N][,critAfter:N]'
  level: crit, warn, ok (checked in that order; none matching = unknown)
  op:    eq ne in lt lte gt gte exists
         ageGt ageLt           the value is a time (epoch s/ms, RFC 3339) older/newer than
                               a duration:  --rule 'ts:warn:ageGt:5m,crit:ageGt:15m'
         versionBehind         older than a version or @field, optionally by a distance:
                               --rule 'version:warn:versionBehind:@target_version,crit:versionBehind:@target_version~minor=1'
         versionAtLeast        at or past:  ok:versionAtLeast:@target_version
  value: a literal, a|b|c for in, or @name: another field (the item's own, else the
         source's), e.g. 'used:warn:gt:@quota'
  warnAfter:N  checks in a row before this rule's warn goes hard (1-20, default 1: at once)
  critAfter:N  checks in a row (not ok, the last one crit) before crit; until then it
               shows as warn ("soft crit 2/3"). Default: warnAfter.
  Opt-in: setting warnAfter or critAfter on ANY rule turns per-rule thresholds on for the
  whole source (rules without them then go hard at once; failAfter = fetch failures only).
  With neither set, every rule reading waits failAfter, as before 0.46.1. Opting in
  changes the definition, so the source is approved again.
  A field rule colours the source; an item field rule colours each item of its list.

WHO SEES WHAT
  --viewers member|admin  --agent-access values|shape  --keep values|states   (people only)
  --link https://…        where the card's title goes
  --preset NAME --preset-arg k=v   start from a preset (k2 study data-sources)

THE FILE FORM (--from) is the export shape; see k2 sources export <name> and
k2 study data-sources for a full example. Flags given with --from override it.
EOF
}

# The daemon's answer as is (pretty when it parses).
_sources_print_json() {
    printf '%s' "${1:-}" | python3 -c '
import json, sys
raw = sys.stdin.read()
try:
    print(json.dumps(json.loads(raw), indent=2, ensure_ascii=False))
except Exception:
    print(raw)
'
}

# Print a refusal and exit with the contract code.
_sources_fail() {
    local status="$1" body="$2" code=""
    code="$(printf '%s' "$body" | python3 -c '
import json, sys
try:
    v = json.loads(sys.stdin.read())
    e = v.get("error") if isinstance(v, dict) else None
    print(e.get("code", "") if isinstance(e, dict) else (e or ""))
except Exception:
    print("")
' 2>/dev/null)"
    if [ "${_SRC_JSON:-0}" = "1" ] && [ -n "$body" ]; then
        _sources_print_json "$body"
    elif [ -n "$body" ]; then
        printf '%s' "$body" | python3 -c '
import json, sys
raw = sys.stdin.read()
try:
    e = json.loads(raw).get("error")
    if isinstance(e, dict):
        print("Error: %s: %s" % (e.get("code", "error"), e.get("hint", "")))
    else:
        print("Error: %s" % e)
except Exception:
    print("Error: daemon returned: %s" % raw[:200])
' >&2
    else
        echo "Error: no answer from the K2 daemon (status ${status:-none})" >&2
    fi
    case "$code" in
        # vault_confirm_required is the one confirm code (0.46.0);
        # confirm_required is what a 0.45.x daemon answers.
        person_only|owner_only|vault_confirm_required|confirm_required|lan_owner_only|field_person_only|secret_not_usable|forbidden)
            if [ "$code" = "secret_not_usable" ]; then
                echo "Bind a secret from your own workspace, or ask your human for \"Allow managing server-wide secrets\"." >&2
            else
                echo "This needs a person (run it outside K2, or Settings → Gardens → External Data), or the agent switch \"Manage Gardens and data sources\" (k2 sources --help)." >&2
            fi
            exit 3 ;;
        source_not_found|trigger_not_found|removed) exit 4 ;;
        *) exit 1 ;;
    esac
}

# _sources_call METHOD PATH [PAYLOAD]: GET payload is a query string, POST
# payload is JSON. Fails (and exits) on anything but 200; the body lands in
# _SRC_BODY.
_sources_call() {
    local raw
    raw="$(_compute_send "$@")"
    _SRC_STATUS="${raw##*$'\n'}"
    _SRC_BODY="${raw%$'\n'*}"
    [ "$_SRC_STATUS" = "$raw" ] && _SRC_BODY=""
    [ -z "$_SRC_STATUS" ] && _SRC_STATUS="000"
    [ "$_SRC_STATUS" = "200" ] || _sources_fail "$_SRC_STATUS" "$_SRC_BODY"
}

_sources_not_built() {
    echo "Error: not_built: k2 sources $1 is not built yet" >&2
    exit 1
}

cmd_sources() {
    local sub="${1:-}"
    case "$sub" in
        ""|help|--help|-h) _sources_usage; return 0 ;;
    esac
    shift
    if _wants_help "$@"; then
        _sources_verb_help "$sub" || _sources_usage
        return 0
    fi
    _SRC_JSON=0
    local a
    for a in "$@"; do [ "$a" = "--json" ] && _SRC_JSON=1; done
    case "$sub" in
        list|ls) cmd_sources_list "$@" ;;
        show) cmd_sources_show "$@" ;;
        read) cmd_sources_read "$@" ;;
        history) cmd_sources_history "$@" ;;
        status) cmd_sources_status "$@" ;;
        export) cmd_sources_export "$@" ;;
        propose) cmd_sources_propose "$@" ;;
        add) cmd_sources_add "$@" ;;
        edit) cmd_sources_edit "$@" ;;
        remove|rm) cmd_sources_remove "$@" ;;
        pause) cmd_sources_pause "$@" ;;
        resume) cmd_sources_resume "$@" ;;
        mute) cmd_sources_mute "$@" ;;
        unmute) cmd_sources_unmute "$@" ;;
        refresh) cmd_sources_refresh "$@" ;;
        try) cmd_sources_try "$@" ;;
        simulate) cmd_sources_simulate "$@" ;;
        approve) cmd_sources_approve "$@" ;;
        secret) cmd_sources_secret "$@" ;;
        pin) cmd_sources_pin "$@" ;;
        unpin) cmd_sources_unpin "$@" ;;
        pending) cmd_sources_pending "$@" ;;
        trigger|triggers) cmd_sources_trigger "$@" ;;
        access) cmd_sources_access "$@" ;;
        *)
            echo "Error: unknown k2 sources command '$sub'" >&2
            _sources_usage >&2
            exit 2
            ;;
    esac
}
