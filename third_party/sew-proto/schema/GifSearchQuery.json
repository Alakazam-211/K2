{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Query of `GET /api/v1/gifs/search`.",
  "properties": {
    "limit": {
      "description": "Page size, 1–50 (default 24).",
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "offset": {
      "description": "Offset, 0–499.",
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "q": {
      "description": "The search words, 1–50 characters after trimming.",
      "type": "string"
    }
  },
  "required": [
    "q"
  ],
  "title": "GifSearchQuery",
  "type": "object"
}
