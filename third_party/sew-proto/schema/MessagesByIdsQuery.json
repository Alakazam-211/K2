{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Query of `GET /api/v1/messages?ids=` (S13 §9.2).",
  "properties": {
    "ids": {
      "description": "1–100 distinct message ids, comma-separated.",
      "pattern": "^[1-9][0-9]{0,18}(,[1-9][0-9]{0,18}){0,99}$",
      "type": "string"
    }
  },
  "required": [
    "ids"
  ],
  "title": "MessagesByIdsQuery",
  "type": "object"
}
