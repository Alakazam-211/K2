          "minimum": 0,
          "type": "integer"
        },
        "start_ms": {
          "description": "Start, ms from the recording start.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "start_ms",
        "end_ms",
        "offset",
        "len"
      ],
      "type": "object"
    }
