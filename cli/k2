    done
    local label="${label_parts[*]}"
    [[ -z "$label" ]] && { echo "Usage: k2 sessions set-label <session-id> <label> [--no-lock]" >&2; exit 1; }
    local params="id=$(urlencode "$session_id")&label=$(urlencode "$label")&lock=$lock"
