# ── Federation (cross-server agent comms) ────────────────────────────
# DARK by default: the daemon 404s every /cli/federation/* route unless it
# was started with K2_FEDERATION=1. SSOT: prd-cross-server-agent-comms.md.
#
#   k2 fed pubkey [--pem|--fingerprint|--json]   export THIS box's SPKI pubkey
#   k2 fed send <peer>::<workspace>::<agent> "message"
#   k2 fed outbox                                queued + dead-lettered per peer
#   k2 fed pair-request --pubkey <spki.pem> [--label L] [--subdomain S]
#   k2 fed confirm <fingerprint> <sas-code>
#
# send + confirm are OWNER-gated (they need ~/.k2/daemon.token). pubkey is
# pure-CLI (reads the on-box tunnel key) so it works even when federation is
# dark — you need your key to bootstrap the very first pairing.
cmd_fed() {
    local owner_token=""
    local _tok_file="$K2_HOME/daemon.token"
    [ -f "$_tok_file" ] && owner_token=$(cat "$_tok_file" 2>/dev/null | tr -d '[:space:]')

    local sub="${1:-}"; shift || true
    case "$sub" in
        send)
            local to="${1:-}"; local text="${2:-}"
            if [ -z "$to" ] || [ -z "$text" ]; then
                echo "usage: k2 fed send <peer>::<workspace>::<agent> \"message\"" >&2
                exit 2
            fi
            if [ -z "$owner_token" ]; then
                echo "k2 fed send: no owner token (need $_tok_file)" >&2
                exit 1
            fi
            # GAP #3: carry the SOURCE workspace ($PROJECT, resolved at the
            # top of this script from K2_PROJECT_PATH/CWD — same source
            # cmd_connections uses). The daemon GATES the cross-daemon send
            # on `is_remote_connection(from_workspace, <agent>@<host>)`:
            # an agent may only message a peer its workspace is connected
            # to. (Owner-remote `k2 talk` is a different, ungated path.)
            local body
            body=$(python3 -c 'import json,sys; print(json.dumps({"to":sys.argv[1],"text":sys.argv[2],"from_workspace":sys.argv[3]}))' "$to" "$text" "$PROJECT")
            curl -s -X POST "${BASE_URL}/cli/federation/send?token=${owner_token}" \
                --connect-timeout 5 --max-time 60 \
                -H "Content-Type: application/json" \
                --data-raw "$body" 2>/dev/null
            echo
            ;;
        pair-request)
            local pubkey_file="" label="" subdomain=""
            while [ $# -gt 0 ]; do
                case "$1" in
                    --pubkey) pubkey_file="${2:-}"; shift 2 ;;
                    --pubkey=*) pubkey_file="${1#--pubkey=}"; shift ;;
                    --label) label="${2:-}"; shift 2 ;;
                    --label=*) label="${1#--label=}"; shift ;;
                    --subdomain) subdomain="${2:-}"; shift 2 ;;
                    --subdomain=*) subdomain="${1#--subdomain=}"; shift ;;
                    *) echo "k2 fed pair-request: unknown arg: $1" >&2; exit 2 ;;
                esac
            done
            if [ -z "$pubkey_file" ] || [ ! -f "$pubkey_file" ]; then
                echo "usage: k2 fed pair-request --pubkey <spki.pem> [--label L] [--subdomain S]" >&2
                exit 2
            fi
            local body
            body=$(python3 -c 'import json,sys; print(json.dumps({"label":sys.argv[1],"subdomain":sys.argv[2],"public_key_pem":open(sys.argv[3]).read()}))' "$label" "$subdomain" "$pubkey_file")
            # UNAUTH route (creates only a Pending peer).
            curl -s -X POST "${BASE_URL}/cli/federation/pair/request" \
                --connect-timeout 5 --max-time 30 \
                -H "Content-Type: application/json" \
                --data-raw "$body" 2>/dev/null
            echo
            ;;
        confirm)
            local fp="${1:-}"; local sas="${2:-}"
            if [ -z "$fp" ] || [ -z "$sas" ]; then
                echo "usage: k2 fed confirm <fingerprint> <sas-code>" >&2
                exit 2
            fi
            if [ -z "$owner_token" ]; then
                echo "k2 fed confirm: no owner token (need $_tok_file)" >&2
                exit 1
            fi
            local body
            body=$(python3 -c 'import json,sys; print(json.dumps({"fingerprint":sys.argv[1],"sas":sys.argv[2]}))' "$fp" "$sas")
            curl -s -X POST "${BASE_URL}/cli/federation/pair/confirm?token=${owner_token}" \
                --connect-timeout 5 --max-time 30 \
                -H "Content-Type: application/json" \
                --data-raw "$body" 2>/dev/null
            echo
            ;;
        pubkey)
            # Export THIS box's federation identity — the SPKI public key PEM a
            # peer pins via `k2 fed pair-request --pubkey`. Pure-CLI: derive it
            # from the on-box ECDSA P-256 tunnel key with openssl, so it works
            # even when K2_FEDERATION is off (you need the key to START pairing).
            # fingerprint = sha256(SPKI DER) hex — matches the daemon's
            # federation::peers::fingerprint_of_spki_der.
            local key_file="$K2_HOME/tunnel-key.pem"
            local want="${1:-}"
            if [ ! -f "$key_file" ]; then
                echo "k2 fed pubkey: no federation key at $key_file (start the daemon once to generate it)" >&2
                exit 1
            fi
            if ! command -v openssl >/dev/null 2>&1; then
                echo "k2 fed pubkey: openssl not found on PATH" >&2
                exit 1
            fi
            local pem fp
            pem=$(openssl pkey -in "$key_file" -pubout 2>/dev/null) || {
                echo "k2 fed pubkey: failed to derive SPKI public key from $key_file" >&2; exit 1; }
            fp=$(openssl pkey -in "$key_file" -pubout -outform DER 2>/dev/null | shasum -a 256 | awk '{print $1}')
            case "$want" in
                --fingerprint|--fp) printf '%s\n' "$fp" ;;
                --json) python3 -c 'import json,sys; print(json.dumps({"public_key_pem":sys.argv[1],"fingerprint":sys.argv[2]}))' "$pem" "$fp" ;;
                ""|--pem) printf '%s\n' "$pem"; printf '# fingerprint: %s\n' "$fp" >&2 ;;
                *) echo "usage: k2 fed pubkey [--pem|--fingerprint|--json]" >&2; exit 2 ;;
            esac
            ;;
        enable|disable)
            # Flip the persisted federation master switch on THIS daemon — the
            # headless equivalent of Settings → K2 Connect → Enable federation.
            # Owner-gated via /cli/settings/update; federation::set_enabled() is
            # synced so the /cli/federation/* gate goes live/dark immediately
            # (no restart). Built for Linux headless setup.
            local fval="true"; [ "$sub" = "disable" ] && fval="false"
            cli_post_json "/cli/settings/update" "{\"federationEnabled\": $fval}" \
                | python3 -c "import json,sys
try:
    d = json.load(sys.stdin)
    print('federation: ' + ('ENABLED' if d.get('federationEnabled') else 'disabled') + ' (this server)')
except Exception:
    sys.stderr.write('k2 fed: unexpected response from /cli/settings/update\n'); sys.exit(1)"
            ;;
        status)
            cli_request "/cli/settings/get" \
                | python3 -c "import json,sys
try:
    d = json.load(sys.stdin)
    print('federation: ' + ('ENABLED' if d.get('federationEnabled') else 'disabled') + ' (this server)')
except Exception:
    sys.stderr.write('k2 fed status: unexpected response from /cli/settings/get\n'); sys.exit(1)"
            ;;
        outbox)
            # The truthful surface for the outbox drain: per peer, how many
            # cross-server messages are still QUEUED (waiting for the peer to
            # become reachable — the drain retries with backoff) and what got
            # DEAD-LETTERED (terminal failures kept for inspection).
            if [ -z "$owner_token" ]; then
                echo "k2 fed outbox: no owner token (need $_tok_file)" >&2
                exit 1
            fi
            curl -s "${BASE_URL}/cli/federation/outbox?token=${owner_token}" \
                --connect-timeout 5 --max-time 30 2>/dev/null \
                | python3 -c "import json,sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.stderr.write('k2 fed outbox: unexpected response (is federation on?)\n'); sys.exit(1)
if 'error' in d:
    sys.stderr.write('k2 fed outbox: ' + str(d['error']) + '\n'); sys.exit(1)
peers = d.get('peers', [])
if not peers:
    print('outbox: empty (no queued or dead-lettered cross-server messages)')
    sys.exit(0)
for p in peers:
    who = p.get('label') or p.get('subdomain') or p.get('fingerprint','')[:12]
    line = f\"{who}: {p.get('queued',0)} queued\"
    age = p.get('oldest_age_secs')
    if age is not None:
        line += f' (oldest {age}s)'
    line += f\", {p.get('dead',0)} dead-lettered\"
    print(line)
    for dl in p.get('dead_letters', [])[:5]:
        print(f\"  dead {dl.get('msg_uuid','')[:8]}… — {dl.get('reason','')}\")
print(f\"total queued: {d.get('total_queued',0)}\")"
            ;;
        *)
            echo "usage: k2 fed <enable|disable|status|pubkey|send|outbox|pair-request|confirm> ..." >&2
            echo "  enable/disable/status: flip the persisted federation switch (headless-friendly)" >&2
            echo "  send/outbox/pair-request/confirm need federation ON; pubkey works anytime" >&2
            echo "  outbox: queued + dead-lettered cross-server messages per peer" >&2
            exit 2
            ;;
    esac
}

# ── Feedback (F1) — ask a human for input, durably ───────────────────
#
# `k2 feedback` files agent→human asks as durable items on this
# server's Feedback page (prd-agent-feedback-notifications, mockup:
# .k2/notes/feedback-cli-mockup.md — the help text below is that
# mockup VERBATIM; it passed the 36/36 comprehension gate).
#
# Contract highlights (pinned):
# - Success output human-readable; --json flips it to JSON.
# - ERRORS are ALWAYS JSON on stderr ({"error":{"code","hint"}})
#   regardless of --json.
# - Exit codes: 0 ok · 1 error · 2 bad usage · 4 not found (ambiguous
#   id prefix = 4 too, candidates in the hint).
# - `ask --wait` prints the BARE answer to stdout (exit 0);
#   resolved/dismissed WITHOUT an answer → empty stdout +
#   {"error":{"code":"closed_unanswered"}} on stderr + exit 1;
#   --timeout → {"error":{"code":"timeout"}} + exit 1, item STAYS
#   waiting.

_feedback_err() {
    local code="$1" hint="$2"
    CODE="$code" HINT="$hint" python3 -c 'import json,os
print(json.dumps({"error": {"code": os.environ["CODE"], "hint": os.environ["HINT"]}}))' >&2 \
        || echo "Error ($code): $hint" >&2
}

# Session auto-detection (feedback F1): the asking session's id + kind
# from the environment, first match wins:
#   1. K2_SESSION_ID — the daemon stages this into SANDBOX cells
#      (v1_sandboxes/policy.rs: guest runs `claude --session-id $K2_SESSION_ID`).
#   2. CLAUDE_SESSION_ID — reserved hook-context spelling (PRD §4.2).
#   3. CLAUDE_CODE_SESSION_ID — what Claude Code actually exports into
#      Bash-tool subshells; in a K2 canonical (pinned-chat) session it
#      equals the forced `claude --session-id <id>`.
# Nothing found → both stay empty (a session-less ask must still work).
_feedback_detect_session() {
    FB_SESSION_ID=""
    FB_SESSION_KIND=""
    if [ -n "${K2_SESSION_ID:-}" ]; then
        FB_SESSION_ID="$K2_SESSION_ID"; FB_SESSION_KIND="sandbox"
    elif [ -n "${CLAUDE_SESSION_ID:-}" ]; then
        FB_SESSION_ID="$CLAUDE_SESSION_ID"; FB_SESSION_KIND="canonical"
    elif [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then
        FB_SESSION_ID="$CLAUDE_CODE_SESSION_ID"; FB_SESSION_KIND="canonical"
    fi
}

cmd_feedback_ask() {
    if _wants_help "$@"; then cmd_help_feedback_ask; exit 0; fi
    local title="" body="" body_file="" kind="" options="" priority=""
    local wait=false timeout="" as_json=false
    while [ $# -gt 0 ]; do
        case "$1" in
            --body)
                [ $# -ge 2 ] || { _feedback_err "usage" "--body requires a value"; exit 2; }
                body="$2"; shift 2 ;;
            --body-file)
                [ $# -ge 2 ] || { _feedback_err "usage" "--body-file requires a file path"; exit 2; }
                body_file="$2"; shift 2 ;;
            --kind)
                [ $# -ge 2 ] || { _feedback_err "usage" "--kind requires a value (question | approval | fyi)"; exit 2; }
                kind="$2"; shift 2 ;;
            --options)
                [ $# -ge 2 ] || { _feedback_err "usage" "--options requires a comma-separated list (e.g. \"Ship it,Hold\")"; exit 2; }
                options="$2"; shift 2 ;;
            --priority)
                [ $# -ge 2 ] || { _feedback_err "usage" "--priority requires a value (1-5)"; exit 2; }
                priority="$2"; shift 2 ;;
            --wait) wait=true; shift ;;
            --timeout)
                [ $# -ge 2 ] || { _feedback_err "usage" "--timeout requires a value in seconds"; exit 2; }
                timeout="$2"; shift 2 ;;
            --json) as_json=true; shift ;;
            -*)
                _feedback_err "usage" "unknown flag '$1' — usage: k2 feedback ask <title> [--body|--body-file f] [--kind k] [--options a,b,c] [--priority 1-5] [--wait [--timeout s]] [--json]"
                exit 2 ;;
            *)
                if [ -z "$title" ]; then title="$1"; else
                    _feedback_err "usage" "unexpected extra argument '$1' — quote the title if it contains spaces"
                    exit 2
                fi
                shift ;;
        esac
    done
    if [ -z "$title" ]; then
        _feedback_err "usage" "ask requires a <title>"
        exit 2
    fi
    case "${kind:-question}" in
        question|approval|fyi) ;;
        *)
            _feedback_err "usage" "invalid --kind '$kind' — valid: question, approval, fyi"
            exit 2 ;;
    esac
    if [ -n "$priority" ]; then
        case "$priority" in
            1|2|3|4|5) ;;
            *)
                _feedback_err "usage" "--priority must be 1-5"
                exit 2 ;;
        esac
    fi
    if [ -n "$body" ] && [ -n "$body_file" ]; then
        _feedback_err "usage" "--body and --body-file are mutually exclusive"
        exit 2
    fi
    if [ -n "$body_file" ]; then
        if [ ! -f "$body_file" ]; then
            _feedback_err "usage" "--body-file: no such file '$body_file'"
            exit 2
        fi
        body="$(cat "$body_file")" || {
            _feedback_err "usage" "--body-file: cannot read '$body_file'"
            exit 2
        }
    fi
    if [ -n "$timeout" ]; then
        if ! $wait; then
            _feedback_err "usage" "--timeout only makes sense with --wait"
            exit 2
        fi
        case "$timeout" in
            ''|*[!0-9]*|0)
                _feedback_err "usage" "--timeout must be a positive number of seconds"
                exit 2 ;;
        esac
    fi
    _feedback_detect_session
    FB_TITLE="$title" FB_BODY="$body" FB_KIND="$kind" FB_OPTIONS="$options" \
    FB_PRIORITY="$priority" FB_WAIT="$wait" FB_TIMEOUT="$timeout" FB_JSON="$as_json" \
    FB_PROJECT="$PROJECT" FB_AGENT="${K2_AGENT_NAME:-${K2SO_AGENT_NAME:-}}" \
    FB_SESSION_ID="$FB_SESSION_ID" FB_SESSION_KIND="$FB_SESSION_KIND" \
    ABASE="$BASE_URL" ATOKEN="$TOKEN" python3 - <<'PYEOF'
import json, os, re, sys, time
import urllib.error, urllib.parse, urllib.request

base = os.environ["ABASE"]
token = os.environ["ATOKEN"]
as_json = os.environ.get("FB_JSON") == "true"
wait = os.environ.get("FB_WAIT") == "true"
timeout = os.environ.get("FB_TIMEOUT", "")

def die(err, exit_code=None):
    # Errors are ALWAYS JSON on stderr, regardless of --json.
    if isinstance(err, str):
        err = {"code": "error", "hint": err}
    sys.stderr.write(json.dumps({"error": err}) + "\n")
    if exit_code is None:
        code = err.get("code")
        exit_code = 4 if code in ("not_found", "ambiguous_id") else 2 if code == "usage" else 1
    sys.exit(exit_code)

def request(method, route, params=None, body=None):
    qs = urllib.parse.urlencode(dict(params or {}, token=token))
    url = base + route + "?" + qs
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method,
        headers={"Content-Type": "application/json"} if data else {})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.loads(r.read().decode("utf-8", "replace"))
    except urllib.error.HTTPError as e:
        try:
            return json.loads(e.read().decode("utf-8", "replace"))
        except Exception:
            return {"error": {"code": "error", "hint": "HTTP %s on %s" % (e.code, route)}}
    except Exception:
        return None

payload = {
    "project": os.environ["FB_PROJECT"],
    "title": os.environ["FB_TITLE"],
}
if os.environ.get("FB_BODY"):
    payload["body"] = os.environ["FB_BODY"]
if os.environ.get("FB_KIND"):
    payload["kind"] = os.environ["FB_KIND"]
if os.environ.get("FB_PRIORITY"):
    payload["priority"] = int(os.environ["FB_PRIORITY"])
if os.environ.get("FB_OPTIONS"):
    # Split on unescaped commas only; "\," inside an option is a literal comma.
    raw = re.split(r"(?<!\\),", os.environ["FB_OPTIONS"])
    opts = [o for o in (p.strip().replace("\\,", ",") for p in raw) if o]
    if opts:
        payload["options"] = opts
if os.environ.get("FB_AGENT"):
    payload["agentName"] = os.environ["FB_AGENT"]
# Session auto-detection result (may be absent — must not fail the ask).
if os.environ.get("FB_SESSION_ID"):
    payload["sessionId"] = os.environ["FB_SESSION_ID"]
    if os.environ.get("FB_SESSION_KIND"):
        payload["sessionKind"] = os.environ["FB_SESSION_KIND"]

d = request("POST", "/cli/feedback/create", body=payload)
if d is None:
    die({"code": "daemon_unreachable", "hint": "no response from the K2 daemon (is it running?)"})
if d.get("error"):
    die(d["error"])
if not d.get("ok"):
    die({"code": "error", "hint": "unexpected daemon response: %r" % json.dumps(d)[:200]})

fid = d["id"]

if not wait:
    if as_json:
        print(json.dumps(d))
    else:
        short = fid[:8]
        print('Filed feedback %s — "%s" (%s, priority %s, %s)'
              % (short, d.get("title", ""), d.get("kind", "?"),
                 d.get("priority", "?"), d.get("status", "?")))
        print("A human will be notified. Check back with: k2 feedback show %s" % short)
    sys.exit(0)

# ── --wait: poll `show` (~2s) until answered / closed / timeout ──────
# Pinned contract: BARE answer to stdout + exit 0 on answered (also on
# resolved/dismissed WITH an answer); closed WITHOUT an answer →
# {"error":{"code":"closed_unanswered"}} on stderr + exit 1; timeout →
# {"error":{"code":"timeout"}} on stderr + exit 1 and the item STAYS
# waiting (we just stop polling). Transient poll failures are retried —
# a daemon blip must not fake a closed_unanswered.
deadline = time.time() + int(timeout) if timeout else None
while True:
    d = request("GET", "/cli/feedback/show", params={"id": fid})
    if isinstance(d, dict) and d.get("ok"):
        status = d.get("status")
        answer = d.get("answer")
        if status == "answered" and answer:
            print(answer)
            sys.exit(0)
        if status in ("resolved", "dismissed"):
            if answer:
                print(answer)
                sys.exit(0)
            sys.stderr.write('{"error":{"code":"closed_unanswered"}}\n')
            sys.exit(1)
    if deadline is not None and time.time() >= deadline:
        sys.stderr.write('{"error":{"code":"timeout"}}\n')
        sys.exit(1)
    nap = 2.0
    if deadline is not None:
        nap = max(0.1, min(nap, deadline - time.time()))
    time.sleep(nap)
PYEOF
}

