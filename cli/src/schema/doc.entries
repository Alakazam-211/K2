        {"name": "--doc", "arg": null, "description": "Pin it to the whole file."},
        {"name": "--node", "arg": "ADDR", "description": "Pin it to a layer."},
        {"name": "--version", "arg": "V", "description": "With --node: the version the key is read in."},
        {"name": "--hint", "arg": "TEXT", "description": "With --node: an anchor hint kept with the pin."},
        {"name": "--body", "arg": "text", "description": "The comment."},
        {"name": "--mention", "arg": "P", "description": "Mention me, a login, a workspace or a pid (repeatable)."},
        {"name": "--proposal", "arg": "FILE", "description": "Name a new file as your proposal (repeatable)."},
        {"name": "--delete", "arg": null, "description": "Delete the thread ann-N, or with --n one comment in it."},
        {"name": "--n", "arg": "N", "description": "Which comment in the thread (default 0: the whole thread)."}
      ]
    },
    {
      "name": "doc reply",
      "usage": "k2 doc reply ann-N --body \"text\" [--mention P]... [--proposal FILE]... <f>",
