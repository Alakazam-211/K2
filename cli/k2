# stdin = body; prints {"id","title","body"}, plus "toml" for an example.
_zen_guide_emit_json() {
    python3 -c '
import json, sys
body = sys.stdin.read()
if body.endswith("\n"):
    body = body[:-1]
out = {"id": sys.argv[1], "title": sys.argv[2], "body": body}
if len(sys.argv) > 3:
    out["toml"] = sys.argv[3] + "\n"
print(json.dumps(out, separators=(",", ":"), ensure_ascii=False))
' "$@"
}

cmd_zen_guide() {
    local as_json=0 toml=0 list=0 p1="" p2="" extra=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --json) as_json=1 ;;
            --toml) toml=1 ;;
            --list) list=1 ;;
            -h|--help)
                _zen_guide_usage
                exit 0
                ;;
            --*)
                echo "Error: unknown flag '$1' (see k2 zen guide --help)" >&2
                exit 2
                ;;
            *)
                if [ -z "$p1" ]; then p1="$1"
                elif [ -z "$p2" ]; then p2="$1"
                else extra="$1"
                fi
                ;;
        esac
        shift
    done
    if [ -n "$extra" ]; then
        echo "Error: unexpected extra argument '$extra' (see k2 zen guide --help)" >&2
        exit 2
    fi
    case "$p1" in
        example|examples)
            if [ "$list" = 1 ]; then
                if [ -n "$p2" ] || [ "$toml" = 1 ]; then
                    echo "Error: --list takes no example name" >&2
                    exit 2
                fi
                if [ "$as_json" = 1 ]; then
                    local n
                    for n in $_ZEN_GUIDE_EXAMPLES; do
                        printf '%s\t%s\n' "$n" "$(_zen_guide_title "$n")"
                    done | python3 -c '
import json, sys
ex = [dict(zip(("id", "title"), l.rstrip("\n").split("\t", 1))) for l in sys.stdin]
print(json.dumps({"examples": ex}, separators=(",", ":")))
'
                else
                    printf '%s\n' $_ZEN_GUIDE_EXAMPLES
                fi
                exit 0
            fi
            if [ -z "$p2" ]; then
                if [ "$toml" = 1 ]; then
                    echo "Error: --toml needs an example name (k2 zen guide example --list)" >&2
                    exit 2
                fi
                if [ "$as_json" = 1 ]; then
                    _zen_guide_page examples | _zen_guide_emit_json examples "$(_zen_guide_title examples)"
                else
                    _zen_guide_page examples
                fi
                exit 0
            fi
            if ! _zen_guide_is_in "$p2" $_ZEN_GUIDE_EXAMPLES; then
                echo "Error: no example '$p2'. Examples: $_ZEN_GUIDE_EXAMPLES" >&2
                exit 2
            fi
            if [ "$as_json" = 1 ]; then
                _zen_example_page "$p2" | _zen_guide_emit_json "$p2" "$(_zen_guide_title "$p2")" "$(_zen_example_toml "$p2")"
            elif [ "$toml" = 1 ]; then
                _zen_example_toml "$p2"
            else
                _zen_example_page "$p2"
            fi
            exit 0
            ;;
    esac
    if [ "$toml" = 1 ] || [ "$list" = 1 ]; then
        echo "Error: --toml and --list are for k2 zen guide example" >&2
        exit 2
    fi
    if [ -n "$p2" ]; then
        echo "Error: unexpected extra argument '$p2' (see k2 zen guide --help)" >&2
        exit 2
    fi
    local topic="${p1:-index}"
    if [ "$topic" != "index" ] && ! _zen_guide_is_in "$topic" $_ZEN_GUIDE_TOPICS; then
        echo "Error: no guide topic '$topic'" >&2
        _zen_guide_usage >&2
        exit 2
    fi
    if [ "$as_json" = 1 ]; then
        if [ "$topic" = "index" ]; then
            local t topics=""
            for t in $_ZEN_GUIDE_TOPICS; do
                topics="$topics$t=$(_zen_guide_title "$t");"
            done
            _zen_guide_index | ZEN_GUIDE_TOPICS="$topics" python3 -c '
import json, os, sys
body = sys.stdin.read().rstrip("\n")
topics = [dict(zip(("id", "title"), p.split("=", 1))) for p in os.environ["ZEN_GUIDE_TOPICS"].split(";") if p]
print(json.dumps({"id": "index", "title": sys.argv[1], "body": body, "topics": topics}, separators=(",", ":"), ensure_ascii=False))
' "$(_zen_guide_title index)"
        else
            _zen_guide_page "$topic" | _zen_guide_emit_json "$topic" "$(_zen_guide_title "$topic")"
        fi
    else
        _zen_guide_page "$topic"
    fi
}

# Shared formatter: verb, as_json, raw daemon body.
_zen_print() {
    ZEN_VERB="$1" ZEN_JSON="$2" ZEN_RAW="$3" python3 -c '
import json, os, sys
verb = os.environ["ZEN_VERB"]
as_json = os.environ.get("ZEN_JSON") == "true"
raw = os.environ.get("ZEN_RAW") or ""
NOT_SET_UP = "Zen isn\x27t set up on this computer. Turn it on with the Zen toggle in the K2 app\x27s top bar."
if not raw.strip():
    print("Error: no response from the K2 daemon on this computer", file=sys.stderr)
    sys.exit(1)
try:
    d = json.loads(raw)
except Exception:
    print("Error: the daemon answered something that is not JSON: %s" % raw[:200], file=sys.stderr)
    sys.exit(1)
err = d.get("error") if isinstance(d, dict) else None
if err == "zen_not_set_up" or (verb in ("path", "garden-list") and d.get("setUp") is False):
    if as_json:
        print(json.dumps(d, separators=(",", ":")))
    print(d.get("message") or NOT_SET_UP, file=sys.stderr)
    sys.exit(3)
if err is not None:
    if as_json:
        print(json.dumps(d, separators=(",", ":")))
    if err == "last_garden":
        print(d.get("message") or "That\x27s your last Garden.", file=sys.stderr)
    elif err == "garden_has_changes":
        print("Error: Garden %s has its own changes (%s). Add --force to start it over; the file is kept in .history/." % (d.get("garden"), ", ".join(d.get("keys") or [])), file=sys.stderr)
    elif err == "zen_local_only" and verb.startswith(("sync", "news")):
        print("Error: only the person on this computer can change Garden sync and news. Ask the person: Settings → Gardens. (Inside a K2 terminal this runs as that session; a person can use Settings or a terminal outside K2.)", file=sys.stderr)
    elif err == "zen_local_only":
        print("Error: k2 zen talks only to the K2 on this computer, and this token is not its owner.", file=sys.stderr)
    elif isinstance(err, dict):
        print("Error: %s" % (err.get("hint") or err.get("message") or err), file=sys.stderr)
    else:
        print("Error: %s" % (d.get("message") or err), file=sys.stderr)
    sys.exit(1)
if as_json:
    print(json.dumps(d, indent=2))
    if verb == "validate" and d.get("ok") is False:
        sys.exit(1)
    sys.exit(0)

def diag(e, warn=False):
    return "%s:%s:%s: %s%s" % (e.get("file"), e.get("line"), e.get("col"), "warning: " if warn else "", e.get("message"))

SYNC = {}
try:
    for row in (json.loads(os.environ.get("ZEN_SYNC_RAW") or "{}").get("gardens") or []):
        SYNC[row.get("id")] = row
except Exception:
    SYNC = {}

def sync_word(row):
    p = (row.get("page") or {}).get("mode")
    t = (row.get("theme") or {}).get("mode")
    if p == t:
        return "synced" if p == "synced" else "own copy"
    word = lambda m: "synced" if m == "synced" else "own copy"
    return "page: %s · theme: %s" % (word(p), word(t))

def garden_line(g):
    line = "%s %d  %s  %s  %s" % ("*" if g.get("theme") else " ", g.get("index"), g.get("id"), g.get("name"), g.get("template"))
    if g.get("id") in SYNC:
        line += "  " + sync_word(SYNC[g.get("id")])
    return line

def part_line(name, part):
    mode = part.get("mode")
    if mode == "synced":
        return "%s synced" % name
    s = "%s own copy of %s" % (name, part.get("defaults"))
    if part.get("k2Version"):
        s += " (K2 %s)" % part["k2Version"]
    if part.get("newerDefault"):
        s += ", K2\x27s default has changed since"
    return s

if verb in ("validate", "reload"):
    errs = d.get("errors") or []
    for e in errs:
        print(diag(e))
    for w in d.get("warnings") or []:
        print(diag(w, True))
    if verb == "reload":
        print("reloaded: %s" % ("changed" if d.get("changed") else "no change"))
    if errs:
        print("%d error(s). Zen is showing the last good version." % len(errs), file=sys.stderr)
        # Point at the guide page for each kind of error (FC35), unless the
        # message already names one.
        topics = []
        for e in errs:
            m = e.get("message") or ""
            f = e.get("file") or ""
            if "k2 zen guide" in m:
                continue
            if any(p in m for p in ("slot = \"menu\"", "a menu", "menu \x27", "menu = ", "menus", "menu.label")):
                t = "menus"
            elif any(w in m for w in ("slot", "band", "edge", "align", "column")):
                t = "bands"
            elif f.startswith("gardens/") and any(w in m for w in ("widget", "kind", "props")):
                t = "widgets"
            elif f.startswith("gardens/") and any(w in m for w in ("layout", "template", "schema")):
                t = "files"
            else:
                t = "themes"
            if t not in topics:
                topics.append(t)
        if topics:
            print("Help: %s" % ", ".join("k2 zen guide %s" % t for t in topics), file=sys.stderr)
        sys.exit(1)
    if verb == "validate":
        files = d.get("files") or []
        print("ok: %s" % (", ".join(files) if files else "no files"))
elif verb == "reset":
    print("reset %s to %s" % (d.get("file"), d.get("restored")))
    if d.get("snapshot"):
        print("previous file kept as snapshot %s (k2 zen reset --to %s to undo)" % (d["snapshot"], d["snapshot"]))
elif verb == "history":
    for f in d.get("files") or []:
        snaps = f.get("snapshots") or []
        note = ""
        if f.get("deleted"):
            note = ", Garden deleted"
        elif not f.get("exists", True):
            note = ", file deleted"
        print("%s (%d snapshot%s%s)" % (f.get("file"), len(snaps), "" if len(snaps) == 1 else "s", note))
        for s in snaps:
            print("  %s  %s%s" % (s.get("name"), s.get("at"), "" if s.get("clean") else "  (has errors)"))
elif verb == "doctor":
    for c in d.get("checks") or []:
        print("%s %s: %s" % ("ok  " if c.get("ok") else "FAIL", c.get("name"), c.get("detail")))
    if not d.get("ok"):
        sys.exit(1)
elif verb == "path":
    print(d.get("path"))
elif verb == "garden-list":
    for g in d.get("gardens") or []:
        print(garden_line(g))
elif verb == "garden-new":
    g = d.get("garden") or {}
    print(g.get("id"))
    print(d.get("path"))
elif verb == "garden-rename":
    g = d.get("garden") or {}
    print("Garden %s is now “%s”%s" % (g.get("id"), g.get("name"), "" if d.get("changed") else " (unchanged)"))
elif verb == "garden-reorder":
    for g in d.get("gardens") or []:
        print(garden_line(g))
elif verb == "garden-template":
    g = d.get("garden") or {}
    if d.get("changed"):
        print("Garden %s (“%s”) is now %s" % (g.get("id"), g.get("name"), d.get("template")))
        if d.get("snapshot"):
            print("its previous file is kept as snapshot %s (k2 zen reset --garden %s --to %s to undo)" % (d["snapshot"], g.get("id"), d["snapshot"]))
    else:
        print("Garden %s (“%s”) is already %s (unchanged)" % (g.get("id"), g.get("name"), d.get("template")))
elif verb == "garden-delete":
    snap = d.get("snapshot")
    print("deleted Garden %s (“%s”)%s" % (d.get("deleted"), d.get("name"), "; its page is kept in .history as %s" % snap if snap else ""))
elif verb == "theme-list":
    for t in d.get("themes") or []:
        tags = []
        if t.get("builtin"):
            tags.append("built in")
        if t.get("user"):
            tags.append("your override" if t.get("builtin") else "yours")
        line = "%s %s  %s  (%s)" % ("*" if t.get("active") else " ", t.get("name"), t.get("label") or t.get("name"), ", ".join(tags))
        if t.get("summary"):
            line += "  " + t["summary"]
        print(line)
    if d.get("garden"):
        print("Garden %s: %s" % (d["garden"], ("its own pick" if d.get("gardenTheme") else "follows this computer")))
    if d.get("missing"):
        print("theme \x27%s\x27 doesn\x27t exist any more; showing %s" % (d["missing"], d.get("active")), file=sys.stderr)
elif verb == "theme-switch":
    if d.get("garden") and d.get("scope") == "garden":
        print("theme %s for Garden %s" % (d.get("theme"), d["garden"]))
    elif d.get("garden"):
        print("Garden %s follows this computer: theme %s" % (d["garden"], d.get("theme")))
    else:
        print("theme %s for this computer" % d.get("theme"))
elif verb == "sync-list":
    for row in d.get("gardens") or []:
        own = row.get("ownChanges")
        extra = []
        if own:
            extra.append("own changes: %s" % ", ".join(own))
        elif own is None:
            extra.append("its file doesn\x27t parse")
        if row.get("undo"):
            extra.append("undo: %s" % ", ".join(row["undo"].get("parts") or []))
        kp = row.get("keepPrevious") or {}
        if kp.get("page") or kp.get("theme"):
            extra.append("keep-previous offered")
        print("%d  %s  %s  %s; %s%s" % (row.get("index"), row.get("id"), row.get("name"), part_line("page", row.get("page") or {}), part_line("theme", row.get("theme") or {}), ("  [" + "; ".join(extra) + "]") if extra else ""))
    print("K2 defaults: %s (K2 %s)%s" % (d.get("liveDefaults"), d.get("k2Version"), ("; previous %s" % d["previousDefaults"]) if d.get("previousDefaults") else ""))
elif verb == "sync-change":
    row = d.get("garden") or {}
    if d.get("changed"):
        print("%s (%s): %s; %s" % (row.get("name"), row.get("id"), part_line("page", row.get("page") or {}), part_line("theme", row.get("theme") or {})))
        if row.get("undo"):
            print("undo with: k2 zen sync %s undo" % row.get("id"))
    else:
        print("%s (%s): unchanged (%s; %s)" % (row.get("name"), row.get("id"), part_line("page", row.get("page") or {}), part_line("theme", row.get("theme") or {})))
elif verb == "sync-preview":
    g = d.get("garden") or {}
    page = d.get("page") or {}
    theme = d.get("theme") or {}
    s = d.get("sync") or {}
    parts = {"page": "page", "theme": "theme", "both": "page and theme"}.get(s.get("preview"), s.get("preview"))
    print("preview of %s (%s) with K2\x27s default for its %s (nothing written)" % (g.get("name"), g.get("id"), parts))
    print("  template %s, layout %s, %d widget(s)" % (page.get("template"), (page.get("layout") or {}).get("split"), len(page.get("widgets") or [])))
    print("  theme %s, accent %s / %s" % (theme.get("name"), ((theme.get("tokens") or {}).get("colors") or {}).get("light", {}).get("accent"), ((theme.get("tokens") or {}).get("colors") or {}).get("dark", {}).get("accent")))
    print("  page now: %s; theme now: %s" % ((s.get("page") or {}).get("mode"), (s.get("theme") or {}).get("mode")))
elif verb == "news":
    items = d.get("items") or []
    if not items:
        print("no unseen Garden news")
    for it in items:
        if it.get("kind") == "catalog":
            print("%s  New in the Garden catalog: %s. %s" % (it.get("id"), it.get("label"), it.get("description")))
        elif it.get("kind") == "update":
            print("%s  %s has a fresh look (%s)%s" % (it.get("id"), it.get("gardenName"), it.get("part"), "; keep-previous offered" if it.get("keepPrevious") else ""))
    n = d.get("copiesWithNewerDefault") or 0
    if n:
        print("%d own cop%s didn\x27t change; K2\x27s default is newer (k2 zen sync)" % (n, "y" if n == 1 else "ies"))
elif verb == "news-seen":
    seen = d.get("seen") or []
    print("marked %d item(s) seen%s" % (len(seen), (": " + ", ".join(seen)) if seen else ""))
elif verb == "theme-new":
    print("made %s from %s" % (d.get("path"), d.get("from")))
    if d.get("copiedImage"):
        print("copied its background %s" % d["copiedImage"])
    print("edit it, check with k2 zen validate, use it with k2 zen theme set %s" % d.get("name"))
elif verb == "widget-new":
    name = d.get("name")
    print(d.get("path"))
    files = d.get("files") or []
    if files:
        print("files: %s" % ", ".join(files))
    print("next: edit it, place it in a Garden with kind = \"custom\" and widget = \"%s\"," % name)
    print("check with k2 zen validate --widget %s, then ask the human to open the Garden and click Review" % name)
elif verb == "widget-list":
    ws = d.get("widgets") or []
    if not ws:
        print("no custom widgets yet (k2 zen widget new <name> --from k2:diary)")
    for w in ws:
        caps = ", ".join(w.get("caps") or []) or "no caps"
        title = w.get("title") or w.get("name")
        print("%s  %s  (%s)  caps: %s" % (w.get("name"), w.get("state"), title, caps))
        for e in (w.get("errors") or [])[:3]:
            print("  " + diag(e))
        placements = w.get("placements") or []
        if not placements:
            print("  not placed in any Garden")
        for p in placements:
            print("  %s/%s  %s" % (p.get("garden"), p.get("placement"), p.get("grant")))
elif verb == "widget-revoke":
    n = d.get("revoked")
    if isinstance(n, list):
        n = len(n)
    print("revoked %s grant%s%s" % (n, "" if n == 1 else "s", "" if d.get("changed", True) else " (nothing to revoke)"))
'
}

# k2 zen widget <new|list|revoke> (prd-zen-user-widgets-v2 UW41). Custom
# widgets are folders under ~/.k2/zen/widgets/; the daemon owns their
# grants. There is no grant verb: only the human allows a widget, in the
# K2 app (UWB3).
cmd_zen_widget() {
    local verb="${1:-}"
    shift || true
    local as_json=false from="" widget="" raw body
    local -a pos=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --json) as_json=true; shift ;;
            --from)
                [ -n "${2:-}" ] || { echo "Error: --from needs an example: k2:diary, hello or arcade" >&2; exit 2; }
                from="$2"; shift 2 ;;
            --from=*) from="${1#*=}"; shift ;;
            --widget)
                [ -n "${2:-}" ] || { echo "Error: --widget needs a widget folder name" >&2; exit 2; }
                widget="$2"; shift 2 ;;
            --widget=*) widget="${1#*=}"; shift ;;
            -h|--help) cmd_help_zen; exit 0 ;;
            -*) echo "Error: unexpected '$1' (see k2 zen --help)" >&2; exit 2 ;;
            *) pos+=("$1"); shift ;;
        esac
    done
    local n=${#pos[@]}
    if [ "$verb" != "new" ] && [ -n "$from" ]; then
        echo "Error: --from is for k2 zen widget new" >&2
        exit 2
    fi
    if [ "$verb" != "revoke" ] && [ -n "$widget" ]; then
        echo "Error: --widget is for k2 zen widget revoke (and k2 zen validate/history/reset)" >&2
        exit 2
    fi
    case "$verb" in
        new)
            [ "$n" -eq 1 ] || { echo "Error: k2 zen widget new needs one name (lower-case letters, digits, - and _)" >&2; exit 2; }
            body=$(ZN="${pos[0]}" ZF="$from" python3 -c '
import json, os
b = {"name": os.environ["ZN"]}
if os.environ.get("ZF"):
    b["from"] = os.environ["ZF"]
print(json.dumps(b))
')
            raw=$(cli_post_json "/cli/zen/widget/new" "$body")
            _zen_print widget-new "$as_json" "$raw"
            ;;
        list)
            [ "$n" -eq 0 ] || { echo "Error: k2 zen widget list takes only --json" >&2; exit 2; }
            raw=$(cli_request "/cli/zen/widgets")
            _zen_print widget-list "$as_json" "$raw"
            ;;
        revoke)
            if [ -n "$widget" ]; then
                [ "$n" -eq 0 ] || { echo "Error: pass a Garden and a placement, or --widget <name>, not both" >&2; exit 2; }
                body=$(ZW="$widget" python3 -c 'import json, os; print(json.dumps({"widget": os.environ["ZW"]}))')
            else
                [ "$n" -eq 2 ] || { echo "Error: k2 zen widget revoke needs a Garden and a placement id, or --widget <name>" >&2; exit 2; }
                body=$(ZG="${pos[0]}" ZP="${pos[1]}" python3 -c '
import json, os
print(json.dumps({"garden": os.environ["ZG"], "placement": os.environ["ZP"]}))
')
            fi
            raw=$(cli_post_json "/cli/zen/widget/revoke" "$body")
            _zen_print widget-revoke "$as_json" "$raw"
            ;;
        grant|allow)
            echo "Only you can allow a widget, in the K2 app: open the Garden and click Review." >&2
            exit 1
            ;;
        ""|help|--help|-h)
            cmd_help_zen
            ;;
        *)
            echo "Unknown 'k2 zen widget' subcommand: $verb (new, list, revoke)" >&2
            exit 2
            ;;
    esac
}

_zen_no_home() {
    echo "Error: --home is gone: Zen pages are Gardens now. Use --garden <name|id> (k2 zen garden list)." >&2
    exit 2
}

# Parse --garden/--file/--theme/--to/--json into ZEN_* globals.
_zen_args() {
    ZEN_AS_JSON=false; ZEN_GARDEN_SEL=""; ZEN_FILE_SEL=""; ZEN_TO=""; ZEN_THEME_SEL=""; ZEN_WIDGET_SEL=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --widget)
                [ -n "${2:-}" ] || { echo "Error: --widget needs a widget folder name (see k2 zen widget list)" >&2; exit 2; }
                ZEN_WIDGET_SEL="$2"; shift 2 ;;
            --widget=*) ZEN_WIDGET_SEL="${1#*=}"; shift ;;
            --json) ZEN_AS_JSON=true; shift ;;
            --garden)
                [ -n "${2:-}" ] || { echo "Error: --garden needs a Garden name or id (see k2 zen garden list)" >&2; exit 2; }
                ZEN_GARDEN_SEL="$2"; shift 2 ;;
            --garden=*) ZEN_GARDEN_SEL="${1#*=}"; shift ;;
            --home|--home=*) _zen_no_home ;;
            --file)
                [ -n "${2:-}" ] || { echo "Error: --file needs zen.toml, gardens/<id>.toml or themes/<name>/theme.toml" >&2; exit 2; }
                ZEN_FILE_SEL="$2"; shift 2 ;;
            --file=*) ZEN_FILE_SEL="${1#*=}"; shift ;;
            --to)
                [ -n "${2:-}" ] || { echo "Error: --to needs a snapshot name (see k2 zen history)" >&2; exit 2; }
                ZEN_TO="$2"; shift 2 ;;
            --to=*) ZEN_TO="${1#*=}"; shift ;;
            --theme)
                [ -n "${2:-}" ] || { echo "Error: --theme needs a theme name (see k2 zen theme list)" >&2; exit 2; }
                ZEN_THEME_SEL="$2"; shift 2 ;;
            --theme=*) ZEN_THEME_SEL="${1#*=}"; shift ;;
            *) echo "Error: unexpected '$1' (see k2 zen --help)" >&2; exit 2 ;;
        esac
    done
    local n=0
    [ -n "$ZEN_GARDEN_SEL" ] && n=$((n + 1))
    [ -n "$ZEN_FILE_SEL" ] && n=$((n + 1))
    [ -n "$ZEN_THEME_SEL" ] && n=$((n + 1))
    [ -n "$ZEN_WIDGET_SEL" ] && n=$((n + 1))
    if [ "$n" -gt 1 ]; then
        echo "Error: pass one of --garden, --theme, --widget or --file" >&2
        exit 2
    fi
}

# k2 zen garden <list|new|rename|delete|reorder> (G35). The daemon owns
# gardens.json; this only calls its routes.
cmd_zen_garden() {
    local verb="${1:-}"
    shift || true
    local as_json=false texting=false force=false at="" raw body
    local -a pos=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --json) as_json=true; shift ;;
            --texting) texting=true; shift ;;
            --force) force=true; shift ;;
            --at)
                [ -n "${2:-}" ] || { echo "Error: --at needs a position (1 is the first)" >&2; exit 2; }
                at="$2"; shift 2 ;;
            --at=*) at="${1#*=}"; shift ;;
            --) shift; while [ $# -gt 0 ]; do pos+=("$1"); shift; done ;;
            -*) echo "Error: unexpected '$1' (see k2 zen --help)" >&2; exit 2 ;;
            *) pos+=("$1"); shift ;;
        esac
    done
    if [ -n "$at" ] && ! [[ "$at" =~ ^[0-9]+$ ]]; then
        echo "Error: --at needs a whole number (1 is the first)" >&2
        exit 2
    fi
    if [ "$verb" != "new" ] && { [ "$texting" = true ] || [ -n "$at" ]; }; then
        echo "Error: --texting and --at are for k2 zen garden new" >&2
        exit 2
    fi
    if [ "$verb" != "template" ] && [ "$force" = true ]; then
        echo "Error: --force is for k2 zen garden template" >&2
        exit 2
    fi
    local n=${#pos[@]}
    case "$verb" in
        list)
            [ "$n" -eq 0 ] || { echo "Error: k2 zen garden list takes only --json" >&2; exit 2; }
            raw=$(cli_request "/cli/zen/gardens")
            # The sync column (prd-zen-garden-sync-defaults-v1 §11); an
            # older daemon has no /cli/zen/sync and the column is left out.
            ZEN_SYNC_RAW="$(cli_request "/cli/zen/sync" 2>/dev/null || true)" _zen_print garden-list "$as_json" "$raw"
            ;;
        new)
            [ "$n" -ge 1 ] || { echo "Error: k2 zen garden new needs a name" >&2; exit 2; }
            body=$(ZN="${pos[*]}" ZT="$texting" ZA="$at" python3 -c '
import json, os
b = {"name": os.environ["ZN"]}
if os.environ.get("ZT") == "true":
    b["template"] = "texting"
if os.environ.get("ZA"):
    b["at"] = int(os.environ["ZA"])
print(json.dumps(b))
')
            raw=$(cli_post_json "/cli/zen/garden/new" "$body")
            _zen_print garden-new "$as_json" "$raw"
            ;;
        rename)
            [ "$n" -ge 2 ] || { echo "Error: k2 zen garden rename needs a Garden and a new name" >&2; exit 2; }
            body=$(ZG="${pos[0]}" ZN="${pos[*]:1}" python3 -c '
import json, os
print(json.dumps({"garden": os.environ["ZG"], "name": os.environ["ZN"]}))
')
            raw=$(cli_post_json "/cli/zen/garden/rename" "$body")
            _zen_print garden-rename "$as_json" "$raw"
            ;;
        reorder)
            [ "$n" -eq 2 ] || { echo "Error: k2 zen garden reorder needs a Garden and a position (1 is the first)" >&2; exit 2; }
            [[ "${pos[1]}" =~ ^[0-9]+$ ]] || { echo "Error: the position must be a whole number (1 is the first)" >&2; exit 2; }
            body=$(ZG="${pos[0]}" ZP="${pos[1]}" python3 -c '
import json, os
print(json.dumps({"garden": os.environ["ZG"], "to": int(os.environ["ZP"])}))
')
            raw=$(cli_post_json "/cli/zen/garden/reorder" "$body")
            _zen_print garden-reorder "$as_json" "$raw"
            ;;
        template)
            [ "$n" -eq 2 ] || { echo "Error: k2 zen garden template needs a Garden and a template: texting (the default) or blank" >&2; exit 2; }
            case "${pos[1]}" in
                texting|blank) ;;
                *) echo "Error: unknown template '${pos[1]}'; use texting (the default) or blank" >&2; exit 2 ;;
            esac
            body=$(ZG="${pos[0]}" ZT="${pos[1]}" ZF="$force" python3 -c '
import json, os
b = {"garden": os.environ["ZG"], "template": os.environ["ZT"]}
if os.environ.get("ZF") == "true":
    b["force"] = True
print(json.dumps(b))
')
            raw=$(cli_post_json "/cli/zen/garden/template" "$body")
            _zen_print garden-template "$as_json" "$raw"
            ;;
        delete)
            [ "$n" -eq 1 ] || { echo "Error: k2 zen garden delete needs one Garden (an id or a name)" >&2; exit 2; }
            body=$(ZG="${pos[0]}" python3 -c '
import json, os
print(json.dumps({"garden": os.environ["ZG"]}))
')
            raw=$(cli_post_json "/cli/zen/garden/delete" "$body")
            _zen_print garden-delete "$as_json" "$raw"
            ;;
        ""|help|--help|-h)
            cmd_help_zen
            ;;
        *)
            echo "Unknown 'k2 zen garden' subcommand: $verb (list, new, rename, reorder, template, delete)" >&2
            exit 2
            ;;
    esac
}

# k2 zen theme <list|next|prev|set|new> (Omarchy additions 2-3, G16). The
# daemon owns the active theme (active.json); an unknown name exits 1 and
# lists the themes.
cmd_zen_theme() {
    local verb="${1:-}"
    shift || true
    local as_json=false garden="" from="" clear=false name="" raw body
    while [ $# -gt 0 ]; do
        case "$1" in
            --json) as_json=true; shift ;;
            --garden)
                [ -n "${2:-}" ] || { echo "Error: --garden needs a Garden name or id" >&2; exit 2; }
                garden="$2"; shift 2 ;;
            --garden=*) garden="${1#*=}"; shift ;;
            --home|--home=*) _zen_no_home ;;
            --from)
                [ -n "${2:-}" ] || { echo "Error: --from needs a theme name" >&2; exit 2; }
                from="$2"; shift 2 ;;
            --from=*) from="${1#*=}"; shift ;;
            --clear) clear=true; shift ;;
            -*) echo "Error: unexpected '$1' (see k2 zen --help)" >&2; exit 2 ;;
            *)
                [ -z "$name" ] || { echo "Error: one theme name, got '$name' and '$1'" >&2; exit 2; }
                name="$1"; shift ;;
        esac
    done
    case "$verb" in
        list)
            [ -z "$name$from" ] && [ "$clear" = false ] || { echo "Error: k2 zen theme list takes only --garden and --json" >&2; exit 2; }
            local -a q=()
            [ -n "$garden" ] && q+=("garden=$(urlencode "$garden")")
            raw=$(cli_request "/cli/zen/theme/list" ${q[@]+"${q[@]}"})
            _zen_print theme-list "$as_json" "$raw"
            ;;
        next|prev)
            [ -z "$name$from" ] && [ "$clear" = false ] || { echo "Error: k2 zen theme $verb takes only --garden and --json" >&2; exit 2; }
            body=$(ZG="$garden" python3 -c 'import json, os; print(json.dumps({"garden": os.environ["ZG"]} if os.environ.get("ZG") else {}))')
            raw=$(cli_post_json "/cli/zen/theme/$verb" "$body")
            _zen_print theme-switch "$as_json" "$raw"
            ;;
        set)
            [ -z "$from" ] || { echo "Error: --from is for k2 zen theme new" >&2; exit 2; }
            if [ "$clear" = true ]; then
                [ -n "$garden" ] && [ -z "$name" ] || { echo "Error: --clear takes --garden <name> and no theme name" >&2; exit 2; }
            else
                [ -n "$name" ] || { echo "Error: k2 zen theme set needs a theme name (see k2 zen theme list)" >&2; exit 2; }
            fi
            body=$(ZN="$name" ZG="$garden" ZC="$clear" python3 -c '
import json, os
b = {}
if os.environ.get("ZN"):
    b["name"] = os.environ["ZN"]
if os.environ.get("ZG"):
    b["garden"] = os.environ["ZG"]
if os.environ.get("ZC") == "true":
    b["clear"] = True
print(json.dumps(b))
')
            raw=$(cli_post_json "/cli/zen/theme/set" "$body")
            _zen_print theme-switch "$as_json" "$raw"
            ;;
        new)
            [ -z "$garden" ] && [ "$clear" = false ] || { echo "Error: k2 zen theme new takes a name, --from and --json" >&2; exit 2; }
            [ -n "$name" ] || { echo "Error: k2 zen theme new needs a name (lower-case letters, digits, - and _)" >&2; exit 2; }
            body=$(ZN="$name" ZF="$from" python3 -c '
import json, os
b = {"name": os.environ["ZN"]}
if os.environ.get("ZF"):
    b["from"] = os.environ["ZF"]
print(json.dumps(b))
')
            raw=$(cli_post_json "/cli/zen/theme/new" "$body")
            _zen_print theme-new "$as_json" "$raw"
            ;;
        ""|help|--help|-h)
            cmd_help_zen
            ;;
        *)
            echo "Unknown 'k2 zen theme' subcommand: $verb (list, next, prev, set, new)" >&2
            exit 2
            ;;
    esac
}

# k2 zen sync / k2 zen news (prd-zen-garden-sync-defaults-v1 §11). The
# daemon owns sync.json and news.json; the changes are owner-only, so an
# agent gets 403 zen_local_only and the message to ask the person.

# GS32: a person-only Zen change (sync on/off/undo/keep-previous, news
# seen). `zen` is an Open tool, so inside a K2 terminal the CLI would
# otherwise send the disk owner token; this sends the session's passport
# instead, and the daemon refuses it. Outside K2 the owner token is used.
_zen_person_post() {
    local endpoint="$1" body="$2" hook_sock="${K2_HOOK_SOCK:-${K2SO_HOOK_SOCK:-}}"
    if [ -n "$hook_sock" ]; then
        local saved="$TOKEN"
        TOKEN="${SCOPED_TOKEN:-${K2_HOOK_TOKEN:-${K2SO_HOOK_TOKEN:-}}}"
        cli_post_json "$endpoint" "$body"
        TOKEN="$saved"
    else
        cli_post_json "$endpoint" "$body"
    fi
}

cmd_zen_sync() {
    local as_json=false part="" raw body
    local -a pos=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --json) as_json=true; shift ;;
            --page) [ -z "$part" ] || { echo "Error: pass one of --page or --theme (neither: both)" >&2; exit 2; }; part="page"; shift ;;
            --theme) [ -z "$part" ] || { echo "Error: pass one of --page or --theme (neither: both)" >&2; exit 2; }; part="theme"; shift ;;
            -h|--help) cmd_help_zen; exit 0 ;;
            -*) echo "Error: unexpected '$1' (see k2 zen --help)" >&2; exit 2 ;;
            *) pos+=("$1"); shift ;;
        esac
    done
    local n=${#pos[@]}
    if [ "$n" -eq 0 ]; then
        [ -z "$part" ] || { echo "Error: k2 zen sync with no Garden takes only --json" >&2; exit 2; }
        raw=$(cli_request "/cli/zen/sync")
        _zen_print sync-list "$as_json" "$raw"
        return
    fi
    [ "$n" -eq 2 ] || { echo "Error: k2 zen sync <garden> on|off|preview|undo|keep-previous [--page|--theme]" >&2; exit 2; }
    local garden="${pos[0]}" act="${pos[1]}"
    case "$act" in
        on|off)
            body=$(ZG="$garden" ZP="${part:-both}" ZS="$act" python3 -c '
import json, os
print(json.dumps({"garden": os.environ["ZG"], "part": os.environ["ZP"], "sync": os.environ["ZS"] == "on"}))
')
            raw=$(_zen_person_post "/cli/zen/garden/sync" "$body")
            _zen_print sync-change "$as_json" "$raw"
            ;;
        undo)
            [ -z "$part" ] || { echo "Error: undo puts back the last change; it takes no --page or --theme" >&2; exit 2; }
            body=$(ZG="$garden" python3 -c 'import json, os; print(json.dumps({"garden": os.environ["ZG"], "undo": True}))')
            raw=$(_zen_person_post "/cli/zen/garden/sync" "$body")
            _zen_print sync-change "$as_json" "$raw"
            ;;
        keep-previous)
            body=$(ZG="$garden" ZP="${part:-both}" python3 -c '
import json, os
print(json.dumps({"garden": os.environ["ZG"], "keep": "previous", "part": os.environ["ZP"]}))
')
            raw=$(_zen_person_post "/cli/zen/garden/sync" "$body")
            _zen_print sync-change "$as_json" "$raw"
            ;;
        preview)
            raw=$(cli_request "/cli/zen/get" "garden=$(urlencode "$garden")" "preview=${part:-both}")
            _zen_print sync-preview "$as_json" "$raw"
            ;;
        *)
            echo "Error: unknown 'k2 zen sync' action '$act' (on, off, preview, undo, keep-previous)" >&2
            exit 2
            ;;
    esac
}

cmd_zen_news() {
    local as_json=false all=false raw body
    local -a pos=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --json) as_json=true; shift ;;
            --all) all=true; shift ;;
            -h|--help) cmd_help_zen; exit 0 ;;
            -*) echo "Error: unexpected '$1' (see k2 zen --help)" >&2; exit 2 ;;
            *) pos+=("$1"); shift ;;
        esac
    done
    if [ ${#pos[@]} -eq 0 ]; then
        [ "$all" = false ] || { echo "Error: --all is for k2 zen news seen" >&2; exit 2; }
        raw=$(cli_request "/cli/zen/news")
        _zen_print news "$as_json" "$raw"
        return
    fi
    [ "${pos[0]}" = "seen" ] || { echo "Error: unknown 'k2 zen news' subcommand '${pos[0]}' (seen)" >&2; exit 2; }
    local -a ids=("${pos[@]:1}")
    if [ "$all" = true ] && [ ${#ids[@]} -gt 0 ]; then
        echo "Error: pass ids or --all, not both" >&2
        exit 2
    fi
    if [ "$all" = false ] && [ ${#ids[@]} -eq 0 ]; then
        echo "Error: k2 zen news seen needs ids (from k2 zen news) or --all" >&2
        exit 2
    fi
    body=$(ZA="$all" python3 -c '
import json, os, sys
if os.environ.get("ZA") == "true":
    print(json.dumps({"all": True}))
else:
    print(json.dumps({"ids": sys.argv[1:]}))
' ${ids[@]+"${ids[@]}"})
    raw=$(_zen_person_post "/cli/zen/news/seen" "$body")
    _zen_print news-seen "$as_json" "$raw"
}

cmd_zen() {
    local sub="${1:-}"
    shift || true
    local raw=""
    case "$sub" in
        validate|history)
            _zen_args "$@"
            [ -z "$ZEN_TO" ] || { echo "Error: --to is for k2 zen reset" >&2; exit 2; }
            local -a q=()
            [ -n "$ZEN_GARDEN_SEL" ] && q+=("garden=$(urlencode "$ZEN_GARDEN_SEL")")
            [ -n "$ZEN_FILE_SEL" ] && q+=("file=$(urlencode "$ZEN_FILE_SEL")")
            [ -n "$ZEN_THEME_SEL" ] && q+=("theme=$(urlencode "$ZEN_THEME_SEL")")
            [ -n "$ZEN_WIDGET_SEL" ] && q+=("widget=$(urlencode "$ZEN_WIDGET_SEL")")
            raw=$(cli_request "/cli/zen/$sub" ${q[@]+"${q[@]}"})
            _zen_print "$sub" "$ZEN_AS_JSON" "$raw"
            ;;
        reload)
            _zen_args "$@"
            if [ -n "$ZEN_GARDEN_SEL$ZEN_FILE_SEL$ZEN_TO$ZEN_THEME_SEL$ZEN_WIDGET_SEL" ]; then
                echo "Error: k2 zen reload takes only --json" >&2
                exit 2
            fi
            raw=$(cli_post_json "/cli/zen/reload" '{}')
            _zen_print reload "$ZEN_AS_JSON" "$raw"
            ;;
        reset)
            _zen_args "$@"
            local body
            body=$(ZG="$ZEN_GARDEN_SEL" ZF="$ZEN_FILE_SEL" ZT="$ZEN_TO" ZM="$ZEN_THEME_SEL" ZW="$ZEN_WIDGET_SEL" python3 -c '
import json, os
b = {}
for k, e in (("garden", "ZG"), ("file", "ZF"), ("to", "ZT"), ("theme", "ZM"), ("widget", "ZW")):
    if os.environ.get(e):
        b[k] = os.environ[e]
print(json.dumps(b))
')
            raw=$(cli_post_json "/cli/zen/reset" "$body")
            _zen_print reset "$ZEN_AS_JSON" "$raw"
            ;;
        doctor|path)
            _zen_args "$@"
            if [ -n "$ZEN_GARDEN_SEL$ZEN_FILE_SEL$ZEN_TO$ZEN_THEME_SEL$ZEN_WIDGET_SEL" ]; then
                echo "Error: k2 zen $sub takes only --json" >&2
                exit 2
            fi
            if [ "$sub" = "doctor" ]; then
                raw=$(cli_request "/cli/zen/doctor")
            else
                raw=$(cli_request "/cli/zen/status")
            fi
            _zen_print "$sub" "$ZEN_AS_JSON" "$raw"
            ;;
        garden|gardens)
            cmd_zen_garden "$@"
            ;;
        theme|themes)
            cmd_zen_theme "$@"
            ;;
        widget|widgets)
            cmd_zen_widget "$@"
            ;;
        sync)
            cmd_zen_sync "$@"
            ;;
        news)
            cmd_zen_news "$@"
            ;;
        pages)
            echo "Error: there is no 'k2 zen pages' any more: Zen pages are Gardens now. Use k2 zen garden list." >&2
            exit 2
            ;;
        ""|help|--help|-h)
            cmd_help_zen
            exit 0
            ;;
        guide)
            cmd_zen_guide "$@"
            ;;
        grant|grants|allow)
            echo "Error: there is no 'k2 zen $sub'. Agents never grant permissions." >&2
            echo "Tell the human what the widget needs and why; they grant it in the K2 app." >&2
            exit 2
            ;;
        *)
            echo "Unknown 'k2 zen' subcommand: $sub" >&2
            cmd_help_zen >&2
            exit 2
            ;;
    esac
}

# ── Router ───────────────────────────────────────────────────────────
# Select TCP credential by catalog mode BEFORE any verb handler runs.
# ID/locked tools in a scoped cell keep SCOPED_TOKEN; Open tools may
