<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 0.37.9: codesign entitlements for the hardened-runtime build.
	     Hardened runtime locks down a bunch of capabilities by default;
	     we have to opt back into the ones we need. -->

	<!-- Required by Tauri/wry's WKWebView (Chromium-style sandboxed
	     WebContent processes execute JIT'd JS). -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>

	<!-- Required because we load dynamic libraries (sqlite, openssl,
	     etc.) that aren't all signed by the same team. Without this
	     the daemon sidecar fails to launch under hardened runtime. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>

	<!-- 0.37.9 — audio capture for Apple Dictation. Hardened runtime
	     denies audio access by default; this entitlement plus the
	     `NSMicrophoneUsageDescription` Info.plist key are BOTH
	     required for macOS to even prompt the user, let alone let
	     Dictation engage in our WebView text inputs. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>

	<!-- REMOVED in 0.40.7 — DO NOT re-add. A `keychain-access-groups` entitlement
	     was added in 0.40.6 to try to persist the keychain "Always Allow" grant.
	     It was BOTH fatal and inert:
	       • FATAL: keychain-access-groups is a RESTRICTED entitlement that macOS
	         only honors with an embedded provisioning profile. Developer-ID builds
	         (distributed outside the App Store) have no profile, so AMFI SIGKILL'd
	         the app at launch — the Finder "K2 can't be opened" dialog (0.40.6
	         crash-on-launch regression). It notarized fine and `tauri dev` never
	         enforced it, so it slipped past dev testing.
	       • INERT: it only governs the iOS-style data-protection keychain, which
	         neither `keyring` nor the `security` CLI use on macOS. The real
	         "Always Allow" persistence comes from the login-keychain trusted-app
	         ACL (`security -T`, see crates/k2-core/src/tunnel/lease.rs), not this.
	     Lesson: smoke-test the SIGNED bundle (not just `tauri dev`) before release. -->
</dict>
</plist>
