# 0074 — record (or drop) a nested label's WORKSPACE attribution on the
# LOCAL daemon: POST /cli/tunnel/subdomains/{claim,unclaim} with the
# label; cli_post_form carries this shell's $PROJECT (the acting
# workspace) in the query string, which is exactly the attribution
# being recorded. Echoes the response body; non-zero when the daemon
# connection is missing/unreachable.
_subdomain_attrib_post() {
    local verb="$1" label="$2"
    if [ -z "$PORT" ] || [ -z "$TOKEN" ]; then return 1; fi
    cli_post_form "/cli/tunnel/subdomains/${verb}" "label=$(urlencode "$label")"
}

# Best-effort attribution stamp AFTER a successful control-plane
# create/point/rm. The control-plane mutation already landed — a failed
# stamp must not fail the command; warn with the manual remediation
# (`k2 publish subdomain claim/unclaim <label>`) instead. Always
# returns 0.
_stamp_subdomain_attrib() {
    local verb="$1" label="$2" resp
    if resp=$(_subdomain_attrib_post "$verb" "$label" 2>/dev/null) && \
       printf '%s' "$resp" | python3 -c 'import json,sys; sys.exit(0 if (json.loads(sys.stdin.read() or "{}") or {}).get("success") else 1)' 2>/dev/null; then
        return 0
    fi
    if [ "$verb" = "claim" ]; then
        echo "Warning: workspace attribution was not recorded on the daemon (unreachable?)." >&2
        echo "  Adopt it later from the owning workspace: k2 publish subdomain claim $label" >&2
    else
        echo "Warning: workspace attribution was not removed on the daemon (unreachable?)." >&2
        echo "  Remove it later: k2 publish subdomain unclaim $label" >&2
    fi
    return 0
}

# Best-effort realtime nudge AFTER a successful control-plane
# create/point/rm (and its attribution stamp): ask the LOCAL daemon to
# re-pull the subdomain map from the control plane NOW, so the
# new/changed URL appears in the UIs immediately instead of on the next
# periodic poll. The daemon runs the same fetch its poll loop uses and
# broadcasts tunnel_subdomains_changed only when the map actually
# changed. A miss (daemon unreachable / tunnel unconfigured) must not
# fail the command — the control-plane op already succeeded and the map
# converges on the next poll. Silent + always returns 0.
_nudge_subdomain_refresh() {
    if [ -z "$PORT" ] || [ -z "$TOKEN" ]; then return 0; fi
    cli_post_form "/cli/tunnel/subdomains/refresh" >/dev/null 2>&1 || true
    return 0
}

