            _uq since "$since"; _uq until "$until"; _uq group_by "$by"; _uq tz "$tz"
            [ "$outside" = "1" ] && _uq outside 1
            _usage_get tokens "$q"
            if [ "$as_json" = "1" ]; then printf '%s\n' "$_SC_BODY"; exit 0; fi
            printf '%s' "$_SC_BODY" | python3 -c '
