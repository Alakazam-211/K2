        {"name": "--limit", "arg": "N", "description": "At most N."},
        {"name": "--version", "arg": "V", "description": "Place the pins at version V (an older one needs history)."},
        {"name": "--log", "arg": null, "description": "The threads' history, for all or for one ann-N."}
      ]
    },
    {
      "name": "doc reanchor",
      "usage": "k2 doc reanchor ann-N --doc|--node ADDR [--version V] [--hint TEXT] <f>",
