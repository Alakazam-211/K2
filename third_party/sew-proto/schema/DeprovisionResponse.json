{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response of `POST /mgmt/v1/principals/deprovision`.",
  "properties": {
    "member_id": {
      "description": "The deactivated member.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "sessions_revoked": {
      "description": "Sessions revoked.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "member_id",
    "sessions_revoked"
  ],
  "title": "DeprovisionResponse",
  "type": "object"
}
