     }
          */
+
+    /// k2: undoing a deletion redoes its items (`Item::redo`, which takes the store's client
+    /// ID). Run in a `transact_mut_as` transaction, the redone items are that client's, and
+    /// the doc's own ID is back after.
+    #[test]
+    fn redo_in_an_as_client_transaction_creates_items_as_that_client() {
+        use crate::transaction::Origin;
+        let doc = Doc::with_client_id(1);
+        let txt = doc.get_or_insert_text("t");
+        let mut mgr: UndoManager = UndoManager::new();
+        mgr.expand_scope(&doc, &txt);
+        txt.insert(&mut doc.transact_mut(), 0, "abc");
+        mgr.reset();
+        txt.remove_range(&mut doc.transact_mut(), 0, 3);
+        assert_eq!(txt.get_string(&doc.transact()), "");
+        // the undo manager's own pop, with an as-77 transaction
+        let inner = mgr.inner_mut();
+        let item = inner.undo_stack.pop().unwrap();
+        let origin = Origin::from(inner as *mut _ as usize);
+        let txn = doc.transact_mut_as(ClientID::new(77));
+        let changed = UndoManager::try_process(
+            item,
+            txn,
+            &mut inner.undo_stack,
+            &inner.redo_stack,
+            &inner.scope,
+            &mut inner.observer_popped,
+            true,
+            origin,
+        );
+        assert!(changed);
+        assert_eq!(txt.get_string(&doc.transact()), "abc");
+        let sv = doc.transact().state_vector();
+        assert_eq!(sv.get(&ClientID::new(77)), 3, "the redone items are 77's");
+        assert_eq!(sv.get(&ClientID::new(1)), 3);
+        // the doc's own client writes next
+        txt.insert(&mut doc.transact_mut(), 0, "x");
+        let sv = doc.transact().state_vector();
+        assert_eq!(sv.get(&ClientID::new(1)), 4);
+        assert_eq!(sv.get(&ClientID::new(77)), 3);
+        // the control: the same through the manager's own transaction is the doc's
+        let doc = Doc::with_client_id(1);
+        let txt = doc.get_or_insert_text("t");
+        let mut mgr: UndoManager = UndoManager::new();
+        mgr.expand_scope(&doc, &txt);
+        txt.insert(&mut doc.transact_mut(), 0, "abc");
+        mgr.reset();
+        txt.remove_range(&mut doc.transact_mut(), 0, 3);
+        assert!(mgr.undo_blocking());
+        assert_eq!(doc.transact().state_vector().get(&ClientID::new(1)), 6);
+    }
 }
