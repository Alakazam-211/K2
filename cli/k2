                echo "" >&2
                echo "  install [--version <x.y.z>] [--bin-dir <dir>] [--manifest-url <url>]" >&2
                echo "          [--no-service] [--dry-run]" >&2
                echo "    Install the STANDALONE (headless, no-GUI) daemon binary from a" >&2
