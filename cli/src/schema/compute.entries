        {"name": "--now", "arg": null, "description": "Stop jobs at once."}
      ]
    },
    {
      "name": "compute node wall",
      "usage": "k2 compute node wall <node> [--no-restart] [--reason \"…\"]",
      "description": "Linux: turn the job wall on (jobs run as k2job, walled off from the node's key, /home and /root). An older node, or one whose owner set it up without the wall, holds it for the owner (exit 2). Node admin: agents need Allow this agent to operate compute nodes.",
      "args": [{"name": "node", "required": true}],
      "flags": [
        {"name": "--no-restart", "arg": null, "description": "Use it at the next restart instead of restarting k2-node."},
        {"name": "--reason", "arg": "text", "description": "Why."}
      ]
    },
    {
      "name": "compute node admin propose",
      "usage": "k2 compute node admin propose <node> <verb> [key=value…] --reason \"…\" | k2 compute node admin propose <node> --plan plan.json --reason \"…\"",
      "description": "File a node admin request, held for the owner: exit 2 with the request id. Verbs today: unit.restart, policy.set, control.pause|drain|resume, gc, jobs.kill, wall.enable, homes.private. Node admin: agents need Allow this agent to operate compute nodes.",
      "args": [{"name": "node", "required": true}, {"name": "verb", "required": false}, {"name": "key=value", "required": false}],
      "flags": [
        {"name": "--reason", "arg": "text", "description": "Why (shown to the owner)."},
        {"name": "--plan", "arg": "plan.json", "description": "A JSON file of steps instead of one verb."}
      ]
    },
    {
