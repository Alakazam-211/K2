{
  "$defs": {
    "SecretSetVia": {
      "description": "Where a secret was set.",
      "oneOf": [
        {
          "const": "client",
          "description": "The client API (an install owner or admin).",
          "type": "string"
        },
        {
          "const": "mgmt",
          "description": "The mgmt API (K2's daemon or the `sew` CLI).",
          "type": "string"
        }
      ]
    },
    "SecretStatus": {
      "description": "A secret's status. The value is never returned.",
      "properties": {
        "configured": {
          "description": "Whether a value is set.",
          "type": "boolean"
        },
        "fingerprint": {
          "description": "`hex(SHA-256(value))[0..8]`, so admins can tell keys apart.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "The name.",
          "type": "string"
        },
        "set_at": {
          "description": "When it was set.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "set_via": {
          "anyOf": [
            {
              "$ref": "#/$defs/SecretSetVia"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where it was set."
        }
      },
      "required": [
        "name",
        "configured"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response of `GET /api/v1/install/secrets` and `GET /mgmt/v1/secrets`.",
  "properties": {
    "items": {
      "description": "Every known secret name, configured or not.",
      "items": {
        "$ref": "#/$defs/SecretStatus"
      },
      "type": "array"
    }
  },
  "required": [
    "items"
  ],
  "title": "SecretsResponse",
  "type": "object"
}
