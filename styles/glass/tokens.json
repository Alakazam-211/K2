{
  "$schema": "../style.schema.json#/$defs/tokens",
  "radius": {
    "box": { "$value": "14px", "$type": "dimension", "$description": "Instrument-glass density: rounder than Square, tighter than iOS." },
    "field": { "$value": "9px", "$type": "dimension" },
    "selector": { "$value": "9999px", "$type": "dimension", "$description": "Pills/circular knobs." }
  },
  "gap": {
    "pane": { "$value": "8px", "$type": "dimension" },
    "tile": { "$value": "6px", "$type": "dimension" },
    "section": { "$value": "8px", "$type": "dimension" }
  },
  "inset": {
    "window": { "$value": "10px", "$type": "dimension", "$description": "The whole workspace floats on the ambient canvas." }
  },
  "divider": {
    "width": { "$value": "12px", "$type": "dimension", "$description": "2 × gap.tile — fills the seam so drag still works." },
    "color": { "$value": "transparent", "$type": "color", "$description": "Seams are open canvas; hover accent remains the drag affordance." }
  },
  "ring": {
    "surface": { "$value": "inset 0 1px 0 0 var(--color-ring-edge-strong), inset 0 0 0 1px var(--color-ring-hairline)", "$type": "shadow", "$description": "Specular top edge + hairline — light from above. Colors live in the palette's ring-* slots so one ring definition serves dark and light." },
    "field": { "$value": "inset 0 1px 0 0 var(--color-ring-edge), inset 0 0 0 1px var(--color-ring-hairline-soft)", "$type": "shadow" },
    "focus": { "$value": "0 0 0 2px rgba(90, 162, 255, 0.35)", "$type": "shadow" }
  },
  "shadow": {
    "1": { "$value": "0 1px 2px rgba(0, 0, 0, 0.25)", "$type": "shadow" },
    "2": { "$value": "0 4px 12px rgba(0, 0, 0, 0.35)", "$type": "shadow" },
    "3": { "$value": "0 8px 24px rgba(0, 0, 0, 0.45)", "$type": "shadow" },
    "4": { "$value": "0 16px 40px rgba(0, 0, 0, 0.50)", "$type": "shadow" },
    "5": { "$value": "0 24px 64px rgba(0, 0, 0, 0.55), 0 4px 16px rgba(0, 0, 0, 0.35)", "$type": "shadow" }
  },
  "material": {
    "blur": { "$value": "18px", "$type": "dimension" },
    "saturate": { "$value": "180%", "$type": "dimension" },
    "tint": { "$value": "rgba(16, 20, 32, 0.58)", "$type": "color" },
    "tint-opacity": { "$value": 0.58, "$type": "number", "$description": "Future user dial." }
  },
  "density": {
    "scale": { "$value": 1, "$type": "number" }
  },
  "motion": {
    "duration-fast": { "$value": "140ms", "$type": "duration" },
    "duration-medium": { "$value": "220ms", "$type": "duration" },
    "duration-slow": { "$value": "340ms", "$type": "duration" },
    "ease-standard": { "$value": "cubic-bezier(0.32, 0.72, 0, 1)", "$type": "cubicBezier", "$description": "Apple-spring feel." }
  },
  "font": {
    "ui": { "$value": "'MesloLGM Nerd Font', Menlo, Monaco, 'Cascadia Code', 'Fira Code', 'SF Mono', Consolas, monospace, 'Apple Color Emoji', 'Segoe UI Emoji'", "$type": "fontFamily", "$description": "Glass changes the material, not K2's mono identity." },
    "display": { "$value": "'MesloLGM Nerd Font', Menlo, Monaco, 'Cascadia Code', 'Fira Code', 'SF Mono', Consolas, monospace, 'Apple Color Emoji', 'Segoe UI Emoji'", "$type": "fontFamily" }
  }
}
