{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response of `POST /mgmt/v1/mail/test`.",
  "properties": {
    "error": {
      "description": "Why it failed (at most 200 characters, never the address).",
      "type": [
        "string",
        "null"
      ]
    },
    "ok": {
      "description": "The relay accepted the mail.",
      "type": "boolean"
    },
    "smtp_code": {
      "description": "The relay's reply code, when there was one.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "ok"
  ],
  "title": "MailTestResponse",
  "type": "object"
}
