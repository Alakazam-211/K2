    "control-hover-quiet": { "$value": "#3a3732", "$type": "color", "$description": "Hover fill of the quiet Button (clear at rest, so the card or page shows). At least 1.25:1 from bg-elevated, bg-surface and bg." },
    "divider": { "$value": "#4f4b44", "$type": "color", "$description": "Short dividers between items in a row: tab-strip tabs, top-bar groups. Between border and control-edge, about 2:1 on the tab strip and the top bar capsule." },
