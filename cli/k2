'
}

# k2 app deploy <app-id> <folder|seed> [--reason TEXT] [--no-wait] [--types] [--json]
cmd_app_deploy() {
    local app="" target="" reason="" wait=150 types=0 json_out=0 engine=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --engine) engine="${2:-}"; shift 2 ;;
            --engine=*) engine="${1#--engine=}"; shift ;;
            --reason) reason="${2:-}"; shift 2 ;;
            --no-wait) wait=0; shift ;;
            --types) types=1; shift ;;
            --json) json_out=1; shift ;;
            -h|--help) _app_rt_usage; return 0 ;;
            -*) echo "Unknown flag: $1" >&2; exit 2 ;;
            *) if [ -z "$app" ]; then app="$1"; else target="$1"; fi; shift ;;
        esac
    done
    { [ -z "$app" ] || [ -z "$target" ]; } && { echo "usage: k2 app deploy <app-id> <folder|seed> [--engine guarded|process] [--reason TEXT] [--no-wait]" >&2; exit 2; }
    case "$engine" in ""|guarded|process) ;; *) echo "--engine is guarded or process" >&2; exit 2 ;; esac
    local body
    if [ -d "$target" ]; then
        body="$(_compute_json K2_CJ_app="$app" K2_CJ_folder="$(_app_rt_abs "$target")" K2_CJ_reason="$reason" K2_CJ_wait_n="$wait" K2_CJ_types_b="$types" K2_CJ_engine="$engine")"
    else
        body="$(_compute_json K2_CJ_app="$app" K2_CJ_seed="$target" K2_CJ_reason="$reason" K2_CJ_wait_n="$wait" K2_CJ_engine="$engine")"
    fi
    _app_rt_post /cli/app/deploy "$body"
    if [ "$_CP_STATUS" = "422" ]; then
        printf '%s' "$_CP_BODY" | _app_rt_report >&2
        exit 1
    fi
    [ "$_CP_STATUS" = "200" ] || _compute_fail "$_CP_STATUS" "$_CP_BODY"
    _app_rt_deployment_exit "$json_out"
}

