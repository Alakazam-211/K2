      ]
    },
    {
      "name": "doc comments",
      "usage": "k2 doc comments [--open|--resolved] [--on KEY] [--since SEQ] [--after ann-N] [--limit N] [--version V] <f> | k2 doc comments --log [ann-N] [--since SEQ] [--limit N] <f>",
      "description": "Each thread with its pin's state: attached, hint-stale, suspect, hidden or orphaned. --log: what happened to the threads (history).",
      "args": [{"name": "f", "required": true, "description": "The doc's path; it is the last argument."}],
      "flags": [
        {"name": "--open", "arg": null, "description": "Only open threads."},
