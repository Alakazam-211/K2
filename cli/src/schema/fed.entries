    {
      "name": "fed",
      "usage": "k2 fed <enable|disable|status|peers|pubkey|send|outbox|pair-start|pair-join|pair-finish|pair-verify|pair-request|confirm> ...",
      "description": "Federation: messages between agents on paired K2 servers. The /cli/federation/* routes answer only while federation is on (k2 fed enable); pubkey works anytime. Inside an agent session pair-start, pair-join, pair-finish, pair-verify, confirm and outbox are the server owner's (refused, exit 3) and send goes with the session's passport. -h or --help anywhere prints the usage and sends nothing; a bare or unknown verb prints it on stderr and exits 2.",
      "args": [{"name": "verb", "required": true, "description": "enable | disable | status | peers | pubkey | send | outbox | pair-start | pair-join | pair-finish | pair-verify | pair-request | confirm"}],
      "flags": []
    },
    {
      "name": "fed enable",
      "usage": "k2 fed enable",
      "description": "Turn on \"Connect agents across servers\" for this server (the same switch as Settings → Network → Tunnel → Policies; live at once with no restart). Owner-gated by the settings route.",
      "args": [],
      "flags": []
    },
    {
      "name": "fed disable",
      "usage": "k2 fed disable",
      "description": "Turn federation off for this server (the saved switch, live at once). Owner-gated by the settings route.",
      "args": [],
      "flags": []
    },
    {
      "name": "fed status",
      "usage": "k2 fed status",
      "description": "Print whether federation is on for this server.",
      "args": [],
      "flags": []
    },
    {
      "name": "fed peers",
      "usage": "k2 fed peers",
      "description": "List the servers pinned on this one, A to Z: host, trust, fingerprint, label, a re-pair hint and any pending or failed address notice. Use a peer's host with k2 msg agent::host. The owner token or an agent's passport.",
      "args": [],
      "flags": []
    },
    {
      "name": "fed pubkey",
      "usage": "k2 fed pubkey [--pem|--fingerprint|--json]",
      "description": "Print this server's federation public key (SPKI PEM, the fingerprint on stderr). Read from the on-box key with openssl, so it works while federation is off.",
      "args": [],
      "flags": [
        {"name": "--pem", "arg": null, "description": "The PEM (the default)."},
        {"name": "--fingerprint", "arg": null, "description": "Only the fingerprint (sha256 of the SPKI DER, hex). Also --fp."},
        {"name": "--json", "arg": null, "description": "{public_key_pem, fingerprint}."}
      ]
    },
    {
      "name": "fed send",
      "usage": "k2 fed send <peer>::<workspace>::<agent> \"message\"",
      "description": "Send one message to an agent on a paired server (the wire form; k2 msg agent::host is the everyday form). Inside an agent session it goes with the session's passport and is bound to that workspace; in a person's terminal it goes with the owner token. The daemon allows only a peer the sending workspace is connected to.",
      "args": [{"name": "to", "required": true, "description": "<peer>::<workspace>::<agent>"}, {"name": "message", "required": true}],
      "flags": []
    },
    {
      "name": "fed outbox",
      "usage": "k2 fed outbox",
      "description": "Per peer: cross-server messages still queued (retried with backoff) and the ones dead-lettered. The server owner's: refused in an agent session (exit 3).",
      "args": [],
      "flags": []
    },
    {
      "name": "fed pair-start",
      "usage": "k2 fed pair-start [--subdomain S] [--url http://host:port] [--label L]",
      "description": "Pairing step 1, on the server that starts: prints a k2pair1: token for the other server's owner (valid 10 minutes, single use). They run pair-join. The server owner's: refused in an agent session (exit 3).",
      "args": [],
      "flags": [
        {"name": "--subdomain", "arg": "S", "description": "This server's subdomain to give the peer."},
        {"name": "--url", "arg": "URL", "description": "This server's base URL to give the peer. Also --base-url."},
        {"name": "--label", "arg": "L", "description": "A label for the pairing."}
      ]
    },
    {
      "name": "fed pair-join",
      "usage": "k2 fed pair-join <k2pair1:token>",
      "description": "Pairing step 2, on the other server: takes the k2pair1: token and prints a k2pair2: token to send back. The server owner's: refused in an agent session (exit 3).",
      "args": [{"name": "token", "required": true}],
      "flags": []
    },
    {
      "name": "fed pair-finish",
      "usage": "k2 fed pair-finish <k2pair2:token>",
      "description": "Pairing step 3, on the server that started: takes the k2pair2: token, prints a k2pair3: token for the other owner and this side's pairing code. The server owner's: refused in an agent session (exit 3).",
      "args": [{"name": "token", "required": true}],
      "flags": []
    },
    {
      "name": "fed pair-verify",
      "usage": "k2 fed pair-verify <k2pair3:token>",
      "description": "Pairing step 4, on the other server: takes the k2pair3: token and prints this side's pairing code. Both owners compare codes, then each runs k2 fed confirm. The server owner's: refused in an agent session (exit 3).",
      "args": [{"name": "token", "required": true}],
      "flags": []
    },
    {
      "name": "fed pair-request",
      "usage": "k2 fed pair-request --pubkey <spki.pem> [--label L] [--subdomain S] [--url http://host:port]",
      "description": "The pre-0.45.2 pairing: asks a server to pin this key as a Pending peer (an open route: no token is sent, and it runs inside an agent session too). Refused for a server not paired yet.",
      "args": [],
      "flags": [
        {"name": "--pubkey", "arg": "spki.pem", "description": "Required. The SPKI public key PEM file (k2 fed pubkey)."},
        {"name": "--label", "arg": "L", "description": "A label for the peer."},
        {"name": "--subdomain", "arg": "S", "description": "The subdomain to give the peer."},
        {"name": "--url", "arg": "URL", "description": "The base URL to give the peer. Also --base-url."}
      ]
    },
    {
      "name": "fed confirm",
      "usage": "k2 fed confirm <fingerprint> <sas-code>",
      "description": "Trust the peer once both owners' pairing codes match. The server owner's: refused in an agent session (exit 3).",
      "args": [{"name": "fingerprint", "required": true}, {"name": "sas-code", "required": true}],
      "flags": []
    },
