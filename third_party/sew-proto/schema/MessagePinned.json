{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Body of `message_pinned` (S13 gap G7).",
  "properties": {
    "channel_id": {
      "description": "The channel.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "message_id": {
      "description": "The pinned message.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "pinned_at": {
      "description": "When.",
      "format": "date-time",
      "type": "string"
    },
    "pinned_by": {
      "description": "Who pinned it.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "seq": {
      "description": "The seq of the `pin_changed` change entry.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "channel_id",
    "message_id",
    "pinned_by",
    "pinned_at",
    "seq"
  ],
  "title": "MessagePinned",
  "type": "object"
}
