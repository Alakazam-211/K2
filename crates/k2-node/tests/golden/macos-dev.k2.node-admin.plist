<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- K2 node admin executor (root). Runs only signed commands it checks itself. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.k2.node-admin</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Library/Application Support/K2/node/k2-node</string>
		<string>admin</string>
		<string>serve</string>
		<string>--config-dir</string>
		<string>/etc/k2-node</string>
		<string>--state-dir</string>
		<string>/var/db/k2-node-admin</string>
		<string>--home</string>
		<string>/var/k2node</string>
		<string>--binary</string>
		<string>/Library/Application Support/K2/node/k2-node</string>
	</array>
	<key>UserName</key>
	<string>root</string>
	<key>Sockets</key>
	<dict>
		<key>Listener</key>
		<dict>
			<key>SockPathName</key>
			<string>/var/run/k2-node-admin.sock</string>
			<key>SockPathMode</key>
			<integer>432</integer>
			<key>SockPathOwner</key>
			<integer>0</integer>
			<key>SockPathGroup</key>
			<integer>399</integer>
		</dict>
	</dict>
	<key>Umask</key>
	<integer>63</integer>
	<key>WorkingDirectory</key>
	<string>/</string>
	<key>StandardErrorPath</key>
	<string>/Library/Logs/k2-node-admin.log</string>
</dict>
</plist>
