{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Body of `message_unpinned` (S13 gap G7).",
  "properties": {
    "channel_id": {
      "description": "The channel.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "message_id": {
      "description": "The unpinned message.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "seq": {
      "description": "The seq of the `pin_changed` change entry.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "channel_id",
    "message_id",
    "seq"
  ],
  "title": "MessageUnpinned",
  "type": "object"
}
