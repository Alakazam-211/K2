{
  "$defs": {
    "When": {
      "description": "\"At what time\": an absolute instant, a local wall-clock time in a named zone, or a delay.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "An absolute instant.",
          "properties": {
            "at": {
              "description": "RFC 3339 with `Z` or an offset.",
              "format": "date-time",
              "type": "string"
            },
            "kind": {
              "const": "at",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "at"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A local wall-clock time.",
          "properties": {
            "date_time": {
              "description": "`YYYY-MM-DDTHH:MM`, no seconds, no offset.",
              "type": "string"
            },
            "kind": {
              "const": "local",
              "type": "string"
            },
            "timezone": {
              "description": "An IANA zone name; absent means the member's profile zone, then UTC.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "date_time"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A delay from the request's clock time.",
          "properties": {
            "kind": {
              "const": "in",
              "type": "string"
            },
            "ms": {
              "description": "Milliseconds from now.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "ms"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Body of `POST /api/v1/reminders/{id}/snooze`.",
  "properties": {
    "when": {
      "$ref": "#/$defs/When",
      "description": "The new time."
    }
  },
  "required": [
    "when"
  ],
  "title": "SnoozeReminderRequest",
  "type": "object"
}
