{
  "$defs": {
    "MeetingState": {
      "description": "A meeting's state (§6.3).",
      "oneOf": [
        {
          "const": "scheduled",
          "description": "Not started; members may join from `starts_at` − 15 min.",
          "type": "string"
        },
        {
          "const": "live",
          "description": "Someone joined (or it was instant).",
          "type": "string"
        },
        {
          "const": "ended",
          "description": "Over; voice joins answer `410 meeting_ended`.",
          "type": "string"
        },
        {
          "const": "cancelled",
          "description": "Cancelled before it started.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Event `meeting_updated` as a link guest gets it (§6.5.4): only what a guest may see. Members\nget [`MeetingUpdated`] (its `meeting` key tells the two apart).",
  "properties": {
    "locked": {
      "description": "Locked (MC3).",
      "type": "boolean"
    },
    "meeting_id": {
      "description": "The meeting.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/MeetingState",
      "description": "Its state."
    }
  },
  "required": [
    "meeting_id",
    "state",
    "locked"
  ],
  "title": "MeetingGuestUpdated",
  "type": "object"
}
