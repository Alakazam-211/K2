{
  "$defs": {
    "InvalidReason": {
      "description": "Why a client asks to be re-added (K6; S50 §9.1, S51 §12.1).",
      "oneOf": [
        {
          "const": "commit_failed",
          "description": "A commit failed to process.",
          "type": "string"
        },
        {
          "const": "bad_commit",
          "description": "A commit failed the member-side checks.",
          "type": "string"
        },
        {
          "const": "bad_proposal",
          "description": "A proposal failed the member-side checks.",
          "type": "string"
        },
        {
          "const": "bad_welcome",
          "description": "A Welcome failed to process or check.",
          "type": "string"
        },
        {
          "const": "missed_epoch",
          "description": "An epoch was missed.",
          "type": "string"
        },
        {
          "const": "recovery_timeout",
          "description": "The recovery watchdog ran out.",
          "type": "string"
        },
        {
          "const": "behind",
          "description": "K3 answered `e2ee_epoch_behind`, or a `resync{behind}`.",
          "type": "string"
        },
        {
          "const": "state_lost",
          "description": "The client lost its MLS state.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "K6 body: re-add the caller's leaf with a fresh inline KeyPackage (one Replace commit).",
  "properties": {
    "epoch": {
      "description": "The client's epoch.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "gateway_session": {
      "description": "The caller's current gateway session, when it re-identified while holding no group\n(its Welcome went to the dead socket, or its join waited across a restart): the DS\nre-binds the join to it (§15.3; additive, KB).",
      "type": [
        "string",
        "null"
      ]
    },
    "group_id": {
      "description": "The group the client holds.",
      "pattern": "^[A-Za-z0-9_-]*$",
      "type": "string"
    },
    "join_id": {
      "description": "The caller's join id (kept by the new leaf).",
      "pattern": "^[0-9a-f]{32}$",
      "type": "string"
    },
    "key_package": {
      "description": "TLS `MLSMessage(KeyPackage)`: same member, device and scope as the leaf.",
      "pattern": "^[A-Za-z0-9_-]*$",
      "type": "string"
    },
    "reason": {
      "$ref": "#/$defs/InvalidReason",
      "description": "Why."
    }
  },
  "required": [
    "join_id",
    "group_id",
    "epoch",
    "reason",
    "key_package"
  ],
  "title": "KeyInvalidRequest",
  "type": "object"
}
