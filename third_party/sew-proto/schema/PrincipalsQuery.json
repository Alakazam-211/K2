{
  "$defs": {
    "MemberKind": {
      "description": "Whether a member is a person or an agent.",
      "oneOf": [
        {
          "const": "person",
          "description": "A human.",
          "type": "string"
        },
        {
          "const": "agent",
          "description": "A K2 agent.",
          "type": "string"
        }
      ]
    },
    "PrincipalsInclude": {
      "description": "`GET /mgmt/v1/principals?include=`.",
      "oneOf": [
        {
          "const": "link_guests",
          "description": "Meeting link guests (`link:*`, install role `link_guest`) too.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Query of `GET /mgmt/v1/principals` (S9 G5, contracts rev 17): pages by member id,\nascending.",
  "properties": {
    "after": {
      "description": "Members with an id above this one.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": [
        "string",
        "null"
      ]
    },
    "compliance": {
      "description": "Only compliance-flag holders (`true`) or only non-holders (`false`) (S23 §6.3, additive).",
      "type": [
        "boolean",
        "null"
      ]
    },
    "external_id": {
      "description": "Only this external id.",
      "maxLength": 128,
      "pattern": "^(k2:(principal|workspace|connect):[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|k2:owner|local:[a-z0-9_-]{2,64}|link:[1-9][0-9]{0,18}:[A-Z2-7]{16})$",
      "type": [
        "string",
        "null"
      ]
    },
    "include": {
      "anyOf": [
        {
          "$ref": "#/$defs/PrincipalsInclude"
        },
        {
          "type": "null"
        }
      ],
      "description": "`link_guests` also lists meeting link guests (`link:*` members), which are left out by\ndefault so K2's reconcile never sees them (Meet MC2a, CC7, K-M6)."
    },
    "include_deactivated": {
      "description": "Include deactivated members (default `true`).",
      "type": "boolean"
    },
    "kind": {
      "anyOf": [
        {
          "$ref": "#/$defs/MemberKind"
        },
        {
          "type": "null"
        }
      ],
      "description": "Only persons or only agents."
    },
    "limit": {
      "description": "Page size, 1–500 (default 100).",
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "username": {
      "description": "Only this handle (exact match).",
      "pattern": "^[a-z0-9_-]{2,64}$",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "title": "PrincipalsQuery",
  "type": "object"
}
