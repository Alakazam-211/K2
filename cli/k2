# ── Multi-heartbeat (agent_heartbeats) CRUD ────────────────────────────
# Parse frequency/day/time flags into spec JSON that matches the scheduler
# logic in should_project_fire.
#   --daily --time 07:00
#   --weekly --days mon,tue --time 07:00
#   --monthly --days 1,15 --time 07:00
#   --yearly --months jan,apr --days 1 --time 07:00
#   --hourly --every 30 --unit minutes --start 09:00 --end 17:00
hb_parse_spec() {
    local frequency=""
    local time=""
    local days=""
    local months=""
    local every=""
    local unit="minutes"
    local start=""
    local end=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --daily)   frequency="daily"; shift ;;
            --weekly)  frequency="weekly"; shift ;;
            --monthly) frequency="monthly"; shift ;;
            --yearly)  frequency="yearly"; shift ;;
            --hourly)  frequency="hourly"; shift ;;
            --time)    time="$2"; shift 2 ;;
            --days)    days="$2"; shift 2 ;;
            --months)  months="$2"; shift 2 ;;
            --every)   every="$2"; shift 2 ;;
            --unit)    unit="$2"; shift 2 ;;
            --start)   start="$2"; shift 2 ;;
            --end)     end="$2"; shift 2 ;;
            *)
                # GH#23/#24: unknown flags used to be silently swallowed,
                # so `--interval 1` / `--frequency hourly` typos produced
                # a default schedule with no hint anything was ignored.
                echo "Error: unknown schedule flag/token: $1" >&2
                echo "Spec: --daily|--weekly|--monthly|--yearly|--hourly [--time HH:MM] [--days ...] [--months ...] [--every N --unit minutes|hours] [--start HH:MM --end HH:MM]" >&2
                exit 2 ;;
        esac
    done
    [ -z "$frequency" ] && { echo "Error: must specify one of --daily/--weekly/--monthly/--yearly/--hourly" >&2; exit 1; }
    case "$unit" in
        minutes|hours) ;;
        *) echo "Error: --unit must be 'minutes' or 'hours' (got '$unit')" >&2; exit 2 ;;
    esac
    if [ -n "$every" ] && ! [[ "$every" =~ ^[0-9]+$ ]]; then
        echo "Error: --every must be a whole number (got '$every')" >&2; exit 2
    fi
    local t
    for t in "$time" "$start" "$end"; do
        if [ -n "$t" ] && ! [[ "$t" =~ ^([01][0-9]|2[0-3]|[0-9]):[0-5][0-9]$ ]]; then
            echo "Error: times must be HH:MM 24-hour (got '$t')" >&2; exit 2
        fi
    done
    # GH#27: day/month VALUES were stored unvalidated — `--weekly --days
    # foobar` persisted "days":["foobar"] and could never fire. Frequency
    # is known here, so validate per-frequency before the spec is built
    # (monthly/yearly take day-of-month numbers; everything else takes
    # 3-letter day names, matching the JSON builder below).
    local tok
    if [ -n "$days" ]; then
        case "$frequency" in
            monthly|yearly)
                for tok in $(printf '%s' "$days" | tr ',' ' '); do
                    if ! [[ "$tok" =~ ^[0-9]+$ ]] || [ "$tok" -lt 1 ] || [ "$tok" -gt 31 ]; then
                        echo "Error: --days for --$frequency takes day-of-month numbers 1-31 (got '$tok')" >&2; exit 2
                    fi
                done
                ;;
            *)
                for tok in $(printf '%s' "$days" | tr ',' ' '); do
                    case "$(printf '%s' "$tok" | tr '[:upper:]' '[:lower:]')" in
                        mon|tue|wed|thu|fri|sat|sun) ;;
                        *) echo "Error: --days for --$frequency takes a comma list of mon,tue,wed,thu,fri,sat,sun (got '$tok')" >&2; exit 2 ;;
                    esac
                done
                ;;
        esac
    fi
    if [ -n "$months" ]; then
        for tok in $(printf '%s' "$months" | tr ',' ' '); do
            case "$(printf '%s' "$tok" | tr '[:upper:]' '[:lower:]')" in
                jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec) ;;
                *) echo "Error: --months takes a comma list of jan,feb,mar,apr,may,jun,jul,aug,sep,oct,nov,dec (got '$tok')" >&2; exit 2 ;;
            esac
        done
    fi
    # Build JSON spec
    python3 -c "
import json
spec = {'frequency': '$frequency'}
if '$time': spec['time'] = '$time'
if '$days':
    d = '$days'.split(',')
    if '$frequency' in ('monthly','yearly'):
        spec['days_of_month'] = [int(x) for x in d if x.strip().isdigit()]
    else:
        spec['days'] = [x.strip().lower() for x in d]
if '$months': spec['months'] = [x.strip().lower() for x in '$months'.split(',')]
if '$every': spec['every_seconds'] = int('$every') * (60 if '$unit' == 'minutes' else 3600 if '$unit' == 'hours' else 1)
if '$start': spec['start'] = '$start'
if '$end': spec['end'] = '$end'
print(json.dumps(spec))
print('FREQ:' + '$frequency')
"
}

cmd_heartbeat_add() {
    # 0.40.41 (GH#23/#24): --instructions/--instructions-file wire the
    # WAKEUP.md at creation time. Before this, an agent had to create,
    # then separately edit a file — and `signal wakeup --edit` opens
    # $EDITOR, which is useless headless. A schedule could therefore
    # fire with no defined job.
    local name="" instructions="" instructions_file=""
    local spec_args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --name) name="$2"; shift 2 ;;
            --instructions) instructions="$2"; shift 2 ;;
            --instructions-file) instructions_file="$2"; shift 2 ;;
            *) spec_args+=("$1"); shift ;;
        esac
    done
    [ -z "$name" ] && { echo "Usage: k2 heartbeat schedule add --name <name> --daily|--weekly|... [--time HH:MM] [--days ...] [--instructions \"...\"|--instructions-file <path>]" >&2; exit 1; }
    if [ -n "$instructions_file" ]; then
        [ -f "$instructions_file" ] || { echo "Error: --instructions-file not found: $instructions_file" >&2; exit 1; }
        instructions="$(cat "$instructions_file")"
    fi
    local spec_output
    spec_output=$(hb_parse_spec ${spec_args[@]+"${spec_args[@]}"})
    local spec_json
    spec_json=$(echo "$spec_output" | head -1)
    local freq
    freq=$(echo "$spec_output" | grep '^FREQ:' | sed 's/^FREQ://')
    local params="name=$(urlencode "$name")&frequency=$freq&spec=$(urlencode "$spec_json")"
    local resp
    resp=$(cli_request "/cli/heartbeat/add" "$params")
    local wakeup_abs
    wakeup_abs=$(printf '%s' "$resp" | python3 -c "
import json, sys
try:
    d = json.loads(sys.stdin.read())
    if 'error' in d:
        print(f'Error: {d[\"error\"]}', file=sys.stderr); sys.exit(1)
    print(d.get('wakeupAbs') or '')
except SystemExit:
    raise
except Exception as e:
    print(f'Error: {e}', file=sys.stderr); sys.exit(1)
")
    echo "Created heartbeat: $name"
    [ -n "$wakeup_abs" ] && echo "Wakeup file: $wakeup_abs"
    echo
    if [ -n "$instructions" ] && [ -n "$wakeup_abs" ]; then
        printf '%s\n' "$instructions" > "$wakeup_abs"
        echo "Wake instructions written ($(printf '%s' "$instructions" | wc -c | tr -d ' ') bytes)."
    else
        echo "Edit the wakeup.md to define what runs on this schedule (or re-run with --instructions)."
    fi
    hb_warn_if_transport_down
}

# GH#23: heartbeats silently never fired when the schedule transport
# (launchd agent on macOS / crontab entry on Linux) wasn't installed or
# had stopped ticking. Warn loudly at create time instead of letting the
# user walk away from a heartbeat that can never fire. Best-effort —
# never fails the command it follows.
hb_warn_if_transport_down() {
    cli_request "/cli/heartbeat/scheduler-status" 2>/dev/null | python3 -c "
import json, sys
try:
    d = json.loads(sys.stdin.read())
except Exception:
    sys.exit(0)
installed = d.get('transportInstalled')
stale = d.get('staleSecs')
if installed is False:
    print('', file=sys.stderr)
    print('WARNING: no schedule transport is installed on this machine (launchd/cron).', file=sys.stderr)
    print('         This heartbeat will NOT fire until the daemon installs it —', file=sys.stderr)
    print('         check \`k2 daemon status\` and the Heartbeat Settings page.', file=sys.stderr)
elif stale is not None and stale > 900 and d.get('enabledCount', 0) > 0:
    print('', file=sys.stderr)
    print(f'WARNING: the heartbeat scheduler has not ticked for {stale // 60} minutes.', file=sys.stderr)
    print('         Scheduled fires are not being delivered — check \`k2 daemon status\`.', file=sys.stderr)
" || true
}

cmd_heartbeat_list() {
    # GH#27: --json dumps the raw daemon array (pass-through, no table);
    # --archived delegates to the archived listing (either flag order).
    local as_json=0 archived=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json)     as_json=1; shift ;;
            --archived) archived=1; shift ;;
            *) shift ;;
        esac
    done
    if [ "$archived" = "1" ]; then
        if [ "$as_json" = "1" ]; then
            cmd_heartbeat_list_archived --json
        else
            cmd_heartbeat_list_archived
        fi
        return
    fi
    if [ "$as_json" = "1" ]; then
        cli_request "/cli/heartbeat/list"
        return
    fi
    cli_request "/cli/heartbeat/list" | python3 -c "
import json, sys
try:
    rows = json.loads(sys.stdin.read())
    if isinstance(rows, dict):
        # Daemon error object, not a row list (e.g. unregistered
        # workspace, missing route on an older daemon) — GH#23 asked
        # for a real message here instead of a parser crash.
        print(f\"Error: {rows.get('error', rows)}\", file=sys.stderr)
        sys.exit(1)
    if not rows:
        print('No heartbeats configured for this workspace.'); sys.exit(0)
    print(f'{\"Name\":<20} {\"Frequency\":<10} {\"Schedule\":<30} {\"Last Fired\":<22} Enabled')
    print('-' * 100)
    for r in rows:
        spec = json.loads(r.get('specJson', '{}'))
        sched_parts = []
        if 'time' in spec: sched_parts.append(f'at {spec[\"time\"]}')
        if 'days' in spec: sched_parts.append(f'on {\", \".join(spec[\"days\"])}')
        if 'days_of_month' in spec: sched_parts.append(f'day(s) {\",\".join(str(d) for d in spec[\"days_of_month\"])}')
        if 'months' in spec: sched_parts.append(f'in {\",\".join(spec[\"months\"])}')
        # GH#27: hourly rows showed '-' — derive a human string from
        # every_seconds / start / end (e.g. 'every 30m, 09:00-17:00').
        if 'every_seconds' in spec:
            es = int(spec['every_seconds'])
            if es and es % 3600 == 0: every = f'{es // 3600}h'
            elif es and es % 60 == 0: every = f'{es // 60}m'
            else: every = f'{es}s'
            hourly = f'every {every}'
            if spec.get('start') or spec.get('end'):
                hourly += f\", {spec.get('start', '00:00')}-{spec.get('end', '23:59')}\"
            sched_parts.append(hourly)
        elif spec.get('start') or spec.get('end'):
            sched_parts.append(f\"{spec.get('start', '00:00')}-{spec.get('end', '23:59')}\")
        sched = ' '.join(sched_parts) or '-'
        last = (r.get('lastFired') or 'never')[:19].replace('T', ' ')
        en = 'yes' if r.get('enabled') else 'no'
        print(f'{r.get(\"name\",\"?\"):<20} {r.get(\"frequency\",\"?\"):<10} {sched:<30} {last:<22} {en}')
except Exception as e:
    print(f'Error: {e}', file=sys.stderr); sys.exit(1)
"
}

