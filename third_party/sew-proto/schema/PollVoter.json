{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One voter of a non-anonymous poll.",
  "properties": {
    "member_id": {
      "description": "The member.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "voted_at": {
      "description": "When they picked this option.",
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "member_id",
    "voted_at"
  ],
  "title": "PollVoter",
  "type": "object"
}
