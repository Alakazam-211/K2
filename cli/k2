#!/bin/bash
# K2 CLI — Agent interface to K2 workspace orchestration
# This script communicates with the K2 daemon via HTTP.
# Works inside K2 terminals (auto-configured) and external terminals
# (auto-discovers connection from ~/.k2/heartbeat.{port,token}).
#
# NOTE (0.40.4+): each workspace's dot-dir was renamed `.k2so/` -> `.k2/`.
# Inbox/skills/prds/agent now live under `<workspace>/.k2/`. This CLI resolves
# either layout (`.k2/` preferred, `.k2so/` fallback) via `_ws_dot_dir()`, so
# agents should read/write `<workspace>/.k2/...` going forward.

K2_CLI_VERSION="0.45.0"

set -euo pipefail

# Connection details (set by K2 when creating terminal sessions)
# Falls back to ~/.k2/heartbeat.{port,token} for external terminals
PORT="${K2_PORT:-${K2SO_PORT:-}}"
# LAN / remote daemon: override loopback. Default matches today's bind.
HOST="${K2_HOST:-127.0.0.1}"
TOKEN="${K2_HOOK_TOKEN:-${K2SO_HOOK_TOKEN:-}}"

# #58 Phase-1 close — capture the per-cell SCOPED token NOW, before any
# Open-tool disk-owner inversion (see _cli_apply_auth_for_verb) can clobber
# $TOKEN with the daemon owner token. The scoped token is what the per-cell
# UDS arm authenticates with (Bearer). For ID/locked tools we MUST keep this
# passport and never re-source ~/.k2/heartbeat.token (owner) — that COMPAT-58
# inversion is the agent elevation hole for ID verbs. Empty outside a scoped
# cell (the UDS arm is then skipped — see cli_send).
SCOPED_TOKEN="${K2_HOOK_TOKEN:-${K2SO_HOOK_TOKEN:-}}"
# Disk owner credential (if present). Used only for Open-tool TCP ergonomics
# and external (non-cell) terminals — never for ID/locked tools when a
# scoped session marker ($K2_HOOK_SOCK) is present.
DISK_OWNER_TOKEN=""

# Daemon home: ~/.k2 post-0.40 (the migration leaves ~/.k2so as a compat
# symlink, so either resolves to the same files — prefer the new name,
# fall back for a not-yet-migrated machine).
K2_HOME="${HOME}/.k2"
[ -d "$K2_HOME" ] || K2_HOME="${HOME}/.k2so"

# Air-gap: same polarity as k2_core::airgap (env wins; garbage → on;
# unset → persisted `airgap` in ~/.k2/settings.json; default off).
_k2_airgap_enabled() {
    if [ "${K2_AIRGAP+x}" = "x" ]; then
        case "$(printf '%s' "$K2_AIRGAP" | tr '[:upper:]' '[:lower:]')" in
            1|true|on|yes) return 0 ;;
            0|false|off|no) return 1 ;;
            *) return 0 ;;
        esac
    fi
    python3 -c '
import json, sys
try:
    with open(sys.argv[1]) as fh:
        v = json.load(fh).get("airgap")
except Exception:
    sys.exit(1)
sys.exit(0 if v is True else 1)
' "${K2_HOME}/settings.json" 2>/dev/null
}

_k2_refuse_if_airgap() {
    if _k2_airgap_enabled; then
        echo "Error: air-gap is on (K2_AIRGAP=1). This command cannot phone Connect, GitHub, or other hosted services." >&2
        exit 1
    fi
}

# Workspace dot-dir for a project root: .k2/ preferred when present,
# .k2so/ is the 0.x default (Q2 dual-compat; full flip lands pre-1.0.0).
_ws_dot_dir() {
    if [ -d "$1/.k2" ]; then echo "$1/.k2"; else echo "$1/.k2so"; fi
}

# One `note:` line about an address, on stderr (exit code unaffected).
# `_k2_addr_note old new [renamed]`: "is now" with `renamed` (a local
# rename; prd-thread-survives-tab-rename S5), "is" without (a synonym;
# prd-cli-addressing A7). Same name and shape as the CLI-addressing
# builder's helper (TR17), so the two branches print one way.
_k2_addr_note() {
    local old="$1" new="$2" how="${3:-}"
    if [ -z "$old" ] || [ -z "$new" ] || [ "$old" = "$new" ]; then
        return 0
    fi
    if [ "$how" = "renamed" ]; then
        echo "note: $old is now $new" >&2
    else
        echo "note: $old is $new" >&2
    fi
}

# The rename note when a daemon response carries `movedFrom` (+ `addr`).
_k2_moved_from_note() {
    local pair
    pair=$(printf '%s' "$1" | python3 -c 'import json,sys
try:
    d=json.load(sys.stdin)
except Exception:
    sys.exit(0)
if isinstance(d,dict) and d.get("movedFrom") and d.get("addr"):
    print("%s %s" % (d["movedFrom"], d["addr"]))' 2>/dev/null)
    [ -n "$pair" ] || return 0
    _k2_addr_note "${pair%% *}" "${pair#* }" renamed
}

# After a successful overlay write (not --json): first post, then every
# 10th. Agents forget Thread is markdown; help is not re-read. stderr
# so stdout stays the id/seq line. Best-effort — missing .k2 is a no-op.
_thread_md_nudge() {
    local root="${K2_PROJECT_PATH:-${K2SO_PROJECT_PATH:-${PROJECT:-$PWD}}}"
    local dot
    dot=$(_ws_dot_dir "$root")
    [ -d "$dot" ] || return 0
    local file="$dot/.thread-md-nudge"
    local n=0
    if [ -f "$file" ]; then
        n=$(tr -d '[:space:]' < "$file" 2>/dev/null || true)
    fi
    case "$n" in
        ''|*[!0-9]*) n=0 ;;
    esac
    n=$((n + 1))
    printf '%s\n' "$n" > "$file" 2>/dev/null || return 0
    if [ "$n" -eq 1 ] || [ $((n % 10)) -eq 0 ]; then
        echo "hint: Thread renders markdown — **bold**, lists, \`code\`, fences, links." >&2
    fi
}

# Same policy as k2_core::db::resolve_home_db_path.
# Stage A: prefer k2.db if it exists, else k2so.db.
# Both real files: pick the one with more live workspaces so a stub k2.db
# cannot hide k2so.db. Never create k2.db here. Stage B symlink k2so.db →
# k2.db is not a "both real" case.
_k2_home_db() {
    local new="$K2_HOME/k2.db"
    local old="$K2_HOME/k2so.db"
    if [ -f "$new" ] && [ ! -L "$new" ] && [ -f "$old" ] && [ ! -L "$old" ]; then
        local cn=0 co=0
        if command -v sqlite3 >/dev/null 2>&1; then
            cn=$(sqlite3 "$new" "SELECT count(*) FROM projects WHERE id NOT IN ('_orphan', '_broadcast');" 2>/dev/null || true)
            co=$(sqlite3 "$old" "SELECT count(*) FROM projects WHERE id NOT IN ('_orphan', '_broadcast');" 2>/dev/null || true)
        fi
        cn=$(( ${cn:-0} + 0 ))
        co=$(( ${co:-0} + 0 ))
        if [ "$co" -gt "$cn" ]; then
            echo "$old"
            return
        fi
        if [ "$cn" -gt "$co" ]; then
            echo "$new"
            return
        fi
        local ln=0 lo=0
        ln=$(wc -c < "$new" 2>/dev/null | tr -d '[:space:]')
        lo=$(wc -c < "$old" 2>/dev/null | tr -d '[:space:]')
        ln=$(( ${ln:-0} + 0 ))
        lo=$(( ${lo:-0} + 0 ))
        if [ "$lo" -gt $(( ln * 2 )) ] && [ "$lo" -gt 1000000 ]; then
            echo "$old"
            return
        fi
        if [ "$ln" -gt $(( lo * 2 )) ] && [ "$ln" -gt 1000000 ]; then
            echo "$new"
            return
        fi
        echo "$old"
        return
    fi
    if [ -e "$new" ]; then
        echo "$new"
    else
        echo "$old"
    fi
}

# Resolve project root: if K2_PROJECT_PATH is set, use it directly.
# Otherwise walk up from CWD to find a .k2/ or .k2so/ directory, skipping $HOME.
# Also handles git worktrees: if CWD is inside a worktree, resolve back to
# the main repo root where the workspace dot-dir lives.
PROJECT="${K2_PROJECT_PATH:-${K2SO_PROJECT_PATH:-$(pwd)}}"
if [ -z "${K2_PROJECT_PATH:-${K2SO_PROJECT_PATH:-}}" ]; then
    _dir="$(pwd)"
    _found=""
    while [ "$_dir" != "/" ]; do
        if { [ -d "$_dir/.k2so" ] || [ -d "$_dir/.k2" ]; } && [ "$_dir" != "$HOME" ]; then
            _found="$_dir"
            break
        fi
        _dir="$(dirname "$_dir")"
    done
    if [ -z "$_found" ]; then
        # May be inside a git worktree — resolve to main repo root.
        # `|| true` is REQUIRED: from a non-git CWD, `git rev-parse` exits 128,
        # and under `set -euo pipefail` that failing command substitution would
        # abort the entire script before it ever reads the daemon port — a
        # silent exit 128 (GH #16). Swallow it so a non-git CWD just leaves
        # _main_root empty and we fall back to $PWD as PROJECT.
        _main_root=$(git -C "$(pwd)" rev-parse --path-format=absolute --git-common-dir 2>/dev/null | sed 's|/.git$||' || true)
        if [ -n "$_main_root" ] && { [ -d "$_main_root/.k2so" ] || [ -d "$_main_root/.k2" ]; }; then
            _found="$_main_root"
        fi
    fi
    PROJECT="${_found:-$PROJECT}"
    unset _dir _found _main_root
fi

# 0.40.4 cutover heads-up — git-derived + self-clearing. While the
# `.k2so/` -> `.k2/` rename is uncommitted, `git ls-files .k2so` still lists
# the (now-deleted-on-disk) tracked files; once the user commits the rename it
# returns nothing and this goes silent. `|| true` guards the git call from
# aborting the script in a non-git CWD (GH#16). stderr only — never pollutes
# command stdout / JSON.
if [ -d "$PROJECT/.k2" ] && [ ! -d "$PROJECT/.k2so" ]; then
    _k2so_pending=$(git -C "$PROJECT" ls-files .k2so 2>/dev/null | head -1 || true)
    if [ -n "$_k2so_pending" ]; then
        echo "i  K2 0.40.4 renamed this workspace's .k2so/ -> .k2/ (harness symlinks + .gitignore updated). Commit the rename when ready — git tracks it as renames." >&2
    fi
    unset _k2so_pending
fi

# Auto-discover connection from the daemon home if not in a K2 terminal.
# Always capture DISK_OWNER_TOKEN when readable so Open tools can still do
# the COMPAT-58 TCP inversion; never *apply* that inversion here — ID/locked
# tools must not inherit the owner credential just because $K2_HOOK_SOCK is set.
if [ -f "${K2_HOME}/heartbeat.port" ]; then
    PORT="${PORT:-$(cat "${K2_HOME}/heartbeat.port" 2>/dev/null)}"
fi
if [ -r "${K2_HOME}/heartbeat.token" ]; then
    DISK_OWNER_TOKEN="$(cat "${K2_HOME}/heartbeat.token" 2>/dev/null)"
fi
# Fresh headless boxes always get daemon.token; heartbeat.token is the
# same secret written alongside. Prefer heartbeat (CLI convention) but
# accept daemon.token so external owner ops work when only one is present.
if [ -z "$DISK_OWNER_TOKEN" ] && [ -r "${K2_HOME}/daemon.token" ]; then
    DISK_OWNER_TOKEN="$(cat "${K2_HOME}/daemon.token" 2>/dev/null)"
fi
if [ -z "$TOKEN" ] && [ -n "$DISK_OWNER_TOKEN" ]; then
    TOKEN="$DISK_OWNER_TOKEN"
fi

# ── CLI Tools identity policy (mirrors crates/k2-core cli_tool_policy) ──
# Static catalog defaults for the bash CLI (daemon overrides live in
# Settings → CLI Tools; locked tools cannot be Open). Pure helpers below
# are unit-testable via the BEGIN/END markers (see tests/cli/).
# BEGIN_CLI_TOOL_POLICY

# Map a top-level `k2 <verb>` to a catalog tool id (empty = ungoverned).
_cli_tool_id_for_verb() {
    case "${1:-}" in
        help|--help|-h|glossary|help-deprecated|help-internal|help-advanced) echo "help" ;;
        --schema|schema) echo "schema" ;;
        study) echo "study" ;;
        whats-new|whatsnew) echo "whats-new" ;;
        checkin|done|status) echo "checkin" ;;
        activity|feed) echo "activity" ;;
        read) echo "read" ;;
        skills) echo "skills" ;;
        msg|talk|thread) echo "msg" ;;
        inbox) echo "inbox" ;;
        wiki) echo "wiki" ;;
        respond) echo "respond" ;;
        connections|reserve|release|roster|who) echo "connections" ;;
        # k2 sidecar v1 (SC35): an `id` tool, so inside a K2 terminal the
        # daemon sees the session's passport, never the owner token.
        sidecar) echo "sidecar" ;;
        # LLM tokens (`k2 llm tokens`, alias `accounts`): an `id` tool, so inside a K2
        # terminal the daemon sees the session passport (read-only there).
        llm) echo "llm-accounts" ;;
        heartbeat) echo "heartbeat" ;;
        mail|hostmail) echo "mail" ;;
        # Calendars S3 (CAL23.4, security): `k2 calendar` rides the mail
        # tool id. Unmapped verbs are "open" and re-source the OWNER token
        # in a scoped cell, which would bypass every k2 mail access grant.
        calendar|cal) echo "mail" ;;
        db) echo "db" ;;
        store) echo "store" ;;
        dns) echo "dns" ;;
        # Custom-domain inventory + certs share the locked dns tool id
        # (prd-custom-domains A10). Unknown verbs elevate as Open.
        domain|cert) echo "dns" ;;
        publish) echo "publish" ;;
        # Headless Connect account pairing (login/status/logout). Distinct
        # from publish (nested-subdomain control plane) so login is not
        # always attributed as the publish tool.
        connect) echo "connect-account" ;;
        sessions|terminal) echo "sessions-spawn" ;;
        fs) echo "fs" ;;
        daemon) echo "daemon-admin" ;;
        users) echo "users-admin" ;;
        api-key) echo "api-key" ;;
        app|skin|skin-token) echo "skin" ;;
        # Remote Session owner/admin surface (Layer 0 + grants + shell PTY).
        # Locked id: cannot Open; needs owner/admin or grant token server-side.
        remote-session) echo "remote-session" ;;
        settings) echo "settings" ;;
        browser) echo "browser-open" ;;
        *) echo "" ;;
    esac
}

# Default identity mode for a tool id: open | id.
# Locked production tools are always id (cannot be Open in the catalog).
_cli_tool_default_mode() {
    case "${1:-}" in
        help|schema|whats-new|checkin|activity|read|skills|wiki|tools-policy|study|"") echo "open" ;;
        msg|inbox|respond|awareness|connections|heartbeat|sidecar) echo "id" ;;
        mail|db|store|dns|publish|connect-account|sessions-spawn|fs|daemon-admin|users-admin|api-key|skin|remote-session) echo "id" ;;
        browser-open|settings|llm-accounts) echo "id" ;;
        *) echo "open" ;;
    esac
}

# True when the tool is a locked production floor (cannot be set Open).
_cli_tool_is_locked() {
    case "${1:-}" in
        mail|db|store|dns|publish|connect-account|sessions-spawn|fs|daemon-admin|users-admin|api-key|skin|remote-session|llm-accounts) return 0 ;;
        *) return 1 ;;
    esac
}

# Teaching error when an ID/locked verb has no session passport in-cell.
_cli_require_session_passport() {
    local tool_id="${1:-unknown}"
    echo "Error: tool '${tool_id}' requires session ID (passport)." >&2
    echo "Run from a K2 agent session that carries session identity, or ask the owner" >&2
    echo "to set this tool to Open in Settings → CLI Tools (if the platform allows)." >&2
    echo "Locked production tools cannot be set Open." >&2
    exit 3
}

# COMPAT-58 disk-token inversion — CONDITIONAL on tool mode.
# When K2_HOOK_SCOPED is on, the daemon injects a per-cell SCOPED token behind
# $K2_HOOK_TOKEN and the per-cell socket behind $K2_HOOK_SOCK.
#
#   Open tools  — re-source DISK OWNER for the TCP arm (migration ergonomics;
#                 scoped credentials still 403 on many owner-only TCP routes).
#   ID / locked — MUST NOT re-source ~/.k2/heartbeat.token. Keep SCOPED_TOKEN
#                 only; prefer per-cell UDS. No passport → exit 3.
#
# Outside a scoped cell (no $K2_HOOK_SOCK), disk owner discovery above is the
# human/external-terminal path and remains valid Owner proof for ID tools.
_cli_apply_auth_for_verb() {
    local verb="${1:-}"
    local tool_id mode
    tool_id="$(_cli_tool_id_for_verb "$verb")"
    mode="$(_cli_tool_default_mode "$tool_id")"
    local hook_sock="${K2_HOOK_SOCK:-${K2SO_HOOK_SOCK:-}}"

    if [ "$mode" = "id" ]; then
        if [ -n "$hook_sock" ]; then
            # In-cell / scoped-session marker: never elevate to disk owner.
            if [ -z "$SCOPED_TOKEN" ]; then
                _cli_require_session_passport "${tool_id:-$verb}"
            fi
            TOKEN="$SCOPED_TOKEN"
        fi
        # No hook sock → TOKEN already owner (external) or env; Owner OK for ID.
    else
        # Open / ungoverned: keep COMPAT-58 inversion for TCP ergonomics.
        if [ -n "$hook_sock" ] && [ -n "${DISK_OWNER_TOKEN:-}" ]; then
            TOKEN="$DISK_OWNER_TOKEN"
        fi
    fi
}

# END_CLI_TOOL_POLICY

# BEGIN_CLI_CURL_CFG
# Credentials never ride curl's argv (0.45.1). Every process's argv is
# readable by every other OS user (`ps`), so the owner token, a session
# passport, a Connect bearer and secret bodies (passwords, API keys) go
# to curl as a config read from stdin (`curl -K -`). The `printf` builtin
# writes it: no exec, no argv, no temp file, no /dev/fd. Works with the
# macOS system curl and Linux curl 7.68+ (Ubuntu 20.04), bash 3.2+.
# Wire bytes are unchanged: `?token=` stays in the query, only the way
# curl learns the URL / header / body moved.

# _k2_cq VALUE — set _K2_CQ to VALUE as a double-quoted curl config string
# (\ and " escaped, newline → \n; curl's config parser undoes exactly
# that). Plain values (tokens, urlencoded params) never fork. Values that
# need escaping go through sed: bash 3.2's ${s//x/y} is quadratic.
_k2_cq() {
    local s="$1"
    if [[ "$s" == *\\* || "$s" == *\"* || "$s" == *$'\n'* ]]; then
        # Sentinel `x` keeps a trailing newline (sed/$(…) would drop it).
        s="$(printf '%sx' "$s" | LC_ALL=C sed -e 's/[\\"]/\\&/g' -e '$!s/$/\\n/' | LC_ALL=C tr -d '\n')"
        s="${s%x}"
    fi
    _K2_CQ="\"${s}\""
}

# _k2_cfg_add NAME VALUE — append `NAME = "VALUE"` to the caller's
# `local _K2_CFG` (bash dynamic scope; no subshell).
_k2_cfg_add() {
    _k2_cq "$2"
    _K2_CFG="${_K2_CFG}${1} = ${_K2_CQ}"$'\n'
}

# _k2_curl CFG curl-args… — run curl with CFG (config lines) on stdin.
# CFG empty → plain curl. The caller's stdin is NOT available to curl.
_k2_curl() {
    local cfg="$1"; shift
    if [ -z "$cfg" ]; then
        curl "$@"
        return
    fi
    printf '%s' "$cfg" | curl -K - "$@"
}
# END_CLI_CURL_CFG

# BEGIN_CLI_STALE_PASSPORT
# Codex 0.155+ runs every interactive session's tool commands under ONE
# shared, detached app-server per CODEX_HOME (`codex app-server --listen
# unix://`, parent pid 1). That server keeps the env of whichever K2 session
# started it, so the passport a Codex tool sees ($K2_HOOK_SOCK +
# $K2_HOOK_TOKEN) can be another tab's or a dead one. K2 now launches Codex
# with --no-daemon; these checks catch tabs started before that, and say so
# instead of a bare 401. They never fall back to the owner token.

# stdin: `ps -axo pid=,ppid=,command=` rows. Succeeds when the ancestry of
# pid $1 includes a shared Codex app-server (unix listener, managed daemon,
# or detached to pid 1). A private in-process / stdio server never matches.
_cli_ancestry_has_shared_codex_server() {
    awk -v start="${1:-}" '
        {
            pid = $1; ppid = $2
            $1 = ""; $2 = ""
            sub(/^ +/, "")
            parent[pid] = ppid
            cmd[pid] = $0
        }
        END {
            p = start; n = 0; found = 0
            while (p != "" && (p + 0) > 1 && n < 64) {
                c = cmd[p]
                if (c ~ /codex/ && c ~ /app-server/ &&
                    (c ~ /--listen[ =]unix/ || c ~ /--managed-daemon/ ||
                     c ~ /app-server daemon/ || parent[p] == 1)) {
                    found = 1
                    break
                }
                p = parent[p]; n++
            }
            exit(found ? 0 : 1)
        }'
}

# True when this process runs under a shared Codex app-server. Only looks
# when a CODEX_* var is exported (Codex sets CODEX_THREAD_ID on tool runs).
_cli_under_shared_codex_server() {
    [ -n "$(compgen -e CODEX_ 2>/dev/null)" ] || return 1
    command -v ps >/dev/null 2>&1 || return 1
    ps -axo pid=,ppid=,command= 2>/dev/null | _cli_ancestry_has_shared_codex_server "$$"
}

# One loopback probe with the SCOPED token: true only when the daemon
# answers with its auth refusal (the token names no live session).
_cli_scoped_token_rejected() {
    [ -n "${SCOPED_TOKEN:-}" ] && [ -n "${BASE_URL:-}" ] || return 1
    local out _K2_CFG=""
    _k2_cfg_add header "Authorization: Bearer ${SCOPED_TOKEN}"
    out="$(_k2_curl "$_K2_CFG" -s --connect-timeout 3 --max-time 5 \
        "${BASE_URL}/cli/whoami" 2>/dev/null)" || return 1
    [[ "$out" == *"Invalid or missing auth token"* ]]
}

_cli_passport_stale_die() {
    local why="$1" sock="$2"
    case "$why" in
        codex_shared)
            echo "Error: this tool runs under a shared Codex app-server started by another session," >&2
            echo "so the K2 session credentials it sees are not this tab's (or no longer exist)." >&2
            echo "Restart Codex in this tab; K2 now starts Codex without the shared server (--no-daemon)." >&2
            echo "If it keeps happening, stop the shared server once: codex app-server daemon stop" >&2
            ;;
        *)
            echo "Error: this shell's K2 session credentials are stale: the session socket is gone" >&2
            echo "(${sock}) and the daemon rejects the session token." >&2
            echo "If this is a Codex tab, the tool runs under a shared Codex app-server started by" >&2
            echo "another session; restart Codex in this tab. Otherwise restart this tab." >&2
            ;;
    esac
    exit 3
}

# Before an ID/locked verb in a scoped cell: refuse a passport that is not
# this session's (shared Codex app-server) or that is dead (socket gone AND
# the daemon rejects the token). A missing socket alone is not enough — a
# failed socket bind still serves the scoped token over TCP.
_cli_check_session_passport() {
    local verb="${1:-}"
    local hook_sock="${K2_HOOK_SOCK:-${K2SO_HOOK_SOCK:-}}"
    [ -n "$hook_sock" ] || return 0
    local tool_id mode
    tool_id="$(_cli_tool_id_for_verb "$verb")"
    mode="$(_cli_tool_default_mode "$tool_id")"
    [ "$mode" = "id" ] || return 0
    if _cli_under_shared_codex_server; then
        _cli_passport_stale_die codex_shared "$hook_sock"
    fi
    if [ ! -S "$hook_sock" ] && _cli_scoped_token_rejected; then
        _cli_passport_stale_die stale "$hook_sock"
    fi
    return 0
}
# END_CLI_STALE_PASSPORT

# DAEMON_INSTALL_EARLY_BYPASS — `k2 daemon install` provisions the
# standalone daemon on a FRESH headless box where no daemon is running
# yet, so it cannot satisfy the PORT/TOKEN connection gate below (and
# doesn't need to: it talks only to GitHub + the filesystem). Skip the
# connection gate for it; the normal router dispatches it to
# cmd_daemon_install (which is defined before the router runs).
_skip_conn_gate=0
[ "${1:-}" = "daemon" ] && [ "${2:-}" = "install" ] && _skip_conn_gate=1
# `k2 publish` P15 — split the connection gate.
# Skip only plan/CP verbs that talk to connect.k2.dev + tunnel.json
# (or print help) and do not need the workspace daemon:
#   publish (no sub / help), publish status, publish subdomain list
#   (empty action = list).
# Never skip hosting verbs: run | ps | start | stop | rm | logs.
# create/point/rm/claim/unclaim POST the local daemon (stamp) — leave
# the gate on so they fail loud without PORT/TOKEN.
if [ "${1:-}" = "publish" ]; then
    case "${2:-}" in
        ""|help|--help|-h|status)
            _skip_conn_gate=1
            ;;
        subdomain)
            case "${3:-}" in
                # create/point/rm stamp 0074 on the daemon — need PORT/TOKEN.
                # list (empty action) and help still skip.
                claim|unclaim|create|point|rm|remove|delete) ;;
                *) _skip_conn_gate=1 ;;
            esac
            ;;
    esac
fi
# Headless Connect account commands: login talks to Supabase first
# (no daemon needed for the account step); status/logout can run from
# disk alone. Daemon-touching steps (tunnel/config + start) check
# PORT/TOKEN themselves and fail loud with a start-daemon hint.
[ "${1:-}" = "connect" ] && _skip_conn_gate=1
# Air-gap: refuse hosted-network verbs before any curl/GitHub, even
# without a running daemon (fresh image). --help still prints.
_k2_cli_wants_help=0
for _a in "$@"; do
    case "$_a" in -h|--help) _k2_cli_wants_help=1 ;; esac
done
if [ "$_k2_cli_wants_help" != "1" ]; then
    case "${1:-}" in
        connect)
            case "${2:-}" in login) _k2_refuse_if_airgap ;; esac
            ;;
        publish)
            if [ "${2:-}" = "subdomain" ]; then
                case "${3:-}" in
                    claim|unclaim) ;;
                    *) _k2_refuse_if_airgap ;;
                esac
            fi
            ;;
        daemon)
            [ "${2:-}" = "install" ] && _k2_refuse_if_airgap
            ;;
        tunnel)
            [ "${2:-}" = "enable" ] && _k2_refuse_if_airgap
            ;;
    esac
fi
unset _k2_cli_wants_help
# `k2 --schema` (GH#8 #4) prints a STATIC command-surface manifest — it
# talks to nothing, so it must work even with no daemon running (its whole
# point is letting an agent load the CLI surface in one call).
[ "${1:-}" = "--schema" ] && _skip_conn_gate=1
[ "${1:-}" = "schema" ] && _skip_conn_gate=1
# `k2 study` prints static in-CLI pages (same skip as --schema). Live
# unknown verbs never skip PORT/TOKEN. `k2 help` is not daemon-optional.
[ "${1:-}" = "study" ] && _skip_conn_gate=1
# `k2 zen guide` is static pages, and `k2 zen` / `k2 zen help` / any
# `k2 zen ... --help` only print help (prd-zen-freeform-chrome FC55):
# none of them talks to the daemon. Neither does `k2 zen widget grant`,
# which only says who grants (prd-zen-user-widgets-v2 UW41).
if [ "${1:-}" = "zen" ]; then
    case "${2:-}" in
        ""|guide|help|--help|-h) _skip_conn_gate=1 ;;
        widget|widgets)
            case "${3:-}" in grant|allow|""|help) _skip_conn_gate=1 ;; esac
            for _a in "${@:2}"; do
                case "$_a" in -h|--help) _skip_conn_gate=1 ;; esac
            done
            ;;
        *)
            for _a in "${@:2}"; do
                case "$_a" in -h|--help) _skip_conn_gate=1 ;; esac
            done
            ;;
    esac
fi
# `k2 sidecar` / `k2 sidecar --help` print help; `k2 sessions spawn` is
# retired and only prints where it moved. Neither talks to the daemon.
if [ "${1:-}" = "sidecar" ]; then
    case "${2:-}" in
        ""|help|--help|-h) _skip_conn_gate=1 ;;
        *)
            for _a in "${@:2}"; do
                case "$_a" in -h|--help) _skip_conn_gate=1 ;; esac
            done
            ;;
    esac
fi
[ "${1:-}" = "sessions" ] && [ "${2:-}" = "spawn" ] && _skip_conn_gate=1
# `k2 llm` / `k2 llm tokens` (alias `accounts`) / any `--help` only print help.
if [ "${1:-}" = "llm" ]; then
    case "${2:-}" in
        ""|help|--help|-h) _skip_conn_gate=1 ;;
        tokens|token|accounts|account)
            case "${3:-}" in ""|help|--help|-h) _skip_conn_gate=1 ;; esac
            for _a in "${@:3}"; do
                case "$_a" in -h|--help) _skip_conn_gate=1 ;; esac
            done
            ;;
    esac
fi
# `k2 tickets template` prints the static brief skeleton (H42).
case "${1:-}" in
    tickets|feedback) [ "${2:-}" = "template" ] && _skip_conn_gate=1 ;;
esac

if [ "$_skip_conn_gate" != "1" ] && { [ -z "$PORT" ] || [ -z "$TOKEN" ]; }; then
    echo "Error: Cannot connect to K2." >&2
    echo "Either run this from a K2 terminal, or ensure K2 is running." >&2
    echo "(Connection details: ~/.k2/heartbeat.port and ~/.k2/heartbeat.token)" >&2
    exit 1
fi
unset _skip_conn_gate

BASE_URL="http://${HOST}:${PORT}"

# HTTP helper
# 75 = local_transport_denied (unused by curl 8.x). Survives $(cli_request)
# subshells; curl 7 / connection refused stay daemon_unreachable.
_CLI_LOCAL_TRANSPORT_DENIED=75

# True when curl/OS failure is a local restriction (daemon health unobserved).
_cli_transport_is_denied() {
    local rc="$1" err="$2"
    if [[ "$err" == *[Cc]onnection\ refused* ]]; then
        return 1
    fi
    if [[ "$err" == *[Oo]peration\ not\ permitted* || "$err" == *EPERM* \
       || "$err" == *[Pp]ermission\ denied* || "$err" == *EACCES* ]]; then
        return 0
    fi
    if [[ "$err" == *Address\ family\ not\ supported* \
       || "$err" == *Protocol\ family\ not\ supported* ]]; then
        return 0
    fi
    if [[ "$err" == *"::1"* && ( "$err" == *Network\ is\ unreachable* \
       || "$err" == *No\ route\ to\ host* ) ]]; then
        return 0
    fi
    if [[ "$err" == *temporary\ file* || "$err" == *temp\ file* || "$err" == *TMPDIR* ]]; then
        return 0
    fi
    if [ "$rc" -ne 0 ]; then
        local td="${TMPDIR:-/tmp}"
        if [ ! -d "$td" ] || [ ! -w "$td" ]; then
            return 0
        fi
    fi
    return 1
}

# Body on stdout. -v so modern curl's OS errno (EPERM vs refused) is visible.
# `{ } 4>&1` + `1>&4` keeps the body on this function's stdout (so
# `resp=$(cli_request …)` works); stderr is classified, never printed.
# A leading `--k2-cfg CFG` hands curl secret config lines on stdin (_k2_curl).
_cli_curl() {
    local err rc=1 cfg=""
    if [ "${1:-}" = "--k2-cfg" ]; then
        cfg="$2"
        shift 2
    fi
    local _had_e=0
    case $- in *e*) _had_e=1; set +e ;; esac
    {
        err=$(_k2_curl "$cfg" "$@" 2>&1 1>&4)
        rc=$?
    } 4>&1
    [ "$_had_e" -eq 1 ] && set -e
    if [ "$rc" -eq 0 ]; then
        return 0
    fi
    if _cli_transport_is_denied "$rc" "$err"; then
        return "$_CLI_LOCAL_TRANSPORT_DENIED"
    fi
    return "$rc"
}

cli_request() {
    local endpoint="$1"
    shift
    local params="token=${TOKEN}&project=$(urlencode "$PROJECT")"
    for param in "$@"; do
        params="${params}&${param}"
    done
    local _K2_CFG=""
    _k2_cfg_add data "$params"
    _cli_curl --k2-cfg "$_K2_CFG" -sS -v -G "${BASE_URL}${endpoint}" \
        --connect-timeout 5 --max-time 30
}

# 0.44.4 — POST twin of cli_request for routes that change state (the
# daemon answers GET with 405 on them). Same contract: pre-urlencoded
# `key=value` args ride the query string, the body is empty, and transport
# errors classify exactly like cli_request (_cli_curl).
#
# A pre-0.44.4 daemon (e.g. a remote host via `--host`) only routes these
# paths as GET and answers the POST with its top-level
# `method not allowed for this route` 405 before any handler runs, so the
# same request is replayed once as GET there (side-effect safe).
cli_request_post() {
    local endpoint="$1"
    shift
    local params="token=${TOKEN}&project=$(urlencode "$PROJECT")"
    for param in "$@"; do
        params="${params}&${param}"
    done
    local out rc=0 _K2_CFG=""
    _k2_cfg_add url "${BASE_URL}${endpoint}?${params}"
    out="$(_cli_curl --k2-cfg "$_K2_CFG" -sS -v -X POST \
        --connect-timeout 5 --max-time 30 \
        --data-raw "")" || rc=$?
    if [ "$rc" -eq 0 ] && [[ "$out" == *'method not allowed for this route'* ]]; then
        cli_request "$endpoint" "$@"
        return $?
    fi
    printf '%s' "$out"
    return "$rc"
}

# UDS twin of cli_request_post (cli_send picks `<fn>_uds`).
cli_request_post_uds() {
    local endpoint="$1"; shift
    local params=""
    for param in "$@"; do params="${params}${params:+&}${param}"; done
    local _K2_CFG=""
    _k2_cfg_add header "Authorization: Bearer ${SCOPED_TOKEN}"
    _cli_curl --k2-cfg "$_K2_CFG" -sS -v -X POST --unix-socket "$(_hook_sock)" "http://localhost${endpoint}${params:+?${params}}" \
        --connect-timeout 5 --max-time 30 \
        --data-raw ""
}

# POST a JSON body. Used by /cli/awareness/publish (Phase 3).
# Token rides in the query string (the daemon parses it there
# before looking at the body). Caller supplies the full endpoint
# and the JSON body on stdin via a pipe, or as the second arg.
cli_post_json() {
    local endpoint="$1"
    local body="${2:-}"
    if [ -z "$body" ]; then
        body="$(cat)"
    fi
    # Bodies carry passwords (k2 users add, k2 app user password): config too.
    local _K2_CFG=""
    _k2_cfg_add url "${BASE_URL}${endpoint}?token=${TOKEN}"
    _k2_cfg_add data-raw "$body"
    _k2_curl "$_K2_CFG" -s -X POST \
        --connect-timeout 5 --max-time 30 \
        -H "Content-Type: application/json" 2>/dev/null
}

urlencode() {
    python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1], safe=''))" "$1" 2>/dev/null || echo "$1"
}

# 0.40.24 (B4): true when any argument is --help/-h. Used to intercept
# help requests on every workspace/connections/agent subcommand BEFORE
# the args reach a handler — `k2 workspace create --help` used to
# literally mkdir + register a workspace named `--help`.
_wants_help() {
    local a
    for a in "$@"; do
        case "$a" in
            --help|-h) return 0 ;;
        esac
    done
    return 1
}

# POST a form-encoded body (0.39.45, GH #35/#37/#29). Token + project
# ride the query string (the daemon's auth gate parses the query);
# everything else — message text, inbox title/body — rides the POST
# body so long payloads dodge the daemon's 16KB request-head cap that
# used to silently truncate query-string values at ~2.7KB. Callers pass
# pre-urlencoded `key=value` pairs, same contract as cli_request.
cli_post_form() {
    local endpoint="$1"
    shift
    local body=""
    for param in "$@"; do
        body="${body}${body:+&}${param}"
    done
    local _K2_CFG=""
    _k2_cfg_add url "${BASE_URL}${endpoint}?token=${TOKEN}&project=$(urlencode "$PROJECT")"
    _k2_cfg_add data-raw "$body"
    _k2_curl "$_K2_CFG" -s -X POST \
        --connect-timeout 5 --max-time 30 \
        -H "Content-Type: application/x-www-form-urlencoded" 2>/dev/null
}

# ── #58 Phase-1 close: scoped per-cell UDS arms ──────────────────────────
# These mirror cli_request / cli_post_form / cli_post_json but talk over the
# per-cell Unix socket ($K2_HOOK_SOCK) with the SCOPED token as a Bearer
# header. They deliberately OMIT `token=` (Bearer instead) and `project=` /
# `from=` (the daemon stamps the sender identity + the agent's own-workspace
# path SERVER-SIDE from the socket-bound principal — the body is never
# trusted for identity). Recipient/routing args (`workspace=`, inbox `id=`,
# etc.) are passed through by the caller exactly as for the TCP arms.
_hook_sock() { echo "${K2_HOOK_SOCK:-${K2SO_HOOK_SOCK:-}}"; }

cli_request_uds() {
    local endpoint="$1"; shift
    local params=""
    for param in "$@"; do params="${params}${params:+&}${param}"; done
    local _K2_CFG=""
    _k2_cfg_add header "Authorization: Bearer ${SCOPED_TOKEN}"
    if [ -n "$params" ]; then
        _k2_cfg_add data "$params"
    fi
    _cli_curl --k2-cfg "$_K2_CFG" -sS -v -G --unix-socket "$(_hook_sock)" "http://localhost${endpoint}" \
        --connect-timeout 5 --max-time 30
}

cli_post_form_uds() {
    local endpoint="$1"; shift
    local body=""
    for param in "$@"; do body="${body}${body:+&}${param}"; done
    local _K2_CFG=""
    _k2_cfg_add header "Authorization: Bearer ${SCOPED_TOKEN}"
    _k2_cfg_add data-raw "$body"
    _k2_curl "$_K2_CFG" -s -X POST --unix-socket "$(_hook_sock)" "http://localhost${endpoint}" \
        --connect-timeout 5 --max-time 30 \
        -H "Content-Type: application/x-www-form-urlencoded" 2>/dev/null
}

cli_post_json_uds() {
    local endpoint="$1"
    local body="${2:-}"
    if [ -z "$body" ]; then body="$(cat)"; fi
    local _K2_CFG=""
    _k2_cfg_add header "Authorization: Bearer ${SCOPED_TOKEN}"
    _k2_cfg_add data-raw "$body"
    _k2_curl "$_K2_CFG" -s -X POST --unix-socket "$(_hook_sock)" "http://localhost${endpoint}" \
        --connect-timeout 5 --max-time 30 \
        -H "Content-Type: application/json" 2>/dev/null
}

# Verbs the scoped per-cell socket actually serves (the daemon allowlist).
# Anything else stays on TCP+owner.
_uds_eligible() {
    case "$1" in
        /cli/workspace/msg|/cli/awareness/publish) return 0 ;;
        # C2: peer-gated live terminal peek (k2 read <ws>).
        /cli/terminal/read) return 0 ;;
        /cli/inbox/*|/cli/review-checklist/*) return 0 ;;
        # DNS K1 — cell_server serves /cli/dns/* POSTs + is_agent_verb GETs.
        /cli/dns/*) return 0 ;;
        # Custom domains: GET list + hostname add/remove + certs are
        # agent verbs (dns_manage). Apex attach/remove stay TCP owner.
        /cli/domains|/cli/domains/names|/cli/domains/names/remove|/cli/certs|/cli/certs/*) return 0 ;;
        # Publish hosted services — /cli/publish/* (agent verb, not /cli/tunnel/).
        /cli/publish/*) return 0 ;;
        # C1 — connections list/add/remove (mutate toggle-gated server-side).
        /cli/connections) return 0 ;;
        # PR1 federation dual-auth — peers/peer-roster/send under passport.
        # pair/confirm stay TCP owner-or-admin only (not here).
        /cli/federation/peers|/cli/federation/peer-roster|/cli/federation/send) return 0 ;;
        # Named heartbeat schedule CRUD + fire/status (agent-owned workspace
        # schedules). OS tick install + fleet-wide list stay TCP owner-only.
        /cli/heartbeat/install-launchd|/cli/heartbeat/uninstall-launchd|/cli/heartbeat/apply-wake-scheduler) return 1 ;;
        /cli/heartbeat/list-all|/cli/heartbeat/fires-list-all|/cli/heartbeat/set-show-sessions) return 1 ;;
        /cli/heartbeat/*|/cli/heartbeat-log) return 0 ;;
        /cli/thread|/cli/thread/*) return 0 ;;
        *) return 1 ;;
    esac
}

# cli_send <tcp_fn> <endpoint> [args...] — channel selector.
# When a per-cell scoped socket is present AND the endpoint is UDS-eligible,
# try the matching `<tcp_fn>_uds` arm; on success (rc==0, non-empty, and NOT
# the daemon's "route not served on cell socket" 404 sentinel) print + return.
# Otherwise fall through to the TCP arm `<tcp_fn>`.
#   UDS arm  → $SCOPED_TOKEN (Bearer)
#   TCP arm  → $TOKEN, which _cli_apply_auth_for_verb already chose:
#              Open tools may be disk-owner (COMPAT-58); ID/locked tools are
#              SCOPED_TOKEN only (never the owner inversion).
cli_send() {
    local fn="$1" endpoint="$2"; shift 2
    local sock; sock="$(_hook_sock)"
    # After _apply_remote_host, every hop must use BASE_URL+Connect token.
    # UDS would hit THIS box's cell socket (Bug A: foreign staged path).
    if _cli_skip_uds; then
        "$fn" "$endpoint" "$@"
        return
    fi
    if [ -n "$sock" ] && [ -S "$sock" ] && _uds_eligible "$endpoint"; then
        local out rc
        out="$("${fn}_uds" "$endpoint" "$@")"; rc=$?
        if [ "$rc" -eq 0 ] && [ -n "$out" ] && [[ "$out" != *"not served on cell socket"* ]]; then
            printf '%s' "$out"
            return 0
        fi
    fi
    "$fn" "$endpoint" "$@"
}

# BEGIN_CLI_SEND_TCP_LOCK
# Set when a command has repointed BASE_URL at a remote Connect host so
# inbox/fs/resolve/deliver cannot UDS-shortcut to the local cell socket.
_K2_FORCE_TCP=0
_cli_skip_uds() {
    [ "${_K2_FORCE_TCP:-0}" = "1" ] || [ "${_K2_TRAY_REMOTE_APPLIED:-0}" = "1" ]
}
# END_CLI_SEND_TCP_LOCK

# ── F2 (sandbox cell + HOST session) — k2 respond ────────────────────
# `k2 respond [--final] <message>` — the in-session agent's RESPONSE
# egress. Posts a curated line to THIS session's response log; the
# external API caller drains it via
# `GET /v1/sandboxes/<id>/messages` (cells) or
# `GET /v1/w/<ws>/host-sessions/<id>/messages` (host sessions). The
# agent itself decides how many times to respond and when (`--final`
# marks the turn's last line) — multi-emit, like a person narrating.
#
# Transport (in preference order):
#   1. Per-cell UDS ($K2_HOOK_SOCK) + scoped Bearer — sandbox cells and
#      scoped host sessions where the socket bound.
#   2. Loopback TCP `/cli/respond` + scoped Bearer — HOST sessions
#      (prd-v1-api-completion §4). The daemon accepts ONLY a scoped
#      per-session token here (session identity comes from the token),
#      so this needs K2_HOOK_SCOPED on the daemon; the owner token is
#      REFUSED by design and we never fall back to it (it names no
#      session — a scoped token is structurally `<sid>.<secret>`).
# Outside any scoped session this errors loudly.
cmd_respond() {
    local final="0"
    while [ $# -gt 0 ]; do
        case "$1" in
            --final) final="1"; shift ;;
            --help|-h)
                echo "Usage: k2 respond [--final] <message>"
                echo "  Send a response line from inside an API-launched session to the API caller."
                echo "  Call it as many times as you like as you work; --final marks the last."
                echo "  Lifecycle-only (no product message): use  k2 done  instead of empty --final."
                return 0 ;;
            --) shift; break ;;
            *) break ;;
        esac
    done
    local message="$*"
    if [ -z "$message" ]; then
        echo "Usage: k2 respond [--final] <message>" >&2
        return 1
    fi
    local sock; sock="$(_hook_sock)"
    if [ -n "$sock" ] && [ -S "$sock" ]; then
        cli_post_form_uds "/cli/respond" "message=$(urlencode "$message")" "final=${final}"
        return $?
    fi
    # HOST session (no per-cell socket): loopback TCP with the SCOPED
    # token as Bearer. Only a scoped token (shape `<sid>.<secret>`)
    # carries session identity — with none present, fail loudly.
    if [[ "$SCOPED_TOKEN" == *.* ]] && [ -n "$PORT" ]; then
        local _K2_CFG=""
        _k2_cfg_add header "Authorization: Bearer ${SCOPED_TOKEN}"
        _k2_cfg_add data-raw "message=$(urlencode "$message")&final=${final}"
        _k2_curl "$_K2_CFG" -s -X POST "${BASE_URL}/cli/respond" \
            --connect-timeout 5 --max-time 30 \
            -H "Content-Type: application/x-www-form-urlencoded" 2>/dev/null
        return $?
    fi
    echo "Error: 'k2 respond' needs an API-launched session (per-cell socket or scoped session token)." >&2
    return 1
}

# ── Host-session / sandbox completion — k2 done (API lifecycle) ───────
# Lifecycle-only complete: arms reaper Grace without appending a product
# message to the respond drain ring. Same transport as `k2 respond`
# (UDS then scoped Bearer). Discriminator is K2_API_CELL (D6) — NOT sock
# or scoped-token presence (workspace agents under COMPAT-58 also have
# those and must keep legacy `checkin --done` meaning).
_is_api_lifecycle_context() {
    case "${K2_API_CELL:-${K2SO_API_CELL:-}}" in
        1|true|yes|YES|True) return 0 ;;
    esac
    return 1
}

cmd_session_complete() {
    local reason=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --reason) reason="$2"; shift 2 ;;
            --help|-h)
                echo "Usage: k2 done [--reason <text>]"
                echo "  Mark this API-launched session complete (enter grace for reap)."
                echo "  Does NOT post a product message to the respond drain."
                echo "  Prefer this over empty 'k2 respond --final \"\"' when you have no answer text."
                echo "  Optional --reason is logged only (not shown to the API caller)."
                return 0 ;;
            --) shift; break ;;
            *) break ;;
        esac
    done
    local form=""
    if [ -n "$reason" ]; then
        form="reason=$(urlencode "$reason")"
    fi
    local sock; sock="$(_hook_sock)"
    if [ -n "$sock" ] && [ -S "$sock" ]; then
        if [ -n "$form" ]; then
            cli_post_form_uds "/cli/session/complete" "$form"
        else
            cli_post_form_uds "/cli/session/complete"
        fi
        return $?
    fi
    if [[ "$SCOPED_TOKEN" == *.* ]] && [ -n "$PORT" ]; then
        # Empty $form → empty body, exactly as before.
        local _K2_CFG=""
        _k2_cfg_add header "Authorization: Bearer ${SCOPED_TOKEN}"
        _k2_cfg_add data-raw "$form"
        _k2_curl "$_K2_CFG" -s -X POST "${BASE_URL}/cli/session/complete" \
            --connect-timeout 5 --max-time 30 \
            -H "Content-Type: application/x-www-form-urlencoded" 2>/dev/null
        return $?
    fi
    echo "Error: 'k2 done' (session complete) needs an API-launched session (per-cell socket or scoped session token)." >&2
    return 1
}

# ── Remote target addressing (K2-as-a-server, 0.40.x) ────────────────
# `k2 talk <ws>@<subdomain>` / `k2 read <ws>@<host>` address a workspace
# on a CONNECTED remote daemon over K2 Connect — the SAME model as local
# workspace<->workspace agent talk, just pointed at a remote base URL.
# We split off the @host, repoint BASE_URL at https://<host>, and swap
# TOKEN for that host's owner token. Every existing cli_request /
# cli_post_* call then routes to the remote daemon with NO call-site
# change: the remote daemon resolves the workspace name against ITS own
# projects (canonical session by default; --session <id> targets a
# specific one). No daemon change — all routes used already exist and are
# reachable over the tunnel with the owner token.
_REMOTE_HOST=""
_BARE_TARGET=""
# PR2 addressing flags (set by _split_remote_target):
#   _IS_WIRE_FORM=1   → 3-part fp::ws::agent (fed send only)
#   _USED_LEGACY_AT=1 → peeled via legacy agent@host
_IS_WIRE_FORM=0
_USED_LEGACY_AT=0
# One-shot stderr hint when agents use @ federated form (prefer ::).
_FED_AT_HINT_SHOWN=0
# Split a remote user address into globals:
#   _BARE_TARGET  — agent/workspace token (host stripped)
#   _REMOTE_HOST  — host, or "" when local
#   _IS_WIRE_FORM / _USED_LEGACY_AT — see above
# Callers MUST invoke it directly (NOT in a "$(...)" subshell).
#
# Grammar (PR2 / GH #47):
#   agent::host.k2.dev  → user remote (2-part ::, host looks like host)
#   agent@host          → legacy user remote
#   fp::ws::agent       → wire form (3-part; not peeled as user remote)
#   bare name           → local
_split_remote_target() {
    local raw="$1"
    _REMOTE_HOST=""
    _BARE_TARGET="$raw"
    _IS_WIRE_FORM=0
    _USED_LEGACY_AT=0

    # 3+ part wire form: at least two '::' separators.
    if [[ "$raw" == *::*::* ]]; then
        _IS_WIRE_FORM=1
        return
    fi

    # 2-part user form agent::host (RHS must look like a host).
    if [[ "$raw" == *::* ]]; then
        local left="${raw%%::*}"
        local right="${raw#*::}"
        if [ -n "$left" ] && [ -n "$right" ] && { [[ "$right" == *.* ]] || [[ "$right" == *.k2.dev ]] || [[ "$right" == *.K2.DEV ]]; }; then
            _BARE_TARGET="$left"
            _REMOTE_HOST="$right"
            return
        fi
        # Not host-like → leave as bare local token.
        return
    fi

    # Legacy agent@host (split on LAST '@').
    case "$raw" in
        *@*)
            _REMOTE_HOST="${raw##*@}"
            _BARE_TARGET="${raw%@*}"
            _USED_LEGACY_AT=1
            ;;
    esac
}

# ── Cross-server agent msg over FEDERATION ────────────────────────────
# `k2 msg <agent>::<host> "text"` (canonical) or legacy `agent@host` routes a
# CONNECTED cross-server peer over federation — the SAME verb agents use for
# a local peer. This is the federation send-surface (gated on
# `is_remote_connection`), NOT the owner-remote drive-the-box path that
# `k2 talk <ws>@<host>` uses.
#
# PR1: uses scoped passport via cli_send (UDS when eligible, else TCP with
# TOKEN which for msg/ID is SCOPED_TOKEN — never disk-owner inversion).
# Daemon forces from_workspace from principal when scoped.
# PR2: prefer agent::host; wire form fp::ws::agent stays on `k2 fed send`.
#
# Args: <agent> <host> <text> <from_project>. Returns:
#   0  delivered ("sent") or durably queued ("queued")
#   3  not_connected / forbidden (mail/C2 teaching parity)
#   2  actionable user error (fed off, no peer, not trusted, no agent)
#   1  unexpected/unparseable daemon response
#
# Steps: resolve the peer by matching "<subdomain>.k2.dev" == <host> in
# /cli/federation/peers (capture fingerprint) → resolve the agent's
# workspace_id from that peer's /cli/federation/peer-roster → POST
# /cli/federation/send with to="<fp>::<wsid>::<agent>". All parsing is
# python3 (consistent with the rest of this CLI).
_send_remote_msg() {
    local agent="$1" host="$2" text="$3" from_project="$4"

    if [ -z "$agent" ]; then
        echo "k2 msg: empty agent name in '<agent>::<host>' target." >&2
        return 2
    fi
    if [ -z "$host" ]; then
        echo "k2 msg: empty host in '<agent>::<host>' target." >&2
        return 2
    fi

    # Optional one-shot compat hint when the caller used legacy @ form.
    if [ "${_USED_LEGACY_AT:-0}" = "1" ] && [ "${_FED_AT_HINT_SHOWN:-0}" = "0" ]; then
        echo "hint: prefer \`k2 msg ${agent}::${host}\` — '@' federated addresses are legacy compat (not email)." >&2
        _FED_AT_HINT_SHOWN=1
    fi

    # 1. Resolve the peer by host (subdomain.k2.dev == host) → fingerprint.
    # cli_send: prefer cell UDS + scoped Bearer when present.
    local peers_json
    peers_json=$(cli_send cli_request "/cli/federation/peers")
    local pmatch
    pmatch=$(printf '%s' "$peers_json" | python3 -c '
import json, sys
host = (sys.argv[1] or "").strip().lower()
# Accept bare subdomain or full host.k2.dev (and collapse accidental doubles).
def bare(h):
    h = (h or "").strip().lower()
    while h.endswith(".k2.dev.k2.dev"):
        h = h[: -len(".k2.dev")]
    if h.endswith(".k2.dev"):
        h = h[: -len(".k2.dev")]
    return h
want = bare(host)
try:
    d = json.load(sys.stdin)
except Exception:
    print("ERR\tparse"); sys.exit(0)
if not isinstance(d, dict) or not isinstance(d.get("peers"), list):
    # federation off (404 {"error":...}) or unexpected shape
    err = d.get("error") if isinstance(d, dict) else None
    if isinstance(err, dict) and err.get("code") in ("forbidden", "not_connected"):
        print("FORBIDDEN\t%s" % (err.get("hint") or err.get("code") or ""))
        sys.exit(0)
    if isinstance(d, dict) and d.get("error"):
        print("NOFED\t%s" % (d.get("error") if not isinstance(d.get("error"), dict) else d["error"].get("hint") or d["error"]))
        sys.exit(0)
    print("NOFED"); sys.exit(0)
def host_port(u):
    u = (u or "").strip()
    if u.lower().startswith("https://"):
        u = u[8:]
    elif u.lower().startswith("http://"):
        u = u[7:]
    return u.split("/")[0] if u else ""
for p in d["peers"]:
    sub = p.get("subdomain") or ""
    label = p.get("label") or ""
    base = p.get("base_url") or p.get("baseUrl") or ""
    hp = host_port(base)
    if want and bare(sub) == want:
        print("OK\t%s\t%s" % (p.get("fingerprint", ""), p.get("trust", "")))
        sys.exit(0)
    # Also match full host forms stored as subdomain
    if host and sub and sub.lower() in (host, host + ".k2.dev", want + ".k2.dev"):
        print("OK\t%s\t%s" % (p.get("fingerprint", ""), p.get("trust", "")))
        sys.exit(0)
    # F5: LAN/Tailscale saved host:port (do not require .k2.dev)
    if host and (sub.lower() == host or hp.lower() == host or hp.lower() == want):
        print("OK\t%s\t%s" % (p.get("fingerprint", ""), p.get("trust", "")))
        sys.exit(0)
    if want and bare(label) == want:
        print("OK\t%s\t%s" % (p.get("fingerprint", ""), p.get("trust", "")))
        sys.exit(0)
# List known peer hosts so the NONE error is actionable (GH #48).
known = []
for p in d["peers"]:
    base = (p.get("base_url") or p.get("baseUrl") or "").strip()
    sub = (p.get("subdomain") or "").strip()
    if base:
        known.append(host_port(base) or base)
    elif sub:
        if ":" in sub or sub.endswith(".ts.net") or sub.endswith(".k2.dev"):
            known.append(sub)
        else:
            known.append(sub + ".k2.dev")
    elif p.get("label"):
        known.append(str(p.get("label")))
print("NONE\t%s" % (", ".join(known) if known else ""))
' "$host")

    local pkind fp trust
    IFS=$'\t' read -r pkind fp trust <<<"$pmatch"
    case "$pkind" in
        FORBIDDEN)
            # Scoped token rejected (should not happen post-PR1) or other gate.
            printf '%s\n' "${fp:-forbidden}" >&2
            return 3 ;;
        NOFED|ERR)
            echo "federation is off or unreachable on $host — enable it and pair first (k2 fed enable / k2 fed pair-request)." >&2
            [ -n "$fp" ] && [ "$pkind" = "NOFED" ] && echo "detail: $fp" >&2
            return 2 ;;
        NONE)
            # GH #48: inbound may have landed while this side never stored a
            # return pin, or the host string doesn't match the peer's subdomain.
            if [ -n "$fp" ]; then
                echo "no paired peer matching $host — known peers: $fp" >&2
                echo "hint: run \`k2 fed peers\` to inspect trust; if you received a message from this host but have no pin, complete pairing (k2 fed pair-request / confirm) so replies can go back." >&2
            else
                echo "no paired peer for $host — pair it first (k2 fed pair-request / confirm), or check the host." >&2
                echo "hint: run \`k2 fed peers\` to list trusted servers on this machine." >&2
            fi
            return 2 ;;
        OK) ;;
        *)
            echo "k2 msg: could not read federation peers from the local daemon." >&2
            return 2 ;;
    esac
    if [ -z "$fp" ]; then
        echo "no paired peer for $host — pair it first (k2 fed pair-request / confirm), or check the host." >&2
        return 2
    fi
    # Trust serializes lowercase ("trusted") on the wire — compare case-insensitively.
    local trust_lc
    trust_lc=$(printf '%s' "$trust" | tr '[:upper:]' '[:lower:]')
    if [ -n "$trust_lc" ] && [ "$trust_lc" != "trusted" ]; then
        echo "peer $host is not trusted yet (state=$trust) — confirm the pairing (k2 fed confirm)." >&2
        return 2
    fi

    # 2. Resolve the agent's workspace_id from that peer's roster.
    local roster_json
    roster_json=$(cli_send cli_request "/cli/federation/peer-roster" "peer=$(urlencode "$fp")")
    local rres
    rres=$(printf '%s' "$roster_json" | python3 -c '
import json, sys
agent = sys.argv[1]
try:
    d = json.load(sys.stdin)
except Exception:
    print("ERR\tparse"); sys.exit(0)
if not isinstance(d, dict):
    print("ERR\t"); sys.exit(0)
if "error" in d:
    err = d.get("error")
    if isinstance(err, dict) and err.get("code") in ("forbidden", "not_connected"):
        print("FORBIDDEN\t%s" % (err.get("hint") or err.get("code") or ""))
        sys.exit(0)
    print("ERR\t%s" % (err if not isinstance(err, dict) else err.get("hint") or err.get("code") or err))
    sys.exit(0)
roster = d.get("roster") or {}
agents = roster.get("agents") or []

def slugify(s):
    if not s:
        return ""
    for ch in s:
        if ch in "/:\\" or ch == "\0" or (ord(ch) < 32):
            return (s or "").strip().lower()
    t = s.strip().lower().replace("_", "-")
    t = "-".join(p for p in t.split() if p)
    while "--" in t:
        t = t.replace("--", "-")
    t = t.strip("-")
    t = "".join(c for c in t if c.isalnum() or c == "-")
    while "--" in t:
        t = t.replace("--", "-")
    return t.strip("-")

def norm(s):
    g = slugify(s)
    return g if g else (s or "").strip().lower()

want = norm(agent)
matches = []
for a in agents:
    handle = (a.get("agent") or "").strip()
    aliases = a.get("aliases") or []
    wname = a.get("workspace_name") or ""
    hit = norm(handle) == want or any(norm(x) == want for x in aliases)
    if not hit and wname.strip() and norm(wname) == want:
        hit = True
    if hit:
        matches.append(a)
# workspace_name convenience: if two UUIDs match, AMBIG
ids = []
seen = set()
for a in matches:
    wid = a.get("workspace_id") or ""
    if wid not in seen:
        seen.add(wid)
        ids.append(a)
if not ids:
    names = ", ".join(a.get("agent", "?") for a in agents)
    print("NONE\t%s" % names); sys.exit(0)
if len(ids) > 1:
    info = "; ".join("%s (%s)" % (a.get("workspace_name", "?"), a.get("workspace_id", "?")) for a in ids)
    print("AMBIG\t%s" % info); sys.exit(0)
print("OK\t%s" % (ids[0].get("workspace_id", "") or ""))
' "$agent")

    local rkind rdetail
    rkind="${rres%%$'\t'*}"
    rdetail="${rres#*$'\t'}"
    [ "$rdetail" = "$rres" ] && rdetail=""
    case "$rkind" in
        FORBIDDEN)
            # Teaching JSON shape parity with local msg/read exit 3.
            python3 -c 'import json,sys
hint=sys.argv[1] or "forbidden"
sys.stderr.write(json.dumps({"error":{"code":"forbidden","hint":hint}},
                            ensure_ascii=False,separators=(",",":"))+"\n")
' "$rdetail" 2>/dev/null || echo "${rdetail:-forbidden}" >&2
            return 3 ;;
        ERR)
            echo "could not reach $host's roster: ${rdetail:-$roster_json}" >&2
            return 2 ;;
        NONE)
            if [ -n "$rdetail" ]; then
                echo "no agent \"$agent\" on $host. Available: $rdetail." >&2
            else
                echo "no agent \"$agent\" on $host (its roster is empty)." >&2
            fi
            return 2 ;;
        AMBIG)
            echo "ambiguous agent \"$agent\" on $host — multiple workspaces expose it: $rdetail. Disambiguate on the host." >&2
            return 2 ;;
        OK) ;;
        *)
            echo "could not parse $host's roster." >&2
            return 2 ;;
    esac
    local wsid="$rdetail"
    if [ -z "$wsid" ]; then
        echo "no resolvable workspace for agent \"$agent\" on $host." >&2
        return 2
    fi

    # 3. Send. Build the body safely with python3 (mirrors cmd_fed send).
    # from_workspace is best-effort for owner path; scoped principal forces it
    # server-side from the passport (body spoof ignored).
    local body resp
    body=$(python3 -c 'import json,sys; print(json.dumps({"to":sys.argv[1],"text":sys.argv[2],"from_workspace":sys.argv[3]}))' \
        "${fp}::${wsid}::${agent}" "$text" "$from_project")
    resp=$(cli_send cli_post_json "/cli/federation/send" "$body")

    # 4. Surface the response.
    # not_connected / forbidden → exit 3 + teaching (mail/C2 parity).
    local sres skind sdetail
    sres=$(printf '%s' "$resp" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    print("RAW"); sys.exit(0)
if not isinstance(d, dict):
    print("RAW"); sys.exit(0)
err = d.get("error")
if isinstance(err, dict):
    code = err.get("code") or ""
    hint = err.get("hint") or code
    if code in ("not_connected", "gated", "forbidden"):
        # Emit teaching JSON on stderr via GATE line; CLI maps to exit 3.
        print("GATE\t%s\t%s" % (code, hint)); sys.exit(0)
    print("ERROR\t%s" % (hint or code or err)); sys.exit(0)
if err is not None and not isinstance(err, dict):
    print("ERROR\t%s" % err); sys.exit(0)
st = d.get("status", "")
if st == "sent":
    print("SENT"); sys.exit(0)
if st == "queued":
    print("QUEUED\t%s" % (d.get("hint", "") or "")); sys.exit(0)
if st == "declined":
    print("ERROR\t%s" % (d.get("reason") or "declined by peer")); sys.exit(0)
print("OTHER")
')
    skind="${sres%%$'\t'*}"
    sdetail="${sres#*$'\t'}"
    [ "$sdetail" = "$sres" ] && sdetail=""
    case "$skind" in
        SENT)
            echo "delivered to ${agent}::${host} (federation)"
            return 0 ;;
        QUEUED)
            echo "${sdetail:-queued for ${agent}::${host} — peer briefly unreachable, will deliver when it reconnects (federation)}" >&2
            return 0 ;;
        GATE)
            # sdetail is "code\thint" after first tab split above left "code\thint"
            local gcode ghint
            gcode="${sdetail%%$'\t'*}"
            ghint="${sdetail#*$'\t'}"
            [ "$ghint" = "$sdetail" ] && ghint="$gcode"
            python3 -c 'import json,sys
code,hint=sys.argv[1],sys.argv[2]
sys.stderr.write(json.dumps({"error":{"code":code,"hint":hint}},
                            ensure_ascii=False,separators=(",",":"))+"\n")
' "$gcode" "$ghint"
            return 3 ;;
        ERROR)
            echo "${sdetail:-$resp}" >&2
            return 2 ;;
        *)
            echo "k2 msg: unexpected daemon response: $resp" >&2
            return 1 ;;
    esac
}

# Resolve the owner/session token for a remote Connect host. Precedence:
#   1. explicit --token (arg $2)
#   2. $K2_REMOTE_TOKEN
#   3. ~/.k2/connect-tokens.json  { "<hostname>": "<token>", ... } with
#      flexible key match (case, bare subdomain vs *.k2.dev)
#   4. OS keychain (desktop "Remember" path): resolve host id from
#      connect-hosts.json, then:
#        macOS  → security find-generic-password (dev.k2.connect.host-token)
#        Linux  → secret-tool lookup (same service name)
# Echoes the token (empty when none found). connect-hosts.json is the
# non-secret address book; connect-tokens.json is the CLI-readable store
# (0600). GH #60: tray file send used to only exact-match connect-tokens
# and ignored keychain, so a signed-in Servers host still failed.
_remote_token_for_host() {
    local host="$1" explicit="${2:-}"
    if [ -n "$explicit" ]; then printf '%s' "$explicit"; return 0; fi
    if [ -n "${K2_REMOTE_TOKEN:-}" ]; then printf '%s' "$K2_REMOTE_TOKEN"; return 0; fi
    if ! command -v python3 >/dev/null 2>&1; then
        return 0
    fi

    # Flexible connect-tokens.json + host-id from connect-hosts.json.
    # Prints either "TOKEN\t<tok>" or "HOSTID\t<id>" or nothing.
    local resolved host_id tok=""
    resolved=$(K2_HOME="$K2_HOME" python3 - "$host" <<'PY' 2>/dev/null
import json, os, sys

def bare(h: str) -> str:
    h = (h or "").strip().lower()
    while h.endswith(".k2.dev.k2.dev"):
        h = h[: -len(".k2.dev")]
    if h.endswith(".k2.dev"):
        h = h[: -len(".k2.dev")]
    return h

def host_keys(h: str):
    h = (h or "").strip()
    if not h:
        return []
    b = bare(h)
    keys = {h, h.lower(), b, f"{b}.k2.dev", f"{b}.K2.DEV"}
    return [k for k in keys if k]

want = sys.argv[1] if len(sys.argv) > 1 else ""
home = os.environ.get("K2_HOME") or os.path.join(os.path.expanduser("~"), ".k2")
# also try sibling .k2so if K2_HOME is .k2 (legacy layout)
homes = [home]
alt = os.path.join(os.path.expanduser("~"), ".k2so")
if alt not in homes and os.path.isdir(alt):
    homes.append(alt)

want_keys = set(host_keys(want))
want_bare = bare(want)

# 1) connect-tokens.json flexible match
for base in homes:
    path = os.path.join(base, "connect-tokens.json")
    if not os.path.isfile(path):
        continue
    try:
        data = json.load(open(path))
    except Exception:
        continue
    if not isinstance(data, dict):
        continue
    for k, v in data.items():
        if not v or not isinstance(v, str):
            continue
        if k in want_keys or bare(k) == want_bare:
            print("TOKEN\t%s" % v)
            sys.exit(0)

# 2) connect-hosts.json → host id for keychain lookup
for base in homes:
    path = os.path.join(base, "connect-hosts.json")
    if not os.path.isfile(path):
        continue
    try:
        data = json.load(open(path))
    except Exception:
        continue
    if not isinstance(data, list):
        continue
    for entry in data:
        if not isinstance(entry, dict):
            continue
        hn = entry.get("hostname") or ""
        label = entry.get("label") or ""
        hid = entry.get("id") or ""
        if not hid:
            continue
        if hn in want_keys or bare(hn) == want_bare or bare(label) == want_bare:
            print("HOSTID\t%s" % hid)
            sys.exit(0)
PY
)
    if [ -n "$resolved" ]; then
        local kind val
        IFS=$'\t' read -r kind val <<<"$resolved"
        if [ "$kind" = "TOKEN" ] && [ -n "$val" ]; then
            printf '%s' "$val"
            return 0
        fi
        if [ "$kind" = "HOSTID" ] && [ -n "$val" ]; then
            host_id="$val"
        fi
    fi

    # 3) OS keychain — same service/account desktop rememberToken uses.
    if [ -n "${host_id:-}" ]; then
        if command -v security >/dev/null 2>&1; then
            local svc
            for svc in "dev.k2.connect.host-token" "com.k2so.connect.host-token"; do
                tok=$(security find-generic-password -s "$svc" -a "$host_id" -w 2>/dev/null || true)
                if [ -n "$tok" ]; then
                    printf '%s' "$tok"
                    return 0
                fi
            done
        fi
        if command -v secret-tool >/dev/null 2>&1; then
            local svc
            for svc in "dev.k2.connect.host-token" "com.k2so.connect.host-token"; do
                tok=$(secret-tool lookup service "$svc" account "$host_id" 2>/dev/null || true)
                if [ -n "$tok" ]; then
                    printf '%s' "$tok"
                    return 0
                fi
            done
        fi
    fi
}

# Diagnose why tray file send could not resolve a Connect token for <host>.
# Prints multi-line stderr teaching for GH #60 (misleading "add/sign-in" text).
_tray_token_missing_error() {
    local host="$1"
    local registered="no" has_tokens_file="no" has_host_id="no"
    if command -v python3 >/dev/null 2>&1; then
        local diag
        diag=$(K2_HOME="$K2_HOME" python3 - "$host" <<'PY' 2>/dev/null
import json, os, sys

def bare(h):
    h = (h or "").strip().lower()
    while h.endswith(".k2.dev.k2.dev"):
        h = h[: -len(".k2.dev")]
    if h.endswith(".k2.dev"):
        h = h[: -len(".k2.dev")]
    return h

want = sys.argv[1] if len(sys.argv) > 1 else ""
want_bare = bare(want)
home = os.environ.get("K2_HOME") or os.path.join(os.path.expanduser("~"), ".k2")
homes = [home]
alt = os.path.join(os.path.expanduser("~"), ".k2so")
if alt not in homes and os.path.isdir(alt):
    homes.append(alt)

registered = False
host_id = ""
tokens_file = False
for base in homes:
    p = os.path.join(base, "connect-tokens.json")
    if os.path.isfile(p):
        tokens_file = True
    p = os.path.join(base, "connect-hosts.json")
    if not os.path.isfile(p):
        continue
    try:
        data = json.load(open(p))
    except Exception:
        continue
    if not isinstance(data, list):
        continue
    for entry in data:
        if not isinstance(entry, dict):
            continue
        hn = entry.get("hostname") or ""
        label = entry.get("label") or ""
        if bare(hn) == want_bare or bare(label) == want_bare or hn.lower() == want.lower():
            registered = True
            host_id = entry.get("id") or ""
            break
print("registered=%s" % ("yes" if registered else "no"))
print("tokens_file=%s" % ("yes" if tokens_file else "no"))
print("host_id=%s" % ("yes" if host_id else "no"))
PY
)
        while IFS= read -r line; do
            case "$line" in
                registered=*) registered="${line#registered=}" ;;
                tokens_file=*) has_tokens_file="${line#tokens_file=}" ;;
                host_id=*) has_host_id="${line#host_id=}" ;;
            esac
        done <<<"$diag"
    fi

    cat >&2 <<EOF
Error: cannot upload tray files to ${host} — no Connect session token for that host.
  host in address book:  ${registered}
  connect-tokens.json:   ${has_tokens_file}
  host id (for keychain): ${has_host_id}
  active account / federation trust is NOT enough — file packages must
  authenticate to the *destination* daemon (upload + inbox deliver).
  Live text \`k2 msg agent::host "…"\` uses federation; tray files do not.

Fix (pick one):
  1. In the desktop app: Servers → sign in to ${host} with Remember on
     (desktop mirrors the token for CLI), then retry.
  2. Or put an owner/session token in \${K2_HOME}/connect-tokens.json:
       { "${host}": "<token>" }   (chmod 600)
  3. Or pass --token <tok> / set \$K2_REMOTE_TOKEN for this command.
  Folders are not supported — send a file or a .zip.
EOF
}

# Point the HTTP helpers at a remote host for the rest of this command
# (overrides the globals BASE_URL + TOKEN). No-op for a local target.
# Non-zero + stderr hint when no token is available.
_apply_remote_host() {
    local host="$1" explicit_token="${2:-}"
    [ -z "$host" ] && return 0
    local tok
    tok="$(_remote_token_for_host "$host" "$explicit_token")"
    if [ -z "$tok" ]; then
        echo "Error: no owner token for remote host '$host'." >&2
        echo "Pass --token <tok>, set \$K2_REMOTE_TOKEN, or add it to ${K2_HOME}/connect-tokens.json ({\"$host\": \"<token>\"})." >&2
        return 1
    fi
    case "$host" in
        http://*|https://*) BASE_URL="${host%/}" ;;
        *)                  BASE_URL="https://${host}" ;;
    esac
    TOKEN="$tok"
    # Inbox/fs/resolve must not UDS-shortcut to this box after a remote
    # BASE_URL swap (federated tray Bug A).
    _K2_FORCE_TCP=1
    return 0
}

# 0.39.0f Phase 2.1b: format_agents / format_work removed. Their
# only callers (cmd_agents_list / cmd_agents_work / cmd_work_inbox)
# are also gone; the inbox surface uses format_inbox instead.

# ── Commands ─────────────────────────────────────────────────────────

# 0.39.0f Phase 2.1b: cmd_agents_list / cmd_agents_work /
# cmd_agents_status / cmd_agents_create removed. The dispatch arms
# now route to fail_deprecated; the function bodies are gone for good.

cmd_agent_update() {
    local name="" field="" value=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --name) name="$2"; shift 2 ;;
            --field) field="$2"; shift 2 ;;
            --value) value="$2"; shift 2 ;;
            *) [ -z "$name" ] && name="$1"; shift ;;
        esac
