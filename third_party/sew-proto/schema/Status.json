            {
              "type": "null"
            }
          ],
          "description": "Present only while a rebuild runs."
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/SearchState"
            },
            {
              "type": "null"
            }
          ],
          "description": "`ready` or `missing` (rebuilding; searches answer 503)."
        }
      },
      "type": "object"
    },
    "StatusSearchDocs": {
      "description": "Live search documents by type.",
      "properties": {
        "files": {
          "description": "File-name documents.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "messages": {
          "description": "Message documents.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "messages",
        "files"
      ],
      "type": "object"
    },
    "StatusSearchRebuild": {
      "description": "A running search rebuild.",
      "properties": {
        "docs": {
          "description": "Documents in the building index so far.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "generation": {
          "description": "The generation being built.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "progress_pct": {
          "description": "0–99 until the swap.",
