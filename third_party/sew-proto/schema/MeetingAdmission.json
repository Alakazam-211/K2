{
  "$defs": {
    "MeetingAdmissionOutcome": {
      "description": "What a host decided about a knock (or that nobody did).",
      "oneOf": [
        {
          "const": "admitted",
          "description": "Let in: join the meeting channel's voice.",
          "type": "string"
        },
        {
          "const": "denied",
          "description": "Not let in.",
          "type": "string"
        },
        {
          "const": "expired",
          "description": "Nobody decided in time, or the link changed: knock again.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Event `meeting_admission` (to the knocking member's sessions): the decision on its entry.",
  "properties": {
    "channel_id": {
      "description": "The meeting channel, when admitted.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": [
        "string",
        "null"
      ]
    },
    "entry_id": {
      "description": "The entry.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "meeting_id": {
      "description": "The meeting.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/MeetingAdmissionOutcome",
      "description": "The decision."
    }
  },
  "required": [
    "meeting_id",
    "entry_id",
    "outcome"
  ],
  "title": "MeetingAdmission",
  "type": "object"
}
