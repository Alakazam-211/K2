elif verb == "path":
    print(d.get("path"))
elif verb == "garden-list":
    for g in d.get("gardens") or []:
        print(garden_line(g))
elif verb == "garden-new":
    g = d.get("garden") or {}
    print(g.get("id"))
    print(d.get("path"))
elif verb == "garden-rename":
    g = d.get("garden") or {}
