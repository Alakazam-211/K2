{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "voice-check",
  "version": "0.1.0",
  "identifier": "dev.k2.voice-check",
  "build": {
    "frontendDist": "../page"
  },
  "app": {
    "windows": [
      {
        "title": "voice-check",
        "create": false,
        "url": "http://127.0.0.1/",
        "width": 480,
        "height": 360,
        "backgroundThrottling": "disabled",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "createUpdaterArtifacts": true,
    "macOS": {
      "entitlements": "./Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://<your-app-host>/_k2/updates/stable/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": ""
    }
  }
}
