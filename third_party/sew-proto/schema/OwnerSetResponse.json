{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response of `POST /mgmt/v1/owner/set` (S9 G7).",
  "properties": {
    "changed": {
      "description": "Whether the owner changed.",
      "type": "boolean"
    },
    "owner_id": {
      "description": "The install owner after the call.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "previous_owner_id": {
      "description": "The owner before the call, now an admin; absent on the first call or when unchanged.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "owner_id",
    "changed"
  ],
  "title": "OwnerSetResponse",
  "type": "object"
}
