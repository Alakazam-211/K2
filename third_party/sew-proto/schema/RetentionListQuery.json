{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Query of `GET /api/v1/compliance/retention`: active and pending rows (all rows with\n`history`), newest first, optionally for one level.",
  "properties": {
    "before": {
      "description": "Rows older than this id.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": [
        "string",
        "null"
      ]
    },
    "history": {
      "description": "Include superseded and cancelled rows.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "limit": {
      "description": "Page size, 1–100 (default 50).",
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "scope_id": {
      "description": "The space or channel id (with `scope_kind`).",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": [
        "string",
        "null"
      ]
    },
    "scope_kind": {
      "description": "`install`, `space` or `channel`.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "title": "RetentionListQuery",
  "type": "object"
}
