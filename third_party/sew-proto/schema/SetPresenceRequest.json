{
  "$defs": {
    "ManualPresence": {
      "description": "A member's manual presence state (persisted).",
      "oneOf": [
        {
          "const": "none",
          "description": "Automatic.",
          "type": "string"
        },
        {
          "const": "away",
          "description": "Shown as idle.",
          "type": "string"
        },
        {
          "const": "dnd",
          "description": "Do not disturb.",
          "type": "string"
        },
        {
          "const": "invisible",
          "description": "Shown offline to others.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Body of `POST /api/v1/me/presence`.",
  "properties": {
    "manual": {
      "$ref": "#/$defs/ManualPresence",
      "description": "The manual state."
    },
    "until": {
      "description": "When it ends (only with `manual ≠ none`).",
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "manual"
  ],
  "title": "SetPresenceRequest",
  "type": "object"
}
