{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One channel of `GET /api/v1/me/sync`.",
  "properties": {
    "floor_seq": {
      "description": "Its change-log floor.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "head_seq": {
      "description": "Its change-log head.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "id": {
      "description": "The channel.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "last_message_id": {
      "description": "Its newest timeline message.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "head_seq",
    "floor_seq"
  ],
  "title": "SyncChannel",
  "type": "object"
}
