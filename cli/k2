import json, sys
v = json.load(sys.stdin)
s = v["seed"]
print("Seed %s" % s["hash"])
print("  %s %s  %s files, %s bytes%s" % (s["seedId"], s.get("version") or "", v.get("entries"), s["sizeBytes"],
      "  (already stored)" if v.get("reused") else ""))
if s.get("sourceRef"):
