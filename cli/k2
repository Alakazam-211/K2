        params["unread"] = "1"
    if env("M_LIMIT"):
        params["limit"] = env("M_LIMIT")
    if env("M_OFFSET"):
        params["offset"] = env("M_OFFSET")
    if env("M_SINCE"):
        params["since"] = env("M_SINCE")
    if env("M_BEFORE"):
        params["before"] = env("M_BEFORE")
    if env("M_JUNK") == "true":
        params["junk"] = "1"
    elif env("M_FOLDER"):
        params["folder"] = env("M_FOLDER")
