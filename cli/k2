#   k2 sessions set-label <session-uuid> <new label>
#   k2 sessions set-label <session-uuid> <new label> --no-lock
cmd_sessions_set_label() {
    local session_id="${1:-}"
    [[ -z "$session_id" ]] && { echo "Usage: k2 sessions set-label <session-id> <label> [--no-lock]" >&2; exit 1; }
    shift
    local lock="true"
