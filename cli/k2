#!/bin/bash
# K2 CLI — Agent interface to K2 workspace orchestration
# This script communicates with the K2 daemon via HTTP.
# Works inside K2 terminals (auto-configured) and external terminals
# (auto-discovers connection from ~/.k2/heartbeat.{port,token}).
#
# NOTE (0.40.4+): each workspace's dot-dir was renamed `.k2so/` -> `.k2/`.
# Inbox/skills/prds/agent now live under `<workspace>/.k2/`. This CLI resolves
# either layout (`.k2/` preferred, `.k2so/` fallback) via `_ws_dot_dir()`, so
# agents should read/write `<workspace>/.k2/...` going forward.

K2_CLI_VERSION="0.40.64"

set -euo pipefail

# Connection details (set by K2 when creating terminal sessions)
# Falls back to ~/.k2/heartbeat.{port,token} for external terminals
PORT="${K2_PORT:-${K2SO_PORT:-}}"
TOKEN="${K2_HOOK_TOKEN:-${K2SO_HOOK_TOKEN:-}}"

# #58 Phase-1 close — capture the per-cell SCOPED token NOW, before any
# Open-tool disk-owner inversion (see _cli_apply_auth_for_verb) can clobber
# $TOKEN with the daemon owner token. The scoped token is what the per-cell
# UDS arm authenticates with (Bearer). For ID/locked tools we MUST keep this
# passport and never re-source ~/.k2/heartbeat.token (owner) — that COMPAT-58
# inversion is the agent elevation hole for ID verbs. Empty outside a scoped
# cell (the UDS arm is then skipped — see cli_send).
SCOPED_TOKEN="${K2_HOOK_TOKEN:-${K2SO_HOOK_TOKEN:-}}"
# Disk owner credential (if present). Used only for Open-tool TCP ergonomics
# and external (non-cell) terminals — never for ID/locked tools when a
# scoped session marker ($K2_HOOK_SOCK) is present.
DISK_OWNER_TOKEN=""

# Daemon home: ~/.k2 post-0.40 (the migration leaves ~/.k2so as a compat
# symlink, so either resolves to the same files — prefer the new name,
# fall back for a not-yet-migrated machine).
K2_HOME="${HOME}/.k2"
[ -d "$K2_HOME" ] || K2_HOME="${HOME}/.k2so"

# Workspace dot-dir for a project root: .k2/ preferred when present,
# .k2so/ is the 0.x default (Q2 dual-compat; full flip lands pre-1.0.0).
_ws_dot_dir() {
    if [ -d "$1/.k2" ]; then echo "$1/.k2"; else echo "$1/.k2so"; fi
}

# Resolve project root: if K2_PROJECT_PATH is set, use it directly.
# Otherwise walk up from CWD to find a .k2/ or .k2so/ directory, skipping $HOME.
# Also handles git worktrees: if CWD is inside a worktree, resolve back to
# the main repo root where the workspace dot-dir lives.
PROJECT="${K2_PROJECT_PATH:-${K2SO_PROJECT_PATH:-$(pwd)}}"
if [ -z "${K2_PROJECT_PATH:-${K2SO_PROJECT_PATH:-}}" ]; then
    _dir="$(pwd)"
    _found=""
    while [ "$_dir" != "/" ]; do
        if { [ -d "$_dir/.k2so" ] || [ -d "$_dir/.k2" ]; } && [ "$_dir" != "$HOME" ]; then
            _found="$_dir"
            break
        fi
        _dir="$(dirname "$_dir")"
    done
    if [ -z "$_found" ]; then
        # May be inside a git worktree — resolve to main repo root.
        # `|| true` is REQUIRED: from a non-git CWD, `git rev-parse` exits 128,
        # and under `set -euo pipefail` that failing command substitution would
        # abort the entire script before it ever reads the daemon port — a
        # silent exit 128 (GH #16). Swallow it so a non-git CWD just leaves
        # _main_root empty and we fall back to $PWD as PROJECT.
        _main_root=$(git -C "$(pwd)" rev-parse --path-format=absolute --git-common-dir 2>/dev/null | sed 's|/.git$||' || true)
        if [ -n "$_main_root" ] && { [ -d "$_main_root/.k2so" ] || [ -d "$_main_root/.k2" ]; }; then
            _found="$_main_root"
        fi
    fi
    PROJECT="${_found:-$PROJECT}"
    unset _dir _found _main_root
fi

# 0.40.4 cutover heads-up — git-derived + self-clearing. While the
# `.k2so/` -> `.k2/` rename is uncommitted, `git ls-files .k2so` still lists
# the (now-deleted-on-disk) tracked files; once the user commits the rename it
# returns nothing and this goes silent. `|| true` guards the git call from
# aborting the script in a non-git CWD (GH#16). stderr only — never pollutes
# command stdout / JSON.
if [ -d "$PROJECT/.k2" ] && [ ! -d "$PROJECT/.k2so" ]; then
    _k2so_pending=$(git -C "$PROJECT" ls-files .k2so 2>/dev/null | head -1 || true)
    if [ -n "$_k2so_pending" ]; then
        echo "i  K2 0.40.4 renamed this workspace's .k2so/ -> .k2/ (harness symlinks + .gitignore updated). Commit the rename when ready — git tracks it as renames." >&2
    fi
    unset _k2so_pending
fi

# Auto-discover connection from the daemon home if not in a K2 terminal.
# Always capture DISK_OWNER_TOKEN when readable so Open tools can still do
# the COMPAT-58 TCP inversion; never *apply* that inversion here — ID/locked
# tools must not inherit the owner credential just because $K2_HOOK_SOCK is set.
if [ -f "${K2_HOME}/heartbeat.port" ]; then
    PORT="${PORT:-$(cat "${K2_HOME}/heartbeat.port" 2>/dev/null)}"
fi
if [ -r "${K2_HOME}/heartbeat.token" ]; then
    DISK_OWNER_TOKEN="$(cat "${K2_HOME}/heartbeat.token" 2>/dev/null)"
fi
# Fresh headless boxes always get daemon.token; heartbeat.token is the
# same secret written alongside. Prefer heartbeat (CLI convention) but
# accept daemon.token so external owner ops work when only one is present.
if [ -z "$DISK_OWNER_TOKEN" ] && [ -r "${K2_HOME}/daemon.token" ]; then
    DISK_OWNER_TOKEN="$(cat "${K2_HOME}/daemon.token" 2>/dev/null)"
fi
if [ -z "$TOKEN" ] && [ -n "$DISK_OWNER_TOKEN" ]; then
    TOKEN="$DISK_OWNER_TOKEN"
fi

# ── CLI Tools identity policy (mirrors crates/k2-core cli_tool_policy) ──
# Static catalog defaults for the bash CLI (daemon overrides live in
# Settings → CLI Tools; locked tools cannot be Open). Pure helpers below
# are unit-testable via the BEGIN/END markers (see tests/cli/).
# BEGIN_CLI_TOOL_POLICY

# Map a top-level `k2 <verb>` to a catalog tool id (empty = ungoverned).
_cli_tool_id_for_verb() {
    case "${1:-}" in
        help|--help|-h|glossary|help-deprecated|help-internal|help-advanced) echo "help" ;;
        --schema|schema) echo "schema" ;;
        whats-new|whatsnew) echo "whats-new" ;;
        checkin|done|status) echo "checkin" ;;
        activity|feed) echo "activity" ;;
        read) echo "read" ;;
        skills) echo "skills" ;;
        msg|talk) echo "msg" ;;
        inbox) echo "inbox" ;;
        wiki) echo "wiki" ;;
        respond) echo "respond" ;;
        connections|reserve|release|roster|who) echo "connections" ;;
        heartbeat) echo "heartbeat" ;;
        mail|hostmail) echo "mail" ;;
        dns) echo "dns" ;;
        publish) echo "publish" ;;
        # Headless Connect account pairing (login/status/logout). Distinct
        # from publish (nested-subdomain control plane) so login is not
        # always attributed as the publish tool.
        connect) echo "connect-account" ;;
        sessions|terminal) echo "sessions-spawn" ;;
        fs) echo "fs" ;;
        daemon) echo "daemon-admin" ;;
        users) echo "users-admin" ;;
        api-key) echo "api-key" ;;
        # Remote Session owner/admin surface (Layer 0 + grants + shell PTY).
        # Locked id: cannot Open; needs owner/admin or grant token server-side.
        remote-session) echo "remote-session" ;;
        settings) echo "settings" ;;
        browser) echo "browser-open" ;;
        *) echo "" ;;
    esac
}

# Default identity mode for a tool id: open | id.
# Locked production tools are always id (cannot be Open in the catalog).
_cli_tool_default_mode() {
    case "${1:-}" in
        help|schema|whats-new|checkin|activity|read|skills|wiki|tools-policy|"") echo "open" ;;
        msg|inbox|respond|awareness|connections|heartbeat) echo "id" ;;
        mail|dns|publish|connect-account|sessions-spawn|fs|daemon-admin|users-admin|api-key|remote-session) echo "id" ;;
        browser-open|settings) echo "id" ;;
        *) echo "open" ;;
    esac
}

# True when the tool is a locked production floor (cannot be set Open).
_cli_tool_is_locked() {
    case "${1:-}" in
        mail|dns|publish|connect-account|sessions-spawn|fs|daemon-admin|users-admin|api-key|remote-session) return 0 ;;
        *) return 1 ;;
    esac
}

# Teaching error when an ID/locked verb has no session passport in-cell.
_cli_require_session_passport() {
    local tool_id="${1:-unknown}"
    echo "Error: tool '${tool_id}' requires session ID (passport)." >&2
    echo "Run from a K2 agent session that carries session identity, or ask the owner" >&2
    echo "to set this tool to Open in Settings → CLI Tools (if the platform allows)." >&2
    echo "Locked production tools cannot be set Open." >&2
    exit 3
}

# COMPAT-58 disk-token inversion — CONDITIONAL on tool mode.
# When K2_HOOK_SCOPED is on, the daemon injects a per-cell SCOPED token behind
# $K2_HOOK_TOKEN and the per-cell socket behind $K2_HOOK_SOCK.
#
#   Open tools  — re-source DISK OWNER for the TCP arm (migration ergonomics;
#                 scoped credentials still 403 on many owner-only TCP routes).
#   ID / locked — MUST NOT re-source ~/.k2/heartbeat.token. Keep SCOPED_TOKEN
#                 only; prefer per-cell UDS. No passport → exit 3.
#
# Outside a scoped cell (no $K2_HOOK_SOCK), disk owner discovery above is the
# human/external-terminal path and remains valid Owner proof for ID tools.
_cli_apply_auth_for_verb() {
    local verb="${1:-}"
    local tool_id mode
    tool_id="$(_cli_tool_id_for_verb "$verb")"
    mode="$(_cli_tool_default_mode "$tool_id")"
    local hook_sock="${K2_HOOK_SOCK:-${K2SO_HOOK_SOCK:-}}"

    if [ "$mode" = "id" ]; then
        if [ -n "$hook_sock" ]; then
            # In-cell / scoped-session marker: never elevate to disk owner.
            if [ -z "$SCOPED_TOKEN" ]; then
                _cli_require_session_passport "${tool_id:-$verb}"
            fi
            TOKEN="$SCOPED_TOKEN"
        fi
        # No hook sock → TOKEN already owner (external) or env; Owner OK for ID.
    else
        # Open / ungoverned: keep COMPAT-58 inversion for TCP ergonomics.
        if [ -n "$hook_sock" ] && [ -n "${DISK_OWNER_TOKEN:-}" ]; then
            TOKEN="$DISK_OWNER_TOKEN"
        fi
    fi
}

# END_CLI_TOOL_POLICY

# DAEMON_INSTALL_EARLY_BYPASS — `k2 daemon install` provisions the
# standalone daemon on a FRESH headless box where no daemon is running
# yet, so it cannot satisfy the PORT/TOKEN connection gate below (and
# doesn't need to: it talks only to GitHub + the filesystem). Skip the
# connection gate for it; the normal router dispatches it to
# cmd_daemon_install (which is defined before the router runs).
_skip_conn_gate=0
[ "${1:-}" = "daemon" ] && [ "${2:-}" = "install" ] && _skip_conn_gate=1
# `k2 publish ...` (Pro-subdomain mgmt) talks to the hosted control
# plane + reads ~/.k2/tunnel.json, so it must not be blocked by the
# no-daemon gate. (Its 0074 attribution seams — claim/unclaim + the
# create/point/rm stamps — DO talk to the local daemon, but check
# PORT/TOKEN themselves: stamps degrade to a warning, claim/unclaim
# fail loud.)
[ "${1:-}" = "publish" ] && _skip_conn_gate=1
# Headless Connect account commands: login talks to Supabase first
# (no daemon needed for the account step); status/logout can run from
# disk alone. Daemon-touching steps (tunnel/config + start) check
# PORT/TOKEN themselves and fail loud with a start-daemon hint.
[ "${1:-}" = "connect" ] && _skip_conn_gate=1
# `k2 --schema` (GH#8 #4) prints a STATIC command-surface manifest — it
# talks to nothing, so it must work even with no daemon running (its whole
# point is letting an agent load the CLI surface in one call).
[ "${1:-}" = "--schema" ] && _skip_conn_gate=1
[ "${1:-}" = "schema" ] && _skip_conn_gate=1

if [ "$_skip_conn_gate" != "1" ] && { [ -z "$PORT" ] || [ -z "$TOKEN" ]; }; then
    echo "Error: Cannot connect to K2." >&2
    echo "Either run this from a K2 terminal, or ensure K2 is running." >&2
    echo "(Connection details: ~/.k2/heartbeat.port and ~/.k2/heartbeat.token)" >&2
    exit 1
fi
unset _skip_conn_gate

BASE_URL="http://127.0.0.1:${PORT}"

# HTTP helper
cli_request() {
    local endpoint="$1"
    shift
    local params="token=${TOKEN}&project=$(urlencode "$PROJECT")"
    for param in "$@"; do
        params="${params}&${param}"
    done
    curl -sG "${BASE_URL}${endpoint}" \
        --connect-timeout 5 --max-time 30 \
        -d "$params" 2>/dev/null
}

# POST a JSON body. Used by /cli/awareness/publish (Phase 3).
# Token rides in the query string (the daemon parses it there
# before looking at the body). Caller supplies the full endpoint
# and the JSON body on stdin via a pipe, or as the second arg.
cli_post_json() {
    local endpoint="$1"
    local body="${2:-}"
    if [ -z "$body" ]; then
        body="$(cat)"
    fi
    curl -s -X POST "${BASE_URL}${endpoint}?token=${TOKEN}" \
        --connect-timeout 5 --max-time 30 \
        -H "Content-Type: application/json" \
        --data-raw "$body" 2>/dev/null
}

urlencode() {
    python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1], safe=''))" "$1" 2>/dev/null || echo "$1"
}

# 0.40.24 (B4): true when any argument is --help/-h. Used to intercept
# help requests on every workspace/connections/agent subcommand BEFORE
# the args reach a handler — `k2 workspace create --help` used to
# literally mkdir + register a workspace named `--help`.
_wants_help() {
    local a
    for a in "$@"; do
        case "$a" in
            --help|-h) return 0 ;;
        esac
    done
    return 1
}

# POST a form-encoded body (0.39.45, GH #35/#37/#29). Token + project
# ride the query string (the daemon's auth gate parses the query);
# everything else — message text, inbox title/body — rides the POST
# body so long payloads dodge the daemon's 16KB request-head cap that
# used to silently truncate query-string values at ~2.7KB. Callers pass
# pre-urlencoded `key=value` pairs, same contract as cli_request.
cli_post_form() {
    local endpoint="$1"
    shift
    local body=""
    for param in "$@"; do
        body="${body}${body:+&}${param}"
    done
    curl -s -X POST "${BASE_URL}${endpoint}?token=${TOKEN}&project=$(urlencode "$PROJECT")" \
        --connect-timeout 5 --max-time 30 \
        -H "Content-Type: application/x-www-form-urlencoded" \
        --data-raw "$body" 2>/dev/null
}

# ── #58 Phase-1 close: scoped per-cell UDS arms ──────────────────────────
# These mirror cli_request / cli_post_form / cli_post_json but talk over the
# per-cell Unix socket ($K2_HOOK_SOCK) with the SCOPED token as a Bearer
# header. They deliberately OMIT `token=` (Bearer instead) and `project=` /
# `from=` (the daemon stamps the sender identity + the agent's own-workspace
# path SERVER-SIDE from the socket-bound principal — the body is never
# trusted for identity). Recipient/routing args (`workspace=`, inbox `id=`,
# etc.) are passed through by the caller exactly as for the TCP arms.
_hook_sock() { echo "${K2_HOOK_SOCK:-${K2SO_HOOK_SOCK:-}}"; }

cli_request_uds() {
    local endpoint="$1"; shift
    local params=""
    for param in "$@"; do params="${params}${params:+&}${param}"; done
    curl -sG --unix-socket "$(_hook_sock)" "http://localhost${endpoint}" \
        --connect-timeout 5 --max-time 30 \
        -H "Authorization: Bearer ${SCOPED_TOKEN}" \
        ${params:+-d "$params"} 2>/dev/null
}

cli_post_form_uds() {
    local endpoint="$1"; shift
    local body=""
    for param in "$@"; do body="${body}${body:+&}${param}"; done
    curl -s -X POST --unix-socket "$(_hook_sock)" "http://localhost${endpoint}" \
        --connect-timeout 5 --max-time 30 \
        -H "Authorization: Bearer ${SCOPED_TOKEN}" \
        -H "Content-Type: application/x-www-form-urlencoded" \
        --data-raw "$body" 2>/dev/null
}

cli_post_json_uds() {
    local endpoint="$1"
    local body="${2:-}"
    if [ -z "$body" ]; then body="$(cat)"; fi
    curl -s -X POST --unix-socket "$(_hook_sock)" "http://localhost${endpoint}" \
        --connect-timeout 5 --max-time 30 \
        -H "Authorization: Bearer ${SCOPED_TOKEN}" \
        -H "Content-Type: application/json" \
        --data-raw "$body" 2>/dev/null
}

# Verbs the scoped per-cell socket actually serves (the daemon allowlist).
# Anything else stays on TCP+owner.
_uds_eligible() {
    case "$1" in
        /cli/workspace/msg|/cli/awareness/publish) return 0 ;;
        # C2: peer-gated live terminal peek (k2 read <ws>).
        /cli/terminal/read) return 0 ;;
        /cli/inbox/*|/cli/review-checklist/*) return 0 ;;
        # DNS K1 — cell_server serves /cli/dns/* POSTs + is_agent_verb GETs.
        /cli/dns/*) return 0 ;;
        # C1 — connections list/add/remove (mutate toggle-gated server-side).
        /cli/connections) return 0 ;;
        # PR1 federation dual-auth — peers/peer-roster/send under passport.
        # pair/confirm stay TCP owner-or-admin only (not here).
        /cli/federation/peers|/cli/federation/peer-roster|/cli/federation/send) return 0 ;;
        # Named heartbeat schedule CRUD + fire/status (agent-owned workspace
        # schedules). OS tick install + fleet-wide list stay TCP owner-only.
        /cli/heartbeat/install-launchd|/cli/heartbeat/uninstall-launchd|/cli/heartbeat/apply-wake-scheduler) return 1 ;;
        /cli/heartbeat/list-all|/cli/heartbeat/fires-list-all|/cli/heartbeat/set-show-sessions) return 1 ;;
        /cli/heartbeat/*|/cli/heartbeat-log) return 0 ;;
        *) return 1 ;;
    esac
}

# cli_send <tcp_fn> <endpoint> [args...] — channel selector.
# When a per-cell scoped socket is present AND the endpoint is UDS-eligible,
# try the matching `<tcp_fn>_uds` arm; on success (rc==0, non-empty, and NOT
# the daemon's "route not served on cell socket" 404 sentinel) print + return.
# Otherwise fall through to the TCP arm `<tcp_fn>`.
#   UDS arm  → $SCOPED_TOKEN (Bearer)
#   TCP arm  → $TOKEN, which _cli_apply_auth_for_verb already chose:
#              Open tools may be disk-owner (COMPAT-58); ID/locked tools are
#              SCOPED_TOKEN only (never the owner inversion).
cli_send() {
    local fn="$1" endpoint="$2"; shift 2
    local sock; sock="$(_hook_sock)"
    if [ -n "$sock" ] && [ -S "$sock" ] && _uds_eligible "$endpoint"; then
        local out rc
        out="$("${fn}_uds" "$endpoint" "$@")"; rc=$?
        if [ "$rc" -eq 0 ] && [ -n "$out" ] && [[ "$out" != *"not served on cell socket"* ]]; then
            printf '%s' "$out"
            return 0
        fi
    fi
    "$fn" "$endpoint" "$@"
}

# ── F2 (sandbox cell + HOST session) — k2 respond ────────────────────
# `k2 respond [--final] <message>` — the in-session agent's RESPONSE
# egress. Posts a curated line to THIS session's response log; the
# external API caller drains it via
# `GET /v1/sandboxes/<id>/messages` (cells) or
# `GET /v1/w/<ws>/host-sessions/<id>/messages` (host sessions). The
# agent itself decides how many times to respond and when (`--final`
# marks the turn's last line) — multi-emit, like a person narrating.
#
# Transport (in preference order):
#   1. Per-cell UDS ($K2_HOOK_SOCK) + scoped Bearer — sandbox cells and
#      scoped host sessions where the socket bound.
#   2. Loopback TCP `/cli/respond` + scoped Bearer — HOST sessions
#      (prd-v1-api-completion §4). The daemon accepts ONLY a scoped
#      per-session token here (session identity comes from the token),
#      so this needs K2_HOOK_SCOPED on the daemon; the owner token is
#      REFUSED by design and we never fall back to it (it names no
#      session — a scoped token is structurally `<sid>.<secret>`).
# Outside any scoped session this errors loudly.
cmd_respond() {
    local final="0"
    while [ $# -gt 0 ]; do
        case "$1" in
            --final) final="1"; shift ;;
            --help|-h)
                echo "Usage: k2 respond [--final] <message>"
                echo "  Send a response line from inside an API-launched session to the API caller."
                echo "  Call it as many times as you like as you work; --final marks the last."
                return 0 ;;
            --) shift; break ;;
            *) break ;;
        esac
    done
    local message="$*"
    if [ -z "$message" ]; then
        echo "Usage: k2 respond [--final] <message>" >&2
        return 1
    fi
    local sock; sock="$(_hook_sock)"
    if [ -n "$sock" ] && [ -S "$sock" ]; then
        cli_post_form_uds "/cli/respond" "message=$(urlencode "$message")" "final=${final}"
        return $?
    fi
    # HOST session (no per-cell socket): loopback TCP with the SCOPED
    # token as Bearer. Only a scoped token (shape `<sid>.<secret>`)
    # carries session identity — with none present, fail loudly.
    if [[ "$SCOPED_TOKEN" == *.* ]] && [ -n "$PORT" ]; then
        curl -s -X POST "${BASE_URL}/cli/respond" \
            --connect-timeout 5 --max-time 30 \
            -H "Authorization: Bearer ${SCOPED_TOKEN}" \
            -H "Content-Type: application/x-www-form-urlencoded" \
            --data-raw "message=$(urlencode "$message")&final=${final}" 2>/dev/null
        return $?
    fi
    echo "Error: 'k2 respond' needs an API-launched session (per-cell socket or scoped session token)." >&2
    return 1
}

# ── Remote target addressing (K2-as-a-server, 0.40.x) ────────────────
# `k2 talk <ws>@<subdomain>` / `k2 read <ws>@<host>` address a workspace
# on a CONNECTED remote daemon over K2 Connect — the SAME model as local
# workspace<->workspace agent talk, just pointed at a remote base URL.
# We split off the @host, repoint BASE_URL at https://<host>, and swap
# TOKEN for that host's owner token. Every existing cli_request /
# cli_post_* call then routes to the remote daemon with NO call-site
# change: the remote daemon resolves the workspace name against ITS own
# projects (canonical session by default; --session <id> targets a
# specific one). No daemon change — all routes used already exist and are
# reachable over the tunnel with the owner token.
_REMOTE_HOST=""
_BARE_TARGET=""
# PR2 addressing flags (set by _split_remote_target):
#   _IS_WIRE_FORM=1   → 3-part fp::ws::agent (fed send only)
#   _USED_LEGACY_AT=1 → peeled via legacy agent@host
_IS_WIRE_FORM=0
_USED_LEGACY_AT=0
# One-shot stderr hint when agents use @ federated form (prefer ::).
_FED_AT_HINT_SHOWN=0
# Split a remote user address into globals:
#   _BARE_TARGET  — agent/workspace token (host stripped)
#   _REMOTE_HOST  — host, or "" when local
#   _IS_WIRE_FORM / _USED_LEGACY_AT — see above
# Callers MUST invoke it directly (NOT in a "$(...)" subshell).
#
# Grammar (PR2 / GH #47):
#   agent::host.k2.dev  → user remote (2-part ::, host looks like host)
#   agent@host          → legacy user remote
#   fp::ws::agent       → wire form (3-part; not peeled as user remote)
#   bare name           → local
_split_remote_target() {
    local raw="$1"
    _REMOTE_HOST=""
    _BARE_TARGET="$raw"
    _IS_WIRE_FORM=0
    _USED_LEGACY_AT=0

    # 3+ part wire form: at least two '::' separators.
    if [[ "$raw" == *::*::* ]]; then
        _IS_WIRE_FORM=1
        return
    fi

    # 2-part user form agent::host (RHS must look like a host).
    if [[ "$raw" == *::* ]]; then
        local left="${raw%%::*}"
        local right="${raw#*::}"
        if [ -n "$left" ] && [ -n "$right" ] && { [[ "$right" == *.* ]] || [[ "$right" == *.k2.dev ]] || [[ "$right" == *.K2.DEV ]]; }; then
            _BARE_TARGET="$left"
            _REMOTE_HOST="$right"
            return
        fi
        # Not host-like → leave as bare local token.
        return
    fi

    # Legacy agent@host (split on LAST '@').
    case "$raw" in
        *@*)
            _REMOTE_HOST="${raw##*@}"
            _BARE_TARGET="${raw%@*}"
            _USED_LEGACY_AT=1
            ;;
    esac
}

# ── Cross-server agent msg over FEDERATION ────────────────────────────
# `k2 msg <agent>::<host> "text"` (canonical) or legacy `agent@host` routes a
# CONNECTED cross-server peer over federation — the SAME verb agents use for
# a local peer. This is the federation send-surface (gated on
# `is_remote_connection`), NOT the owner-remote drive-the-box path that
# `k2 talk <ws>@<host>` uses.
#
# PR1: uses scoped passport via cli_send (UDS when eligible, else TCP with
# TOKEN which for msg/ID is SCOPED_TOKEN — never disk-owner inversion).
# Daemon forces from_workspace from principal when scoped.
# PR2: prefer agent::host; wire form fp::ws::agent stays on `k2 fed send`.
#
# Args: <agent> <host> <text> <from_project>. Returns:
#   0  delivered ("sent") or durably queued ("queued")
#   3  not_connected / forbidden (mail/C2 teaching parity)
#   2  actionable user error (fed off, no peer, not trusted, no agent)
#   1  unexpected/unparseable daemon response
#
# Steps: resolve the peer by matching "<subdomain>.k2.dev" == <host> in
# /cli/federation/peers (capture fingerprint) → resolve the agent's
# workspace_id from that peer's /cli/federation/peer-roster → POST
# /cli/federation/send with to="<fp>::<wsid>::<agent>". All parsing is
# python3 (consistent with the rest of this CLI).
_send_remote_msg() {
    local agent="$1" host="$2" text="$3" from_project="$4"

    if [ -z "$agent" ]; then
        echo "k2 msg: empty agent name in '<agent>::<host>' target." >&2
        return 2
    fi
    if [ -z "$host" ]; then
        echo "k2 msg: empty host in '<agent>::<host>' target." >&2
        return 2
    fi

    # Optional one-shot compat hint when the caller used legacy @ form.
    if [ "${_USED_LEGACY_AT:-0}" = "1" ] && [ "${_FED_AT_HINT_SHOWN:-0}" = "0" ]; then
        echo "hint: prefer \`k2 msg ${agent}::${host}\` — '@' federated addresses are legacy compat (not email)." >&2
        _FED_AT_HINT_SHOWN=1
    fi

    # 1. Resolve the peer by host (subdomain.k2.dev == host) → fingerprint.
    # cli_send: prefer cell UDS + scoped Bearer when present.
    local peers_json
    peers_json=$(cli_send cli_request "/cli/federation/peers")
    local pmatch
    pmatch=$(printf '%s' "$peers_json" | python3 -c '
import json, sys
host = (sys.argv[1] or "").strip().lower()
# Accept bare subdomain or full host.k2.dev (and collapse accidental doubles).
def bare(h):
    h = (h or "").strip().lower()
    while h.endswith(".k2.dev.k2.dev"):
        h = h[: -len(".k2.dev")]
    if h.endswith(".k2.dev"):
        h = h[: -len(".k2.dev")]
    return h
want = bare(host)
try:
    d = json.load(sys.stdin)
except Exception:
    print("ERR\tparse"); sys.exit(0)
if not isinstance(d, dict) or not isinstance(d.get("peers"), list):
    # federation off (404 {"error":...}) or unexpected shape
    err = d.get("error") if isinstance(d, dict) else None
    if isinstance(err, dict) and err.get("code") in ("forbidden", "not_connected"):
        print("FORBIDDEN\t%s" % (err.get("hint") or err.get("code") or ""))
        sys.exit(0)
    if isinstance(d, dict) and d.get("error"):
        print("NOFED\t%s" % (d.get("error") if not isinstance(d.get("error"), dict) else d["error"].get("hint") or d["error"]))
        sys.exit(0)
    print("NOFED"); sys.exit(0)
for p in d["peers"]:
    sub = p.get("subdomain") or ""
    label = p.get("label") or ""
    if want and bare(sub) == want:
        print("OK\t%s\t%s" % (p.get("fingerprint", ""), p.get("trust", "")))
        sys.exit(0)
    # Also match full host forms stored as subdomain
    if host and sub and sub.lower() in (host, host + ".k2.dev", want + ".k2.dev"):
        print("OK\t%s\t%s" % (p.get("fingerprint", ""), p.get("trust", "")))
        sys.exit(0)
    if want and bare(label) == want:
        print("OK\t%s\t%s" % (p.get("fingerprint", ""), p.get("trust", "")))
        sys.exit(0)
# List known peer hosts so the NONE error is actionable (GH #48).
known = []
for p in d["peers"]:
    sub = (p.get("subdomain") or "").strip()
    if sub:
        known.append(sub if sub.endswith(".k2.dev") else sub + ".k2.dev")
    elif p.get("label"):
        known.append(str(p.get("label")))
print("NONE\t%s" % (", ".join(known) if known else ""))
' "$host")

    local pkind fp trust
    IFS=$'\t' read -r pkind fp trust <<<"$pmatch"
    case "$pkind" in
        FORBIDDEN)
            # Scoped token rejected (should not happen post-PR1) or other gate.
            printf '%s\n' "${fp:-forbidden}" >&2
            return 3 ;;
        NOFED|ERR)
            echo "federation is off or unreachable on $host — enable it and pair first (k2 fed enable / k2 fed pair-request)." >&2
            [ -n "$fp" ] && [ "$pkind" = "NOFED" ] && echo "detail: $fp" >&2
            return 2 ;;
        NONE)
            # GH #48: inbound may have landed while this side never stored a
            # return pin, or the host string doesn't match the peer's subdomain.
            if [ -n "$fp" ]; then
                echo "no paired peer matching $host — known peers: $fp" >&2
                echo "hint: run \`k2 fed peers\` to inspect trust; if you received a message from this host but have no pin, complete pairing (k2 fed pair-request / confirm) so replies can go back." >&2
            else
                echo "no paired peer for $host — pair it first (k2 fed pair-request / confirm), or check the host." >&2
                echo "hint: run \`k2 fed peers\` to list trusted servers on this machine." >&2
            fi
            return 2 ;;
        OK) ;;
        *)
            echo "k2 msg: could not read federation peers from the local daemon." >&2
            return 2 ;;
    esac
    if [ -z "$fp" ]; then
        echo "no paired peer for $host — pair it first (k2 fed pair-request / confirm), or check the host." >&2
        return 2
    fi
    # Trust serializes lowercase ("trusted") on the wire — compare case-insensitively.
    local trust_lc
    trust_lc=$(printf '%s' "$trust" | tr '[:upper:]' '[:lower:]')
    if [ -n "$trust_lc" ] && [ "$trust_lc" != "trusted" ]; then
        echo "peer $host is not trusted yet (state=$trust) — confirm the pairing (k2 fed confirm)." >&2
        return 2
    fi

    # 2. Resolve the agent's workspace_id from that peer's roster.
    local roster_json
    roster_json=$(cli_send cli_request "/cli/federation/peer-roster" "peer=$(urlencode "$fp")")
    local rres
    rres=$(printf '%s' "$roster_json" | python3 -c '
import json, sys
agent = sys.argv[1]
try:
    d = json.load(sys.stdin)
except Exception:
    print("ERR\tparse"); sys.exit(0)
if not isinstance(d, dict):
    print("ERR\t"); sys.exit(0)
if "error" in d:
    err = d.get("error")
    if isinstance(err, dict) and err.get("code") in ("forbidden", "not_connected"):
        print("FORBIDDEN\t%s" % (err.get("hint") or err.get("code") or ""))
        sys.exit(0)
    print("ERR\t%s" % (err if not isinstance(err, dict) else err.get("hint") or err.get("code") or err))
    sys.exit(0)
roster = d.get("roster") or {}
agents = roster.get("agents") or []
agent_lc = (agent or "").strip().lower()
matches = [a for a in agents if (a.get("agent") or "").strip().lower() == agent_lc]
if not matches:
    names = ", ".join(a.get("agent", "?") for a in agents)
    print("NONE\t%s" % names); sys.exit(0)
if len(matches) > 1:
    info = "; ".join("%s (%s)" % (a.get("workspace_name", "?"), a.get("workspace_id", "?")) for a in matches)
    print("AMBIG\t%s" % info); sys.exit(0)
print("OK\t%s" % (matches[0].get("workspace_id", "") or ""))
' "$agent")

    local rkind rdetail
    rkind="${rres%%$'\t'*}"
    rdetail="${rres#*$'\t'}"
    [ "$rdetail" = "$rres" ] && rdetail=""
    case "$rkind" in
        FORBIDDEN)
            # Teaching JSON shape parity with local msg/read exit 3.
            python3 -c 'import json,sys
hint=sys.argv[1] or "forbidden"
sys.stderr.write(json.dumps({"error":{"code":"forbidden","hint":hint}},
                            ensure_ascii=False,separators=(",",":"))+"\n")
' "$rdetail" 2>/dev/null || echo "${rdetail:-forbidden}" >&2
            return 3 ;;
        ERR)
            echo "could not reach $host's roster: ${rdetail:-$roster_json}" >&2
            return 2 ;;
        NONE)
            if [ -n "$rdetail" ]; then
                echo "no agent \"$agent\" on $host. Available: $rdetail." >&2
            else
                echo "no agent \"$agent\" on $host (its roster is empty)." >&2
            fi
            return 2 ;;
        AMBIG)
            echo "ambiguous agent \"$agent\" on $host — multiple workspaces expose it: $rdetail. Disambiguate on the host." >&2
            return 2 ;;
        OK) ;;
        *)
            echo "could not parse $host's roster." >&2
            return 2 ;;
    esac
    local wsid="$rdetail"
    if [ -z "$wsid" ]; then
        echo "no resolvable workspace for agent \"$agent\" on $host." >&2
        return 2
    fi

    # 3. Send. Build the body safely with python3 (mirrors cmd_fed send).
    # from_workspace is best-effort for owner path; scoped principal forces it
    # server-side from the passport (body spoof ignored).
    local body resp
    body=$(python3 -c 'import json,sys; print(json.dumps({"to":sys.argv[1],"text":sys.argv[2],"from_workspace":sys.argv[3]}))' \
        "${fp}::${wsid}::${agent}" "$text" "$from_project")
    resp=$(cli_send cli_post_json "/cli/federation/send" "$body")

    # 4. Surface the response.
    # not_connected / forbidden → exit 3 + teaching (mail/C2 parity).
    local sres skind sdetail
    sres=$(printf '%s' "$resp" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    print("RAW"); sys.exit(0)
if not isinstance(d, dict):
    print("RAW"); sys.exit(0)
err = d.get("error")
if isinstance(err, dict):
    code = err.get("code") or ""
    hint = err.get("hint") or code
    if code in ("not_connected", "gated", "forbidden"):
        # Emit teaching JSON on stderr via GATE line; CLI maps to exit 3.
        print("GATE\t%s\t%s" % (code, hint)); sys.exit(0)
    print("ERROR\t%s" % (hint or code or err)); sys.exit(0)
if err is not None and not isinstance(err, dict):
    print("ERROR\t%s" % err); sys.exit(0)
st = d.get("status", "")
if st == "sent":
    print("SENT"); sys.exit(0)
if st == "queued":
    print("QUEUED\t%s" % (d.get("hint", "") or "")); sys.exit(0)
if st == "declined":
    print("ERROR\t%s" % (d.get("reason") or "declined by peer")); sys.exit(0)
print("OTHER")
')
    skind="${sres%%$'\t'*}"
    sdetail="${sres#*$'\t'}"
    [ "$sdetail" = "$sres" ] && sdetail=""
    case "$skind" in
        SENT)
            echo "delivered to ${agent}::${host} (federation)"
            return 0 ;;
        QUEUED)
            echo "${sdetail:-queued for ${agent}::${host} — peer briefly unreachable, will deliver when it reconnects (federation)}" >&2
            return 0 ;;
        GATE)
            # sdetail is "code\thint" after first tab split above left "code\thint"
            local gcode ghint
            gcode="${sdetail%%$'\t'*}"
            ghint="${sdetail#*$'\t'}"
            [ "$ghint" = "$sdetail" ] && ghint="$gcode"
            python3 -c 'import json,sys
code,hint=sys.argv[1],sys.argv[2]
sys.stderr.write(json.dumps({"error":{"code":code,"hint":hint}},
                            ensure_ascii=False,separators=(",",":"))+"\n")
' "$gcode" "$ghint"
            return 3 ;;
        ERROR)
            echo "${sdetail:-$resp}" >&2
            return 2 ;;
        *)
            echo "k2 msg: unexpected daemon response: $resp" >&2
            return 1 ;;
    esac
}

# Resolve the owner token for a remote host. Precedence:
#   1. explicit --token (arg $2)   2. $K2_REMOTE_TOKEN
#   3. ~/.k2/connect-tokens.json  { "<host>": "<token>", ... }
# Echoes the token (empty when none found). connect-hosts.json is the
# non-secret address book (no tokens by invariant); this sibling file is
# the CLI-readable token store, 0600.
_remote_token_for_host() {
    local host="$1" explicit="${2:-}"
    if [ -n "$explicit" ]; then printf '%s' "$explicit"; return 0; fi
    if [ -n "${K2_REMOTE_TOKEN:-}" ]; then printf '%s' "$K2_REMOTE_TOKEN"; return 0; fi
    local f="${K2_HOME}/connect-tokens.json"
    if [ -f "$f" ] && command -v python3 >/dev/null 2>&1; then
        python3 -c "
import json,sys
try:
    print(json.load(open('''$f''')).get('''$host''','') or '')
except Exception:
    pass" 2>/dev/null
    fi
}

# Point the HTTP helpers at a remote host for the rest of this command
# (overrides the globals BASE_URL + TOKEN). No-op for a local target.
# Non-zero + stderr hint when no token is available.
_apply_remote_host() {
    local host="$1" explicit_token="${2:-}"
    [ -z "$host" ] && return 0
    local tok
    tok="$(_remote_token_for_host "$host" "$explicit_token")"
    if [ -z "$tok" ]; then
        echo "Error: no owner token for remote host '$host'." >&2
        echo "Pass --token <tok>, set \$K2_REMOTE_TOKEN, or add it to ${K2_HOME}/connect-tokens.json ({\"$host\": \"<token>\"})." >&2
        return 1
    fi
    case "$host" in
        http://*|https://*) BASE_URL="${host%/}" ;;
        *)                  BASE_URL="https://${host}" ;;
    esac
    TOKEN="$tok"
    return 0
}

