{
  "$defs": {
    "DigestAvailability": {
      "description": "Whether the member gets an email digest, and why not.",
      "properties": {
        "available": {
          "description": "A digest can be sent to this member now.",
          "type": "boolean"
        },
        "interval": {
          "$ref": "#/$defs/DigestInterval",
          "description": "The member's interval."
        },
        "reason": {
          "description": "Why not: `policy_off`, `mail_unconfigured`, `no_email`, `agent`, `interval_off`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "interval",
        "available"
      ],
      "type": "object"
    },
    "DigestInterval": {
      "description": "How often the email digest may be sent (`notify_settings.digest_interval` codes 0–3).",
      "oneOf": [
        {
          "const": "off",
          "description": "No digest.",
          "type": "string"
        },
        {
          "const": "15m",
          "description": "At most every 15 minutes.",
          "type": "string"
        },
        {
          "const": "1h",
          "description": "At most every hour (the default).",
          "type": "string"
        },
        {
          "const": "1d",
          "description": "At most every day.",
          "type": "string"
        }
      ]
    },
    "NotifyLevel": {
      "description": "A notification level (`*.level` codes 1–3).",
      "oneOf": [
        {
          "const": "all",
          "description": "Every message.",
          "type": "string"
        },
        {
          "const": "mentions",
          "description": "Mentions, DMs, keywords and followed threads.",
          "type": "string"
        },
        {
          "const": "none",
          "description": "Nothing (reminders still arrive).",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The member's account-level notification settings (`GET /api/v1/me/notify`).",
  "properties": {
    "broad_mentions": {
      "description": "`@channel` and `@here` notify.",
      "type": "boolean"
    },
    "default_level": {
      "anyOf": [
        {
          "$ref": "#/$defs/NotifyLevel"
        },
        {
          "type": "null"
        }
      ],
      "description": "The account default; `null` = the install default."
    },
    "digest": {
      "$ref": "#/$defs/DigestAvailability",
      "description": "The email digest."
    },
    "effective_default_level": {
      "$ref": "#/$defs/NotifyLevel",
      "description": "What space channels fall back to for this member."
    },
    "keyword_count": {
      "description": "How many keywords are set.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "keywords": {
      "description": "The keywords (only in `GET /me/notify` and `POST /me/notify/set`; never in READY or\nevents).",
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "mute_lets_mentions": {
      "description": "Direct mentions still notify in muted channels.",
      "type": "boolean"
    },
    "rev": {
      "description": "Bumped by every change (`if_rev`).",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "thread_replies": {
      "description": "Replies in followed threads notify.",
      "type": "boolean"
    }
  },
  "required": [
    "effective_default_level",
    "thread_replies",
    "broad_mentions",
    "mute_lets_mentions",
    "digest",
    "keyword_count",
    "rev"
  ],
  "title": "NotifySettings",
  "type": "object"
}
