{
  "$defs": {
    "AuditVerifyMode": {
      "description": "Where an audit chain check starts.",
      "oneOf": [
        {
          "const": "incremental",
          "description": "From the last saved checkpoint (the daily schedule's mode).",
          "type": "string"
        },
        {
          "const": "full",
          "description": "The whole chain from `chain_seq` 1.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "What an `audit_verify` job found: `JobStatus.result` of a succeeded `audit_verify` job. A\nbroken chain is a successful job whose report has `broken_at`.",
  "properties": {
    "broken_at": {
      "description": "The first failing `chain_seq`; `null` when the chain is intact.",
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "checked": {
      "description": "Events that passed.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "head_hash": {
      "description": "Its hash, 64 lowercase hex chars.",
      "type": "string"
    },
    "head_seq": {
      "description": "The last good `chain_seq`.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "mode": {
      "$ref": "#/$defs/AuditVerifyMode",
      "description": "Incremental or full."
    },
    "reason": {
      "description": "Why it failed; `null` when the chain is intact.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "mode",
    "checked",
    "head_seq",
    "head_hash"
  ],
  "title": "AuditVerifyReport",
  "type": "object"
}
