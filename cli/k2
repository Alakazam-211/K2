    [ -z "$name" ] && { echo "Usage: k2 heartbeat enable|disable <name>" >&2; exit 1; }
    # GH#27: this used to print "Heartbeat 'x' trued/falsed" and swallowed
    # daemon errors (> /dev/null). Surface {"error"} with exit 1 and say
    # Enabled/Disabled like a human would.
