    "Actor": {
      "description": "Who performed an audited action.",
      "properties": {
        "ip": {
          "description": "The client IP.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/ActorKind",
          "description": "What kind of principal acted."
        },
        "member_id": {
          "description": "The acting member, when a member acted.",
          "pattern": "^[1-9][0-9]{0,18}$",
          "type": [
            "string",
            "null"
          ]
        },
        "on_behalf_of": {
          "description": "For an assistant, the member id of its person.",
          "pattern": "^[1-9][0-9]{0,18}$",
          "type": [
            "string",
            "null"
          ]
        },
        "peer_uid": {
          "description": "The mgmt caller's `SO_PEERCRED` uid.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "via": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActorVia"
            },
            {
              "type": "null"
            }
          ],
          "description": "Set on act-as calls."
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "ActorKind": {
      "description": "What kind of principal acted.",
      "oneOf": [
        {
          "const": "person",
          "description": "A person member.",
          "type": "string"
        },
        {
          "const": "agent",
          "description": "An agent member.",
          "type": "string"
        },
        {
          "const": "service",
          "description": "The mgmt service (K2's daemon or the `sew` CLI).",
          "type": "string"
        },
        {
          "const": "system",
          "description": "Sew itself (jobs).",
          "type": "string"
        }
      ]
    },
    "ActorVia": {
      "description": "How an act-as call reached Sew (C9): through K2, for an agent, in a K2 session.",
      "properties": {
        "agent": {
          "description": "The K2 workspace uuid of the agent.",
          "type": "string"
        },
        "k2_session": {
          "description": "The K2 session id.",
          "type": "string"
        },
        "system": {
          "description": "The delegating system; `\"k2\"` in v1.",
          "type": "string"
        }
      },
      "required": [
        "system",
        "agent",
        "k2_session"
      ],
      "type": "object"
    },
    "AuditEvent": {
      "description": "One row of the append-only audit log (C14).",
      "properties": {
        "action": {
          "$ref": "#/$defs/Action",
          "description": "What was done."
        },
        "actor": {
          "$ref": "#/$defs/Actor",
          "description": "Who acted."
        },
        "at": {
          "description": "When it happened.",
          "format": "date-time",
          "type": "string"
        },
        "channel_id": {
          "description": "The channel involved.",
          "pattern": "^[1-9][0-9]{0,18}$",
          "type": [
            "string",
            "null"
          ]
        },
        "details": {
          "additionalProperties": true,
          "default": {},
          "description": "Ids, names, old and new values, permission bits. Never content.",
          "type": "object"
        },
        "id": {
          "description": "The event id.",
          "pattern": "^[1-9][0-9]{0,18}$",
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/AuditResult",
          "description": "How it ended."
        },
        "space_id": {
          "description": "The space involved.",
          "pattern": "^[1-9][0-9]{0,18}$",
          "type": [
            "string",
            "null"
          ]
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuditTarget"
            },
            {
              "type": "null"
            }
          ],
          "description": "What it touched; absent when there is no target (for example a failed login)."
        }
      },
      "required": [
        "id",
        "at",
        "actor",
        "action",
        "result"
      ],
      "type": "object"
    },
    "AuditResult": {
      "description": "How an audited action ended.",
      "oneOf": [
        {
          "const": "ok",
          "description": "It succeeded.",
          "type": "string"
        },
        {
          "const": "denied",
          "description": "A permission or policy check refused it.",
          "type": "string"
        },
        {
          "const": "error",
          "description": "It failed.",
          "type": "string"
        }
      ]
    },
    "AuditTarget": {
      "description": "What an audited action touched.",
      "properties": {
        "id": {
          "description": "The entity id.",
          "pattern": "^[1-9][0-9]{0,18}$",
          "type": "string"
        },
        "kind": {
          "description": "The entity kind, `lower_snake` (for example `channel`).",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One chained audit row.",
  "properties": {
    "chain_seq": {
      "description": "Its chain position.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "event": {
      "$ref": "#/$defs/AuditEvent",
      "description": "The stored event."
    },
    "hash": {
      "description": "Its hash, 64 hex.",
      "type": "string"
    },
    "prev_hash": {
      "description": "The previous row's hash, 64 hex.",
      "type": "string"
    }
  },
  "required": [
    "chain_seq",
    "hash",
    "prev_hash",
    "event"
  ],
  "title": "AuditEntry",
  "type": "object"
}
