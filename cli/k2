cmd_inbox_folders() {
    cli_send cli_request "/cli/inbox/folders" | python3 -c "
import json, sys
try:
    folders = json.loads(sys.stdin.read() or '[]')
except Exception:
    folders = []
if not folders:
    print('No folders yet. Create one by moving an item:')
    print('  k2 inbox move <id> projects')
else:
    for f in folders:
        print('  ' + f)
