{
 "agentAccess": "values",
 "everySecs": 60,
 "extract": {
  "aggregates": {
   "past_due": {
    "op": "count"
   },
   "past_due_not_kept": {
    "cond": {
     "eq": false
    },
    "field": "keep_live",
    "op": "countWhere"
   }
  },
  "counts": {
   "canceled_routing": "/billing/canceled_but_routing"
  },
  "fields": {
   "canceled_routing_first": "/billing/canceled_but_routing/0",
   "canceled_routing_first_label": "/billing/canceled_but_routing/0/label",
   "date_diffs": "/billing/reconcile/date_diffs",
   "error": "/billing/error",
   "missing_period_end": "/billing/subdomains/missing_period_end",
   "reconcile_error": "/billing/reconcile/error",
   "reconcile_ok": "/billing/reconcile/ok",
   "reconcile_ts": "/billing/reconcile/ts",
   "srv_active": "/billing/servers/by_stripe_status/active",
   "srv_past_due": "/billing/servers/by_stripe_status/past_due",
   "status_diffs": "/billing/reconcile/status_diffs",
   "sub_active": "/billing/subdomains/by_stripe_status/active",
   "sub_canceled": "/billing/subdomains/by_stripe_status/canceled",
   "sub_past_due": "/billing/subdomains/by_stripe_status/past_due",
   "suspended": "/billing/subdomains/suspended",
   "ts": "/billing/ts",
   "would_cancel": "/billing/reconcile/would_cancel",
   "would_restore": "/billing/reconcile/would_restore",
   "write_mode": "/billing/reconcile/write_mode"
  },
  "items": {
   "itemFields": {
    "keep_live": "/keep_live"
   },
   "itemKey": "/label",
   "pointer": "/billing/past_due"
  },
  "lists": {
   "canceled": {
    "itemFields": {
     "canceled_label": "/label"
    },
    "itemKey": "/label",
    "pointer": "/billing/canceled_but_routing"
   }
  },
  "trend": [
   "past_due",
   "sub_past_due"
  ]
 },
 "failAfter": 3,
 "fetch": {
  "url": "https://ops.example.test/api/ops/fleet?part=billing"
 },
 "headers": [],
 "keep": "values",
 "label": "Ops: billing and reconcile",
 "link": null,
 "name": "k2-ops-billing",
 "onTargetError": "crit",
 "rules": [
  {
   "field": "keep_live",
   "ok": {
    "eq": true
   },
   "warn": {
    "eq": false
   },
   "warnAfter": 1
  },
  {
   "crit": {
    "gt": 0
   },
   "field": "canceled_routing",
   "ok": {
    "eq": 0
   }
  },
  {
   "crit": {
    "exists": true
   },
   "field": "canceled_label"
  },
  {
   "crit": {
    "eq": false
   },
   "field": "reconcile_ok",
   "ok": {
    "eq": true
   }
  },
  {
   "field": "reconcile_ts",
   "ok": {
    "ageLt": 7200
   },
   "warn": {
    "ageGt": 7200
   }
  },
  {
   "field": "reconcile_ts",
   "warn": {
    "exists": false
   }
  },
  {
   "field": "missing_period_end",
   "ok": {
    "eq": 0
   },
   "warn": {
    "gt": 0
   }
  },
  {
   "crit": {
    "ageGt": 900
   },
   "field": "ts",
   "ok": {
    "ageLt": 300
   },
   "warn": {
    "ageGt": 300
   }
  },
  {
   "field": "ts",
   "warn": {
    "exists": false
   }
  }
 ],
 "secret": "OPS_READ_TOKEN",
 "timeoutSecs": 10,
 "viewers": "admin"
}
