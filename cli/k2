cmd_app_key_mint() {
    local app="" scopes="" rooms="" roles="" label="" show=0 json_out=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --scopes|--scope) scopes="${2:-}"; shift 2 ;;
