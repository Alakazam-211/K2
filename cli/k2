        elif d.get("policy") == "applied":
            policy = "set by the owner"
            if d.get("backfilledAt") is None:
                policy += "; some accounts not done yet (finished on the next daemon start)"
        else:
            policy = d.get("policy") or "?"
        print("calendars : %s  (CalDAV + CardDAV for every hosted address)" % ("on" if d.get("enabled") else "off"))
        print("files     : %s  (WebDAV file storage)" % ("on" if d.get("files") else "off"))
        print("policy    : %s" % policy)
        print("reachable : %s" % ("yes" if d.get("reachable") else "no"))
        if d.get("url"):
            print("url       : %s" % d["url"])
        if d.get("reason"):
            print("reason    : %s" % d["reason"])
        acc = d.get("accounts")
        if isinstance(acc, dict):
            print("accounts  : %s total, %s updated, %s unchanged, %s skipped" % (
                acc.get("total", "?"), acc.get("updated", "?"), acc.get("unchanged", "?"),
                len(acc.get("skipped") or [])))
        print("note      : a calendar app retrying a wrong password gets its IP banned —"
              " k2 hostmail bans list / k2 hostmail allowlist")

elif verb in ("group_create", "group_members", "group_list", "group_show", "group_delete"):
    # Calendars S4: groups (mail-manage). A group is for shared calendars;
    # a list (k2 hostmail list) is for mail fan-out.
    def print_group(g):
        print("group %s · %s member(s)%s" % (
            g.get("address") or g.get("name") or "?", len(g.get("members") or []),
            "" if g.get("receivesMail") else " · inbound mail off"))
        for m in g.get("members") or []:
            print("  %s" % m)
    if verb == "group_create":
        body = {"name": env("M_NAME"), "mail": env("M_GROUP_MAIL") == "true"}
        if env("M_DOMAIN"):
            body["domain"] = env("M_DOMAIN")
        d = call("POST", "/cli/mail/group", body=body, timeout=60)
        if as_json:
            print(dumps(d))
        else:
            print("created group %s%s" % (d.get("address"),
                  "" if d.get("receivesMail") else " (inbound mail off; --mail keeps it on)"))
            print("add members: k2 hostmail group add %s <addr> [<addr>…]" % d.get("address"))
    elif verb == "group_members":
        body = {"group": env("M_GROUP")}
        body["add" if env("M_LIST_OP") == "add" else "remove"] = env_list("M_MEMBERS")
        d = call("POST", "/cli/mail/group/members", body=body, timeout=120)
        print(dumps(d) if as_json else "group %s members=%s" % (
            d.get("group") or env("M_GROUP"), ",".join(d.get("members") or []) or "(none)"))
    elif verb == "group_list":
        d = call("GET", "/cli/mail/group", timeout=60)
        if as_json:
            print(dumps(d))
        else:
            gs = d.get("groups") or []
            if not gs:
                print("No groups. Create one: k2 hostmail group create <name>")
            for g in gs:
                print_group(g)
    elif verb == "group_show":
        d = call("GET", "/cli/mail/group", params={"group": env("M_GROUP")}, timeout=60)
        if as_json:
            print(dumps(d))
        else:
            print_group(d.get("group") or {})
    else:
        d = call("POST", "/cli/mail/group/delete", body={"group": env("M_GROUP")}, timeout=300)
        print(dumps(d) if as_json else "deleted group %s (%s calendar share(s) and %s membership(s) removed)" % (
            d.get("group") or env("M_GROUP"), d.get("sharesRemoved", 0), d.get("membersRemoved", 0)))

elif verb in ("cal_manage", "cal_share", "cal_unshare", "cal_shares", "cal_sharing"):
    # Calendars S4: calendar create/rename + sharing (mail-manage).
    if verb == "cal_manage":
        body = {"action": env("M_CAL_ACTION"), "owner": env("M_ADDRESS"), "name": env("M_NAME")}
        if env("M_CALENDAR"):
            body["calendar"] = env("M_CALENDAR")
        if env("M_COLOR"):
            body["color"] = env("M_COLOR")
        d = call("POST", "/cli/mail/calendar/manage", body=body, timeout=60)
        if as_json:
            print(dumps(d))
        else:
            c = d.get("calendar") or {}
            if d.get("created"):
                print("created calendar '%s' (%s) on %s" % (c.get("name"), c.get("id"), d.get("owner")))
            else:
                print("renamed calendar '%s' → '%s' (%s) on %s" % (
                    c.get("previousName"), c.get("name"), c.get("id"), d.get("owner")))
    elif verb in ("cal_share", "cal_unshare"):
        body = {"owner": env("M_ADDRESS"), "with": env("M_WITH")}
        if env("M_CALENDAR"):
            body["calendar"] = env("M_CALENDAR")
        if verb == "cal_share":
            body["level"] = env("M_SHARE_LEVEL")
        d = call("POST", "/cli/mail/calendar/" + ("share" if verb == "cal_share" else "unshare"),
                 body=body, timeout=120)
        if as_json:
            print(dumps(d))
        else:
            c = d.get("calendar") or {}
            if verb == "cal_share":
                prev = d.get("previousLevel")
                print("shared '%s' of %s with %s: %s%s" % (
                    c.get("name"), d.get("owner"), d.get("with"), d.get("level"),
                    (" (was %s)" % prev) if prev else ""))
                if d.get("maxShares"):
                    print("limit: %s shares per calendar (k2 hostmail calendar sharing)" % d.get("maxShares"))
            elif d.get("removed"):
                print("stopped sharing '%s' of %s with %s" % (c.get("name"), d.get("owner"), d.get("with")))
            else:
                print("'%s' of %s was not shared with %s — nothing to do" % (
                    c.get("name"), d.get("owner"), d.get("with")))
    elif verb == "cal_shares":
        d = call("GET", "/cli/mail/calendar/shares", params={"owner": env("M_ADDRESS")}, timeout=60)
        if as_json:
            print(dumps(d))
        else:
            cals = d.get("calendars") or []
            if not cals:
                print("%s has no calendars." % d.get("owner"))
            for c in cals:
                shares = c.get("shares") or []
                print("%s · %s%s · %s" % (c.get("id"), c.get("name") or "(unnamed)",
                      " · default" if c.get("isDefault") else "",
                      "not shared" if not shares else "%d share(s)" % len(shares)))
                for s in shares:
                    print("  %s (%s): %s" % (s.get("with"), s.get("withType"), s.get("level")))
            if d.get("maxShares"):
                print("limit: %s shares per calendar" % d.get("maxShares"))
    else:
        if env("M_MAX_SHARES"):
            d = call("POST", "/cli/mail/calendar/sharing",
                     body={"maxShares": int(env("M_MAX_SHARES"))}, timeout=60)
        else:
            d = call("GET", "/cli/mail/calendar/sharing", timeout=60)
        if as_json:
            print(dumps(d))
        else:
            print("max shares per calendar : %s" % d.get("maxShares"))
            print("directory queries       : %s" % ("on" if d.get("allowDirectoryQueries") else "off"))
            if isinstance(d.get("reloaded"), str):
                print("note: %s" % d.get("reloaded"))

elif verb == "profile":
    # Calendars S6: Apple .mobileconfig with a FRESH app password. The
    # secret is only inside the profile: never echoed in human output,
    # never in an error.
    out = env("M_OUT")
    force = env("M_FORCE") == "true"
    if out and os.path.lexists(out) and not force:
        die({"code": "usage", "hint": "%s already exists — pass --force to overwrite (nothing was minted)" % out})
    d = call("POST", "/cli/mail/profile", body={"address": env("M_ADDRESS"), "apple": True}, timeout=60)
    xml = d.get("profile") or ""
    if not xml:
        die({"code": "error", "hint": "daemon returned no profile"})
    revoke = d.get("revoke") or "k2 hostmail app-password revoke %s %s" % (env("M_ADDRESS"), d.get("appPasswordId") or "<id>")
    if out:
        flags = os.O_WRONLY | os.O_CREAT | (os.O_TRUNC if force else os.O_EXCL)
        try:
            fd = os.open(out, flags, 0o600)
            try:
                os.fchmod(fd, 0o600)
                os.write(fd, xml.encode("utf-8"))
            finally:
                os.close(fd)
        except OSError as e:
            die({"code": "error", "hint": "could not write %s (%s) — an app password was minted anyway; revoke it: %s" % (out, e.strerror or e, revoke)})
    if as_json:
        if out:
            d = dict(d)
            d.pop("profile", None)
            d["out"] = out
        print(dumps(d))
    elif out:
        print("wrote    : %s  (mode 0600, unsigned — iOS/macOS show \"Unverified\")" % out)
        print("address  : %s" % (d.get("address") or env("M_ADDRESS")))
        print("server   : %s" % (d.get("mailHost") or "?"))
        print("includes : %s" % ", ".join(d.get("includes") or ["mail"]))
        print("password : app password %s (%s) — inside the file only" % (d.get("appPasswordId") or "?", d.get("description") or "?"))
        print("revoke   : %s" % revoke)
        for n in d.get("notes") or []:
            print("note     : %s" % n)
        print("next     : AirDrop or email the file to the Mac/iPhone, then Settings → Profile Downloaded → Install. Delete the file afterwards.")
    else:
        # Profile XML alone on stdout (pipe-safe); the summary on stderr.
        sys.stdout.write(xml)
        sys.stdout.flush()
        sys.stderr.write("app password %s (%s) is inside this profile; revoke: %s\n" % (d.get("appPasswordId") or "?", d.get("description") or "?", revoke))
        for n in d.get("notes") or []:
            sys.stderr.write("note: %s\n" % n)

else:
    die({"code": "usage", "hint": "unknown mail verb '%s'" % verb})
PYEOF
}

# ── cmd_mail_* wrappers (arg parsing + validation; PRD §11) ──────────

# Positive-integer check shared by --timeout/--limit/--get/... (bash
# 3.2-safe; no [[ =~ ]]).
_mail_is_uint() {
    case "$1" in
        ''|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

# Validate a wait/--wait timeout: integer, 1..900 (§8.2 bounds — the
# daemon enforces the same; this just gives a friendlier local error).
_mail_check_timeout() {
    if ! _mail_is_uint "$1" || [ "$1" -lt 1 ] || [ "$1" -gt 900 ]; then
        _mail_err "usage" "--timeout must be 1-900 seconds (default 300); loop the call to wait longer"
        exit 2
    fi
}

cmd_mail_create() {
    if _wants_help "$@"; then cmd_help_mail_create; exit 0; fi
    local local_part="" domain="" client_id="" as_json=false person=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --domain)
                [ $# -ge 2 ] || { _mail_err "usage" "--domain requires a value"; exit 2; }
                domain="$2"; shift 2 ;;
            --id)
                [ $# -ge 2 ] || { _mail_err "usage" "--id requires a value (the idempotency key)"; exit 2; }
                client_id="$2"; shift 2 ;;
            --person) person=true; shift ;;
            --json) as_json=true; shift ;;
            -*)
                _mail_err "usage" "unknown flag '$1' — usage: k2 mail create <localpart>[@<domain>] [--domain <d>] [--id <client-id>] [--person] [--json]"
                exit 2 ;;
            *)
                if [ -z "$local_part" ]; then local_part="$1"; else
                    _mail_err "usage" "unexpected extra argument '$1' — one <localpart>[@<domain>] only"
                    exit 2
                fi
                shift ;;
        esac
    done
    if [ -z "$local_part" ]; then
        _mail_err "usage" "create requires a <localpart> (e.g. research-bot or research-bot@acme.dev)"
        exit 2
    fi
    local M_VERB="create" M_JSON="$as_json" M_LOCAL="$local_part" \
          M_DOMAIN="$domain" M_CLIENT_ID="$client_id" M_PERSON="$person"
    _mail_py
}

cmd_mail_addresses() {
    if _wants_help "$@"; then cmd_help_mail_addresses; exit 0; fi
    local as_json=false
    while [ $# -gt 0 ]; do
        case "$1" in
            --json) as_json=true; shift ;;
            *)
                _mail_err "usage" "unexpected argument '$1' — usage: k2 mail addresses [--json]"
                exit 2 ;;
        esac
    done
    local M_VERB="addresses" M_JSON="$as_json"
    _mail_py
}

cmd_mail_domains() {
    if _wants_help "$@"; then cmd_help_mail_domains; exit 0; fi
    local as_json=false
    while [ $# -gt 0 ]; do
        case "$1" in
            --json) as_json=true; shift ;;
            *)
                _mail_err "usage" "unexpected argument '$1' — usage: k2 mail domains [--json]"
                exit 2 ;;
        esac
    done
    local M_VERB="domains" M_JSON="$as_json"
    _mail_py
}

cmd_mail_messages() {
    if _wants_help "$@"; then cmd_help_mail_messages; exit 0; fi
    local address="" unread=false limit="" query="" from="" as_json=false
    local since="" before="" folder="" junk=false offset=""
    local usage="k2 mail messages [<address>] [--unread] [--limit N] [--offset N] [--since <date>] [--before <date>] [--folder <name>] [--junk] [--query <text>] [--from <substr>] [--json]"
    while [ $# -gt 0 ]; do
        case "$1" in
            --unread) unread=true; shift ;;
            --limit)
                [ $# -ge 2 ] || { _mail_err "usage" "--limit requires a number (1-200)"; exit 2; }
                limit="$2"; shift 2 ;;
            --offset)
                [ $# -ge 2 ] || { _mail_err "usage" "--offset requires a whole number (0-based page cursor)"; exit 2; }
                offset="$2"; shift 2 ;;
            --since)
                [ $# -ge 2 ] || { _mail_err "usage" "--since requires a date (YYYY-MM-DD or a relative age like 7d/24h/30m)"; exit 2; }
                since="$2"; shift 2 ;;
            --before)
                [ $# -ge 2 ] || { _mail_err "usage" "--before requires a date (YYYY-MM-DD or a relative age like 7d/24h/30m)"; exit 2; }
                before="$2"; shift 2 ;;
            --folder)
                [ $# -ge 2 ] || { _mail_err "usage" "--folder requires a mailbox name"; exit 2; }
                folder="$2"; shift 2 ;;
            --junk) junk=true; shift ;;
            --query)
                [ $# -ge 2 ] || { _mail_err "usage" "--query requires a value (matches subject AND body)"; exit 2; }
                query="$2"; shift 2 ;;
            --from)
                [ $# -ge 2 ] || { _mail_err "usage" "--from requires a value (matches the From header)"; exit 2; }
                from="$2"; shift 2 ;;
            --json) as_json=true; shift ;;
            -*)
                _mail_err "usage" "unknown flag '$1' — usage: $usage"
                exit 2 ;;
            *)
                if [ -z "$address" ]; then address="$1"; else
                    _mail_err "usage" "unexpected extra argument '$1' — one optional <address> only"
                    exit 2
                fi
                shift ;;
        esac
    done
    if [ -n "$limit" ] && { ! _mail_is_uint "$limit" || [ "$limit" -lt 1 ] || [ "$limit" -gt 200 ]; }; then
        _mail_err "usage" "--limit must be a number from 1 to 200 (default 25)"
        exit 2
    fi
    if [ -n "$offset" ] && ! _mail_is_uint "$offset"; then
        _mail_err "usage" "--offset must be a whole number (0 = first page)"
        exit 2
    fi
    if $junk && [ -n "$folder" ]; then
        _mail_err "usage" "use either --junk or --folder <name>, not both"
        exit 2
    fi
    local M_VERB="messages" M_JSON="$as_json" M_ADDRESS="$address" \
          M_UNREAD="$unread" M_LIMIT="$limit" M_QUERY="$query" M_FROM="$from" \
          M_OFFSET="$offset" M_SINCE="$since" M_BEFORE="$before" \
          M_FOLDER="$folder" M_JUNK="$junk"
    _mail_py
}

cmd_mail_read() {
    if _wants_help "$@"; then cmd_help_mail_read; exit 0; fi
    local id="" html=false raw=false as_json=false
    while [ $# -gt 0 ]; do
        case "$1" in
            --html) html=true; shift ;;
            --raw) raw=true; shift ;;
            --json) as_json=true; shift ;;
            -*)
                _mail_err "usage" "unknown flag '$1' — usage: k2 mail read <message-id> [--html] [--raw] [--json]"
                exit 2 ;;
            *)
                if [ -z "$id" ]; then id="$1"; else
                    _mail_err "usage" "unexpected extra argument '$1' — one <message-id> only"
                    exit 2
                fi
                shift ;;
        esac
    done
    if [ -z "$id" ]; then
        _mail_err "usage" "read requires a <message-id> (from 'k2 mail messages')"
        exit 2
    fi
    if $html && $raw; then
        _mail_err "usage" "--html and --raw are mutually exclusive (--raw is the full RFC 822 blob)"
        exit 2
    fi
    local M_VERB="read" M_JSON="$as_json" M_ID="$id" M_HTML="$html" M_RAW="$raw"
    _mail_py
}

cmd_mail_attachments() {
    if _wants_help "$@"; then cmd_help_mail_attachments; exit 0; fi
    local id="" get="" out="" as_json=false
    while [ $# -gt 0 ]; do
        case "$1" in
            --get)
                [ $# -ge 2 ] || { _mail_err "usage" "--get requires the 1-based attachment number"; exit 2; }
                get="$2"; shift 2 ;;
            --out)
                [ $# -ge 2 ] || { _mail_err "usage" "--out requires a workspace-relative path"; exit 2; }
                out="$2"; shift 2 ;;
            --json) as_json=true; shift ;;
            -*)
                _mail_err "usage" "unknown flag '$1' — usage: k2 mail attachments <message-id> [--get <n> --out <path>] [--json]"
                exit 2 ;;
            *)
                if [ -z "$id" ]; then id="$1"; else
                    _mail_err "usage" "unexpected extra argument '$1' — one <message-id> only"
                    exit 2
                fi
                shift ;;
        esac
    done
    if [ -z "$id" ]; then
        _mail_err "usage" "attachments requires a <message-id> (from 'k2 mail messages')"
        exit 2
    fi
    if [ -n "$get" ]; then
        if ! _mail_is_uint "$get" || [ "$get" -lt 1 ]; then
            _mail_err "usage" "--get takes the 1-based attachment number from the list"
            exit 2
        fi
        if [ -z "$out" ]; then
            _mail_err "usage" "--get needs --out <path> (workspace-relative; the daemon writes the bytes there, nothing more)"
            exit 2
        fi
    elif [ -n "$out" ]; then
        _mail_err "usage" "--out only makes sense with --get <n>"
        exit 2
    fi
    local M_VERB="attachments" M_JSON="$as_json" M_ID="$id" M_GET="$get" M_OUT="$out"
    _mail_py
}

cmd_mail_wait() {
    if _wants_help "$@"; then cmd_help_mail_wait; exit 0; fi
    local to="" from="" subject="" timeout="" as_json=false
    while [ $# -gt 0 ]; do
        case "$1" in
            --to)
                [ $# -ge 2 ] || { _mail_err "usage" "--to requires an owned address"; exit 2; }
                to="$2"; shift 2 ;;
            --from)
                [ $# -ge 2 ] || { _mail_err "usage" "--from requires a substring"; exit 2; }
                from="$2"; shift 2 ;;
            --subject)
                [ $# -ge 2 ] || { _mail_err "usage" "--subject requires a substring"; exit 2; }
                subject="$2"; shift 2 ;;
            --timeout)
                [ $# -ge 2 ] || { _mail_err "usage" "--timeout requires a value in seconds (1-900)"; exit 2; }
                timeout="$2"; shift 2 ;;
            --json) as_json=true; shift ;;
            -*)
                _mail_err "usage" "unknown flag '$1' — usage: k2 mail wait [--to <addr>] [--from <substr>] [--subject <substr>] [--timeout <secs>] [--json]"
                exit 2 ;;
            *)
                _mail_err "usage" "unexpected argument '$1' — wait takes filters as flags only"
                exit 2 ;;
        esac
    done
    [ -n "$timeout" ] && _mail_check_timeout "$timeout"
    local M_VERB="wait" M_JSON="$as_json" M_TO="$to" M_FROM="$from" \
          M_SUBJECT="$subject" M_TIMEOUT="$timeout"
    _mail_py
}

cmd_mail_send() {
    if _wants_help "$@"; then cmd_help_mail_send; exit 0; fi
    local to="" subject="" body="" body_file="" cc="" bcc="" from="" attach=""
    local wait=false timeout="" as_json=false send_at="" send_in=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --to)
                # §11.1.7: positional <to> AND --to both accepted.
                [ $# -ge 2 ] || { _mail_err "usage" "--to requires a recipient address"; exit 2; }
                to="${to}${to:+$'\n'}$2"; shift 2 ;;
            --subject)
                [ $# -ge 2 ] || { _mail_err "usage" "--subject requires a value"; exit 2; }
                subject="$2"; shift 2 ;;
            --body)
                [ $# -ge 2 ] || { _mail_err "usage" "--body requires the message text"; exit 2; }
                body="$2"; shift 2 ;;
            --body-file)
                [ $# -ge 2 ] || { _mail_err "usage" "--body-file requires a file path"; exit 2; }
                body_file="$2"; shift 2 ;;
            --cc)
                [ $# -ge 2 ] || { _mail_err "usage" "--cc requires an address"; exit 2; }
                cc="${cc}${cc:+$'\n'}$2"; shift 2 ;;
            --bcc)
                [ $# -ge 2 ] || { _mail_err "usage" "--bcc requires an address"; exit 2; }
                bcc="${bcc}${bcc:+$'\n'}$2"; shift 2 ;;
            --from)
                [ $# -ge 2 ] || { _mail_err "usage" "--from requires one of your addresses (see 'k2 mail addresses')"; exit 2; }
                from="$2"; shift 2 ;;
            --attach)
                [ $# -ge 2 ] || { _mail_err "usage" "--attach requires a file path"; exit 2; }
                attach="${attach}${attach:+$'\n'}$2"; shift 2 ;;
            --at)
                [ $# -ge 2 ] || { _mail_err "usage" "--at requires an RFC3339 timestamp"; exit 2; }
                send_at="$2"; shift 2 ;;
            --in)
                [ $# -ge 2 ] || { _mail_err "usage" "--in requires a duration (e.g. 30m, 2h, 1d)"; exit 2; }
                send_in="$2"; shift 2 ;;
            --wait) wait=true; shift ;;
            --timeout)
                [ $# -ge 2 ] || { _mail_err "usage" "--timeout requires a value in seconds (1-900)"; exit 2; }
                timeout="$2"; shift 2 ;;
            --json) as_json=true; shift ;;
            -*)
                _mail_err "usage" "unknown flag '$1' — usage: k2 mail send <to> --subject <s> (--body <text> | --body-file <f>) [--cc <addr>] [--bcc <addr>] [--from <owned-addr>] [--attach <path>] [--wait [--timeout <s>]] [--json]"
                exit 2 ;;
            *)
                to="${to}${to:+$'\n'}$1"; shift ;;
        esac
    done
    if [ -z "$to" ]; then
        _mail_err "usage" "send requires a recipient — positional <to> or --to <addr>"
        exit 2
    fi
    if [ -z "$subject" ]; then
        _mail_err "usage" "send requires --subject"
        exit 2
    fi
    if [ -n "$body" ] && [ -n "$body_file" ]; then
        _mail_err "usage" "--body and --body-file are mutually exclusive"
        exit 2
    fi
    if [ -n "$body_file" ]; then
        if [ ! -f "$body_file" ]; then
            _mail_err "usage" "--body-file: no such file '$body_file'"
            exit 2
        fi
        body="$(cat "$body_file")" || {
            _mail_err "usage" "--body-file: cannot read '$body_file'"
            exit 2
        }
    fi
    if [ -z "$body" ]; then
        _mail_err "usage" "send requires --body <text> or --body-file <f>"
        exit 2
    fi
    if [ -n "$timeout" ]; then
        if ! $wait; then
            _mail_err "usage" "--timeout only makes sense with --wait"
            exit 2
        fi
        _mail_check_timeout "$timeout"
    fi
    if [ -n "$send_at" ] && [ -n "$send_in" ]; then
        _mail_err "usage" "pass only one of --at <when> or --in <duration>, not both"
        exit 2
    fi
    if $wait && { [ -n "$send_at" ] || [ -n "$send_in" ]; }; then
        _mail_err "usage" "--wait cannot combine with --at/--in"
        exit 2
    fi
    local M_VERB="send" M_JSON="$as_json" M_TO="$to" M_SUBJECT="$subject" \
          M_BODY="$body" M_CC="$cc" M_BCC="$bcc" M_FROM="$from" M_ATTACH="$attach" \
