{
  "$defs": {
    "ArchiveWho": {
      "description": "`channels.archive`: who can archive a channel.",
      "oneOf": [
        {
          "const": "creator_and_managers",
          "description": "The channel's creator and channel managers.",
          "type": "string"
        },
        {
          "const": "managers",
          "description": "Channel managers only.",
          "type": "string"
        }
      ]
    },
    "ChannelCreateFloor": {
      "description": "`channels.create_*_floor`: the install-level gate on top of the create bit\n(gap G29 as amended by contracts revs 6 and 10).",
      "oneOf": [
        {
          "const": "perm",
          "description": "The permission bit alone suffices.",
          "type": "string"
        },
        {
          "const": "space_admins",
          "description": "The bit plus being a space admin.",
          "type": "string"
        },
        {
          "const": "install_admins",
          "description": "The bit plus being an install owner or admin.",
          "type": "string"
        }
      ]
    },
    "DigestDetail": {
      "description": "Org policy `digest.detail`: what a digest mail names (gap G13).",
      "oneOf": [
        {
          "const": "names",
          "description": "Conversations, counts, author names and times.",
          "type": "string"
        },
        {
          "const": "counts",
          "description": "Only the total and an \"Open Sew\" link.",
          "type": "string"
        }
      ]
    },
    "GuestInvite": {
      "description": "`guests.invite`: who can invite guests.",
      "oneOf": [
        {
          "const": "admins",
          "description": "Install owners and admins only.",
          "type": "string"
        },
        {
          "const": "perm",
          "description": "Anyone holding INVITE_GUESTS (bit 44).",
          "type": "string"
        }
      ]
    },
    "MeetingsCreate": {
      "description": "`meetings.create`: who may host a meeting (Meet MC1).",
      "oneOf": [
        {
          "const": "members",
          "description": "Any active non-guest member of the Meetings Space (on a standalone install, any\nactive non-guest member: the first create adds them to the Space).",
          "type": "string"
        },
        {
          "const": "admins",
          "description": "Install owners and admins only.",
          "type": "string"
        }
      ]
    },
    "NotifyLevel": {
      "description": "A notification level (`*.level` codes 1–3).",
      "oneOf": [
        {
          "const": "all",
          "description": "Every message.",
          "type": "string"
        },
        {
          "const": "mentions",
          "description": "Mentions, DMs, keywords and followed threads.",
          "type": "string"
        },
        {
          "const": "none",
          "description": "Nothing (reminders still arrive).",
          "type": "string"
        }
      ]
    },
    "SpacesCreate": {
      "description": "`spaces.create`: who can create spaces.",
      "oneOf": [
        {
          "const": "admins",
          "description": "Install owners and admins only.",
          "type": "string"
        },
        {
          "const": "members",
          "description": "Any member.",
          "type": "string"
        }
      ]
    },
    "VerificationCode": {
      "description": "Policy `calls.verification_code` (S50 §16.4): whether \"Call info → Security code\" is\nshown. `required` is reserved for a later mode and refused by the policy validator.",
      "oneOf": [
        {
          "const": "shown",
          "description": "Shown on request, never modal (the default).",
          "type": "string"
        },
        {
          "const": "hidden",
          "description": "Not shown.",
          "type": "string"
        },
        {
          "const": "required",
          "description": "Reserved: \"confirm before you speak\" (refused in v1).",
          "type": "string"
        }
      ]
    }
  },
