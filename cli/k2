cmd_msg() {
    # `k2 msg <workspace> "text" [--from <name>]`
    #
    # 0.38.6 deliver-or-loudly-fail contract: tries to deliver live to
    # the workspace's running agent, spawning the agent if needed.
    # Returns success only when the message has landed in the agent's
    # session. Never silently writes to inbox. For queued tasks the
    # recipient reads on their own schedule, use `k2 work send`.
    #
    # <workspace>   workspace name (preferred), absolute path, or UUID
    # --from <name> sender identity (default: auto-derived from CWD/
    #               K2SO_PROJECT_PATH; falls back to `external`)
    #
    # Legacy flags `--wake` and `--agent <name>` are accepted as
    # silent no-ops for one release so external scripts don't break
    # overnight. They'll be removed in 0.39.x.

    # `--help` / `-h` must be detected BEFORE arg-required validation
    # below — closes the chronic UX bug where `k2 msg --help`
    # errored with "message text required" instead of showing help.
    for arg in "$@"; do
        case "$arg" in
            --help|-h)
                cmd_help_msg
                return 0
                ;;
        esac
    done

    local target=""
    local text=""
    local explicit_from=""
    local explicit_command=""
    local explicit_via=""
    # Issue #9 — `msg` AUTO-WAKES a dormant canonical session by DEFAULT
    # (resume/spawn → wait READY → deliver), preserving the legacy
    # wake-on-message UX (PRD D7). `--no-wake` opts out (blind live-only
    # send); `--wake` is accepted as an explicit no-op for symmetry.
    # `--wake-timeout` bounds the post-wake readiness wait.
    local wake="true"
    local wake_timeout=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --from) explicit_from="$2"; shift 2 ;;
            --command) explicit_command="$2"; shift 2 ;;
            --wake)
                wake="true"; shift ;;
            --no-wake)
                wake="false"; shift ;;
            --wake-timeout)
                wake_timeout="$2"; shift 2 ;;
            --via)
                # Internal: `k2 talk` stamps via=talk so chatter does not
                # vanish into msg. Not a documented agent flag.
                explicit_via="$2"; shift 2 ;;
            --agent)
                # 0.39.0f Phase 2.1b: hard-deprecated. The agent-keyed
                # routing path is gone; `msg` is workspace-implicit.
                fail_deprecated "k2 msg --agent <name>" "k2 msg <workspace> \"text\"  (workspace-implicit; pass a workspace name/path)" ;;
            -*)
                echo "Error: unknown flag '$1' (try 'k2 msg --help')" >&2
                exit 1 ;;
            *)
                if [[ -z "$target" ]]; then target="$1"
                else text="$1"
                fi
                shift ;;
        esac
    done

    [[ -z "$target" ]] && {
        echo "Error: workspace required" >&2
        echo "Usage: k2 msg <workspace> \"text\" [--from <name>] [--command \"<text>\"]" >&2
        echo "       Run 'k2 msg --help' for full reference." >&2
        exit 1
    }
    [[ -z "$text" ]] && {
        echo "Error: message text required" >&2
        echo "Usage: k2 msg <workspace> \"text\" [--from <name>] [--command \"<text>\"]" >&2
        exit 1
    }

    # Cross-server peer: `k2 msg <agent>::<host> "text"` (or legacy @)
    # routes a CONNECTED remote peer over federation (same verb as a local
    # peer). Wire form `fp::ws::agent` is for `k2 fed send` only — teach.
    # Local-workspace path below is untouched when _REMOTE_HOST is empty.
    # (cmd_talk's @host is a different, owner-remote path and is
    # intentionally NOT unified here.)
    _split_remote_target "$target"
    if [ "${_IS_WIRE_FORM:-0}" = "1" ]; then
        echo "k2 msg: '${target}' looks like federation wire form (<fp>::<workspace>::<agent>)." >&2
        echo "  For agents use the user form:  k2 msg <agent>::<host> \"text\"" >&2
        echo "  Wire form is for:              k2 fed send <fp>::<ws>::<agent> \"text\"" >&2
        return 2
    fi
    if [ -n "$_REMOTE_HOST" ]; then
        _send_remote_msg "$_BARE_TARGET" "$_REMOTE_HOST" "$text" "$PROJECT"
        return $?
    fi

    # Resolve sender identity.
    #
    # Priority:
    #   1. Explicit --from <name>
    #   2. Auto-derive from K2SO_PROJECT_PATH or CWD (look up workspace name)
    #   3. Fallback: "external"
    #
    # The daemon also substitutes "external" defensively if it gets an
    # empty string, so the recipient PTY always sees a [from ...] prefix.
    local from="$explicit_from"
    if [[ -z "$from" ]]; then
        # Sidecar cells stamp sales/reviewer (D15). Daemon rewrite is
        # SSOT on scoped UDS; this covers TCP / env-only fallbacks.
        if [[ "${K2_CELL:-}" == "sidecar" && -n "${K2_PRIMARY:-}" && -n "${K2_SIDECAR_NAME:-}" ]]; then
            from="${K2_PRIMARY}/${K2_SIDECAR_NAME}"
        fi
    fi
    if [[ -z "$from" ]]; then
        # Prefer the workspace handle (D18) so [from] is a reply address,
        # never a pretty display name or a passport UUID.
        local sender_path="${K2_PROJECT_PATH:-${K2SO_PROJECT_PATH:-$PWD}}"
        if [[ -n "$sender_path" ]]; then
            local sender_name
            sender_name=$(cli_request "/cli/workspace/handle" \
                "project=$(urlencode "$sender_path")" 2>/dev/null \
                | python3 -c 'import json,sys
try:
    d = json.load(sys.stdin)
    name = (d.get("handle") or "").strip()
    if name:
        print(name)
except Exception:
    pass' 2>/dev/null)
            if [[ -z "$sender_name" ]]; then
                sender_name=$(cli_request "/cli/workspace/agent-display-name" \
                    "project=$(urlencode "$sender_path")" 2>/dev/null \
                    | python3 -c 'import json,sys
try:
    d = json.load(sys.stdin)
    name = (d.get("handle") or "").strip()
    if name:
        print(name)
except Exception:
    pass' 2>/dev/null)
            fi
            if [[ -z "$sender_name" ]]; then
                sender_name=$(cli_request "/cli/workspace/resolve" "q=$(urlencode "$sender_path")" 2>/dev/null \
                    | python3 -c 'import json,sys,os
try:
    data = json.load(sys.stdin)
    path = data.get("path","")
    if path:
        print(os.path.basename(path.rstrip("/")))
except Exception:
    pass' 2>/dev/null)
            fi
            from="${sender_name:-external}"
        else
            from="external"
        fi
    fi

    # Single canonical endpoint. Returns the canonical MsgResponse
    # shape: {success, target_session_id, attempts, reason, hint}.
    #
    # 0.39.45 (#29/#35/#37): POST with the text in the form body — long
    # messages used to ride the URL query string and got silently
    # truncated at the daemon's request-head cap (~2.7KB of payload).
    local params="workspace=$(urlencode "$target")"
    params="${params}&text=$(urlencode "$text")"
    params="${params}&from=$(urlencode "$from")"
    # 0.39.25: optional slash-command, prepended at the very front of the
    # delivered message (before the [from <name>] prefix). Only sent when
    # non-empty; an older daemon simply ignores this unknown param.
    [[ -n "$explicit_command" ]] && params="${params}&command=$(urlencode "$explicit_command")"
    # Issue #9 — wake gating. Send the resolved value EXPLICITLY (both
    # true and false): the daemon now defaults wake=ON, so `--no-wake`
    # MUST send `wake=false` to actually opt out. (An older daemon that
    # predates the param ignores it and never auto-woke — acceptable skew.)
    params="${params}&wake=${wake}"
    [[ -n "$wake_timeout" ]] && params="${params}&wake_timeout=$(urlencode "$wake_timeout")"
    [[ -n "$explicit_via" ]] && params="${params}&via=$(urlencode "$explicit_via")"

    local response
    # #58 Phase-1 close: prefer the scoped per-cell UDS for msg (the daemon
    # stamps `from` server-side); falls back to TCP+owner transparently.
    response=$(cli_send cli_post_form "/cli/workspace/msg" "$params")
    local rc=$?
    # 0.44.4: the legacy GET retry for pre-0.39.45 daemons is gone — the
    # daemon refuses GET on this route (it changes state).
    echo "$response"
    _k2_moved_from_note "$response"

    # Issue #9 — if the daemon WOKE a dormant canonical session to deliver,
    # surface it on stderr so the caller attributes the latency rather than
    # mistaking a multi-second wake for a hang. `woke`/`wake_ms` are only
    # present when a wake actually happened (older daemons omit them).
    echo "$response" | python3 -c 'import json,sys
try:
    d = json.load(sys.stdin)
    if d.get("woke"):
        ms = d.get("wake_ms")
        secs = " (%.1fs)" % (ms/1000.0) if isinstance(ms,(int,float)) else ""
        sys.stderr.write("note: peer was dormant — woke canonical session%s — delivered\n" % secs)
except Exception:
    pass' 2>/dev/null

    # C2 (0.40.45): 403 not_connected / gated → exit 3 + teaching stderr
    # (mail/dns shape). deliver-or-fail MsgResponse still exits 2.
    local gate_rc
    gate_rc=$(echo "$response" | python3 -c 'import json,sys
try:
    d = json.load(sys.stdin)
    err = d.get("error")
    if isinstance(err, dict):
        code = err.get("code") or ""
        if code in ("not_connected", "gated", "forbidden"):
            hint = err.get("hint") or code
            sys.stderr.write(json.dumps({"error": {"code": code, "hint": hint}},
                                        ensure_ascii=False, separators=(",", ":")) + "\n")
            print(3)
            raise SystemExit
    if d.get("success") is True:
        print(0)
    else:
        print(2)
except SystemExit:
    pass
except Exception:
    print(2)
' 2>/dev/null)
    if [[ "$gate_rc" == "3" ]]; then
        return 3
    fi
    if [[ "$gate_rc" != "0" ]]; then
        return 2
    fi
    return $rc
}

# ── `k2 thread` — user-agent overlay (not PTY; that's k2 msg) ───────
_thread_sender_from() {
    local explicit_from="$1"
    if [[ -n "$explicit_from" ]]; then
        printf '%s' "$explicit_from"
        return 0
    fi
    if [[ "${K2_CELL:-}" == "sidecar" && -n "${K2_PRIMARY:-}" && -n "${K2_SIDECAR_NAME:-}" ]]; then
        printf '%s' "${K2_PRIMARY}/${K2_SIDECAR_NAME}"
        return 0
    fi
    local sender_path="${K2_PROJECT_PATH:-${K2SO_PROJECT_PATH:-$PWD}}"
    if [[ -n "$sender_path" ]]; then
        local sender_name
        sender_name=$(cli_request "/cli/workspace/handle" \
            "project=$(urlencode "$sender_path")" 2>/dev/null \
            | python3 -c 'import json,sys
try:
    d = json.load(sys.stdin)
    name = (d.get("handle") or "").strip()
    if name:
        print(name)
except Exception:
    pass' 2>/dev/null)
        printf '%s' "${sender_name:-k2}"
        return 0
    fi
    printf '%s' "k2"
}

# ── Design mode: k2 browser note (prd-browser-design-mode-v1 D-A13) ───────
# Files a page note into a workspace's Thread exactly like a Design tab's
# Send: ONE Thread item (design origin) that wakes + injects the pinned
# Chat. Agents post only on their own workspace (passport); people need a
# login (Connect logins also need the workspace's remote-instruct opt-in).
cmd_help_browser() {
    cat <<'EOF'
Usage:
  k2 browser note --url <page-url> [--workspace <ws>] [--selector <css>]
                  [--html-file <file>] [--text <element text>] [--title <page title>]
                  [--intent change|question] [--json] "what to change"
  k2 browser redeliver <threadItemId> [--workspace <ws>] [--json]

note        Post one Design note (same route as a Design tab's Send:
            POST /cli/browser/notes). The note lands in the workspace's
            Thread and is delivered to its pinned Chat once. The page URL
            loses its query and hash; HTML is cleaned (scripts, handlers and
            secret-looking attributes removed) and clamped by the daemon.
            Without --workspace an agent posts to its own workspace.
redeliver   Deliver a stored notes post again when the first delivery
            failed ("delivered": false). Never posts a second Thread item.

Exit codes: 0 ok · 1 refused or failed · 2 usage.
EOF
}

cmd_browser() {
    case "${1:-}" in
        note)       shift; cmd_browser_note "$@" ;;
        redeliver)  shift; cmd_browser_redeliver "$@" ;;
        ""|-h|--help|help) cmd_help_browser ;;
        *)
            echo "Error: unknown browser subcommand '${1}'" >&2
            cmd_help_browser >&2
            exit 2
            ;;
    esac
}

# Print a /cli/browser/notes reply; exit 1 on an error body.
_browser_notes_reply() {
    local json="$1" raw="$2"
    printf '%s' "$raw" | python3 -c '
import json, sys
as_json = sys.argv[1] == "true"
raw = sys.stdin.read()
try:
    d = json.loads(raw)
except Exception:
    print("Error: daemon returned an unparseable response: %r" % raw[:200], file=sys.stderr)
    sys.exit(1)
err = d.get("error") if isinstance(d, dict) else None
if err or not d.get("ok"):
    if isinstance(err, dict):
        err = err.get("hint") or err.get("code") or err
    msg = d.get("message") or err or raw[:200]
    print("Error: %s" % msg, file=sys.stderr)
    sys.exit(1)
if as_json:
    print(json.dumps(d))
    sys.exit(0)
if d.get("delivered"):
    print("Sent to %s (Thread item %s)." % (d.get("addr"), d.get("threadItemId")))
else:
    print("Posted to the %s Thread (item %s) but not delivered to the agent yet." % (d.get("addr"), d.get("threadItemId")))
    print("Retry: k2 browser redeliver %s --workspace %s" % (d.get("threadItemId"), d.get("addr")))
' "$json"
}

cmd_browser_note() {
    local workspace="" url="" selector="" html_file="" text="" title="" intent="change" json="false" comment=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --workspace|-w) workspace="${2:-}"; shift 2 ;;
            --url) url="${2:-}"; shift 2 ;;
            --selector) selector="${2:-}"; shift 2 ;;
            --html-file) html_file="${2:-}"; shift 2 ;;
            --text) text="${2:-}"; shift 2 ;;
            --title) title="${2:-}"; shift 2 ;;
            --intent) intent="${2:-}"; shift 2 ;;
            --json) json="true"; shift ;;
            -h|--help) cmd_help_browser; return 0 ;;
            --*) echo "Error: unknown flag '$1'" >&2; cmd_help_browser >&2; exit 2 ;;
            *)
                if [ -n "$comment" ]; then
                    echo "Error: one note text only (quote it)" >&2
                    exit 2
                fi
                comment="$1"; shift ;;
        esac
    done
    if [ -z "$url" ] || [ -z "$comment" ]; then
        echo "Error: --url and the note text are required" >&2
        cmd_help_browser >&2
        exit 2
    fi
    case "$intent" in
        change|question) ;;
        *) echo "Error: --intent is change or question, got: $intent" >&2; exit 2 ;;
    esac
    if [ -n "$html_file" ] && [ ! -r "$html_file" ]; then
        echo "Error: cannot read --html-file $html_file" >&2
        exit 2
    fi
    [ -z "$workspace" ] && workspace="${PROJECT:-}"
    local body
    body=$(python3 -c '
import json, sys
ws, url, selector, html_file, text, title, intent, comment = sys.argv[1:9]
note = {"comment": comment, "intent": intent}
if selector or html_file or text:
    html = ""
    if html_file:
        with open(html_file, encoding="utf-8", errors="replace") as f:
            html = f.read(64 * 1024)
    note["payload"] = {"selector": selector, "html": html, "text": text}
print(json.dumps({"workspace": ws, "page": {"url": url, "title": title}, "notes": [note]}))
' "$workspace" "$url" "$selector" "$html_file" "$text" "$title" "$intent" "$comment") || exit 2
    local raw
    raw="$(cli_send cli_post_json "/cli/browser/notes" "$body")"
    _browser_notes_reply "$json" "$raw"
}

cmd_browser_redeliver() {
    local workspace="" item="" json="false"
    while [ $# -gt 0 ]; do
        case "$1" in
            --workspace|-w) workspace="${2:-}"; shift 2 ;;
            --json) json="true"; shift ;;
            -h|--help) cmd_help_browser; return 0 ;;
            --*) echo "Error: unknown flag '$1'" >&2; exit 2 ;;
            *) item="$1"; shift ;;
        esac
    done
    if [ -z "$item" ]; then
        echo "Error: the Thread item id is required" >&2
        cmd_help_browser >&2
        exit 2
    fi
    [ -z "$workspace" ] && workspace="${PROJECT:-}"
    local body
    body=$(python3 -c 'import json,sys; print(json.dumps({"workspace": sys.argv[1], "threadItemId": sys.argv[2]}))' "$workspace" "$item")
    local raw
    raw="$(cli_send cli_post_json "/cli/browser/notes/redeliver" "$body")"
    _browser_notes_reply "$json" "$raw"
}

# Design mode per workspace (migration 0179): the pinned Design tab and the
# + menu's Design entry. Default on. `k2 workspace design-mode get|set`.
cmd_workspace_design_mode() {
    local sub="${1:-}"
    shift || true
    local target="${1:-}"
    case "$sub" in
        get|set)
            if [ -z "$target" ]; then
                echo "Usage: k2 workspace design-mode get|set <workspace> [on|off]" >&2
                exit 2
            fi
            ;;
        ""|-h|--help|help)
            cat <<'EOF' >&2
Usage: k2 workspace design-mode get|set <workspace> [on|off]

Design mode shows the workspace's pinned Design tab (next to Inbox) and
Design in the + menu, for every client of the room. Default on. Off hides
both; it does not stop `k2 browser note`.
EOF
            [ -z "$sub" ] && exit 2
            return 0
            ;;
        *) echo "Usage: k2 workspace design-mode get|set <workspace> [on|off]" >&2; exit 2 ;;
    esac
    local resolved_path
    resolved_path=$(cli_request "/cli/workspace/resolve" "q=$(urlencode "$target")" 2>/dev/null \
        | python3 -c 'import json,sys
try:
    print(json.load(sys.stdin).get("path",""))
except Exception:
    pass' 2>/dev/null)
    [ -z "$resolved_path" ] && resolved_path="$target"
    if [ "$sub" = "get" ]; then
        cli_request "/cli/settings" "project=$(urlencode "$resolved_path")" | python3 -c '
import json, sys
raw = sys.stdin.read()
try:
    d = json.loads(raw)
except Exception:
    print("Error: daemon returned an unparseable response: %r" % raw[:200], file=sys.stderr)
    sys.exit(1)
if isinstance(d, dict) and d.get("error"):
    err = d["error"]
    print("Error: %s" % (err.get("hint") or err.get("code") or err if isinstance(err, dict) else err), file=sys.stderr)
    sys.exit(1)
if "designModeEnabled" not in d:
    print("Error: this daemon does not know Design mode (update it)", file=sys.stderr)
    sys.exit(1)
print("on" if d["designModeEnabled"] else "off")
'
        return
    fi
    local mode="${2:-}" val=""
    case "$(printf '%s' "$mode" | tr '[:upper:]' '[:lower:]')" in
        on|1|true|yes)  val="1" ;;
        off|0|false|no) val="0" ;;
        *) echo "Error: expected on|off, got: ${mode:-<nothing>}" >&2; exit 2 ;;
    esac
    local body
    body=$(python3 -c 'import json,sys
print(json.dumps({"project": sys.argv[1], "fields": {"design_mode_enabled": sys.argv[2]}}))' "$resolved_path" "$val")
    cli_post_json "/cli/workspace/set" "$body" | python3 -c '
import json, sys
raw = sys.stdin.read()
try:
    d = json.loads(raw)
except Exception:
    print("Error: daemon returned an unparseable response: %r" % raw[:200], file=sys.stderr)
    sys.exit(1)
if d.get("error") or d.get("ok") is False:
    err = d.get("error")
    if isinstance(err, dict):
        err = err.get("hint") or err.get("code") or err
    print("Error: %s" % (err or raw[:200]), file=sys.stderr)
    sys.exit(1)
state = "on" if sys.argv[1] == "1" else "off"
for a in d.get("actions") or []:
    if a.get("field") == "design_mode_enabled" and a.get("status") == "skipped":
        print("Design mode already %s (unchanged)." % state)
        sys.exit(0)
print("Design mode %s." % state)
' "$val"
}

# k2 thread export|import|imports (prd-clone-carries-threads-and-vault-v1
# T4): move a workspace's Threads outside a clone. People only (Owner/Admin);
# imports land read-only and re-runs are no-ops.
cmd_thread_transfer() {
    local sub="" ws="" path="" to="" since="" json=0
    while [ $# -gt 0 ]; do
        case "$1" in
            export|import|imports) [ -z "$sub" ] && sub="$1" || ws="$1"; shift ;;
            --to) to="${2:-}"; shift 2 ;;
            --since-days|--threads-since) since="${2:-}"; shift 2 ;;
            --json) json=1; shift ;;
            -*) echo "usage: k2 thread export <ws> [--since-days N] | import <file> --to <ws> | imports <ws>" >&2; exit 2 ;;
            *) if [ "$sub" = "import" ]; then path="$1"; else ws="$1"; fi; shift ;;
        esac
    done
    case "$sub" in
        export)
            [ -n "$ws" ] || { echo "usage: k2 thread export <ws> [--since-days N]" >&2; exit 2; }
            _clone_person_guard
            _compute_call POST /cli/thread/export "$(_compute_json K2_CJ_ws="$ws" K2_CJ_sinceDays_n="$since")" tcp
            if [ "$json" = 1 ]; then printf '%s\n' "$_CP_BODY"; return 0; fi
            printf '%s' "$_CP_BODY" | python3 -c '
import json, sys
v = json.load(sys.stdin)
s = v.get("summary") or {}
print("%s: %s Thread(s), %s line(s) → %s" % (v.get("workspace"), s.get("conversations"), s.get("docs"), v.get("path")))'
            ;;
        import)
            [ -n "$path" ] && [ -n "$to" ] || { echo "usage: k2 thread import <file> --to <ws>" >&2; exit 2; }
            _clone_person_guard
            local abs
            abs="$(cd "$(dirname "$path")" 2>/dev/null && pwd)/$(basename "$path")"
            _compute_call POST /cli/thread/import "$(_compute_json K2_CJ_path="$abs" K2_CJ_to="$to")" tcp
            if [ "$json" = 1 ]; then printf '%s\n' "$_CP_BODY"; return 0; fi
            printf '%s' "$_CP_BODY" | python3 -c '
import json, sys
v = json.load(sys.stdin)
r = v.get("report") or {}
print("%s: imported %s line(s) into %s Thread(s) (%s already there)%s" % (v.get("workspace"), r.get("docsImported"),
      len(r.get("conversations") or []), r.get("docsSkipped"), " — main Thread waits for the first chat" if r.get("pending") else ""))'
            ;;
        imports)
            [ -n "$ws" ] || { echo "usage: k2 thread imports <ws>" >&2; exit 2; }
            _compute_call GET /cli/thread/imports "ws=$(urlencode "$ws")" tcp
            if [ "$json" = 1 ]; then printf '%s\n' "$_CP_BODY"; return 0; fi
            printf '%s' "$_CP_BODY" | python3 -c '
import json, sys
rows = json.load(sys.stdin).get("imports") or []
if not rows:
    print("No imported Threads."); sys.exit(0)
for r in rows:
    print("%-44s %-17s %5s lines  from %s on %s%s" % (r["localConversationId"], r["role"], r["docCount"], r["sourceHandle"], r["sourceHost"],
          (" (" + r["name"] + ")") if r.get("name") else ""))'
            ;;
    esac
}

cmd_thread() {
    for arg in "$@"; do
        case "$arg" in
            --help|-h)
                cmd_help_thread
                return 0
                ;;
        esac
    done

    local first_pos="" skip_next=0
    for arg in "$@"; do
        if [[ $skip_next -eq 1 ]]; then skip_next=0; continue; fi
        case "$arg" in
            --from|--options|--option|--name|--prompt|--dest|--timeout|--style|--limit|--before-seq)
                skip_next=1
                continue
                ;;
            --*) continue ;;
            *) first_pos="$arg"; break ;;
        esac
    done
    case "$first_pos" in
        ask) cmd_thread_ask "$@"; return $? ;;
        secret) cmd_thread_secret "$@"; return $? ;;
        void) cmd_thread_void "$@"; return $? ;;
        export|import|imports) cmd_thread_transfer "$@"; return $? ;;
        post)
            echo "Error: no 'post' subcommand — use  k2 thread <addr> \"text\"" >&2
            exit 1 ;;
    esac

    local target=""
    local text=""
    local json="false"
    local explicit_from=""
    local limit=""
    local all="false"
    local before_seq=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json) json="true"; shift ;;
            --from) explicit_from="$2"; shift 2 ;;
            --limit) limit="$2"; shift 2 ;;
            --all) all="true"; shift ;;
            --before-seq) before_seq="$2"; shift 2 ;;
            -*)
                echo "Error: unknown flag '$1' (try 'k2 thread --help')" >&2
                exit 1 ;;
            *)
                if [[ -z "$target" ]]; then target="$1"
                else text="$1"
                fi
                shift ;;
        esac
    done

    [[ -z "$target" ]] && {
        echo "Error: address required" >&2
        echo "Usage: k2 thread <addr> \"text\"     # write overlay text" >&2
        echo "       k2 thread <addr> [--json] [--limit N|--all] [--before-seq N]" >&2
        echo "       k2 thread ask <addr> \"prompt\" --options \"a,b,c\"" >&2
        echo "       k2 thread secret <addr> --name NAME" >&2
        echo "       k2 thread void <addr> <card-id>" >&2
        exit 1
    }

    local from
    from="$(_thread_sender_from "$explicit_from")"

    if [[ -n "$text" ]]; then
        local params="addr=$(urlencode "$target")"
        params="${params}&text=$(urlencode "$text")"
        params="${params}&from=$(urlencode "$from")"
        params="${params}&via=thread"
        local response
        response=$(cli_send cli_post_form "/cli/thread/post" "$params")
        local rc=$?
        _k2_moved_from_note "$response"
        if [[ "$json" == "true" ]]; then
            echo "$response"
        else
            echo "$response" | python3 -c 'import json,sys
raw=sys.stdin.read()
try:
    d=json.loads(raw)
except Exception:
    sys.stdout.write(raw)
    sys.exit(0)
if d.get("ok") is not True:
    err=d.get("error") or d
    if isinstance(err, dict):
        sys.stderr.write("%s: %s\n" % (err.get("code") or "error", err.get("hint") or err))
    else:
        sys.stderr.write(str(err)+"\n")
    sys.exit(2)
print("%s  seq=%s  from=%s" % (d.get("id",""), d.get("seq",""), d.get("from","")))
'
            rc=$?
            if [[ $rc -eq 0 ]]; then
                _thread_md_nudge
            fi
        fi
        return $rc
    fi

    local params="addr=$(urlencode "$target")"
    if [[ "$all" == "true" ]]; then
        params="${params}&limit=0"
    elif [[ -n "$limit" ]]; then
        params="${params}&limit=$(urlencode "$limit")"
    fi
    if [[ -n "$before_seq" ]]; then
        params="${params}&before_seq=$(urlencode "$before_seq")"
    fi
    local response
    response=$(cli_send cli_request "/cli/thread" "$params")
    local rc=$?
    if [[ "$json" == "true" ]]; then
        echo "$response"
        return $rc
    fi
    echo "$response" | python3 -c 'import json,sys
raw=sys.stdin.read()
try:
    d=json.loads(raw)
except Exception:
    sys.stdout.write(raw)
    sys.exit(0)
if d.get("ok") is not True:
    err=d.get("error") or d
    if isinstance(err, dict):
