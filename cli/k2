            frm = e.get('from') or ''
            to = e.get('to') or ''
            route = f' ({frm}→{to})' if frm and to else ''
            print(f'  [{ts}] {agent}: {etype}{route} {summary}')
except Exception as ex:
    print(f'Error: {ex}', file=sys.stderr)
" 2>/dev/null
}

cmd_workspace_create() {
