          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "reason": {
          "description": "Why: `marker`, `missing`, `corrupt`, `meta_mismatch` or `admin`.",
          "type": "string"
        },
        "started_at": {
          "description": "When it started.",
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "reason",
        "generation",
        "progress_pct",
        "docs",
        "started_at"
      ],
      "type": "object"
    },
