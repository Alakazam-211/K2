        {"name": "--mention", "arg": "P", "description": "Mention someone (repeatable)."},
        {"name": "--proposal", "arg": "FILE", "description": "Name a new file as your proposal (repeatable)."}
      ]
    },
    {
      "name": "doc resolve",
      "usage": "k2 doc resolve ann-N [--reopen] <f>",
      "description": "Resolve a comment thread.",
      "args": [{"name": "ann-N", "required": true}, {"name": "f", "required": true, "description": "The doc's path; it is the last argument."}],
