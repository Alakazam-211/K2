# k2-daemon systemd USER unit — Linux twin of the macOS launchd agent
# dev.k2.daemon (RunAtLoad=true, KeepAlive=true, logs under ~/.k2/).
#
# systemd opens StandardOutput= before any command in this unit, so the
# log directory has to exist already. k2-daemon-home.service creates it.
#
# Enable per-user, after installing the k2-daemon package:
#   systemctl --user daemon-reload
#   systemctl --user enable --now k2-daemon
# Headless boxes need a lingering user manager first:
#   loginctl enable-linger <user>
[Unit]
Description=K2 daemon — AI workspace orchestration backend
Documentation=https://k2.dev
After=network.target k2-daemon-home.service
Requires=k2-daemon-home.service

[Service]
Type=simple
ExecStart=/usr/bin/k2-daemon
Restart=always
RestartSec=2
# Agents run in this unit's cgroup. The default OOMPolicy=stop turns one
# OOM-killed agent into a stop + restart of the whole daemon; continue lets
# only that process die. (The stage H drop-in carries the same line.)
OOMPolicy=continue
# The unit's own runtime dir (/run/k2; XDG_RUNTIME_DIR/k2 for a user unit)
# holds frpc.toml and agents' secret files: systemd-logind deletes
# /run/user/<uid> and the user's /dev/shm files when their last login
# session ends. Preserve keeps it across restarts (frpc and agents outlive
# the daemon process). (The stage H drop-in carries the same lines.)
RuntimeDirectory=k2
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
StandardOutput=append:%h/.k2/daemon.stdout.log
StandardError=append:%h/.k2/daemon.stderr.log

[Install]
WantedBy=default.target
